use ::byte_engine::rendering::layouts::color::*;

source: descriptor<{ type: StorageImage, binding: 0, access: read }>;
// A tile output, so the replacement for `main` this writes needs no shader-write usage and stays losslessly compressed.
result: output<vec4f, 0>;

// The fitted curve is a ratio of two polynomials, so an infinite input, which a floating-point scene holds where a
// highlight overflowed, would give infinity over infinity, NaN, and show as black. Holding the input to the half-float
// range keeps the curve finite near its limit of about 1.0165, which the output clamp maps to white.
HALF_FLOAT_MAX: const f32 = 65504.0;

// Stephen Hill's fitted ACES approximation, `ACESFitted` in Baking Lab, built from the color layout's `aces_fitted_*`
// helpers. It maps scene-linear sRGB to display-linear sRGB in [0, 1].
aces_fitted: fn(input_color: vec3f) -> vec3f {
	let color: vec3f = clamp(input_color, splat3(0.0), splat3(HALF_FLOAT_MAX));
	color = aces_fitted_output(aces_fitted_rrt_odt(aces_fitted_input(color)));
	return clamp(color, splat3(0.0), splat3(1.0));
}

main: fn(input: StageInput) -> void {
	let coord: vec2u = input.thread_id;
	let source_color: vec4f = vec4f(0.0, 0.0, 0.0, 0.0);
	let result_color: vec3f = vec3f(0.0, 0.0, 0.0);

	let extent: vec2u = input.extent;
	if (coord.x >= extent.x || coord.y >= extent.y) {
		return;
	}
	source_color = image_load(source, coord);
	result_color = aces_fitted(vec3f(source_color.x, source_color.y, source_color.z));
	// The swapchain uses a non-sRGB UNORM format, so encode linear output before storing it.
	result_color = linear_srgb_to_srgb(result_color);
	write(result, coord, vec4f(result_color.x, result_color.y, result_color.z, 1.0));
}
