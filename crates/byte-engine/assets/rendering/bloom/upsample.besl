// Climbs one level of the bloom pyramid: the lower level is blurred with a 3x3 tent filter, spread `filter.x`
// lower-level texels wide, and added to the same-resolution level from the downsample chain. Adding instead of
// blending means every level contributes, so the glow falls off smoothly over the whole pyramid.
BloomParameters: struct {
	prefilter: vec4f[1],
	filter: vec4f[1],
}

low_resolution_texture: descriptor<{ type: Texture2D, binding: 0, access: read }>;
high_resolution_texture: descriptor<{ type: Texture2D, binding: 1, access: read }>;
result_texture: descriptor<{ type: StorageImage<rgba16f>, binding: 2, access: write }>;
bloom_parameters: descriptor<{ type: BloomParameters, binding: 3, access: read, memory: constant }>;

// Reads the lower level `offset_x`, `offset_y` filter steps away from `uv`.
sample_low: fn (uv: vec2f, step: vec2f, offset_x: f32, offset_y: f32) -> vec3f {
	let sampled: vec4f = texture_lod(low_resolution_texture, uv + vec2f(offset_x, offset_y) * step);
	return vec3f(sampled.x, sampled.y, sampled.z);
}

main: fn(input: StageInput) -> void {
	let coord: vec2u = input.thread_id;
	guard_image_bounds(result_texture, coord);
	let result_size: vec2u = image_size(result_texture);
	let low_size: vec2u = texture_size(low_resolution_texture);
	let uv: vec2f = (vec2f(f32(coord.x), f32(coord.y)) + vec2f(0.5, 0.5)) / vec2f(f32(result_size.x), f32(result_size.y));
	let radius: f32 = bloom_parameters.filter[0].x;
	let step: vec2f = vec2f(radius / f32(low_size.x), radius / f32(low_size.y));

	// Tent weights: 4 at the center, 2 on the edges, 1 in the corners, out of 16.
	let center: vec3f = sample_low(uv, step, 0.0, 0.0);
	let edges: vec3f = sample_low(uv, step, 0.0 - 1.0, 0.0)
		+ sample_low(uv, step, 1.0, 0.0)
		+ sample_low(uv, step, 0.0, 0.0 - 1.0)
		+ sample_low(uv, step, 0.0, 1.0);
	let corners: vec3f = sample_low(uv, step, 0.0 - 1.0, 0.0 - 1.0)
		+ sample_low(uv, step, 1.0, 0.0 - 1.0)
		+ sample_low(uv, step, 0.0 - 1.0, 1.0)
		+ sample_low(uv, step, 1.0, 1.0);
	let blurred: vec3f = center * 0.25 + edges * 0.125 + corners * 0.0625;

	let high_res: vec4f = texture_lod(high_resolution_texture, uv);
	let combined: vec3f = vec3f(high_res.x, high_res.y, high_res.z) + blurred;
	write(result_texture, coord, vec4f(combined.x, combined.y, combined.z, 1.0));
}
