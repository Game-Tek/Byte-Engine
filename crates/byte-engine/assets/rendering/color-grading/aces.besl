// A tile output, so the replacement for `main` this writes needs no shader-write usage and stays losslessly compressed.
result_texture: output<vec4f, 0>;

rrt_saturation: fn(color: vec3f) -> vec3f {
	let x: f32 = 0.9708891487 * color.x + 0.0269632706 * color.y + 0.0021475807 * color.z;
	let y: f32 = 0.0108891487 * color.x + 0.9869632706 * color.y + 0.0021475807 * color.z;
	let z: f32 = 0.0108891487 * color.x + 0.0269632706 * color.y + 0.9621475807 * color.z;
	return vec3f(x, y, z);
}

// This AP1-aware fitted transform is stable and hue-aware, but does not claim ACES reference-transform compliance.
// The input is already AP1, so it takes only the RRT's saturation in place of Hill's full input matrix.
aces_fitted_sdr: fn(color: vec3f) -> vec3f {
	color = max(color, vec3f(0.0, 0.0, 0.0));
	color = aces_fitted_output(aces_fitted_rrt_odt(rrt_saturation(color)));
	return clamp(color, vec3f(0.0, 0.0, 0.0), vec3f(1.0, 1.0, 1.0));
}

// Convert to ACEScct, apply the creative look, then render the result to the SDR sRGB display.
main: fn(input: StageInput) -> void {
	let coord: vec2u = input.thread_id;
	let extent: vec2u = input.extent;
	if (coord.x >= extent.x || coord.y >= extent.y) {
		return;
	}
	let uv: vec2f = (vec2f(f32(coord.x), f32(coord.y)) + vec2f(0.5, 0.5)) / vec2f(f32(extent.x), f32(extent.y));
	let source_color: vec4f = texture_lod(source_texture, uv);
	let source_rgb: vec3f = vec3f(source_color.x, source_color.y, source_color.z);
	let grading_color: vec3f = acescct(linear_srgb_to_acescg(source_rgb));
	// The LUT operates entirely in ACEScct.
	let looked_acescg: vec3f = acescct_to_acescg(apply_lut(grading_color));
	let result_color: vec3f = linear_srgb_to_srgb(aces_fitted_sdr(looked_acescg));
	write(result_texture, coord, vec4f(result_color.x, result_color.y, result_color.z, source_color.w));
}
