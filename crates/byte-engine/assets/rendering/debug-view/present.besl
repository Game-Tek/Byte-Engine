// Tiles the debug views the renderer shows this frame into the sink's final output, over whatever the frame drew.
//
// Shown views hold the first `count` pool slots, and sit in the grid in slot order. One view fills the screen, two sit side by side, three or four take a 2x2 grid,
// five to nine a 3x3, and so on; a cell past the last view is black. Each slot is written at full resolution, so a
// cell averages the `side` x `side` block of slot texels that lands on each of its pixels: a box filter that keeps
// thin lines visible where point sampling would drop them.

DebugViewPresentParameters: struct {
	// How many views are shown: they hold pool slots `0` to `count - 1`.
	count: u32,
	// The grid's side: the smallest whole number whose square holds `count` views.
	side: u32,
}

result: descriptor<{ type: StorageImage, binding: 0, access: write }>;
parameters: descriptor<{ type: DebugViewPresentParameters, binding: 1, access: read, memory: constant }>;
// An arrayed binding takes `count` flat slots, so the pool comes last.
debug_view_targets: descriptor<{ type: StorageImage, binding: 2, access: read, count: 15 }>;

main: fn (input: StageInput) -> void {
	let pixel: vec2u = input.thread_id;
	guard_image_bounds(result, pixel);
	let extent: vec2u = image_size(result);
	let side: u32 = max(parameters.side, 1);
	// The cell this pixel lies in, and where the pixel lies inside it.
	let cell_extent: vec2u = vec2u(max(extent.x / side, 1), max(extent.y / side, 1));
	let cell: vec2u = vec2u(min(pixel.x / cell_extent.x, side - 1), min(pixel.y / cell_extent.y, side - 1));
	let index: u32 = cell.y * side + cell.x;
	if (index >= parameters.count) {
		write(result, pixel, vec4f(0.0, 0.0, 0.0, 1.0));
		return;
	}
	// The block of slot texels this pixel stands for, clamped to the slot, which is sink-sized.
	let origin: vec2u = vec2u((pixel.x - cell.x * cell_extent.x) * side, (pixel.y - cell.y * cell_extent.y) * side);
	let sum: vec4f = vec4f(0.0, 0.0, 0.0, 0.0);
	for (let y: u32 = 0; y < side; y = y + 1) {
		for (let x: u32 = 0; x < side; x = x + 1) {
			let texel: vec2u = vec2u(min(origin.x + x, extent.x - 1), min(origin.y + y, extent.y - 1));
			sum = sum + image_load(debug_view_targets[index], texel);
		}
	}
	let color: vec4f = sum / f32(side * side);
	write(result, pixel, vec4f(color.x, color.y, color.z, 1.0));
}
