push_constant: push_constant {
	view_projection_model: mat4f,
	color: vec4f,
}

in_position: input<vec3f, 0>;

main: fn () -> interface { position: vec4f, color: vec4f } {
	let position: vec4f = push_constant.view_projection_model * vec4f(in_position.x, in_position.y, in_position.z, 1.0);
	return { position, color: push_constant.color };
}
