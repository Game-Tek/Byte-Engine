// Prepares the depth-of-field gather: each pixel's color next to its blur diameter, in one half-float image the gather
// and the averaged levels read, and each 16x16 tile's widest reach, which tells the gather how far it must look.
//
// The blur diameter comes from depth in one multiply-add: the thin-lens circle of confusion is affine in reverse-Z
// depth, and the CPU folds the lens and the view into `parameters.circle_of_confusion`. See the depth of field section
// of the rendering reference.

scene_texture: descriptor<{ type: Texture2D, binding: 0, access: read }>;
depth_texture: descriptor<{ type: Texture2D, binding: 1, access: read }>;
parameters: descriptor<{ type: DepthOfFieldParameters, binding: 2, access: read, memory: constant }>;
// rgb: the scene's color; a: the signed blur diameter in pixels.
source: descriptor<{ type: StorageImage<rgba16f>, binding: 3, access: write }>;
tile_reaches: descriptor<{ type: TileReaches, binding: 4, access: write }>;
// The renderer's debug target pool, which the shown debug views write; see `debug_views.rs`.
debug_view_targets: descriptor<{ type: StorageImage, binding: 5, access: write, count: 15 }>;

// The tile's widest reach, in 1/64 pixels, so lanes can take its maximum with integer atomics.
tile_reach: workgroup<atomicu32, 1>;

DEPTH_OF_FIELD_TILE_WIDTH: const u32 = 16;
REACH_STEPS_PER_PIXEL: const f32 = 64.0;
HALF_FLOAT_MAX: const f32 = 65504.0;
// The blur diameter, in pixels, at which the debug view reaches full brightness.
DEBUG_FULL_SCALE: const f32 = 32.0;

main: fn (input: StageInput) -> void {
	let lane: u32 = input.thread_idx;
	let pixel: vec2u = input.thread_id;
	let extent: vec2u = texture_size(depth_texture);
	if (lane == 0) {
		atomic_store(tile_reach[0], 0);
	}
	workgroup_barrier();

	// Every lane reaches the shuffles and both barriers; only lanes over the image read and write it.
	let reach: f32 = 0.0;
	if (pixel.x < extent.x && pixel.y < extent.y) {
		let depth: f32 = fetch(depth_texture, pixel).x;
		let color: vec4f = fetch(scene_texture, pixel);
		let blur: f32 = blur_diameter(parameters.circle_of_confusion.x + parameters.circle_of_confusion.y * depth, parameters.blur_limits);
		// A texel at the half-float limit would turn the gather's sums infinite.
		write(source, pixel, vec4f(min(color.x, HALF_FLOAT_MAX), min(color.y, HALF_FLOAT_MAX), min(color.z, HALF_FLOAT_MAX), blur));
		reach = abs(blur) * 0.5;

		// The blur view: red in front of the focus distance, blue behind it, green where the blur is under a pixel.
		if (parameters.debug_view_circle_of_confusion) {
			let in_focus: f32 = 0.0;
			if (abs(blur) < 1.0) {
				in_focus = 1.0;
			}
			write(
				debug_view_targets[parameters.debug_view_first_slot],
				pixel,
				vec4f(clamp((0.0 - blur) / DEBUG_FULL_SCALE, 0.0, 1.0), in_focus, clamp(blur / DEBUG_FULL_SCALE, 0.0, 1.0), 1.0)
			);
		}
	}
	// The widest reach of each aligned group of 16 lanes, one row of the tile, from lane shuffles; then one atomic per
	// group instead of one per lane, which would queue all 256 lanes on one address.
	reach = max(reach, subgroup_shuffle_xor_f32(reach, 1));
	reach = max(reach, subgroup_shuffle_xor_f32(reach, 2));
	reach = max(reach, subgroup_shuffle_xor_f32(reach, 4));
	reach = max(reach, subgroup_shuffle_xor_f32(reach, 8));
	if (lane % DEPTH_OF_FIELD_TILE_WIDTH == 0) {
		// Rounded up, so the stored reach never falls short of a texel's.
		atomic_max(tile_reach[0], u32(ceil(reach * REACH_STEPS_PER_PIXEL)));
	}
	workgroup_barrier();

	// Lane 0's pixel is the tile's first, which always lies in the image.
	if (lane == 0) {
		let tile: vec2u = pixel / DEPTH_OF_FIELD_TILE_WIDTH;
		tile_reaches.values[tile.y * parameters.tiles_per_row + tile.x] = f32(atomic_load(tile_reach[0])) / REACH_STEPS_PER_PIXEL;
	}
}
