// Averages 2x2 texels of one depth-of-field level into the next, for the gather's far taps, which each stand for an
// area as wide as the level's texels. A far tap only reaches the pixel through a wide blur, so each texel is weighed
// by how wide its blur is next to the new texels, min(|b| / w): sharp texels, which no far tap could carry, fade out
// instead of tinting the blur around them. Where every texel is sharp, they are averaged evenly. The blur diameter is
// averaged with the same weights, so the far tap's reach follows the colors it carries.

DepthOfFieldDownsampleParameters: struct {
	// One over the width, in full-resolution pixels, of the texels this level writes.
	inverse_texel_width: f32,
}

source: descriptor<{ type: Texture2D, binding: 0, access: read }>;
result: descriptor<{ type: StorageImage<rgba16f>, binding: 1, access: write }>;
parameters: descriptor<{ type: DepthOfFieldDownsampleParameters, binding: 2, access: read, memory: constant }>;

// Returns how much `texel` counts in the average: its blur's width next to the new texels', at most 1.
weight: fn (texel: vec4f) -> f32 {
	return min(abs(texel.w) * parameters.inverse_texel_width, 1.0);
}

main: fn (input: StageInput) -> void {
	let texel: vec2u = input.thread_id;
	let extent: vec2u = image_size(result);
	if (texel.x >= extent.x || texel.y >= extent.y) {
		return;
	}
	let last: vec2u = texture_size(source) - vec2u(1, 1);
	let left: u32 = min(texel.x * 2, last.x);
	let right: u32 = min(texel.x * 2 + 1, last.x);
	let top: u32 = min(texel.y * 2, last.y);
	let bottom: u32 = min(texel.y * 2 + 1, last.y);
	// All four reads go out before any is weighed.
	let a: vec4f = fetch(source, vec2u(left, top));
	let b: vec4f = fetch(source, vec2u(right, top));
	let c: vec4f = fetch(source, vec2u(left, bottom));
	let d: vec4f = fetch(source, vec2u(right, bottom));
	let weight_a: f32 = weight(a);
	let weight_b: f32 = weight(b);
	let weight_c: f32 = weight(c);
	let weight_d: f32 = weight(d);
	let total: f32 = weight_a + weight_b + weight_c + weight_d;
	if (total <= 0.0) {
		write(result, texel, (a + b + c + d) * 0.25);
		return;
	}
	write(result, texel, (a * weight_a + b * weight_b + c * weight_c + d * weight_d) * (1.0 / total));
}
