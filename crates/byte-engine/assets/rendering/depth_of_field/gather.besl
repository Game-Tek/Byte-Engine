// Blurs each pixel by the camera's lens in one continuous gather: every point around the pixel adds its color,
// weighted by how much of its blur disc covers the pixel and by one over the disc's area, and the weights normalize.
// No pixel is sorted into a near or far layer and no two images are blended, so a surface that recedes through focus
// blurs by an amount that grows continuously along it. See the depth of field section of the rendering reference.
//
// The taps sit on a lattice fixed in pixels, compiled into the shader so every offset, distance, and area is a
// constant: every pixel within 3.5 pixels, in groups by distance, then rings of 16 taps whose bounds grow by 1.39 times
// from 3.5 pixels, each reading the widest averaged level whose texels are no wider than its taps' spacing. Tiles only
// decide where the walk stops, never where taps land, so a tile's edge never shows. The depth of field tests check
// the taps against that rule.
//
// Each pixel turns the rings by its own blue-noise angle, up to one tap's spacing, and places each ring's taps at its
// own blue-noise radius within the ring's bounds, chosen evenly by area. Every tap still stands for a sixteenth of its
// ring, so the blur is the same on average, but a small bright point no longer shows the lattice as rings of dots:
// the error becomes fine grain, which the filter pass removes. The result's alpha is the share of the weight the
// rings carried, which is where that grain is.
//
// The workgroup stages its 16x16 pixels and a 3-pixel halo in shared memory once, as the half-float source holds them,
// 8 bytes a texel; the inner taps read it, and each recomputes its texel's density, which measured faster than reading
// a staged one. The workgroup also reads the reach of the tiles around it and skips every ring that no blur in reach
// of it can cover.
//
// Every tap is written out, the inner taps by group and each ring's 16 taps, with all of a group's or ring's reads
// issued before any is weighed. The GPU waits for every read in flight at each branch, and a loop over the taps
// branches once a tap, which left each read's latency exposed: unrolled, the gather takes about a third less.

use ::byte_engine::rendering::depth_of_field::layouts::parameters::*;

source_level_0: descriptor<{ type: Texture2D, binding: 0, access: read }>;
source_level_1: descriptor<{ type: Texture2D, binding: 1, access: read }>;
source_level_2: descriptor<{ type: Texture2D, binding: 2, access: read }>;
source_level_3: descriptor<{ type: Texture2D, binding: 3, access: read }>;
parameters: descriptor<{ type: DepthOfFieldParameters, binding: 4, access: read, memory: constant }>;
tile_reaches: descriptor<{ type: TileReaches, binding: 5, access: read }>;
result: descriptor<{ type: StorageImage<rgba16f>, binding: 6, access: write }>;
blue_noise: descriptor<{ type: Texture2D, binding: 7, access: read }>;

// rgb: the texel's color; a: its blur diameter, both exactly as the half-float source holds them.
shared_texel: workgroup<vec4f16, 484>;
// How far, in 1/64 pixels, any blur that reaches this tile can reach.
search_reach: workgroup<atomicu32, 1>;

DEPTH_OF_FIELD_TILE_WIDTH: const u32 = 16;
WORKGROUP_LANES: const u32 = 256;
// The staged tile: the workgroup's 16 pixels and 3 more on each side.
SHARED_WIDTH: const u32 = 22;
SHARED_TEXELS: const u32 = 484;
HALO: const u32 = 3;
TAPS_PER_RING: const u32 = 16;
// The side of the tiling blue-noise texture, `BLUE_NOISE_SIDE` in `lookup_textures.rs`.
BLUE_NOISE_SIDE: const u32 = 64;
// The square of each ring's outer bound over its inner bound, 1.39 squared, less one.
RING_AREA_GROWTH: const f32 = 0.9321;

// Each outer ring's inner bound, the radius of its taps, which splits the ring's area in half, and the area each tap
// stands for: a sixteenth of the ring.
RING_INNER_RADIUS: const f32[7] = f32[7](
	3.5, 4.865, 6.76235, 9.399666, 13.065536, 18.161096, 25.243923
);
RING_RADIUS: const f32[7] = f32[7](
	4.237819, 5.890569, 8.187891, 11.381168, 15.819824, 21.989555, 30.565481
);
RING_AREA: const f32[7] = f32[7](
	2.241963, 4.331697, 8.369272, 16.170271, 31.24258, 60.363789, 116.628876
);

// The outer taps' offsets from the pixel, 16 per ring; each ring turns by the golden angle from the one before, so
// the taps don't line up into spokes.
OUTER_TAP_X: const f32[112] = f32[112](
	4.237819, 3.915235, 2.996591, 1.621743, 0.0, -1.621743, -2.996591, -3.915235,
	-4.237819, -3.915235, -2.996591, -1.621743, -0.0, 1.621743, 2.996591, 3.915235,
	-4.343522, -5.535597, -5.884927, -5.338331, -3.979022, -2.013943, 0.25774, 2.490185,
	4.343522, 5.535597, 5.884927, 5.338331, 3.979022, 2.013943, -0.25774, -2.490185,
	0.715832, 3.782715, 6.273714, 7.809597, 8.15654, 7.261723, 5.261375, 2.46003,
	-0.715832, -3.782715, -6.273714, -7.809597, -8.15654, -7.261723, -5.261375, -2.46003,
	6.924745, 2.941194, -1.490128, -5.69459, -9.032104, -10.994561, -11.283196, -9.854066,
	-6.924745, -2.941194, 1.490128, 5.69459, 9.032104, 10.994561, 11.283196, 9.854066,
	-15.577994, -13.337695, -9.066853, -3.415664, 2.755528, 8.507216, 12.963757, 15.446684,
	15.577994, 13.337695, 9.066853, 3.415664, -2.755528, -8.507216, -12.963757, -15.446684,
	18.553803, 21.658066, 21.465085, 18.004239, 11.802411, 3.803773, -4.773955, -12.624892,
	-18.553803, -21.658066, -21.465085, -18.004239, -11.802411, -3.803773, 4.773955, 12.624892,
	-7.93493, -18.626796, -26.4829, -30.307223, -29.517546, -24.23409, -15.261214, -3.964956,
	7.93493, 18.626796, 26.4829, 30.307223, 29.517546, 24.23409, 15.261214, 3.964956
);
OUTER_TAP_Y: const f32[112] = f32[112](
	0.0, 1.621743, 2.996591, 3.915235, 4.237819, 3.915235, 2.996591, 1.621743,
	0.0, -1.621743, -2.996591, -3.915235, -4.237819, -3.915235, -2.996591, -1.621743,
	3.979022, 2.013943, -0.25774, -2.490185, -4.343522, -5.535597, -5.884927, -5.338331,
	-3.979022, -2.013943, 0.25774, 2.490185, 4.343522, 5.535597, 5.884927, 5.338331,
	-8.15654, -7.261723, -5.261375, -2.46003, 0.715832, 3.782715, 6.273714, 7.809597,
	8.15654, 7.261723, 5.261375, 2.46003, -0.715832, -3.782715, -6.273714, -7.809597,
	9.032104, 10.994561, 11.283196, 9.854066, 6.924745, 2.941194, -1.490128, -5.69459,
	-9.032104, -10.994561, -11.283196, -9.854066, -6.924745, -2.941194, 1.490128, 5.69459,
	-2.755528, -8.507216, -12.963757, -15.446684, -15.577994, -13.337695, -9.066853, -3.415664,
	2.755528, 8.507216, 12.963757, 15.446684, 15.577994, 13.337695, 9.066853, 3.415664,
	-11.802411, -3.803773, 4.773955, 12.624892, 18.553803, 21.658066, 21.465085, 18.004239,
	11.802411, 3.803773, -4.773955, -12.624892, -18.553803, -21.658066, -21.465085, -18.004239,
	29.517546, 24.23409, 15.261214, 3.964956, -7.93493, -18.626796, -26.4829, -30.307223,
	-29.517546, -24.23409, -15.261214, -3.964956, 7.93493, 18.626796, 26.4829, 30.307223
);
// The tiles around this one, 3 on each side, that a blur below 64 pixels across can reach from.
NEIGHBOR_TILES: const u32 = 49;
NEIGHBOR_WIDTH: const u32 = 7;
REACH_STEPS_PER_PIXEL: const f32 = 64.0;

// One over the area of a blur disc `blur` pixels across, and 1 for a disc under a pixel, which lands on one pixel.
density: fn (blur: f32) -> f32 {
	return 1.0 / max(0.785398163 * blur * blur, 1.0);
}

// How far the blur of a point whose diameter is `blur` reaches toward a pixel whose diameter is `center`. A point
// behind the pixel (a larger signed diameter) is hidden by the pixel's own surface except within the pixel's blur.
reach: fn (blur: f32, center: f32) -> f32 {
	let own: f32 = abs(blur) * 0.5;
	// Where blur equals center the two are the same, so the step's edge doesn't matter.
	return mix(own, min(own, abs(center) * 0.5), step(center, blur));
}

// Returns `texel`'s color times `weight`, next to the weight, one term of a weighted mean.
weighted: fn (texel: vec4f, weight: f32) -> vec4f {
	return vec4f(texel.x * weight, texel.y * weight, texel.z * weight, weight);
}

// Weighs the inner tap `texel`, `distance` pixels from a pixel whose blur diameter is `center`.
inner_tap: fn (texel: vec4f, distance: f32, center: f32) -> vec4f {
	return weighted(texel, clamp(reach(texel.w, center) - distance + 0.5, 0.0, 1.0) * density(texel.w));
}

// Weighs the ring tap `texel`, `radius` pixels from a pixel whose blur diameter is `center`, standing for `area`.
ring_tap: fn (texel: vec4f, center: f32, radius: f32, area: f32) -> vec4f {
	return weighted(texel, clamp(reach(texel.w, center) - radius + 0.5, 0.0, 1.0) * density(texel.w) * area);
}

// Returns outer tap `index`'s offset from the pixel, in pixels, turned and scaled by `cosine` and `sine`.
ring_offset: fn (index: u32, cosine: f32, sine: f32) -> vec2f {
	let x: f32 = OUTER_TAP_X[index];
	let y: f32 = OUTER_TAP_Y[index];
	return vec2f(x * cosine - y * sine, x * sine + y * cosine);
}

// Adds up outer ring `ring`'s taps from `level`, an averaged level as wide as their spacing, around the pixel at `uv`
// whose blur diameter is `center`. `rotation` is the cosine and sine of the pixel's turn of the lattice, and `jitter`
// the pixel's blue-noise value, which picks where between the ring's bounds its taps sit. A ring whose taps all lie
// beyond `search` adds nothing: no blur in reach covers them.
gather_ring: fn (level: Texture2D, ring: u32, uv: vec2f, inverse_extent: vec2f, center: f32, search: f32, rotation: vec2f, jitter: f32) -> vec4f {
	let sum: vec4f = vec4f(0.0, 0.0, 0.0, 0.0);
	let inner: f32 = RING_INNER_RADIUS[ring];
	if (inner >= search) {
		return sum;
	}
	// Each ring takes the noise shifted by the golden ratio, so neighboring rings' radii don't move together; the
	// square root spreads the radii evenly over the ring's area.
	let radius: f32 = inner * sqrt(1.0 + RING_AREA_GROWTH * fract(jitter + f32(ring) * 0.618034));
	let scale: f32 = radius / RING_RADIUS[ring];
	let cosine: f32 = rotation.x * scale;
	let sine: f32 = rotation.y * scale;
	let area: f32 = RING_AREA[ring];
	let first: u32 = ring * TAPS_PER_RING;
	// All 16 reads go out before any is weighed.
	let texel_0: vec4f = texture_lod(level, uv + ring_offset(first + 0, cosine, sine) * inverse_extent);
	let texel_1: vec4f = texture_lod(level, uv + ring_offset(first + 1, cosine, sine) * inverse_extent);
	let texel_2: vec4f = texture_lod(level, uv + ring_offset(first + 2, cosine, sine) * inverse_extent);
	let texel_3: vec4f = texture_lod(level, uv + ring_offset(first + 3, cosine, sine) * inverse_extent);
	let texel_4: vec4f = texture_lod(level, uv + ring_offset(first + 4, cosine, sine) * inverse_extent);
	let texel_5: vec4f = texture_lod(level, uv + ring_offset(first + 5, cosine, sine) * inverse_extent);
	let texel_6: vec4f = texture_lod(level, uv + ring_offset(first + 6, cosine, sine) * inverse_extent);
	let texel_7: vec4f = texture_lod(level, uv + ring_offset(first + 7, cosine, sine) * inverse_extent);
	let texel_8: vec4f = texture_lod(level, uv + ring_offset(first + 8, cosine, sine) * inverse_extent);
	let texel_9: vec4f = texture_lod(level, uv + ring_offset(first + 9, cosine, sine) * inverse_extent);
	let texel_10: vec4f = texture_lod(level, uv + ring_offset(first + 10, cosine, sine) * inverse_extent);
	let texel_11: vec4f = texture_lod(level, uv + ring_offset(first + 11, cosine, sine) * inverse_extent);
	let texel_12: vec4f = texture_lod(level, uv + ring_offset(first + 12, cosine, sine) * inverse_extent);
	let texel_13: vec4f = texture_lod(level, uv + ring_offset(first + 13, cosine, sine) * inverse_extent);
	let texel_14: vec4f = texture_lod(level, uv + ring_offset(first + 14, cosine, sine) * inverse_extent);
	let texel_15: vec4f = texture_lod(level, uv + ring_offset(first + 15, cosine, sine) * inverse_extent);
	sum = sum + ring_tap(texel_0, center, radius, area);
	sum = sum + ring_tap(texel_1, center, radius, area);
	sum = sum + ring_tap(texel_2, center, radius, area);
	sum = sum + ring_tap(texel_3, center, radius, area);
	sum = sum + ring_tap(texel_4, center, radius, area);
	sum = sum + ring_tap(texel_5, center, radius, area);
	sum = sum + ring_tap(texel_6, center, radius, area);
	sum = sum + ring_tap(texel_7, center, radius, area);
	sum = sum + ring_tap(texel_8, center, radius, area);
	sum = sum + ring_tap(texel_9, center, radius, area);
	sum = sum + ring_tap(texel_10, center, radius, area);
	sum = sum + ring_tap(texel_11, center, radius, area);
	sum = sum + ring_tap(texel_12, center, radius, area);
	sum = sum + ring_tap(texel_13, center, radius, area);
	sum = sum + ring_tap(texel_14, center, radius, area);
	sum = sum + ring_tap(texel_15, center, radius, area);
	return sum;
}

// Returns the distance, in tile widths, between a tile and one `offset` tiles away along an axis, counted from 3:
// 0 for itself and its neighbors, which touch it.
tile_gap: fn (offset: u32) -> f32 {
	let distance: u32 = max(offset, HALO) - min(offset, HALO);
	return f32(max(distance, 1) - 1);
}

main: fn (input: StageInput) -> void {
	let lane: u32 = input.thread_idx;
	let pixel: vec2u = input.thread_id;
	let local: vec2u = vec2u(lane % DEPTH_OF_FIELD_TILE_WIDTH, lane / DEPTH_OF_FIELD_TILE_WIDTH);
	let origin: vec2u = pixel - local;
	let extent: vec2u = texture_size(source_level_0);
	let last: vec2u = extent - vec2u(1, 1);
	if (lane == 0) {
		atomic_store(search_reach[0], 0);
	}

	// Stage the tile and its halo, clamped to the image like the sampler; each lane reads up to two texels, both
	// issued before either is weighed.
	let first: u32 = lane;
	let second: u32 = min(lane + WORKGROUP_LANES, SHARED_TEXELS - 1);
	let first_texel: vec4f = fetch(
		source_level_0,
		vec2u(min(max(origin.x + first % SHARED_WIDTH, HALO) - HALO, last.x), min(max(origin.y + first / SHARED_WIDTH, HALO) - HALO, last.y))
	);
	let second_texel: vec4f = fetch(
		source_level_0,
		vec2u(min(max(origin.x + second % SHARED_WIDTH, HALO) - HALO, last.x), min(max(origin.y + second / SHARED_WIDTH, HALO) - HALO, last.y))
	);
	shared_texel[first] = vec4f16(first_texel);
	if (lane + WORKGROUP_LANES < SHARED_TEXELS) {
		shared_texel[second] = vec4f16(second_texel);
	}

	// The search reach: the widest reach of any tile whose blur can reach this one. The prepare pass stored each
	// tile's widest reach; a tile counts when that reach spans the gap between the two tiles.
	let tile: vec2u = origin / DEPTH_OF_FIELD_TILE_WIDTH;
	let tiles: vec2u = (extent + vec2u(DEPTH_OF_FIELD_TILE_WIDTH - 1, DEPTH_OF_FIELD_TILE_WIDTH - 1)) / DEPTH_OF_FIELD_TILE_WIDTH;
	workgroup_barrier();
	let needed: f32 = 0.0;
	if (lane < NEIGHBOR_TILES) {
		let offset: vec2u = vec2u(lane % NEIGHBOR_WIDTH, lane / NEIGHBOR_WIDTH);
		let neighbor: vec2u = tile + offset;
		// Neighbors before the first tile wrap to huge values and fail the bound test like those past the last.
		if (neighbor.x >= HALO && neighbor.y >= HALO && neighbor.x - HALO < tiles.x && neighbor.y - HALO < tiles.y) {
			let index: u32 = (neighbor.y - HALO) * parameters.tiles_per_row + neighbor.x - HALO;
			let neighbor_reach: f32 = tile_reaches.values[index] + 0.5;
			let gap: vec2f = vec2f(tile_gap(offset.x), tile_gap(offset.y)) * f32(DEPTH_OF_FIELD_TILE_WIDTH);
			if (neighbor_reach >= sqrt(dot(gap, gap))) {
				needed = neighbor_reach;
			}
		}
	}
	// The widest of each aligned group of 16 lanes from lane shuffles, then one atomic per group; every lane takes
	// part in the shuffles, and only the first four groups hold neighbors.
	needed = max(needed, subgroup_shuffle_xor_f32(needed, 1));
	needed = max(needed, subgroup_shuffle_xor_f32(needed, 2));
	needed = max(needed, subgroup_shuffle_xor_f32(needed, 4));
	needed = max(needed, subgroup_shuffle_xor_f32(needed, 8));
	if (lane < NEIGHBOR_TILES && lane % DEPTH_OF_FIELD_TILE_WIDTH == 0) {
		atomic_max(search_reach[0], u32(ceil(needed * REACH_STEPS_PER_PIXEL)));
	}
	workgroup_barrier();
	let search: f32 = f32(atomic_load(search_reach[0])) / REACH_STEPS_PER_PIXEL;
	if (pixel.x >= extent.x || pixel.y >= extent.y) {
		return;
	}

	// The inner taps, one per pixel within 3.5 pixels, from shared memory, in groups by distance. A group is skipped
	// once its nearest tap lies beyond every reach; a tap of a group read beyond every reach weighs exactly 0, so the
	// sum is the same as stopping at the first such tap.
	let window: u32 = local.y * SHARED_WIDTH + local.x;
	let center: f32 = f32(shared_texel[window + HALO * SHARED_WIDTH + HALO].w);
	let sum: vec4f = vec4f(0.0, 0.0, 0.0, 0.0);
	let texel_0: vec4f = vec4f(shared_texel[window + 69]);
	sum = sum + inner_tap(texel_0, 0.0, center);
	if (search > 1.0) {
		let texel_1: vec4f = vec4f(shared_texel[window + 47]);
		let texel_2: vec4f = vec4f(shared_texel[window + 68]);
		let texel_3: vec4f = vec4f(shared_texel[window + 70]);
		let texel_4: vec4f = vec4f(shared_texel[window + 91]);
		let texel_5: vec4f = vec4f(shared_texel[window + 46]);
		let texel_6: vec4f = vec4f(shared_texel[window + 48]);
		let texel_7: vec4f = vec4f(shared_texel[window + 90]);
		let texel_8: vec4f = vec4f(shared_texel[window + 92]);
		sum = sum + inner_tap(texel_1, 1.0, center);
		sum = sum + inner_tap(texel_2, 1.0, center);
		sum = sum + inner_tap(texel_3, 1.0, center);
		sum = sum + inner_tap(texel_4, 1.0, center);
		sum = sum + inner_tap(texel_5, 1.414214, center);
		sum = sum + inner_tap(texel_6, 1.414214, center);
		sum = sum + inner_tap(texel_7, 1.414214, center);
		sum = sum + inner_tap(texel_8, 1.414214, center);
	}
	if (search > 2.0) {
		let texel_9: vec4f = vec4f(shared_texel[window + 25]);
		let texel_10: vec4f = vec4f(shared_texel[window + 67]);
		let texel_11: vec4f = vec4f(shared_texel[window + 71]);
		let texel_12: vec4f = vec4f(shared_texel[window + 113]);
		let texel_13: vec4f = vec4f(shared_texel[window + 24]);
		let texel_14: vec4f = vec4f(shared_texel[window + 26]);
		let texel_15: vec4f = vec4f(shared_texel[window + 45]);
		let texel_16: vec4f = vec4f(shared_texel[window + 49]);
		let texel_17: vec4f = vec4f(shared_texel[window + 89]);
		let texel_18: vec4f = vec4f(shared_texel[window + 93]);
		let texel_19: vec4f = vec4f(shared_texel[window + 112]);
		let texel_20: vec4f = vec4f(shared_texel[window + 114]);
		sum = sum + inner_tap(texel_9, 2.0, center);
		sum = sum + inner_tap(texel_10, 2.0, center);
		sum = sum + inner_tap(texel_11, 2.0, center);
		sum = sum + inner_tap(texel_12, 2.0, center);
		sum = sum + inner_tap(texel_13, 2.236068, center);
		sum = sum + inner_tap(texel_14, 2.236068, center);
		sum = sum + inner_tap(texel_15, 2.236068, center);
		sum = sum + inner_tap(texel_16, 2.236068, center);
		sum = sum + inner_tap(texel_17, 2.236068, center);
		sum = sum + inner_tap(texel_18, 2.236068, center);
		sum = sum + inner_tap(texel_19, 2.236068, center);
		sum = sum + inner_tap(texel_20, 2.236068, center);
	}
	if (search > 2.828427) {
		let texel_21: vec4f = vec4f(shared_texel[window + 23]);
		let texel_22: vec4f = vec4f(shared_texel[window + 27]);
		let texel_23: vec4f = vec4f(shared_texel[window + 111]);
		let texel_24: vec4f = vec4f(shared_texel[window + 115]);
		let texel_25: vec4f = vec4f(shared_texel[window + 3]);
		let texel_26: vec4f = vec4f(shared_texel[window + 66]);
		let texel_27: vec4f = vec4f(shared_texel[window + 72]);
		let texel_28: vec4f = vec4f(shared_texel[window + 135]);
		let texel_29: vec4f = vec4f(shared_texel[window + 2]);
		let texel_30: vec4f = vec4f(shared_texel[window + 4]);
		let texel_31: vec4f = vec4f(shared_texel[window + 44]);
		let texel_32: vec4f = vec4f(shared_texel[window + 50]);
		let texel_33: vec4f = vec4f(shared_texel[window + 88]);
		let texel_34: vec4f = vec4f(shared_texel[window + 94]);
		let texel_35: vec4f = vec4f(shared_texel[window + 134]);
		let texel_36: vec4f = vec4f(shared_texel[window + 136]);
		sum = sum + inner_tap(texel_21, 2.828427, center);
		sum = sum + inner_tap(texel_22, 2.828427, center);
		sum = sum + inner_tap(texel_23, 2.828427, center);
		sum = sum + inner_tap(texel_24, 2.828427, center);
		sum = sum + inner_tap(texel_25, 3.0, center);
		sum = sum + inner_tap(texel_26, 3.0, center);
		sum = sum + inner_tap(texel_27, 3.0, center);
		sum = sum + inner_tap(texel_28, 3.0, center);
		sum = sum + inner_tap(texel_29, 3.162278, center);
		sum = sum + inner_tap(texel_30, 3.162278, center);
		sum = sum + inner_tap(texel_31, 3.162278, center);
		sum = sum + inner_tap(texel_32, 3.162278, center);
		sum = sum + inner_tap(texel_33, 3.162278, center);
		sum = sum + inner_tap(texel_34, 3.162278, center);
		sum = sum + inner_tap(texel_35, 3.162278, center);
		sum = sum + inner_tap(texel_36, 3.162278, center);
	}

	// The rings beyond, each from the widest level no wider than its taps' spacing, turned by up to one tap's spacing.
	let noise: vec4f = fetch(blue_noise, vec2u(pixel.x % BLUE_NOISE_SIDE, pixel.y % BLUE_NOISE_SIDE));
	let angle: f32 = noise.x * 0.392699082;
	let rotation: vec2f = vec2f(cos(angle), sin(angle));
	let inverse_extent: vec2f = vec2f(1.0 / f32(extent.x), 1.0 / f32(extent.y));
	let uv: vec2f = (vec2f(f32(pixel.x), f32(pixel.y)) + vec2f(0.5, 0.5)) * inverse_extent;
	let rings: vec4f = gather_ring(source_level_0, 0, uv, inverse_extent, center, search, rotation, noise.y);
	rings = rings + gather_ring(source_level_1, 1, uv, inverse_extent, center, search, rotation, noise.y);
	rings = rings + gather_ring(source_level_1, 2, uv, inverse_extent, center, search, rotation, noise.y);
	rings = rings + gather_ring(source_level_2, 3, uv, inverse_extent, center, search, rotation, noise.y);
	rings = rings + gather_ring(source_level_2, 4, uv, inverse_extent, center, search, rotation, noise.y);
	rings = rings + gather_ring(source_level_3, 5, uv, inverse_extent, center, search, rotation, noise.y);
	rings = rings + gather_ring(source_level_3, 6, uv, inverse_extent, center, search, rotation, noise.y);
	sum = sum + rings;

	// The pixel's own tap covers at least half of it, so the sum of weights is never 0.
	let inverse_weight: f32 = 1.0 / sum.w;
	write(result, pixel, vec4f(sum.x * inverse_weight, sum.y * inverse_weight, sum.z * inverse_weight, rings.w * inverse_weight));
}
