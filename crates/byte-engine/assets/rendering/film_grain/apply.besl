// Grains the display-encoded picture in one tile pass. Every step of the grain happens in workgroup memory, because a
// separate pass before this one, compute or tile, costs several times the grain's own work.
//
// Each tile builds both parts of its grain from the same noise. The narrow part: the noise its pixels reach, a ring of
// the narrow radius around them, blurred along the rows and then the columns. The wide part: the quarter-resolution
// cells its pixels filter between, each the mean of a 4x4 block of noise, plus a ring of the wide radius, blurred the
// same way and filtered up bilinearly. The difference of the two, scaled to unit variance, then changes the picture's
// density, as grain does on film: the color is multiplied by e raised to the grain, so dark and bright areas take the
// same relative grain. A five-zone equalizer over luma sets how strong the grain is at each brightness, with smooth
// steps between the zones at luma 0, 0.13, 0.30, 0.60, and 1.

use ::byte_engine::rendering::film_grain::layouts::grain::*;

scene_texture: descriptor<{ type: Texture2D, binding: 0, access: read }>;
// A tile output, so the replacement for `main` this writes needs no shader-write usage and stays losslessly compressed.
result: output<vec4f, 0>;
parameters: descriptor<{ type: FilmGrainParameters, binding: 1, access: read, memory: constant }>;

GRAIN_TILE: const u32 = 16;
GRAIN_LANES: const u32 = 256;
// The narrow region's stride: the tile plus a ring of the largest narrow radius, 8, on each side.
NARROW_STRIDE: const u32 = 32;
shared_noise: workgroup<f32, 1024>;
// The narrow region's rows blurred, one value per row and tile column.
shared_narrow_rows: workgroup<f32, 512>;

// Pixels per quarter-resolution cell along each axis.
CELL_SIZE: const u32 = 4;
// The cells a tile's pixels filter between: its four, plus one on each side for the bilinear filter.
WIDE_CELLS: const u32 = 6;
// The wide region's stride: those cells plus a ring of the largest wide radius, 16, on each side.
WIDE_STRIDE: const u32 = 38;
shared_cells: workgroup<f32, 1444>;
// The wide region's rows blurred, one value per row and filtered cell column.
shared_wide_rows: workgroup<f32, 228>;
// The blurred cells the pixels filter between.
shared_wide: workgroup<f32, 36>;

// Returns the step from `low` to `high` that `luma` has taken, eased with a smooth step.
zone_step: fn (luma: f32, low: f32, high: f32) -> f32 {
	let t: f32 = clamp((luma - low) / (high - low), 0.0, 1.0);
	return t * t * (3.0 - 2.0 * t);
}

// Returns the equalizer's grain weight at display-encoded `luma`.
zone_weight: fn (luma: f32) -> f32 {
	let zones: vec4f = parameters.zone_weights;
	let l: f32 = clamp(luma, 0.0, 1.0);
	let weight: f32 = mix(zones.z, zones.w, zone_step(l, 0.30, 0.60));
	if (l <= 0.13) {
		weight = mix(zones.x, zones.y, zone_step(l, 0.0, 0.13));
	} else if (l <= 0.30) {
		weight = mix(zones.y, zones.z, zone_step(l, 0.13, 0.30));
	} else if (l > 0.60) {
		weight = mix(zones.w, parameters.white_weight, zone_step(l, 0.60, 1.0));
	}
	return max(weight, 0.0);
}

// Returns the mean of the 4x4 block of noise whose first noise position is `first`.
block_mean: fn (first: vec2u, seed: u32) -> f32 {
	let sum: f32 = 0.0;
	for (let y: u32 = 0; y < CELL_SIZE; y = y + 1) {
		for (let x: u32 = 0; x < CELL_SIZE; x = x + 1) {
			sum = sum + grain_noise(first + vec2u(x, y), seed);
		}
	}
	return sum * 0.0625;
}

main: fn(input: StageInput) -> void {
	let lane: u32 = input.thread_idx;
	let pixel: vec2u = input.thread_id;
	let extent: vec2u = input.extent;
	let local: vec2u = pixel % vec2u(GRAIN_TILE, GRAIN_TILE);
	let tile_origin: vec2u = pixel - local;
	let seed: u32 = parameters.seed;
	let narrow_sigma: f32 = parameters.narrow_sigma;
	let narrow_radius: u32 = parameters.narrow_radius;
	let narrow_span: u32 = GRAIN_TILE + 2 * narrow_radius;
	let wide_sigma: f32 = parameters.wide_sigma;
	let wide_radius: u32 = parameters.wide_radius;
	let wide_span: u32 = WIDE_CELLS + 2 * wide_radius;
	// The noise positions of the two regions' first cells: `narrow_radius` pixels before the tile, and one cell plus
	// `wide_radius` cells before the tile's first cell.
	let narrow_origin: vec2u = tile_origin + vec2u(GRAIN_NOISE_MARGIN - narrow_radius, GRAIN_NOISE_MARGIN - narrow_radius);
	let wide_offset: u32 = GRAIN_NOISE_MARGIN - CELL_SIZE * (1 + wide_radius);
	let wide_origin: vec2u = tile_origin + vec2u(wide_offset, wide_offset);

	// Both regions' noise, in one phase.
	for (let index: u32 = lane; index < narrow_span * narrow_span; index = index + GRAIN_LANES) {
		let region: vec2u = vec2u(index % narrow_span, index / narrow_span);
		shared_noise[region.y * NARROW_STRIDE + region.x] = grain_noise(narrow_origin + region, seed);
	}
	for (let index: u32 = lane; index < wide_span * wide_span; index = index + GRAIN_LANES) {
		let region: vec2u = vec2u(index % wide_span, index / wide_span);
		shared_cells[region.y * WIDE_STRIDE + region.x] = block_mean(wide_origin + region * vec2u(CELL_SIZE, CELL_SIZE), seed);
	}
	workgroup_barrier();

	// Both regions' rows.
	for (let index: u32 = lane; index < narrow_span * GRAIN_TILE; index = index + GRAIN_LANES) {
		let center: u32 = (index / GRAIN_TILE) * NARROW_STRIDE + index % GRAIN_TILE + narrow_radius;
		let sum: f32 = shared_noise[center];
		let weights: f32 = 1.0;
		for (let distance: u32 = 1; distance <= narrow_radius; distance = distance + 1) {
			let weight: f32 = grain_gaussian(f32(distance), narrow_sigma);
			sum = sum + (shared_noise[center - distance] + shared_noise[center + distance]) * weight;
			weights = weights + 2.0 * weight;
		}
		shared_narrow_rows[index] = sum / weights;
	}
	for (let index: u32 = lane; index < wide_span * WIDE_CELLS; index = index + GRAIN_LANES) {
		let center: u32 = (index / WIDE_CELLS) * WIDE_STRIDE + index % WIDE_CELLS + wide_radius;
		let sum: f32 = shared_cells[center];
		let weights: f32 = 1.0;
		for (let distance: u32 = 1; distance <= wide_radius; distance = distance + 1) {
			let weight: f32 = grain_gaussian(f32(distance), wide_sigma);
			sum = sum + (shared_cells[center - distance] + shared_cells[center + distance]) * weight;
			weights = weights + 2.0 * weight;
		}
		shared_wide_rows[index] = sum / weights;
	}
	workgroup_barrier();

	// The wide region's columns, for the cells the pixels filter between.
	if (lane < WIDE_CELLS * WIDE_CELLS) {
		let center: u32 = (lane / WIDE_CELLS + wide_radius) * WIDE_CELLS + lane % WIDE_CELLS;
		let sum: f32 = shared_wide_rows[center];
		let weights: f32 = 1.0;
		for (let distance: u32 = 1; distance <= wide_radius; distance = distance + 1) {
			let weight: f32 = grain_gaussian(f32(distance), wide_sigma);
			sum = sum + (shared_wide_rows[center - distance * WIDE_CELLS] + shared_wide_rows[center + distance * WIDE_CELLS]) * weight;
			weights = weights + 2.0 * weight;
		}
		shared_wide[lane] = sum / weights;
	}
	workgroup_barrier();

	// Partial edge tiles must take part in building the regions before returning.
	if (pixel.x >= extent.x || pixel.y >= extent.y) {
		return;
	}
	let color: vec4f = fetch(scene_texture, pixel);

	// The narrow part: this pixel's column.
	let center: u32 = (local.y + narrow_radius) * GRAIN_TILE + local.x;
	let sum: f32 = shared_narrow_rows[center];
	let weights: f32 = 1.0;
	for (let distance: u32 = 1; distance <= narrow_radius; distance = distance + 1) {
		let weight: f32 = grain_gaussian(f32(distance), narrow_sigma);
		sum = sum + (shared_narrow_rows[center - distance * GRAIN_TILE] + shared_narrow_rows[center + distance * GRAIN_TILE]) * weight;
		weights = weights + 2.0 * weight;
	}

	// The wide part, filtered bilinearly between cell centers, as a sampler would filter the quarter-resolution image.
	// The pixel's center in cells, measured from the first filtered cell's center, lies in [0.625, 4.625].
	let position: vec2f = (vec2f(f32(local.x), f32(local.y)) + vec2f(0.5, 0.5)) * 0.25 + vec2f(0.5, 0.5);
	let cell_x: f32 = floor(position.x);
	let cell_y: f32 = floor(position.y);
	let fraction_x: f32 = position.x - cell_x;
	let fraction_y: f32 = position.y - cell_y;
	let cell: u32 = u32(cell_y) * WIDE_CELLS + u32(cell_x);
	let top: f32 = mix(shared_wide[cell], shared_wide[cell + 1], fraction_x);
	let bottom: f32 = mix(shared_wide[cell + WIDE_CELLS], shared_wide[cell + WIDE_CELLS + 1], fraction_x);
	let wide: f32 = mix(top, bottom, fraction_y);

	let grain: f32 = (sum / weights - GRAIN_WIDE_SHARE * wide) * parameters.normalization;
	let luma: f32 = dot(vec3f(color.x, color.y, color.z), vec3f(0.2126, 0.7152, 0.0722));
	let density: f32 = exp(parameters.amplitude * zone_weight(luma) * grain);
	write(result, pixel, vec4f(max(color.x * density, 0.0), max(color.y * density, 0.0), max(color.z * density, 0.0), color.w));
}
