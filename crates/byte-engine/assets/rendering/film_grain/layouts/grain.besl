// The film grain passes share this layer: the parameter type and the white noise every pass draws from. The grain
// model follows cinegrain2 by mr-berndt (https://github.com/mr-berndt/cinegrain2), as published under the MIT license
// up to commit fd9e8f3; see THIRD_PARTY_NOTICES.md.
//
// Grain is white noise shaped like a film scan's: a narrow Gaussian blur at the grain size, minus 0.95 of a wide blur
// 8.4 times as wide that removes the coarse blotches plain blurred noise shows. Both parts draw the same noise for the
// same pixel and frame, so they are two blurs of one field.

FilmGrainParameters: struct {
	// The grain weights of the Black, Shadow, Mid, and High luma zones, already divided by the weight at mid grey.
	zone_weights: vec4f,
	// The grain weight of the White zone, divided like the others.
	white_weight: f32,
	// The narrow blur's Gaussian weight one pixel from the center, e^(-1 / (2 sigma^2)), and its radius in pixels, at
	// most 8.
	narrow_falloff: f32,
	narrow_radius: u32,
	// The wide blur's weight one quarter-resolution cell from the center and its radius in cells, at most 16. A radius
	// of 0 skips the blur.
	wide_falloff: f32,
	wide_radius: u32,
	// Scale the two blurs' unnormalized sums so their difference, narrow minus wide, has unit variance. Each holds the
	// reciprocal of its kernel's total weight, and the wide one the wide part's share of the difference, 0.95.
	narrow_scale: f32,
	wide_scale: f32,
	// The exponent scale that turns unit-variance grain into a change of density.
	amplitude: f32,
	// Picks this frame's noise.
	seed: u32,
}

// Returns a well-mixed 32-bit hash of `value` (the PCG output permutation, from "Hash Functions for GPU Rendering",
// Jarzynski and Olano, 2020).
grain_hash: fn (value: u32) -> u32 {
	let state: u32 = value * 747796405 + 2891336453;
	let word: u32 = ((state >> ((state >> 28) + 4)) ^ state) * 277803737;
	return (word >> 22) ^ word;
}

// Pixels the noise reaches before the image's first row and column. Callers pass a pixel plus this margin, so a blur
// that reads up to this many pixels before the image keeps unsigned coordinates. The wide region reaches furthest:
// one cell for the bilinear filter plus a ring of 16 cells, 4 pixels each.
GRAIN_NOISE_MARGIN: const u32 = 68;

// Pixels per quarter-resolution cell along each axis. Cells start at the image's first pixel, and
// GRAIN_NOISE_MARGIN is a whole number of them.
GRAIN_CELL: const u32 = 4;

// Returns the draw at `position`, a pixel plus GRAIN_NOISE_MARGIN, for the frame `seed` picks: the sum of four uniform
// draws minus 2, so mean 0 and variance 1/3, close to Gaussian. Pixels outside the image have draws too, so a blur
// needs no edge handling.
//
// The noise a pixel takes is its draw, minus the mean of its cell's 16 draws, plus `grain_cell_mean` of its cell. That
// noise is as white as the draws, with the same variance, and a cell's mean is one draw instead of 16, which is what
// keeps the wide blur's ring of cells cheap. This construction is the engine's own, not cinegrain2's.
grain_draw: fn (position: vec2u, seed: u32) -> f32 {
	let first: u32 = grain_hash(position.x ^ grain_hash(position.y ^ seed));
	let second: u32 = grain_hash(first);
	// Four 16-bit draws, each centered in its interval so their mean is exactly 1/2.
	let sum: f32 = f32(first & 65535) + f32(first >> 16) + f32(second & 65535) + f32(second >> 16);
	return (sum + 2.0) / 65536.0 - 2.0;
}

// Returns the mean of the noise in the cell whose first position is `first`: a draw of the cell's own, from a seed
// the pixels' draws don't use, scaled to the variance the mean of 16 draws has.
grain_cell_mean: fn (first: vec2u, seed: u32) -> f32 {
	return grain_draw(first, seed ^ 2654435769) * 0.25;
}
