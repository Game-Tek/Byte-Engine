// Blends exponential height fog over the HDR scene. Each layer's density falls off exponentially with height, so the
// fog along each view ray has a closed form and needs no ray marching. Ambient sky light lights the fog evenly. The
// scene's lights light it through `fog_light`, which the visibility pipeline marches at half resolution with their
// shadows; where it holds nothing, as under another scene pipeline, the sun lights the fog unshadowed, shaped by the
// Henyey-Greenstein phase function. All light arrives pre-exposed, like the scene the fog covers.
//
// Everything that is the same for every pixel is folded into the parameters on the CPU, and positions are relative to
// the camera, which keeps them precise far from the world origin.

use ::byte_engine::rendering::layouts::fog::*;

FogParameters: struct {
	// Maps a pixel's integer coordinate and reverse-Z depth to its offset from the camera, in world axes, before the
	// division by w.
	pixel_to_camera_offset: mat4f,
	layers: FogLayer[2],
	// x: 1 + g² and y: 2g for the sun anisotropy g, z: maximum opacity.
	scattering: vec4f,
	// xyz: the direction toward the sun.
	sun_direction: vec4f,
	// rgb: exposed radiance the fog scatters toward the camera from the ambient sky.
	ambient_inscattering: vec4f,
	// rgb: exposed sun illuminance times the fog albedo and (1 − g²) / 4π, the phase function's constant factor.
	sun_inscattering: vec4f,
}

depth_texture: descriptor<{ type: Texture2D, binding: 0, access: read }>;
scene_texture: descriptor<{ type: Texture2D, binding: 1, access: read }>;
// The half-resolution light the scene's lights scatter toward the camera: rgb the exposed light, a log2(1 + the
// marched distance), zero where nothing was marched.
fog_light: descriptor<{ type: Texture2D, binding: 2, access: read }>;
// A tile output, so the replacement for `main` this writes needs no shader-write usage and stays losslessly compressed.
result: output<vec4f, 0>;
parameters: descriptor<{ type: FogParameters, binding: 3, access: read, memory: constant }>;

HALF_FLOAT_MAX: const f32 = 65504.0;

// Returns the depth-aware weight of a march texel whose alpha is `texel_distance` for a pixel whose alpha would be
// `distance`, both log2(1 + meters), or zero for a texel nothing was marched into.
march_weight: fn (bilinear: f32, texel_distance: f32, distance: f32) -> f32 {
	if (texel_distance <= 0.0) {
		return 0.0;
	}
	return bilinear / (0.01 + 16.0 * abs(texel_distance - distance));
}

main: fn (input: StageInput) -> void {
	let pixel: vec2u = input.thread_id;
	let extent: vec2u = input.extent;
	if (pixel.x >= extent.x || pixel.y >= extent.y) {
		return;
	}
	let scene: vec4f = fetch(scene_texture, pixel);
	let depth: f32 = fetch(depth_texture, pixel).x;

	// Background pixels hold no surface. Reverse Z puts the near plane at depth 1, which still gives their direction.
	let is_surface: bool = depth > 0.000001;
	let ray_depth: f32 = 1.0;
	if (is_surface) {
		ray_depth = depth;
	}
	let offset: vec4f = parameters.pixel_to_camera_offset * vec4f(f32(pixel.x), f32(pixel.y), ray_depth, 1.0);
	let ray: vec3f = vec3f(offset.x, offset.y, offset.z) * (1.0 / offset.w);
	let ray_length: f32 = length(ray);
	let direction: vec3f = ray * (1.0 / ray_length);
	let distance: f32 = BACKGROUND_DISTANCE;
	if (is_surface) {
		distance = ray_length;
	}

	let fog: f32 = 1.0 - exp(0.0 - fog_optical_depth(parameters.layers[0], parameters.layers[1], direction, distance));
	let opacity: f32 = min(fog, parameters.scattering.z);

	// The four march texels around the pixel's center, weighted bilinearly and by how close their distance lies to the
	// pixel's own, so light doesn't bleed across depth edges.
	let march_extent: vec2u = texture_size(fog_light);
	let march_position: vec2f = vec2f(f32(pixel.x) * 0.5 - 0.25, f32(pixel.y) * 0.5 - 0.25);
	let first_texel: vec2f = vec2f(max(floor(march_position.x), 0.0), max(floor(march_position.y), 0.0));
	let fraction: vec2f = vec2f(
		clamp(march_position.x - first_texel.x, 0.0, 1.0),
		clamp(march_position.y - first_texel.y, 0.0, 1.0)
	);
	let first: vec2u = vec2u(min(u32(first_texel.x), march_extent.x - 1), min(u32(first_texel.y), march_extent.y - 1));
	let next: vec2u = vec2u(min(first.x + 1, march_extent.x - 1), min(first.y + 1, march_extent.y - 1));
	let top_left: vec4f = fetch(fog_light, first);
	let top_right: vec4f = fetch(fog_light, vec2u(next.x, first.y));
	let bottom_left: vec4f = fetch(fog_light, vec2u(first.x, next.y));
	let bottom_right: vec4f = fetch(fog_light, next);
	let key: f32 = log2(1.0 + distance);
	let top_left_weight: f32 = march_weight((1.0 - fraction.x) * (1.0 - fraction.y), top_left.w, key);
	let top_right_weight: f32 = march_weight(fraction.x * (1.0 - fraction.y), top_right.w, key);
	let bottom_left_weight: f32 = march_weight((1.0 - fraction.x) * fraction.y, bottom_left.w, key);
	let bottom_right_weight: f32 = march_weight(fraction.x * fraction.y, bottom_right.w, key);
	let total_weight: f32 = top_left_weight + top_right_weight + bottom_left_weight + bottom_right_weight;

	// The sky's light is the same everywhere along the ray: the fog shows it in proportion to how much of the view it
	// hides.
	let light: vec3f = vec3f(parameters.ambient_inscattering.x, parameters.ambient_inscattering.y, parameters.ambient_inscattering.z) * opacity;
	if (total_weight > 0.0) {
		let marched: vec4f = (top_left * top_left_weight + top_right * top_right_weight + bottom_left * bottom_left_weight
			+ bottom_right * bottom_right_weight) * (1.0 / total_weight);
		// The march gathered the light of the whole fog, which the maximum opacity scales down with the rest.
		let opacity_scale: f32 = 1.0;
		if (fog > 0.0) {
			opacity_scale = opacity / fog;
		}
		light = light + vec3f(marched.x, marched.y, marched.z) * opacity_scale;
	} else {
		// The phase function's angular part is (1 + g² − 2g cos θ)^-3/2.
		let sun_direction: vec3f = vec3f(parameters.sun_direction.x, parameters.sun_direction.y, parameters.sun_direction.z);
		let phase_root: f32 = inversesqrt(parameters.scattering.x - parameters.scattering.y * dot(direction, sun_direction));
		light = light + vec3f(parameters.sun_inscattering.x, parameters.sun_inscattering.y, parameters.sun_inscattering.z)
			* (phase_root * phase_root * phase_root * opacity);
	}
	let color: vec3f = vec3f(scene.x, scene.y, scene.z);
	let fogged: vec3f = color * (1.0 - opacity) + light;
	// Held to the half-float range so a bright glow around the sun never overflows to infinity on store.
	write(result, pixel, vec4f(
		min(fogged.x, HALF_FLOAT_MAX),
		min(fogged.y, HALF_FLOAT_MAX),
		min(fogged.z, HALF_FLOAT_MAX),
		scene.w
	));
}
