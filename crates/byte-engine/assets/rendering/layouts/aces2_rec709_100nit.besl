// Converts ACEScg to the CAM's adapted cone space, through ACES2065-1, as the transform's input conversion does.
aces2_acescg_to_cam16: fn(v: vec3f) -> vec3f {
	return vec3f(
		0.3252707586 * v.x + 0.3632063022 * v.y + 0.1052234668 * v.z,
		0.1132278264 * v.x + 0.5451651581 * v.y + 0.1353075431 * v.z,
		0.005228088273 * v.x + 0.02880385797 * v.y + 0.7596685813 * v.z
	);
}

// Converts compressed cone responses to the input space's achromatic and opponent signals.
aces2_input_cone_to_aab: fn(v: vec3f) -> vec3f {
	return vec3f(
		20.25881034 * v.x + 10.12940517 * v.y + 0.5064702585 * v.z,
		15480.0 * v.x - 16887.27273 * v.y + 1407.272727 * v.z,
		1720.0 * v.x + 1720.0 * v.y - 3440.0 * v.z
	);
}

// Converts achromatic and opponent signals back to the display's compressed cone responses.
aces2_limit_aab_to_cone: fn(v: vec3f) -> vec3f {
	return vec3f(
		0.03236802625 * v.x + 0.00002076576402 * v.y + 0.00001326062093 * v.z,
		0.03236802625 * v.x - 0.000041025046 * v.y - 0.00001201743772 * v.z,
		0.03236802625 * v.x - 0.00001012964099 * v.y - 0.0002900760828 * v.z
	);
}

// Converts the display's adapted cone responses to linear Rec.709 display color.
aces2_limit_cam16_to_rgb: fn(v: vec3f) -> vec3f {
	return vec3f(
		7.450485164 * v.x - 6.130183289 * v.y - 0.06038082804 * v.z,
		-1.475067089 * v.x + 3.118357198 * v.y - 0.383369061 * v.z,
		0.0106288727 * v.x - 0.3185728276 * v.y + 1.567865002 * v.z
	);
}

