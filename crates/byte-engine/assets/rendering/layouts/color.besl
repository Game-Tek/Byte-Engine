// Hill's `ACESInputMat`: linear sRGB to AP1 through XYZ and a D65 to D60 adaptation, then the RRT's saturation.
// Each row sums to 1, so neutral colors stay neutral.
aces_fitted_input: fn(color: vec3f) -> vec3f {
	let x: f32 = 0.59719 * color.x + 0.35458 * color.y + 0.04823 * color.z;
	let y: f32 = 0.07600 * color.x + 0.90834 * color.y + 0.01566 * color.z;
	let z: f32 = 0.02840 * color.x + 0.13383 * color.y + 0.83777 * color.z;
	return vec3f(x, y, z);
}

// Hill's `RRTAndODTFit`: one ratio of two quadratics per channel that fits the RRT and ODT curves on RRT-saturated
// AP1 color. It approaches 1 / 0.983729, about 1.0165, as a channel grows, so `aces_fitted_output` and a clamp map
// large finite values to white.
aces_fitted_rrt_odt: fn(color: vec3f) -> vec3f {
	let numerator: vec3f = color * (color + splat3(0.0245786)) - splat3(0.000090537);
	let denominator: vec3f = color * (0.983729 * color + splat3(0.4329510)) + splat3(0.238081);
	return numerator / denominator;
}

// Hill's `ACESOutputMat`: the ODT's desaturation, then AP1 to linear sRGB through XYZ and a D60 to D65 adaptation.
aces_fitted_output: fn(color: vec3f) -> vec3f {
	let x: f32 = 1.60475 * color.x - 0.53108 * color.y - 0.07367 * color.z;
	let y: f32 = 0.0 - 0.10208 * color.x + 1.10813 * color.y - 0.00605 * color.z;
	let z: f32 = 0.0 - 0.00327 * color.x - 0.07276 * color.y + 1.07602 * color.z;
	return vec3f(x, y, z);
}
