use ::byte_engine::rendering::layouts::lut::*;

// Applies the creative look to one pixel's scene-linear color and keeps its alpha.
pixel: fn (color: vec4f, coordinate: vec2u, extent: vec2u, lut: Lut) -> vec4f {
	let result_color: vec3f = apply_lut(lut, vec3f(color.x, color.y, color.z));
	return vec4f(result_color.x, result_color.y, result_color.z, color.w);
}
