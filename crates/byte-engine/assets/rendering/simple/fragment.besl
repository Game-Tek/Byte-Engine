palette_color: fn(index: u32) -> vec3f {
	match index {
		1 => return vec3f(0.20, 0.70, 0.95),
		2 => return vec3f(0.35, 0.85, 0.35),
		3 => return vec3f(0.95, 0.75, 0.20),
		4 => return vec3f(0.75, 0.35, 0.95),
		5 => return vec3f(0.95, 0.45, 0.20),
		6 => return vec3f(0.25, 0.90, 0.75),
		7 => return vec3f(0.85, 0.85, 0.90),
		_ => return vec3f(0.90, 0.20, 0.20),
	}
}

main: fn (pipeline_input: interface { instance_index: u32, local_position: vec3f }) -> output { albedo: vec4f } {
	let instance_index: u32 = pipeline_input.instance_index;
	let local_grid: vec3f = vec3f(
		abs(fract(pipeline_input.local_position.x * 4.0 + 0.5) - 0.5),
		abs(fract(pipeline_input.local_position.y * 4.0 + 0.5) - 0.5),
		abs(fract(pipeline_input.local_position.z * 4.0 + 0.5) - 0.5)
	);
	let grid_distance: f32 = min(local_grid.x, min(local_grid.y, local_grid.z));
	let grid_line: f32 = 1.0 - smoothstep(0.015, 0.035, grid_distance);
	let base_color: vec3f = palette_color(instance_index % 8);
	let grid_color: vec3f = base_color + (vec3f(1.0, 1.0, 1.0) - base_color) * (grid_line * 0.45);
	let albedo: vec4f = vec4f(grid_color.x, grid_color.y, grid_color.z, 1.0);

	return { albedo };
}
