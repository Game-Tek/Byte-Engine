SkyParameters: struct {
	inverse_view_projection: mat4f,
	camera_position: vec4f,
	sun_direction: vec4f,
	planet_center: vec4f,
	atmosphere: vec4f,
	misc: vec4f,
}

transmittance_lut: descriptor<StorageImage<rgba16>, 0, write>;
parameters: descriptor<SkyParameters, 1, read>;

sample_distribution: fn (value: f32) -> f32 {
	let clamped: f32 = clamp(value, 0.0, 1.0);
	return clamped * clamped;
}

main: fn () -> void {
	let pixel: vec2u = thread_id();
	guard_image_bounds(transmittance_lut, pixel);
	let extent: vec2u = image_size(transmittance_lut);
	let uv: vec2f = (vec2f(f32(pixel.x), f32(pixel.y)) + vec2f(0.5, 0.5)) / vec2f(f32(extent.x), f32(extent.y));
	let planet_center: vec3f = vec3f(parameters.planet_center.x, parameters.planet_center.y, parameters.planet_center.z);
	let ground_radius: f32 = parameters.atmosphere.x;
	let atmosphere_radius: f32 = parameters.atmosphere.y;
	let altitude: f32 = ground_radius + (atmosphere_radius - ground_radius) * uv.y;
	let zenith_cosine: f32 = uv.x * 2.0 - 1.0;
	let origin: vec3f = planet_center + vec3f(0.0, altitude, 0.0);
	let direction: vec3f = vec3f(sqrt(max(0.0, 1.0 - zenith_cosine * zenith_cosine)), zenith_cosine, 0.0);
	let atmosphere_roots: vec2f = atmosphere_ray_sphere_roots(origin, direction, planet_center, atmosphere_radius);
	if (atmosphere_roots.x > atmosphere_roots.y || atmosphere_roots.y <= 0.0) {
		write(transmittance_lut, pixel, vec4f(1.0, 1.0, 1.0, 1.0));
		return;
	}
	let ground_roots: vec2f = atmosphere_ray_sphere_roots(origin, direction, planet_center, ground_radius);
	if (ground_roots.x <= ground_roots.y && ground_roots.y > 0.0 && zenith_cosine < 0.0) {
		write(transmittance_lut, pixel, vec4f(0.0, 0.0, 0.0, 1.0));
		return;
	}

	let distance_through_atmosphere: f32 = atmosphere_roots.y;
	let optical_depth: vec3f = vec3f(0.0, 0.0, 0.0);
	for (let i: u32 = 0; i < 32; i = i + 1) {
		let t0: f32 = distance_through_atmosphere * sample_distribution(f32(i) / 32.0);
		let t1: f32 = distance_through_atmosphere * sample_distribution(f32(i + 1) / 32.0);
		let sample_position: vec3f = origin + direction * (0.5 * (t0 + t1));
		let density: vec3f = atmosphere_density_profile(
			sample_position,
			planet_center,
			ground_radius,
			parameters.atmosphere.z,
			parameters.atmosphere.w,
			parameters.misc.x
		);
		optical_depth = optical_depth + density * (t1 - t0);
	}
	let transmittance: vec3f = exp(vec3f(0.0, 0.0, 0.0) - atmosphere_extinction_from_density(optical_depth));
	write(transmittance_lut, pixel, vec4f(transmittance.x, transmittance.y, transmittance.z, 1.0));
}
