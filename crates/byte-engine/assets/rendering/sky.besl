SkyParameters: struct {
	inverse_view_projection: mat4f,
	camera_position: vec4f,
	sun_direction: vec4f,
	planet_center: vec4f,
	atmosphere: vec4f,
	misc: vec4f,
}

depth_texture: descriptor<{ type: Texture2D, binding: 0, access: read }>;
source: descriptor<{ type: StorageImage<rgba16f>, binding: 1, access: read }>;
result: descriptor<{ type: StorageImage, binding: 2, access: write }>;
sky_view_lut: descriptor<{ type: Texture2D, binding: 3, access: read }>;
transmittance_lut: descriptor<{ type: Texture2D, binding: 4, access: read }>;
parameters: descriptor<{ type: SkyParameters, binding: 5, access: read, memory: constant }>;

get_camera_position: fn () -> vec3f {
	return vec3f(parameters.camera_position.x, parameters.camera_position.y, parameters.camera_position.z);
}

get_sun_direction: fn () -> vec3f {
	return vec3f(parameters.sun_direction.x, parameters.sun_direction.y, parameters.sun_direction.z);
}

get_planet_center: fn () -> vec3f {
	return vec3f(parameters.planet_center.x, parameters.planet_center.y, parameters.planet_center.z);
}

get_ground_radius: fn () -> f32 { return parameters.atmosphere.x; }
get_atmosphere_radius: fn () -> f32 { return parameters.atmosphere.y; }
get_sun_angular_radius: fn () -> f32 { return parameters.planet_center.w; }

should_skip_below_horizon: fn () -> bool {
	return parameters.misc.y > 0.5;
}

reconstruct_view_direction: fn (pixel: vec2u, extent: vec2u) -> vec3f {
	let uv: vec2f = (vec2f(f32(pixel.x), f32(pixel.y)) + vec2f(0.5, 0.5)) / vec2f(f32(extent.x), f32(extent.y));
	let ndc: vec2f = vec2f(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
	let world: vec4f = parameters.inverse_view_projection * vec4f(ndc.x, ndc.y, 0.0, 1.0);
	return normalize(vec3f(world.x / world.w, world.y / world.w, world.z / world.w) - get_camera_position());
}

main: fn (input: StageInput) -> void {
	let pixel: vec2u = input.thread_id;
	guard_image_bounds(result, pixel);
	let extent: vec2u = image_size(result);
	let foreground: vec4f = image_load(source, pixel);
	let depth_uv: vec2f = (vec2f(f32(pixel.x), f32(pixel.y)) + vec2f(0.5, 0.5)) / vec2f(f32(extent.x), f32(extent.y));
	let depth: f32 = texture_lod(depth_texture, depth_uv).x;
	if (depth > 0.000001) {
		write(result, pixel, foreground);
		return;
	}

	let direction: vec3f = reconstruct_view_direction(pixel, extent);
	let camera_position: vec3f = get_camera_position();
	let planet_center: vec3f = get_planet_center();
	if (should_skip_below_horizon() && dot(direction, normalize(camera_position - planet_center)) < 0.0) {
		write(result, pixel, foreground);
		return;
	}

	let sampled_sky: vec4f = texture_lod(sky_view_lut, octahedral_encode(direction));
	let sky_scattering: vec3f = vec3f(sampled_sky.x, sampled_sky.y, sampled_sky.z);
	let sun_direction: vec3f = get_sun_direction();
	let cosine_theta: f32 = dot(direction, sun_direction);
	let sun_disk: f32 = smoothstep(
		cos(get_sun_angular_radius() * 1.4),
		cos(get_sun_angular_radius()),
		cosine_theta
	);
	let sun_radiance: vec3f = vec3f(0.0, 0.0, 0.0);
	if (sun_disk > 0.0) {
		let transmittance_uv: vec2f = atmosphere_transmittance_uv(
			camera_position,
			sun_direction,
			planet_center,
			get_ground_radius(),
			get_atmosphere_radius()
		);
		let sampled_transmittance: vec4f = texture_lod(transmittance_lut, transmittance_uv);
		sun_radiance = sun_disk
			* vec3f(sampled_transmittance.x, sampled_transmittance.y, sampled_transmittance.z)
			* vec3f(20.0, 18.0, 16.0);
	}
	// Keep atmosphere and sun radiance scene-linear for the final tonemap pass.
	let sky: vec3f = sky_scattering + sun_radiance;
	let foreground_source: vec4f = vec4f(foreground.x, foreground.y, foreground.z, clamp(foreground.w, 0.0, 1.0));
	let destination: vec4f = vec4f(sky.x, sky.y, sky.z, 1.0);
	write(result, pixel, source_over(foreground_source, destination));
}
