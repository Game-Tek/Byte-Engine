// Spatial SMAA 1x weight calculation and neighborhood resolve ported from the reference implementation.
// See LICENSE.txt beside this shader for the original authors and license.
source: descriptor<Texture2D, 0, read>;
edges: descriptor<Texture2D, 1, read>;
area_texture: descriptor<Texture2D, 2, read>;
search_texture: descriptor<Texture2D, 3, read>;
result: descriptor<StorageImage, 4, write>;

// These values match the official SMAA 1x Ultra preset and lookup textures.
SMAA_MAX_SEARCH_STEPS: const u32 = 32;
SMAA_MAX_DIAGONAL_SEARCH_STEPS: const u32 = 16;
SMAA_CORNER_ROUNDING: const f16 = 0.25;
SMAA_AREA_MAX_DISTANCE: const f16 = 16.0;
SMAA_AREA_MAX_DIAGONAL_DISTANCE: const f16 = 20.0;
SMAA_AREA_PIXEL_SIZE: const vec2f16 = vec2f16(0.00625, 0.0017857142857142857);
SMAA_SEARCH_SIZE: const vec2f16 = vec2f16(66.0, 33.0);
SMAA_SEARCH_PACKED_SIZE: const vec2f16 = vec2f16(64.0, 16.0);
SMAA_SEARCH_LENGTH_SCALE: const f16 = 2.0078125;
SMAA_PACKED_EDGE_MAX: const f16 = 3.0;
SMAA_DIAGONAL_CONTINUATION: const f16 = 0.9;
SMAA_ORTHOGONAL_CONTINUATION: const f16 = 0.8281;

// A 16x8 output tile keeps the original two-dimensional locality. It needs one
// texel of right and bottom weight look-ahead. The shared cache replaces the
// full-screen RGBA8 weight intermediate; each entry packs four quantized UNORM
// bytes so resolve matches the former store/load.
SMAA_RESOLVE_WORKGROUP_WIDTH: const u32 = 16;
SMAA_RESOLVE_WORKGROUP_HEIGHT: const u32 = 8;
SMAA_RESOLVE_WORKGROUP_THREADS: const u32 = 128;
SMAA_WEIGHT_TILE_WIDTH: const u32 = 17;
SMAA_WEIGHT_TILE_HEIGHT: const u32 = 9;
SMAA_WEIGHT_TILE_SIZE: const u32 = 153;

// Each lane cooperatively supplies final packed RGBA8 weights for a small tile.
cached_weights: workgroup<u32, 153>;

// Decodes the west and north binary flags stored in the low two bits of R8UNORM.
unpack_edge_flags: fn(value: f32) -> vec2f16 {
	// R8UNORM encodes only 0, 1/3, 2/3, and 1. Round in half precision before
	// converting to an integer so this hot edge-fetch path stays on the f16 ALU.
	let packed: u32 = u32(round(clamp(f16(value), f16(0.0), f16(1.0)) * SMAA_PACKED_EDGE_MAX));
	let west: u32 = packed & 1;
	let north: u32 = (packed >> 1) & 1;
	return vec2f16(f16(west), f16(north));
}

edge_flags_at: fn(coordinate: vec2u) -> vec2f16 {
	return unpack_edge_flags(fetch(edges, coordinate).x);
}

edge_next_coordinate: fn(value: u32, extent: u32) -> u32 {
	if (value + 1 >= extent) {
		return value;
	}
	return value + 1;
}

// Converts a pixel-space sample position to an in-bounds source texel. Weight
// search coordinates intentionally stay in f32 because they address pixels;
// edge values and every weight calculation below stay in f16.
edge_lower_coordinate: fn(position: vec2f, extent: vec2u) -> vec2u {
	let maximum: vec2f = vec2f(f32(extent.x - 1), f32(extent.y - 1));
	let clamped: vec2f = vec2f(
		clamp(position.x, 0.0, maximum.x),
		clamp(position.y, 0.0, maximum.y)
	);
	return vec2u(u32(floor(clamped.x)), u32(floor(clamped.y)));
}

// Exact pixel-center path used by the first diagonal orientation and crossing tests.
sample_edges_pixel: fn(position: vec2f, extent: vec2u) -> vec2f16 {
	return edge_flags_at(edge_lower_coordinate(position, extent));
}

// The second diagonal orientation is always one quarter of a pixel right of a
// texel center, so it needs just two packed R8 reads instead of a generic 2x2 sample.
sample_edges_x_quarter_pixel: fn(position: vec2f, extent: vec2u) -> vec2f16 {
	let lower: vec2u = edge_lower_coordinate(position, extent);
	let fraction: f16 = 0.25;
	if (position.x < 0.0 || position.x > f32(extent.x - 1)) {
		fraction = 0.0;
	}
	let lower_edge: vec2f16 = edge_flags_at(lower);
	let upper_edge: vec2f16 = edge_flags_at(vec2u(edge_next_coordinate(lower.x, extent.x), lower.y));
	return lower_edge * (1.0 - fraction) + upper_edge * fraction;
}

// Orthogonal searches use fixed subpixel phases. Keeping those phases explicit
// removes normalized-coordinate setup and dynamic fractional interpolation from
// their hot loops while preserving Clamp sampling at the image boundary.
sample_edges_fixed_pixel: fn(position: vec2f, fraction: vec2f16, extent: vec2u) -> vec2f16 {
	let lower: vec2u = edge_lower_coordinate(position, extent);
	let fraction_x: f16 = fraction.x;
	let fraction_y: f16 = fraction.y;
	if (position.x < 0.0 || position.x > f32(extent.x - 1)) {
		fraction_x = 0.0;
	}
	if (position.y < 0.0 || position.y > f32(extent.y - 1)) {
		fraction_y = 0.0;
	}
	let upper: vec2u = vec2u(
		edge_next_coordinate(lower.x, extent.x),
		edge_next_coordinate(lower.y, extent.y)
	);
	let lower_row: vec2f16 = edge_flags_at(lower) * (1.0 - fraction_x)
		+ edge_flags_at(vec2u(upper.x, lower.y)) * fraction_x;
	let upper_row: vec2f16 = edge_flags_at(vec2u(lower.x, upper.y)) * (1.0 - fraction_x)
		+ edge_flags_at(upper) * fraction_x;
	return lower_row * (1.0 - fraction_y) + upper_row * fraction_y;
}

// Endpoint correction and corner tests have LUT-derived phases, so they retain
// the general pixel-space reconstruction. This is outside the search hot loops.
sample_edges_linear_pixel: fn(position: vec2f, extent: vec2u) -> vec2f16 {
	let maximum: vec2f = vec2f(f32(extent.x - 1), f32(extent.y - 1));
	let clamped: vec2f = vec2f(
		clamp(position.x, 0.0, maximum.x),
		clamp(position.y, 0.0, maximum.y)
	);
	let lower: vec2u = vec2u(u32(floor(clamped.x)), u32(floor(clamped.y)));
	let upper: vec2u = vec2u(
		edge_next_coordinate(lower.x, extent.x),
		edge_next_coordinate(lower.y, extent.y)
	);
	let fraction: vec2f16 = vec2f16(f16(fract(clamped.x)), f16(fract(clamped.y)));
	let lower_row: vec2f16 = edge_flags_at(lower) * (1.0 - fraction.x)
		+ edge_flags_at(vec2u(upper.x, lower.y)) * fraction.x;
	let upper_row: vec2f16 = edge_flags_at(vec2u(lower.x, upper.y)) * (1.0 - fraction.x)
		+ edge_flags_at(upper) * fraction.x;
	return lower_row * (1.0 - fraction.y) + upper_row * fraction.y;
}

decode_diagonal: fn(value: vec2f16) -> vec2f16 {
	let red: f16 = value.x * abs(5.0 * value.x - 3.75);
	return vec2f16(round(red), round(value.y));
}

// Returns distance, continuation state, and the last two edge values.
search_diagonal_1: fn(pixel_position: vec2f, direction: vec2f, extent: vec2u) -> vec4f16 {
	let position: vec2f = pixel_position;
	let distance: f16 = f16(0.0) - f16(1.0);
	let continuation: f16 = 1.0;
	let edge: vec2f16 = vec2f16(0.0, 0.0);
	for (let step: u32 = 0; step < SMAA_MAX_DIAGONAL_SEARCH_STEPS && continuation > SMAA_DIAGONAL_CONTINUATION; step = step + 1) {
		position = position + direction;
		distance = distance + 1.0;
		edge = sample_edges_pixel(position, extent);
		continuation = 0.5 * (edge.x + edge.y);
	}
	return vec4f16(distance, continuation, edge.x, edge.y);
}

// The quarter-pixel shift lets linear filtering retrieve both diagonal edge bits.
search_diagonal_2: fn(pixel_position: vec2f, direction: vec2f, extent: vec2u) -> vec4f16 {
	let position: vec2f = pixel_position + vec2f(0.25, 0.0);
	let distance: f16 = f16(0.0) - f16(1.0);
	let continuation: f16 = 1.0;
	let edge: vec2f16 = vec2f16(0.0, 0.0);
	for (let step: u32 = 0; step < SMAA_MAX_DIAGONAL_SEARCH_STEPS && continuation > SMAA_DIAGONAL_CONTINUATION; step = step + 1) {
		position = position + direction;
		distance = distance + 1.0;
		edge = decode_diagonal(sample_edges_x_quarter_pixel(position, extent));
		continuation = 0.5 * (edge.x + edge.y);
	}
	return vec4f16(distance, continuation, edge.x, edge.y);
}

area_diagonal: fn(distance: vec2f16, crossing: vec2f16) -> vec2f16 {
	let lookup: vec2f16 = distance + crossing * SMAA_AREA_MAX_DIAGONAL_DISTANCE;
	// Texture coordinates are the precision boundary for hardware lookup.
	let texcoord: vec2f = vec2f(lookup * SMAA_AREA_PIXEL_SIZE + 0.5 * SMAA_AREA_PIXEL_SIZE) + vec2f(0.5, 0.0);
	let value: vec4f = texture_lod(area_texture, texcoord);
	return vec2f16(value.x, value.y);
}

// If all six first-step texels are empty, every diagonal search exits at once.
// It is deliberately conservative: a true result can never be skipped.
diagonal_candidate: fn(pixel_position: vec2f, extent: vec2u) -> bool {
	let left_down: vec2f16 = sample_edges_pixel(pixel_position + vec2f(0.0 - 1.0, 1.0), extent);
	let right_up: vec2f16 = sample_edges_pixel(pixel_position + vec2f(1.0, 0.0 - 1.0), extent);
	let upper_left: vec2f16 = sample_edges_pixel(pixel_position + vec2f(0.0 - 1.0, 0.0 - 1.0), extent);
	let upper_center: vec2f16 = sample_edges_pixel(pixel_position + vec2f(0.0, 0.0 - 1.0), extent);
	let lower_right: vec2f16 = sample_edges_pixel(pixel_position + vec2f(1.0, 1.0), extent);
	let lower_far_right: vec2f16 = sample_edges_pixel(pixel_position + vec2f(2.0, 1.0), extent);
	return left_down.x > 0.0 || left_down.y > 0.0
		|| right_up.x > 0.0 || right_up.y > 0.0
		|| upper_left.x > 0.0 || upper_left.y > 0.0
		|| upper_center.x > 0.0 || upper_center.y > 0.0
		|| lower_right.x > 0.0 || lower_right.y > 0.0
		|| lower_far_right.x > 0.0 || lower_far_right.y > 0.0;
}

// Uses both diagonal orientations and returns their accumulated reference-area weights.
diagonal_weights: fn(pixel_position: vec2f, edge: vec2f16, extent: vec2u) -> vec2f16 {
	let result: vec2f16 = vec2f16(0.0, 0.0);
	let left: vec4f16 = vec4f16(0.0, 0.0, 0.0, 0.0);
	if (edge.x > 0.0) {
		left = search_diagonal_1(pixel_position, vec2f(0.0 - 1.0, 1.0), extent);
	}
	let right: vec4f16 = search_diagonal_1(pixel_position, vec2f(1.0, 0.0 - 1.0), extent);
	let left_distance: f16 = left.x;
	if (left.w > SMAA_DIAGONAL_CONTINUATION) {
		left_distance = left_distance + 1.0;
	}
	if (left_distance + right.x > 2.0) {
		let left_coordinate: vec2f = pixel_position + vec2f(0.0 - f32(left_distance), f32(left_distance));
		let right_coordinate: vec2f = pixel_position + vec2f(f32(right.x), 0.0 - f32(right.x));
		let left_a: vec2f16 = sample_edges_pixel(left_coordinate + vec2f(0.0 - 1.0, 0.0), extent);
		let left_b: vec2f16 = sample_edges_pixel(left_coordinate, extent);
		let right_a: vec2f16 = sample_edges_pixel(right_coordinate + vec2f(1.0, 0.0), extent);
		let right_b: vec2f16 = sample_edges_pixel(right_coordinate + vec2f(1.0, 0.0 - 1.0), extent);
		let crossing_left: f16 = 2.0 * left_a.y + left_b.x;
		let crossing_right: f16 = 2.0 * right_a.y + right_b.x;
		if (left.y < SMAA_DIAGONAL_CONTINUATION) {
			crossing_left = 0.0;
		}
		if (right.y < SMAA_DIAGONAL_CONTINUATION) {
			crossing_right = 0.0;
		}
		result = result + area_diagonal(vec2f16(left_distance, right.x), vec2f16(crossing_left, crossing_right));
	}

	let upper_left: vec4f16 = search_diagonal_2(pixel_position, vec2f(0.0 - 1.0, 0.0 - 1.0), extent);
	let lower_right: vec4f16 = vec4f16(0.0, 0.0, 0.0, 0.0);
	if (sample_edges_pixel(pixel_position + vec2f(1.0, 0.0), extent).x > 0.0) {
		lower_right = search_diagonal_2(pixel_position, vec2f(1.0, 1.0), extent);
	}
	let right_distance: f16 = lower_right.x;
	if (lower_right.w > SMAA_DIAGONAL_CONTINUATION) {
		right_distance = right_distance + 1.0;
	}
	if (upper_left.x + right_distance > 2.0) {
		let left_coordinate: vec2f = pixel_position + vec2f(0.0 - f32(upper_left.x), 0.0 - f32(upper_left.x));
		let right_coordinate: vec2f = pixel_position + vec2f(f32(right_distance), f32(right_distance));
		let left_a: vec2f16 = sample_edges_pixel(left_coordinate + vec2f(0.0 - 1.0, 0.0), extent);
		let left_b: vec2f16 = sample_edges_pixel(left_coordinate + vec2f(0.0, 0.0 - 1.0), extent);
		let right_edge: vec2f16 = sample_edges_pixel(right_coordinate + vec2f(1.0, 0.0), extent);
		let crossing_left: f16 = 2.0 * left_a.y + left_b.x;
		let crossing_right: f16 = 2.0 * right_edge.y + right_edge.x;
		if (upper_left.y < SMAA_DIAGONAL_CONTINUATION) {
			crossing_left = 0.0;
		}
		if (lower_right.y < SMAA_DIAGONAL_CONTINUATION) {
			crossing_right = 0.0;
		}
		let area: vec2f16 = area_diagonal(vec2f16(upper_left.x, right_distance), vec2f16(crossing_left, crossing_right));
		result = result + vec2f16(area.y, area.x);
	}
	return result;
}

search_length: fn(edge: vec2f16, offset: f16) -> f16 {
	let scale: vec2f16 = (SMAA_SEARCH_SIZE * vec2f16(0.5, 0.0 - 1.0) + vec2f16(0.0 - 1.0, 1.0)) / SMAA_SEARCH_PACKED_SIZE;
	let bias: vec2f16 = (SMAA_SEARCH_SIZE * vec2f16(offset, 1.0) + vec2f16(0.5, 0.0 - 0.5)) / SMAA_SEARCH_PACKED_SIZE;
	return f16(texture_lod(search_texture, vec2f(scale * edge + bias)).x);
}

search_x_left: fn(start: vec2f, end: f32, extent: vec2u) -> f32 {
	let position: vec2f = start;
	let edge: vec2f16 = vec2f16(0.0, 1.0);
	for (let step: u32 = 0; step < SMAA_MAX_SEARCH_STEPS && position.x > end && edge.y > SMAA_ORTHOGONAL_CONTINUATION && edge.x <= 0.0; step = step + 1) {
		edge = sample_edges_fixed_pixel(position, vec2f16(0.75, 0.875), extent);
		position = position - vec2f(2.0, 0.0);
	}
	let correction: f16 = f16(3.25) - SMAA_SEARCH_LENGTH_SCALE * search_length(edge, f16(0.0));
	return position.x + f32(correction);
}

search_x_right: fn(start: vec2f, end: f32, extent: vec2u) -> f32 {
	let position: vec2f = start;
	let edge: vec2f16 = vec2f16(0.0, 1.0);
	for (let step: u32 = 0; step < SMAA_MAX_SEARCH_STEPS && position.x < end && edge.y > SMAA_ORTHOGONAL_CONTINUATION && edge.x <= 0.0; step = step + 1) {
		edge = sample_edges_fixed_pixel(position, vec2f16(0.25, 0.875), extent);
		position = position + vec2f(2.0, 0.0);
	}
	let correction: f16 = f16(3.25) - SMAA_SEARCH_LENGTH_SCALE * search_length(edge, f16(0.5));
	return position.x - f32(correction);
}

search_y_up: fn(start: vec2f, end: f32, extent: vec2u) -> f32 {
	let position: vec2f = start;
	let edge: vec2f16 = vec2f16(1.0, 0.0);
	for (let step: u32 = 0; step < SMAA_MAX_SEARCH_STEPS && position.y > end && edge.x > SMAA_ORTHOGONAL_CONTINUATION && edge.y <= 0.0; step = step + 1) {
		edge = sample_edges_fixed_pixel(position, vec2f16(0.875, 0.75), extent);
		position = position - vec2f(0.0, 2.0);
	}
	let correction: f16 = f16(3.25) - SMAA_SEARCH_LENGTH_SCALE * search_length(vec2f16(edge.y, edge.x), f16(0.0));
	return position.y + f32(correction);
}

search_y_down: fn(start: vec2f, end: f32, extent: vec2u) -> f32 {
	let position: vec2f = start;
	let edge: vec2f16 = vec2f16(1.0, 0.0);
	for (let step: u32 = 0; step < SMAA_MAX_SEARCH_STEPS && position.y < end && edge.x > SMAA_ORTHOGONAL_CONTINUATION && edge.y <= 0.0; step = step + 1) {
		edge = sample_edges_fixed_pixel(position, vec2f16(0.875, 0.25), extent);
		position = position + vec2f(0.0, 2.0);
	}
	let correction: f16 = f16(3.25) - SMAA_SEARCH_LENGTH_SCALE * search_length(vec2f16(edge.y, edge.x), f16(0.5));
	return position.y - f32(correction);
}

area_orthogonal: fn(distance: vec2f16, edge_a: f16, edge_b: f16) -> vec2f16 {
	let crossing: vec2f16 = round(vec2f16(f16(4.0) * edge_a, f16(4.0) * edge_b));
	let lookup: vec2f16 = distance + crossing * SMAA_AREA_MAX_DISTANCE;
	let value: vec4f = texture_lod(area_texture, vec2f(lookup * SMAA_AREA_PIXEL_SIZE + 0.5 * SMAA_AREA_PIXEL_SIZE));
	return vec2f16(value.x, value.y);
}

horizontal_corners: fn(value: vec2f16, left_coord: vec2f, right_coord: vec2f, distance: vec2f16, extent: vec2u) -> vec2f16 {
	let left_nearer: f16 = 0.0;
	let right_nearer: f16 = 0.0;
	if (distance.x <= distance.y) {
		left_nearer = 1.0;
	}
	if (distance.y <= distance.x) {
		right_nearer = 1.0;
	}
	let divisor: f16 = left_nearer + right_nearer;
	let left_rounding: f16 = (1.0 - SMAA_CORNER_ROUNDING) * left_nearer / divisor;
	let right_rounding: f16 = (1.0 - SMAA_CORNER_ROUNDING) * right_nearer / divisor;
	let factor_a: f16 = 1.0 - left_rounding * sample_edges_linear_pixel(left_coord + vec2f(0.0, 1.0), extent).x
		- right_rounding * sample_edges_linear_pixel(right_coord + vec2f(1.0, 1.0), extent).x;
	let factor_b: f16 = 1.0 - left_rounding * sample_edges_linear_pixel(left_coord + vec2f(0.0, 0.0 - 2.0), extent).x
		- right_rounding * sample_edges_linear_pixel(right_coord + vec2f(1.0, 0.0 - 2.0), extent).x;
	return value * vec2f16(clamp(factor_a, f16(0.0), f16(1.0)), clamp(factor_b, f16(0.0), f16(1.0)));
}

vertical_corners: fn(value: vec2f16, top_coord: vec2f, bottom_coord: vec2f, distance: vec2f16, extent: vec2u) -> vec2f16 {
	let top_nearer: f16 = 0.0;
	let bottom_nearer: f16 = 0.0;
	if (distance.x <= distance.y) {
		top_nearer = 1.0;
	}
	if (distance.y <= distance.x) {
		bottom_nearer = 1.0;
	}
	let divisor: f16 = top_nearer + bottom_nearer;
	let top_rounding: f16 = (1.0 - SMAA_CORNER_ROUNDING) * top_nearer / divisor;
	let bottom_rounding: f16 = (1.0 - SMAA_CORNER_ROUNDING) * bottom_nearer / divisor;
	let factor_a: f16 = 1.0 - top_rounding * sample_edges_linear_pixel(top_coord + vec2f(1.0, 0.0), extent).y
		- bottom_rounding * sample_edges_linear_pixel(bottom_coord + vec2f(1.0, 1.0), extent).y;
	let factor_b: f16 = 1.0 - top_rounding * sample_edges_linear_pixel(top_coord + vec2f(0.0 - 2.0, 0.0), extent).y
		- bottom_rounding * sample_edges_linear_pixel(bottom_coord + vec2f(0.0 - 2.0, 1.0), extent).y;
	return value * vec2f16(clamp(factor_a, f16(0.0), f16(1.0)), clamp(factor_b, f16(0.0), f16(1.0)));
}

// Calculates the final reference weights before their former RGBA8 storage step.
blend_weights_at: fn(coordinate: vec2u, extent: vec2u, edge: vec2f16) -> vec4f16 {
	let pixel_position: vec2f = vec2f(f32(coordinate.x), f32(coordinate.y));
	let output: vec4f16 = vec4f16(0.0, 0.0, 0.0, 0.0);

	if (edge.y > 0.0) {
		let diagonal: vec2f16 = vec2f16(0.0, 0.0);
		if (diagonal_candidate(pixel_position, extent)) {
			diagonal = diagonal_weights(pixel_position, edge, extent);
		}
		output = vec4f16(diagonal.x, diagonal.y, 0.0, 0.0);
		if (diagonal.x + diagonal.y <= 0.0) {
			let left_start: vec2f = pixel_position + vec2f(0.0 - 0.25, 0.0 - 0.125);
			let right_start: vec2f = pixel_position + vec2f(1.25, 0.0 - 0.125);
			let left_end: f32 = left_start.x - 2.0 * f32(SMAA_MAX_SEARCH_STEPS);
			let right_end: f32 = right_start.x + 2.0 * f32(SMAA_MAX_SEARCH_STEPS);
			let left_x: f32 = search_x_left(left_start, left_end, extent);
			let right_x: f32 = search_x_right(right_start, right_end, extent);
			let distance: vec2f16 = abs(round(vec2f16(vec2f(left_x, right_x) - vec2f(pixel_position.x, pixel_position.x))));
			let root_distance: vec2f16 = vec2f16(sqrt(distance.x), sqrt(distance.y));
			let area: vec2f16 = area_orthogonal(root_distance,
				sample_edges_linear_pixel(vec2f(left_x, pixel_position.y - 0.25), extent).x,
				sample_edges_linear_pixel(vec2f(right_x + 1.0, pixel_position.y - 0.25), extent).x);
			let cornered: vec2f16 = horizontal_corners(area, vec2f(left_x, pixel_position.y), vec2f(right_x, pixel_position.y), distance, extent);
			output = vec4f16(cornered.x, cornered.y, 0.0, 0.0);
		}
	}

	// A detected diagonal owns this pixel, so west-edge processing is skipped.
	if (edge.x > 0.0 && output.x + output.y <= 0.0) {
		let top_start: vec2f = pixel_position + vec2f(0.0 - 0.125, 0.0 - 0.25);
		let bottom_start: vec2f = pixel_position + vec2f(0.0 - 0.125, 1.25);
		let top_end: f32 = top_start.y - 2.0 * f32(SMAA_MAX_SEARCH_STEPS);
		let bottom_end: f32 = bottom_start.y + 2.0 * f32(SMAA_MAX_SEARCH_STEPS);
		let top_y: f32 = search_y_up(top_start, top_end, extent);
		let bottom_y: f32 = search_y_down(bottom_start, bottom_end, extent);
		let distance: vec2f16 = abs(round(vec2f16(vec2f(top_y, bottom_y) - vec2f(pixel_position.y, pixel_position.y))));
		let root_distance: vec2f16 = vec2f16(sqrt(distance.x), sqrt(distance.y));
		let area: vec2f16 = area_orthogonal(root_distance,
			sample_edges_linear_pixel(vec2f(pixel_position.x - 0.25, top_y), extent).y,
			sample_edges_linear_pixel(vec2f(pixel_position.x - 0.25, bottom_y + 1.0), extent).y);
		let cornered: vec2f16 = vertical_corners(area, vec2f(pixel_position.x, top_y), vec2f(pixel_position.x, bottom_y), distance, extent);
		output = vec4f16(output.x, output.y, cornered.x, cornered.y);
	}

	return output;
}

// Matches conversion through the former RGBA8UNORM weight image before sampling.
quantize_unorm8: fn(value: f16) -> u32 {
	return u32(round(clamp(value, f16(0.0), f16(1.0)) * f16(255.0)));
}

pack_weights: fn(value: vec4f16) -> u32 {
	return quantize_unorm8(value.x)
		| (quantize_unorm8(value.y) << 8)
		| (quantize_unorm8(value.z) << 16)
		| (quantize_unorm8(value.w) << 24);
}

cached_weight_at: fn(local: vec2u) -> u32 {
	return cached_weights[local.y * SMAA_WEIGHT_TILE_WIDTH + local.x];
}

unpack_weight_component: fn(value: u32, shift: u32) -> f16 {
	let component: u32 = (value >> shift) & 255;
	return f16(component) / f16(255.0);
}

// Clamps a positive tile offset to reproduce Clamp sampling beyond the image edge.
clamp_tile_add: fn(origin: u32, offset: u32, extent: u32) -> u32 {
	let maximum: u32 = extent - 1;
	if (offset > maximum - origin) {
		return maximum;
	}
	return origin + offset;
}

main: fn() -> void {
	let coordinate: vec2u = thread_id();
	let extent: vec2u = texture_size(edges);
	let workgroup_origin: vec2u = vec2u(
		coordinate.x - coordinate.x % SMAA_RESOLVE_WORKGROUP_WIDTH,
		coordinate.y - coordinate.y % SMAA_RESOLVE_WORKGROUP_HEIGHT
	);
	let lane: u32 = thread_idx();

	// Cooperatively calculate the core plus the two resolve look-ahead borders.
	// All lanes populate shared storage before any partial-workgroup lane returns.
	for (let index: u32 = lane; index < SMAA_WEIGHT_TILE_SIZE; index = index + SMAA_RESOLVE_WORKGROUP_THREADS) {
		let local: vec2u = vec2u(index % SMAA_WEIGHT_TILE_WIDTH, index / SMAA_WEIGHT_TILE_WIDTH);
		let weight_coordinate: vec2u = vec2u(
			clamp_tile_add(workgroup_origin.x, local.x, extent.x),
			clamp_tile_add(workgroup_origin.y, local.y, extent.y)
		);
		cached_weights[index] = pack_weights(blend_weights_at(weight_coordinate, extent, edge_flags_at(weight_coordinate)));
	}
	workgroup_barrier();

	guard_image_bounds(result, coordinate);
	let local: vec2u = coordinate - workgroup_origin;
	let center_weights: u32 = cached_weight_at(local);
	let right: f16 = unpack_weight_component(cached_weight_at(local + vec2u(1, 0)), 24);
	let top: f16 = unpack_weight_component(cached_weight_at(local + vec2u(0, 1)), 8);
	let bottom: f16 = unpack_weight_component(center_weights, 0);
	let left: f16 = unpack_weight_component(center_weights, 16);
	let total: f16 = right + top + bottom + left;
	if (total < f16(0.00001)) {
		// An exact texel read avoids filtering work for the overwhelmingly common no-edge path.
		write(result, coordinate, fetch(source, coordinate));
		return;
	}

	// Source UVs and color remain f32 at the sampling boundary. The four weights,
	// dominant-axis decision, and normalization stay f16 until this final blend.
	let extent_f: vec2f = vec2f(f32(extent.x), f32(extent.y));
	let pixel_size: vec2f = vec2f(1.0 / extent_f.x, 1.0 / extent_f.y);
	let texcoord: vec2f = (vec2f(f32(coordinate.x), f32(coordinate.y)) + vec2f(0.5, 0.5)) / extent_f;
	let horizontal: bool = max(right, left) > max(top, bottom);
	let first_offset: vec2f = vec2f(0.0, f32(top));
	let second_offset: vec2f = vec2f(0.0, 0.0 - f32(bottom));
	let first_weight: f16 = top;
	let second_weight: f16 = bottom;
	if (horizontal) {
		first_offset = vec2f(f32(right), 0.0);
		second_offset = vec2f(0.0 - f32(left), 0.0);
		first_weight = right;
		second_weight = left;
	}
	let normalization: f16 = first_weight + second_weight;
	let color_a: vec4f = texture_lod(source, texcoord + first_offset * pixel_size);
	let color_b: vec4f = texture_lod(source, texcoord + second_offset * pixel_size);
	write(result, coordinate, (color_a * f32(first_weight) + color_b * f32(second_weight)) / f32(normalization));
}
