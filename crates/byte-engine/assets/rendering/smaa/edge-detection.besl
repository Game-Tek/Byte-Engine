// Spatial SMAA 1x luma edge detection ported from the reference implementation.
// See LICENSE.txt beside this shader for the original authors and license.
source: descriptor<Texture2D, 0, read>;
edges: descriptor<StorageImage<rgba8>, 1, write>;

// These values match the official SMAA 1x Ultra preset.
SMAA_EDGE_THRESHOLD: const f32 = 0.05;
SMAA_LOCAL_CONTRAST_FACTOR: const f32 = 2.0;

clamp_subtract: fn(value: u32, offset: u32) -> u32 {
	if (value < offset) {
		return 0;
	}
	return value - offset;
}

clamp_add: fn(value: u32, offset: u32, extent: u32) -> u32 {
	let maximum: u32 = extent - 1;
	if (offset > maximum - value) {
		return maximum;
	}
	return value + offset;
}

luma_at: fn(coordinate: vec2u, extent: vec2u) -> f32 {
	let texcoord: vec2f = (vec2f(f32(coordinate.x), f32(coordinate.y)) + vec2f(0.5, 0.5))
		/ vec2f(f32(extent.x), f32(extent.y));
	let color: vec4f = texture_lod(source, texcoord);
	return color.x * 0.2126 + color.y * 0.7152 + color.z * 0.0722;
}

main: fn() -> void {
	let coordinate: vec2u = thread_id();
	guard_image_bounds(edges, coordinate);
	let extent: vec2u = texture_size(source);
	let left: vec2u = vec2u(clamp_subtract(coordinate.x, 1), coordinate.y);
	let left_left: vec2u = vec2u(clamp_subtract(coordinate.x, 2), coordinate.y);
	let right: vec2u = vec2u(clamp_add(coordinate.x, 1, extent.x), coordinate.y);
	let top: vec2u = vec2u(coordinate.x, clamp_subtract(coordinate.y, 1));
	let top_top: vec2u = vec2u(coordinate.x, clamp_subtract(coordinate.y, 2));
	let bottom: vec2u = vec2u(coordinate.x, clamp_add(coordinate.y, 1, extent.y));

	// Store west and north boundaries. Neighboring pixels supply the opposite sides later.
	let center_luma: f32 = luma_at(coordinate, extent);
	let left_luma: f32 = luma_at(left, extent);
	let top_luma: f32 = luma_at(top, extent);
	let west_delta: f32 = abs(center_luma - left_luma);
	let north_delta: f32 = abs(center_luma - top_luma);
	let east_delta: f32 = abs(center_luma - luma_at(right, extent));
	let south_delta: f32 = abs(center_luma - luma_at(bottom, extent));
	let far_west_delta: f32 = abs(left_luma - luma_at(left_left, extent));
	let far_north_delta: f32 = abs(top_luma - luma_at(top_top, extent));

	// Local contrast adaptation suppresses a weak crossing edge hidden by a stronger neighbor.
	let maximum_delta: f32 = max(max(west_delta, north_delta), max(east_delta, south_delta));
	maximum_delta = max(maximum_delta, max(far_west_delta, far_north_delta));
	let west_edge: f32 = 0.0;
	let north_edge: f32 = 0.0;
	if (west_delta >= SMAA_EDGE_THRESHOLD && SMAA_LOCAL_CONTRAST_FACTOR * west_delta >= maximum_delta) {
		west_edge = 1.0;
	}
	if (north_delta >= SMAA_EDGE_THRESHOLD && SMAA_LOCAL_CONTRAST_FACTOR * north_delta >= maximum_delta) {
		north_edge = 1.0;
	}

	write(edges, coordinate, vec4f(west_edge, north_edge, 0.0, 0.0));
}
