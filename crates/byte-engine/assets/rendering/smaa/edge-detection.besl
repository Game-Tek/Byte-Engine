// Spatial SMAA 1x luma edge detection ported from the reference implementation.
// See LICENSE.txt beside this shader for the original authors and license.
source: descriptor<{ type: Texture2D, binding: 0, access: read }>;
// A tile output on an R8 target, which needs no shader-write usage and stays losslessly compressed.
edges: output<vec4f, 0>;

// These values match the official SMAA 1x Ultra preset.
SMAA_EDGE_THRESHOLD: const f32 = 0.05;
SMAA_LOCAL_CONTRAST_FACTOR: const f32 = 2.0;
SMAA_PACKED_EDGE_MAX: const f32 = 3.0;

// A 16x16 tile, one lane per pixel, needs two texels of left/top halo and one texel of right/bottom halo.
// Sharing luma reduces seven source samples per output pixel to 361 loads per 256-pixel tile.
SMAA_EDGE_WORKGROUP_WIDTH: const u32 = 16;
SMAA_EDGE_WORKGROUP_HEIGHT: const u32 = 16;
SMAA_EDGE_WORKGROUP_THREADS: const u32 = 256;
SMAA_EDGE_HALO_LEFT_TOP: const u32 = 2;
SMAA_EDGE_TILE_WIDTH: const u32 = 19;
SMAA_EDGE_TILE_HEIGHT: const u32 = 19;
SMAA_EDGE_TILE_SIZE: const u32 = 361;

cached_luma: workgroup<f32, 361>;

clamp_subtract: fn(value: u32, offset: u32) -> u32 {
	if (value < offset) {
		return 0;
	}
	return value - offset;
}

clamp_add: fn(value: u32, offset: u32, extent: u32) -> u32 {
	let maximum: u32 = extent - 1;
	if (offset > maximum - value) {
		return maximum;
	}
	return value + offset;
}

// Perceptual luma: Reinhard bounds HDR highlights and the square root approximates display gamma, so the
// reference threshold, tuned for display values, also fits scene-linear input.
source_luma: fn(coordinate: vec2u) -> f32 {
	let color: vec4f = fetch(source, coordinate);
	let linear_luma: f32 = max(color.x * 0.2126 + color.y * 0.7152 + color.z * 0.0722, 0.0);
	return sqrt(linear_luma / (1.0 + linear_luma));
}

// Maps a shared-tile coordinate to the clamped source coordinate it caches.
tile_coordinate: fn(origin: u32, local: u32, halo: u32, extent: u32) -> u32 {
	if (local < halo) {
		return clamp_subtract(origin, halo - local);
	}
	return clamp_add(origin, local - halo, extent);
}

cached_luma_at: fn(coordinate: vec2u) -> f32 {
	return cached_luma[coordinate.y * SMAA_EDGE_TILE_WIDTH + coordinate.x];
}

main: fn(input: StageInput) -> void {
	let coordinate: vec2u = input.thread_id;
	let extent: vec2u = input.extent;
	let workgroup_origin: vec2u = vec2u(
		coordinate.x - coordinate.x % SMAA_EDGE_WORKGROUP_WIDTH,
		coordinate.y - coordinate.y % SMAA_EDGE_WORKGROUP_HEIGHT
	);
	let lane: u32 = input.thread_idx;

	// Every lane participates before the barrier, including lanes outside a partial edge tile.
	for (let index: u32 = lane; index < SMAA_EDGE_TILE_SIZE; index = index + SMAA_EDGE_WORKGROUP_THREADS) {
		let local: vec2u = vec2u(index % SMAA_EDGE_TILE_WIDTH, index / SMAA_EDGE_TILE_WIDTH);
		let source_coordinate: vec2u = vec2u(
			tile_coordinate(workgroup_origin.x, local.x, SMAA_EDGE_HALO_LEFT_TOP, extent.x),
			tile_coordinate(workgroup_origin.y, local.y, SMAA_EDGE_HALO_LEFT_TOP, extent.y)
		);
		cached_luma[index] = source_luma(source_coordinate);
	}
	workgroup_barrier();

	if (coordinate.x >= extent.x || coordinate.y >= extent.y) {
		return;
	}
	let local: vec2u = coordinate - workgroup_origin + vec2u(SMAA_EDGE_HALO_LEFT_TOP, SMAA_EDGE_HALO_LEFT_TOP);
	let center_luma: f32 = cached_luma_at(local);
	let left_luma: f32 = cached_luma_at(local - vec2u(1, 0));
	let top_luma: f32 = cached_luma_at(local - vec2u(0, 1));
	let west_delta: f32 = abs(center_luma - left_luma);
	let north_delta: f32 = abs(center_luma - top_luma);
	let east_delta: f32 = abs(center_luma - cached_luma_at(local + vec2u(1, 0)));
	let south_delta: f32 = abs(center_luma - cached_luma_at(local + vec2u(0, 1)));
	let far_west_delta: f32 = abs(left_luma - cached_luma_at(local - vec2u(2, 0)));
	let far_north_delta: f32 = abs(top_luma - cached_luma_at(local - vec2u(0, 2)));

	// Local contrast adaptation suppresses a weak crossing edge hidden by a stronger neighbor.
	let maximum_delta: f32 = max(max(west_delta, north_delta), max(east_delta, south_delta));
	maximum_delta = max(maximum_delta, max(far_west_delta, far_north_delta));
	let packed_edges: u32 = 0;
	if (west_delta >= SMAA_EDGE_THRESHOLD && SMAA_LOCAL_CONTRAST_FACTOR * west_delta >= maximum_delta) {
		packed_edges = packed_edges | 1;
	}
	if (north_delta >= SMAA_EDGE_THRESHOLD && SMAA_LOCAL_CONTRAST_FACTOR * north_delta >= maximum_delta) {
		packed_edges = packed_edges | 2;
	}

	// The R8 target stores west in bit 0 and north in bit 1 as one of four exact UNORM levels.
	write(edges, coordinate, vec4f(f32(packed_edges) / SMAA_PACKED_EDGE_MAX, 0.0, 0.0, 0.0));
}
