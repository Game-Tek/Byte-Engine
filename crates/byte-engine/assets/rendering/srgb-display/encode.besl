
linear_srgb_channel_to_srgb: fn(channel: f32) -> f32 {
	let bounded: f32 = clamp(channel, 0.0, 1.0);
	if (bounded <= 0.0031308) {
		return 12.92 * bounded;
	}
	return 1.055 * pow(bounded, 1.0 / 2.4) - 0.055;
}

// Encodes the pixel's linear color for the non-sRGB UNORM swapchain, channel by channel, and keeps its alpha.
pixel: fn(color: vec4f, coordinate: vec2u, extent: vec2u) -> vec4f {
	return vec4f(
		linear_srgb_channel_to_srgb(color.x),
		linear_srgb_channel_to_srgb(color.y),
		linear_srgb_channel_to_srgb(color.z),
		color.w
	);
}
