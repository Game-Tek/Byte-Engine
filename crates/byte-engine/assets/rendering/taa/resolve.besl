// Temporal antialiasing: blends each jittered frame into a running history reprojected through the scene's velocity,
// as the temporal antialiasing section of the rendering reference specifies.
//
// The steps, in the order they keep stale history out of the result:
// - The velocity comes from the nearest surface of the 3 x 3 pixels around the pixel (FSR 2, INSIDE), so the edge of
//   a moving object follows the object instead of the background behind it.
// - History that falls off screen, or that something stood in front of in the previous frame, is dropped: the
//   previous frame's depth around the reprojected point must reach the surface's previous depth (FSR 2). Both are the
//   opaque layer's, from `Velocity`, because blended surfaces later overwrite `Depth` without moving the velocity.
// - The history is clipped toward the center of the current neighborhood's box in YCoCg (Pedersen, INSIDE), the box
//   being the variance box μ ± γσ (Salvi, GDC 2016) inside the 3 x 3 minimum and maximum.
// - The history's weight falls with the luma difference (INSIDE) as a pixel starts to move, with speed, for a young
//   history, and under the reactive mask of blended surfaces and particles (FSR 2). A still pixel keeps the most
//   history, so the jittered samples of detail finer than a pixel average out instead of flickering.
// Colors blend as c / (1 + Y) (Lottes), so a single bright sample can't dominate the blend, and the history is read
// with a 5-tap Catmull-Rom filter (Jimenez, Filmic SMAA), so repeated resampling doesn't blur it. See the temporal
// antialiasing design note.

TaaParameters: struct {
	// The history's least and greatest weight, and the variance box's half-width in standard deviations.
	feedback_min: f32,
	feedback_max: f32,
	variance_gamma: f32,
	// This frame's exposure scale over the previous frame's, which brings the history to this frame's exposure.
	exposure_ratio: f32,
	// 1 on a frame whose history holds nothing usable: the first, after a resize, or after the pass was bypassed.
	reset: u32,
	// The pool slot the first shown debug view writes; shown views write consecutive slots in view order.
	debug_view_first_slot: u32,
	// Whether to write each debug view, in the order `TAA_DEBUG_VIEWS` declares them.
	debug_view_velocity: bool,
	debug_view_disocclusion: bool,
	debug_view_reactive: bool,
	debug_view_frames: bool,
}

scene_texture: descriptor<{ type: Texture2D, binding: 0, access: read }>;
// rg: motion in pixels; b and a: the opaque surface's previous and current linear depth.
velocity: descriptor<{ type: Texture2D, binding: 1, access: read }>;
// The previous frame's `Velocity`, whose alpha holds that frame's opaque linear depth.
previous_velocity: descriptor<{ type: Texture2D, binding: 2, access: read }>;
reactive: descriptor<{ type: Texture2D, binding: 3, access: read }>;
// The previous frame's history, read through a linear filter by the Catmull-Rom taps.
history: descriptor<{ type: Texture2D, binding: 4, access: read }>;
parameters: descriptor<{ type: TaaParameters, binding: 5, access: read, memory: constant }>;
// The renderer's debug target pool, which the shown debug views write; see `debug_views.rs`.
debug_view_targets: descriptor<{ type: StorageImage, binding: 6, access: write, count: 15 }>;
// The replacement for `main`.
result: output<vec4f, 0>;
// This frame's history: the result in rgb and the frame count over 255 in alpha.
history_output: output<vec4f, 1>;

// A history no older than this many frames weighs at most n / (n + 1), so a recovering pixel follows the scene fast.
MAX_FRAME_COUNT: const f32 = 255.0;
// The share of the surface's previous depth that the previous frame's depth must reach for the history to count.
DISOCCLUSION_DEPTH_SHARE: const f32 = 0.99;
// Up to the first speed, in pixels per frame, the luma difference phases in; between the two, the history's weight
// falls from its luma-based value to the minimum.
SLOW_SPEED: const f32 = 2.0;
FAST_SPEED: const f32 = 15.0;
// The luma under which the luma difference is measured against this floor instead, so dark noise doesn't reset it.
LUMA_FLOOR: const f32 = 0.2;
// The debug velocity view's full scale, in pixels.
DEBUG_VELOCITY_SCALE: const f32 = 16.0;
// The debug frame count view's full scale, in frames.
DEBUG_FRAMES_SCALE: const f32 = 32.0;
HALF_FLOAT_MAX: const f32 = 65504.0;

// Per-component helpers for the vector forms BESL's builtins don't overload.
min3: fn (a: vec3f, b: vec3f) -> vec3f {
	return vec3f(min(a.x, b.x), min(a.y, b.y), min(a.z, b.z));
}

abs3: fn (value: vec3f) -> vec3f {
	return vec3f(abs(value.x), abs(value.y), abs(value.z));
}

sqrt3: fn (value: vec3f) -> vec3f {
	return vec3f(sqrt(value.x), sqrt(value.y), sqrt(value.z));
}

floor2: fn (value: vec2f) -> vec2f {
	return vec2f(floor(value.x), floor(value.y));
}

clamp2: fn (value: vec2f, minimum: vec2f, maximum: vec2f) -> vec2f {
	return vec2f(clamp(value.x, minimum.x, maximum.x), clamp(value.y, minimum.y, maximum.y));
}

// Returns `color` in YCoCg, divided by 1 + its luma.
weigh: fn (color: vec3f) -> vec3f {
	let clamped: vec3f = clamp(color, vec3f(0.0, 0.0, 0.0), vec3f(HALF_FLOAT_MAX, HALF_FLOAT_MAX, HALF_FLOAT_MAX));
	let y: f32 = 0.25 * clamped.x + 0.5 * clamped.y + 0.25 * clamped.z;
	let co: f32 = 0.5 * clamped.x - 0.5 * clamped.z;
	let cg: f32 = 0.0 - 0.25 * clamped.x + 0.5 * clamped.y - 0.25 * clamped.z;
	return vec3f(y, co, cg) / (1.0 + y);
}

// Returns the color whose weighted YCoCg is `weighted`, inverting `weigh`.
unweigh: fn (weighted: vec3f) -> vec3f {
	let ycocg: vec3f = weighted / max(1.0 - weighted.x, 0.0000001);
	let tmp: f32 = ycocg.x - ycocg.z;
	return max(vec3f(tmp + ycocg.y, ycocg.x + ycocg.z, tmp - ycocg.y), vec3f(0.0, 0.0, 0.0));
}

// Returns `a` moved toward `b` by `t`.
lerp: fn (a: f32, b: f32, t: f32) -> f32 {
	return a + (b - a) * t;
}

// Returns the texel at `position`, held inside the image's `size`.
clamped_texel: fn (position: vec2f, size: vec2f) -> vec2u {
	let held: vec2f = clamp2(position, vec2f(0.0, 0.0), size - vec2f(1.0, 1.0));
	return vec2u(u32(held.x), u32(held.y));
}

// Moves `point` along the line toward `center` until it lies inside the box `center` ± `extent`.
clip_toward_center: fn (point: vec3f, center: vec3f, extent: vec3f) -> vec3f {
	let offset: vec3f = point - center;
	let units: vec3f = abs3(offset / max(extent, vec3f(0.000001, 0.000001, 0.000001)));
	let largest: f32 = max(units.x, max(units.y, units.z));
	if (largest > 1.0) {
		return center + offset / largest;
	}
	return point;
}

// Reads the history at `uv` with a 5-tap Catmull-Rom filter (B = 0, C = 0.5): the 4 x 4 filter's corner taps are
// left out, and pairs of the remaining taps are folded into bilinear reads.
sample_history: fn (uv: vec2f, size: vec2f) -> vec4f {
	let position: vec2f = uv * size;
	let center: vec2f = floor2(position - vec2f(0.5, 0.5)) + vec2f(0.5, 0.5);
	let f: vec2f = position - center;
	let w0: vec2f = f * (vec2f(-0.5, -0.5) + f * (vec2f(1.0, 1.0) - 0.5 * f));
	let w1: vec2f = vec2f(1.0, 1.0) + f * f * (vec2f(-2.5, -2.5) + 1.5 * f);
	let w2: vec2f = f * (vec2f(0.5, 0.5) + f * (vec2f(2.0, 2.0) - 1.5 * f));
	let w3: vec2f = f * f * (vec2f(-0.5, -0.5) + 0.5 * f);
	let w12: vec2f = w1 + w2;
	let middle: vec2f = (center + w2 / w12) / size;
	let before: vec2f = (center - vec2f(1.0, 1.0)) / size;
	let after: vec2f = (center + vec2f(2.0, 2.0)) / size;
	let top_weight: f32 = w12.x * w0.y;
	let left_weight: f32 = w0.x * w12.y;
	let middle_weight: f32 = w12.x * w12.y;
	let right_weight: f32 = w3.x * w12.y;
	let bottom_weight: f32 = w12.x * w3.y;
	let sum: vec4f = texture_lod(history, vec2f(middle.x, before.y)) * top_weight
		+ texture_lod(history, vec2f(before.x, middle.y)) * left_weight
		+ texture_lod(history, middle) * middle_weight
		+ texture_lod(history, vec2f(after.x, middle.y)) * right_weight
		+ texture_lod(history, vec2f(middle.x, after.y)) * bottom_weight;
	let total: f32 = top_weight + left_weight + middle_weight + right_weight + bottom_weight;
	let filtered: vec4f = sum / total;
	return vec4f(max(filtered.x, 0.0), max(filtered.y, 0.0), max(filtered.z, 0.0), max(filtered.w, 0.0));
}

main: fn (input: StageInput) -> void {
	let pixel: vec2u = input.thread_id;
	let extent: vec2u = input.extent;
	if (pixel.x >= extent.x || pixel.y >= extent.y) {
		return;
	}
	let size: vec2f = vec2f(f32(extent.x), f32(extent.y));
	let current: vec4f = fetch(scene_texture, pixel);

	// The neighborhood's moments in weighted YCoCg, and the nearest surface among the same 3 x 3 pixels.
	let first_moment: vec3f = vec3f(0.0, 0.0, 0.0);
	let second_moment: vec3f = vec3f(0.0, 0.0, 0.0);
	let minimum: vec3f = vec3f(HALF_FLOAT_MAX, HALF_FLOAT_MAX, HALF_FLOAT_MAX);
	let maximum: vec3f = vec3f(0.0 - HALF_FLOAT_MAX, 0.0 - HALF_FLOAT_MAX, 0.0 - HALF_FLOAT_MAX);
	let nearest_depth: f32 = HALF_FLOAT_MAX;
	let nearest_pixel: vec2u = pixel;
	for (let index: u32 = 0; index < 9; index = index + 1) {
		// The neighbor one pixel left, at, or right of the pixel, and above, at, or below it, held inside the image.
		let neighbor: vec2u = vec2u(
			min(max(pixel.x + index % 3, 1), extent.x) - 1,
			min(max(pixel.y + index / 3, 1), extent.y) - 1
		);
		let sample: vec4f = fetch(scene_texture, neighbor);
		let weighted: vec3f = weigh(vec3f(sample.x, sample.y, sample.z));
		first_moment = first_moment + weighted;
		second_moment = second_moment + weighted * weighted;
		minimum = min3(minimum, weighted);
		maximum = max(maximum, weighted);
		let neighbor_depth: f32 = fetch(velocity, neighbor).w;
		if (neighbor_depth < nearest_depth) {
			nearest_depth = neighbor_depth;
			nearest_pixel = neighbor;
		}
	}
	let mean: vec3f = first_moment / 9.0;
	let deviation: vec3f = sqrt3(max(second_moment / 9.0 - mean * mean, vec3f(0.0, 0.0, 0.0)));
	let box_minimum: vec3f = max(minimum, mean - parameters.variance_gamma * deviation);
	let box_maximum: vec3f = min3(maximum, mean + parameters.variance_gamma * deviation);

	let motion: vec4f = fetch(velocity, nearest_pixel);
	let motion_xy: vec2f = vec2f(motion.x, motion.y);
	let center: vec2f = vec2f(f32(pixel.x) + 0.5, f32(pixel.y) + 0.5);
	let previous_position: vec2f = center - motion_xy;
	let off_screen: bool = previous_position.x < 0.0 || previous_position.y < 0.0
		|| previous_position.x > size.x || previous_position.y > size.y;

	// The farthest of the 4 previous depth texels around the reprojected point, which a surface still visible from
	// there reaches.
	let disoccluded: bool = false;
	if (!off_screen) {
		let corner: vec2f = floor2(previous_position - vec2f(0.5, 0.5));
		let farthest: f32 = 0.0;
		for (let index: u32 = 0; index < 4; index = index + 1) {
			let tap: vec2u = clamped_texel(corner + vec2f(f32(index % 2), f32(index / 2)), size);
			farthest = max(farthest, fetch(previous_velocity, tap).w);
		}
		disoccluded = farthest < DISOCCLUSION_DEPTH_SHARE * motion.z;
	}

	let current_weighted: vec3f = weigh(vec3f(current.x, current.y, current.z));
	let feedback: f32 = 0.0;
	let frames: f32 = 0.0;
	let clipped: vec3f = current_weighted;
	if (parameters.reset == 0 && !off_screen && !disoccluded) {
		let history_sample: vec4f = sample_history(previous_position / size, size);
		let history_color: vec3f = vec3f(history_sample.x, history_sample.y, history_sample.z) * parameters.exposure_ratio;
		let box_center: vec3f = (box_minimum + box_maximum) * 0.5;
		let box_extent: vec3f = max((box_maximum - box_minimum) * 0.5, vec3f(0.0, 0.0, 0.0));
		clipped = clip_toward_center(weigh(history_color), box_center, box_extent);

		let current_luma: f32 = current_weighted.x / max(1.0 - current_weighted.x, 0.0000001);
		let history_luma: f32 = clipped.x / max(1.0 - clipped.x, 0.0000001);
		let difference: f32 = abs(current_luma - history_luma) / max(max(current_luma, history_luma), LUMA_FLOOR);
		let similarity: f32 = (1.0 - difference) * (1.0 - difference);
		// A still pixel's samples differ from its history only by the jitter, which the history should average, so the
		// luma difference lowers the history's weight only as the pixel moves.
		let speed: f32 = length(motion_xy);
		let luma_feedback: f32 = lerp(parameters.feedback_min, parameters.feedback_max, similarity);
		feedback = lerp(parameters.feedback_max, luma_feedback, clamp(speed / SLOW_SPEED, 0.0, 1.0));
		feedback = lerp(feedback, parameters.feedback_min, clamp((speed - SLOW_SPEED) / (FAST_SPEED - SLOW_SPEED), 0.0, 1.0));
		let history_frames: f32 = round(history_sample.w * MAX_FRAME_COUNT);
		feedback = min(feedback, history_frames / (history_frames + 1.0));
		feedback = feedback * (1.0 - fetch(reactive, pixel).x);
		frames = min(history_frames + 1.0, MAX_FRAME_COUNT);
	}

	let blended: vec3f = unweigh(current_weighted + (clipped - current_weighted) * feedback);
	write(result, pixel, vec4f(blended.x, blended.y, blended.z, current.w));
	write(history_output, pixel, vec4f(blended.x, blended.y, blended.z, frames / MAX_FRAME_COUNT));

	// The debug views write consecutive pool slots in declaration order.
	let slot: u32 = parameters.debug_view_first_slot;
	if (parameters.debug_view_velocity) {
		let scaled: vec2f = clamp2(motion_xy / DEBUG_VELOCITY_SCALE, vec2f(-1.0, -1.0), vec2f(1.0, 1.0));
		write(debug_view_targets[slot], pixel, vec4f(scaled.x * 0.5 + 0.5, scaled.y * 0.5 + 0.5, 0.0, 1.0));
		slot = slot + 1;
	}
	if (parameters.debug_view_disocclusion) {
		let marks: vec4f = vec4f(0.0, 0.0, 0.0, 1.0);
		if (off_screen) {
			marks[0] = 1.0;
		}
		if (disoccluded) {
			marks[1] = 1.0;
		}
		write(debug_view_targets[slot], pixel, marks);
		slot = slot + 1;
	}
	if (parameters.debug_view_reactive) {
		let mask: f32 = fetch(reactive, pixel).x;
		write(debug_view_targets[slot], pixel, vec4f(mask, mask, mask, 1.0));
		slot = slot + 1;
	}
	if (parameters.debug_view_frames) {
		let shown: f32 = min(frames / DEBUG_FRAMES_SCALE, 1.0);
		write(debug_view_targets[slot], pixel, vec4f(shown, shown, shown, 1.0));
	}
}
