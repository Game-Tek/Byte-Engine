// The vertex stage of the draw that lays the UI layer over the frame. No buffer is bound: three vertices make one
// triangle that covers the whole target, with corners at (-1, 1), (3, 1), and (-1, -3) in clip space.

main: fn (input: StageInput) -> interface { position: vec4f, uv: vec2f } {
	// Texture coordinates (0, 0), (2, 0), and (0, 2): the target spans 0 to 1 on both axes, top left first.
	let uv: vec2f = vec2f(f32((input.vertex_index << 1) & 2), f32(input.vertex_index & 2));
	let position: vec4f = vec4f(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, 0.0, 1.0);

	return { position, uv };
}
