// The descriptor set of the UI composite pass: the scene, the premultiplied UI layer over it, and the image the
// composite writes. The frame output and the backdrop resolve each bind one.

Composite: layer {
	scene: descriptor<{ type: StorageImage, binding: 0, access: read }>;
	layer: descriptor<{ type: StorageImage<rgba16f>, binding: 1, access: read }>;
	result: descriptor<{ type: StorageImage, binding: 2, access: write }>;
}

// The descriptor set of the UI composite on a sink without a scene: the premultiplied UI layer and the image the
// composite writes. The frame output and the backdrop resolve each bind one.

LayerComposite: layer {
	layer: descriptor<{ type: StorageImage<rgba16f>, binding: 0, access: read }>;
	result: descriptor<{ type: StorageImage, binding: 1, access: write }>;
}
