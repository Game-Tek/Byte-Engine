in_position: input<vec2f, 0>;
in_pixel_position: input<vec2f, 1>;
in_local_position: input<vec2f, 2>;
in_rect_size: input<vec2f, 3>;
in_color: input<vec4f, 4>;
in_corner_radius: input<f32, 5>;
in_corner_exponent: input<f32, 6>;
in_layer_kind: input<f32, 7>;
in_stroke_width: input<f32, 8>;
in_feather_mask_position: input<vec2f, 9>;
in_feather_mask_size: input<vec2f, 10>;
in_feather_mask_edges: input<vec4f, 11>;
in_feather_mask_corner: input<vec2f, 12>;
in_blur_resolution_mix: input<f32, 13>;

main: fn () -> interface {
	position: vec4f,
	color: vec4f,
	pixel_position: vec2f,
	local_position: vec2f,
	rect_size: vec2f,
	corner_radius: f32,
	corner_exponent: f32,
	layer_kind: f32,
	stroke_width: f32,
	feather_mask_position: vec2f,
	feather_mask_size: vec2f,
	feather_mask_edges: vec4f,
	feather_mask_corner: vec2f,
	screen_uv: vec2f,
	blur_resolution_mix: f32,
} {
	let position: vec4f = vec4f(in_position.x, in_position.y, 0.0, 1.0);
	let screen_uv: vec2f = vec2f(in_position.x * 0.5 + 0.5, 0.5 - in_position.y * 0.5);

	return {
		position,
		color: in_color,
		pixel_position: in_pixel_position,
		local_position: in_local_position,
		rect_size: in_rect_size,
		corner_radius: in_corner_radius,
		corner_exponent: in_corner_exponent,
		layer_kind: in_layer_kind,
		stroke_width: in_stroke_width,
		feather_mask_position: in_feather_mask_position,
		feather_mask_size: in_feather_mask_size,
		feather_mask_edges: in_feather_mask_edges,
		feather_mask_corner: in_feather_mask_corner,
		screen_uv,
		blur_resolution_mix: in_blur_resolution_mix,
	};
}
