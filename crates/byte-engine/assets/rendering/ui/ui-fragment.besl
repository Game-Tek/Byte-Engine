// The UI ubershader. Every UI primitive is one record in `primitives`, and its kind selects how
// the quad is shaded. A record is constant across its quad, so every branch on it is coherent and
// the work a primitive does not need is skipped instead of being multiplied by zero.

use ::byte_engine::rendering::ui::layouts::ui::*;
use ::byte_engine::rendering::ui::shading::*;

main: fn(pipeline_input: interface {
	curve_from: vec4f,
	curve_to: vec2f,
	pixel_position: vec2f,
	primitive: u32,
	uv: vec2f,
	backdrop_position: vec2f,
}, ui: Ui) -> output { color_attachment: vec4f } {
	// The shading comes before the clip, mask, and fade. `shade` is where the shader holds the most values at once, and
	// the GPU sizes every thread for that peak, so nothing is computed ahead of it and held across it: measured, one
	// mask value held across `shade` cost every primitive 15 percent.
	let shaded: vec4f = shade(
		ui,
		pipeline_input.primitive,
		pipeline_input.pixel_position,
		pipeline_input.backdrop_position,
		pipeline_input.uv,
		pipeline_input.curve_from,
		pipeline_input.curve_to
	);
	let mask: f32 = mask_coverage(ui, primitive_mask(ui.primitives[pipeline_input.primitive].header), pipeline_input.pixel_position)
		* fade_coverage(ui, pipeline_input.primitive, pipeline_input.pixel_position)
		* turned_edge_coverage(ui, pipeline_input.primitive, pipeline_input.pixel_position);
	let color_attachment: vec4f = vec4f(shaded.x, shaded.y, shaded.z, clamp(shaded.w * mask, 0.0, 1.0));

	return { color_attachment };
}
