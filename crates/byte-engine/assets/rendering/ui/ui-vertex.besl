// The UI ubershader's vertex stage. No vertex or index buffer is bound: six vertices pull one
// record from `primitives` and place the corners of its quad.

use ::byte_engine::rendering::ui::layouts::ui::*;

push_constant: push_constant {
	viewport: vec2f,
	// The record the draw's first vertex belongs to. A push constant means the same on every backend,
	// where a first vertex does not always reach the vertex index.
	first: u32,
	padding: u32,
}

// Evaluates a cubic's blossom. With parameters drawn from {t0, t1} this yields the control points
// of the cubic restricted to [t0, t1].
blossom: fn (c01: vec4f, c23: vec4f, u: f32, v: f32, w: f32) -> vec2f {
	let c0: vec2f = vec2f(c01.x, c01.y);
	let c1: vec2f = vec2f(c01.z, c01.w);
	let c2: vec2f = vec2f(c23.x, c23.y);
	let c3: vec2f = vec2f(c23.z, c23.w);
	let p01: vec2f = c0 + (c1 - c0) * u;
	let p12: vec2f = c1 + (c2 - c1) * u;
	let p23: vec2f = c2 + (c3 - c2) * u;
	let p012: vec2f = p01 + (p12 - p01) * v;
	let p123: vec2f = p12 + (p23 - p12) * v;
	return p012 + (p123 - p012) * w;
}

// Where `point` was drawn when the shutter opened, by the motion record at `motion` in `masks`. See
// `UiMotionRecord` in `ui/render_pass/data.rs` and `motion_warp` in `ui-fragment.besl`, its inverse.
motion_start: fn (ui: Ui, motion: u32, point: vec2f) -> vec2f {
	let placement: vec4f = ui.masks[motion].clip;
	let scale: vec4f = ui.masks[motion].rect;
	let angle: f32 = ui.masks[motion].edges.x;
	let center: vec2f = vec2f(placement.x, placement.y);
	let offset: vec2f = point - center;
	let scaled: vec2f = offset + vec2f(scale.x * offset.x + scale.y * offset.y, scale.z * offset.x + scale.w * offset.y);
	let turn_cos: f32 = cos(angle);
	let turn_sin: f32 = sin(angle);
	return center
		+ vec2f(turn_cos * scaled.x - turn_sin * scaled.y, turn_sin * scaled.x + turn_cos * scaled.y)
		+ vec2f(placement.z, placement.w);
}

// Grows a quad's (along min, along max, across min, across max) range to hold where `corner` was
// when the shutter opened.
swept_range: fn (ui: Ui, motion: u32, origin: vec2f, tangent: vec2f, normal: vec2f, corner: vec2f, reach: vec4f) -> vec4f {
	let start: vec2f = motion_start(ui, motion, corner) - origin;
	let along: f32 = dot(start, tangent);
	let across: f32 = dot(start, normal);
	return vec4f(min(reach.x, along), max(reach.y, along), min(reach.z, across), max(reach.w, across));
}

main: fn (input: StageInput, ui: Ui) -> interface {
	position: vec4f,
	curve_from: vec4f,
	curve_to: vec2f,
	pixel_position: vec2f,
	primitive: u32,
	uv: vec2f,
	screen_position: vec2f,
} {
	let primitive: u32 = push_constant.first + input.vertex_index / 6;
	// Two triangles: top left, top right, bottom right, then bottom right, bottom left, top left.
	let corner_index: u32 = input.vertex_index % 6;
	let corner: vec2f = vec2f(f32((14 >> corner_index) & 1), f32((28 >> corner_index) & 1));

	let bounds: vec4f = ui.primitives[primitive].bounds;
	let a: vec4f = ui.primitives[primitive].a;
	let curve_from: vec4f = vec4f(0.0, 0.0, 0.0, 0.0);
	let curve_to: vec2f = vec2f(0.0, 0.0);

	// The quad is a box along two axes: the screen's for most kinds, a curve piece's chord for curves.
	let origin: vec2f = vec2f(0.0, 0.0);
	let tangent: vec2f = vec2f(1.0, 0.0);
	let normal: vec2f = vec2f(0.0, 1.0);
	let along_range: vec2f = vec2f(bounds.x, bounds.z);
	let across_range: vec2f = vec2f(bounds.y, bounds.w);

	// A turned edge crosses pixels at an angle, so the rasterizer can no longer resolve it. The quad
	// grows by a pixel for the fragment stage to fade the edge across, and the texture rectangle
	// grows with it. Glyphs carry their own padding and curves their own expansion.
	let turn: vec4f = ui.masks[ui.primitives[primitive].mask].rotation;
	let kind: u32 = ui.primitives[primitive].kind;
	if (abs(turn.y) > 0.00001 && (kind == 0 || kind == 1 || kind == 3)) {
		along_range = vec2f(along_range.x - 1.0, along_range.y + 1.0);
		across_range = vec2f(across_range.x - 1.0, across_range.y + 1.0);
	}

	// A curve piece holds its segment's whole cubic and which slice of it to draw.
	if (kind == 2) {
		let piece: u32 = ui.primitives[primitive].data0 & 65535;
		let count: u32 = ui.primitives[primitive].data0 >> 16;
		let t0: f32 = f32(piece) / f32(count);
		let t1: f32 = f32(piece + 1) / f32(count);
		let s0: vec2f = blossom(bounds, a, t0, t0, t0);
		let s1: vec2f = blossom(bounds, a, t0, t0, t1);
		let s2: vec2f = blossom(bounds, a, t0, t1, t1);
		let s3: vec2f = blossom(bounds, a, t1, t1, t1);
		// The quadratic closest to a cubic slice. Its error falls with the cube of the slice count,
		// which the CPU picks, and it is exact for a line or a quadratic stored as a cubic.
		let control: vec2f = ((s1 + s2) * 3.0 - s0 - s3) * 0.25;
		curve_from = vec4f(s0.x, s0.y, control.x, control.y);
		curve_to = s3;

		// Bound the slice with a box along its chord. A quadratic stays inside its control points
		// along the chord and bulges half as far as its control point across it.
		let chord: vec2f = s3 - s0;
		let chord_length: f32 = sqrt(dot(chord, chord));
		if (chord_length > 0.0001) {
			tangent = chord / chord_length;
		}
		normal = vec2f(0.0 - tangent.y, tangent.x);
		let along: f32 = dot(control - s0, tangent);
		let across: f32 = dot(control - s0, normal) * 0.5;
		// Half the stroke plus one pixel of anti-aliasing, which also covers a round cap.
		let expansion: f32 = ui.primitives[primitive].b.x + 1.0;
		origin = s0;
		along_range = vec2f(min(min(along, 0.0), chord_length) - expansion, max(max(along, 0.0), chord_length) + expansion);
		across_range = vec2f(min(across, 0.0) - expansion, max(across, 0.0) + expansion);
	}

	// A moving primitive is shaded wherever it passed during the shutter, so its box grows to hold
	// where its corners were when the shutter opened, plus the bow a turn gives their paths.
	let motion: u32 = u32(ui.masks[ui.primitives[primitive].mask].corner.z);
	if (motion != 0) {
		let reach: vec4f = vec4f(along_range.x, along_range.y, across_range.x, across_range.y);
		reach = swept_range(ui, motion, origin, tangent, normal, origin + tangent * along_range.x + normal * across_range.x, reach);
		reach = swept_range(ui, motion, origin, tangent, normal, origin + tangent * along_range.y + normal * across_range.x, reach);
		reach = swept_range(ui, motion, origin, tangent, normal, origin + tangent * along_range.y + normal * across_range.y, reach);
		reach = swept_range(ui, motion, origin, tangent, normal, origin + tangent * along_range.x + normal * across_range.y, reach);
		let record: vec4f = ui.masks[motion].edges;
		let bulge: f32 = record.y * abs(record.x) * 0.125 + 1.0;
		along_range = vec2f(reach.x - bulge, reach.y + bulge);
		across_range = vec2f(reach.z - bulge, reach.w + bulge);
	}

	let pixel_position: vec2f = origin
		+ tangent * mix(along_range.x, along_range.y, corner.x)
		+ normal * mix(across_range.x, across_range.y, corner.y);
	// Images and atlas glyphs keep their texture rectangle in `a`, which maps linearly onto `bounds`.
	let uv: vec2f = vec2f(
		a.x + (pixel_position.x - bounds.x) * (a.z - a.x) / max(bounds.z - bounds.x, 0.0001),
		a.y + (pixel_position.y - bounds.y) * (a.w - a.y) / max(bounds.w - bounds.y, 0.0001)
	);

	// A primitive is laid out and shaded unrotated. Only its quad turns, and the unrotated pixel
	// position interpolates across it, so the fragment stage needs no inverse.
	let screen_position: vec2f = vec2f(
		turn.x * pixel_position.x - turn.y * pixel_position.y + turn.z,
		turn.y * pixel_position.x + turn.x * pixel_position.y + turn.w
	);

	let position: vec4f = vec4f(
		screen_position.x / push_constant.viewport.x * 2.0 - 1.0,
		1.0 - screen_position.y / push_constant.viewport.y * 2.0,
		0.0,
		1.0
	);

	return { position, curve_from, curve_to, pixel_position, primitive, uv, screen_position };
}
