// Smooths the contact-shadow trace. The trace starts each pixel's ray at a different point along it, dithered by
// interleaved gradient noise, and each pixel keeps only its own result, so its shadow edges are jagged at pixel scale.
// This pass averages each pixel with its 5x5 neighbors on the same surface, which turns the dither into a smooth ramp.
// A neighbor on another surface, such as a foot in front of the floor, does not count, so shadows keep to their
// surface.
// Each 8x8 workgroup first loads the linear depth and trace of its pixels and a two-pixel border into workgroup memory,
// so every pixel's 25 taps and depth gradient read shared values instead of fetching and linearizing depth again.
ScreenView: struct {
	pixel_to_ray_mul: vec2f,
	pixel_to_ray_add: vec2f,
	projection_pixels_y: f32,
	view_z_sign: f32,
	depth_unproject_numerator: f32,
	depth_unproject_denominator_offset: f32,
}

screen_view: descriptor<{ type: ScreenView, binding: 0, access: read }>;
visibility_depth: descriptor<{ type: Texture2D, binding: 1033, access: read }>;
contact_shadow_output: descriptor<{ type: StorageImage<r8>, binding: 1034, access: write }>;
contact_shadow_trace: descriptor<{ type: Texture2D, binding: 1035, access: read }>;

// Per tile texel: 1/z of the view depth, which every use of depth below needs, or zero without a surface; and the trace.
shared_inverse_depth: workgroup<f32, 144>;
shared_trace: workgroup<f32, 144>;

CONTACT_SHADOW_FILTER_RADIUS: const u32 = 2;
CONTACT_SHADOW_FILTER_WORKGROUP_WIDTH: const u32 = 8;
CONTACT_SHADOW_FILTER_WORKGROUP_SIZE: const u32 = 64;
// The workgroup's pixels plus the filter radius on every side.
CONTACT_SHADOW_FILTER_TILE_WIDTH: const u32 = 12;
CONTACT_SHADOW_FILTER_TILE_SIZE: const u32 = 144;
// Gaussian weights for offsets zero, one, and two. The product of two gives the 5x5 kernel.
CONTACT_SHADOW_FILTER_WEIGHTS: const f32[3] = f32[3](0.4026199469, 0.2442013420, 0.0544886845);
// A neighbor counts fully when its depth lies on the center's surface plane, and less the further it lies from it, down
// to nothing at this distance relative to the center's depth.
CONTACT_SHADOW_FILTER_PLANE_TOLERANCE: const f32 = 0.02;

// Returns 1/z of a pixel's positive linear view depth, or zero where no surface was drawn or outside the image. It
// matches the contact-shadow trace's own depth reconstruction.
fetch_inverse_depth: fn (column: f32, row: f32, extent: vec2u) -> f32 {
	if (column < 0.0 || row < 0.0 || column >= f32(extent.x) || row >= f32(extent.y)) {
		return 0.0;
	}
	let depth: f32 = fetch(visibility_depth, vec2u(u32(column), u32(row))).x;
	if (depth == 0.0) {
		return 0.0;
	}
	return (depth + screen_view.depth_unproject_denominator_offset) / screen_view.depth_unproject_numerator;
}

// Returns the error of predicting the center's 1/z by extending the line through two neighbors on one side.
// 1/z is linear across the screen on a plane, so a side on the center's own surface predicts it exactly.
side_error: fn (center: f32, near: f32, far: f32) -> f32 {
	if (near == 0.0 || far == 0.0) {
		return 1000000.0;
	}
	return abs(2.0 * near - far - center);
}

// Returns how much 1/z of the pixel's own surface changes per pixel along one screen axis, or zero without a
// neighbor. `stride` steps one pixel along the axis in the tile. It uses the side whose neighbors best extend the
// center's surface (atyuwen, "Accurate Normal Reconstruction from Depth Buffer", 2020), so a floor pixel next to a foot
// takes its slope from the floor.
inverse_depth_gradient: fn (center_index: u32, stride: u32) -> f32 {
	let center: f32 = shared_inverse_depth[center_index];
	let positive: f32 = shared_inverse_depth[center_index + stride];
	let negative: f32 = shared_inverse_depth[center_index - stride];
	let positive_error: f32 = side_error(center, positive, shared_inverse_depth[center_index + 2 * stride]);
	let negative_error: f32 = side_error(center, negative, shared_inverse_depth[center_index - 2 * stride]);
	if (positive != 0.0 && (positive_error <= negative_error || negative == 0.0)) {
		return positive - center;
	}
	if (negative != 0.0) {
		return center - negative;
	}
	return 0.0;
}

// Returns the Gaussian weight of a filter tap `offset` steps along one axis, whose distance is |offset - radius|.
filter_weight: fn (offset: u32) -> f32 {
	return CONTACT_SHADOW_FILTER_WEIGHTS[max(offset, CONTACT_SHADOW_FILTER_RADIUS) - min(offset, CONTACT_SHADOW_FILTER_RADIUS)];
}

main: fn (input: StageInput) -> void {
	let pixel: vec2u = input.thread_id;
	let extent: vec2u = image_size(contact_shadow_output);
	let local: vec2u = vec2u(
		input.thread_idx % CONTACT_SHADOW_FILTER_WORKGROUP_WIDTH,
		input.thread_idx / CONTACT_SHADOW_FILTER_WORKGROUP_WIDTH
	);
	// Tile coordinate zero lies the filter radius above and left of the workgroup's first pixel.
	let tile_origin_column: f32 = f32(pixel.x - local.x) - f32(CONTACT_SHADOW_FILTER_RADIUS);
	let tile_origin_row: f32 = f32(pixel.y - local.y) - f32(CONTACT_SHADOW_FILTER_RADIUS);
	for (
		let tile_index: u32 = input.thread_idx;
		tile_index < CONTACT_SHADOW_FILTER_TILE_SIZE;
		tile_index = tile_index + CONTACT_SHADOW_FILTER_WORKGROUP_SIZE
	) {
		let column: f32 = tile_origin_column + f32(tile_index % CONTACT_SHADOW_FILTER_TILE_WIDTH);
		let row: f32 = tile_origin_row + f32(tile_index / CONTACT_SHADOW_FILTER_TILE_WIDTH);
		let inverse_depth: f32 = fetch_inverse_depth(column, row, extent);
		shared_inverse_depth[tile_index] = inverse_depth;
		// A texel outside the image, or without a surface, has zero depth and never counts as a tap, so nothing reads
		// its trace.
		if (inverse_depth != 0.0) {
			shared_trace[tile_index] = fetch(contact_shadow_trace, vec2u(u32(column), u32(row))).x;
		}
	}
	workgroup_barrier();

	guard_image_bounds(contact_shadow_output, pixel);
	let center_index: u32 = (local.y + CONTACT_SHADOW_FILTER_RADIUS) * CONTACT_SHADOW_FILTER_TILE_WIDTH
		+ local.x + CONTACT_SHADOW_FILTER_RADIUS;
	let center_inverse_z: f32 = shared_inverse_depth[center_index];
	if (center_inverse_z == 0.0) {
		write(contact_shadow_output, pixel, vec4f(1.0, 0.0, 0.0, 0.0));
		return;
	}
	// 1/z is linear across the screen on a plane, so the center's slope predicts each neighbor on its surface.
	let surface_gradient: vec2f = vec2f(
		inverse_depth_gradient(center_index, 1),
		inverse_depth_gradient(center_index, CONTACT_SHADOW_FILTER_TILE_WIDTH)
	);

	let lit: f32 = 0.0;
	let total_weight: f32 = 0.0;
	for (let tap_row: u32 = 0; tap_row < 5; tap_row = tap_row + 1) {
		for (let tap_column: u32 = 0; tap_column < 5; tap_column = tap_column + 1) {
			let offset: vec2f = vec2f(f32(tap_column), f32(tap_row)) - vec2f(2.0, 2.0);
			// The taps span the tile around the pixel: tap (0, 0) is two pixels above and left of the center.
			let tap_index: u32 = (local.y + tap_row) * CONTACT_SHADOW_FILTER_TILE_WIDTH + local.x + tap_column;
			let neighbor_inverse_z: f32 = shared_inverse_depth[tap_index];
			if (neighbor_inverse_z != 0.0) {
				let predicted_inverse_z: f32 = center_inverse_z + dot(surface_gradient, offset);
				let plane_error: f32 = abs(neighbor_inverse_z - predicted_inverse_z) / center_inverse_z;
				let weight: f32 = filter_weight(tap_column) * filter_weight(tap_row)
					* clamp(1.0 - plane_error / CONTACT_SHADOW_FILTER_PLANE_TOLERANCE, 0.0, 1.0);
				lit = lit + weight * shared_trace[tap_index];
				total_weight = total_weight + weight;
			}
		}
	}
	// The center always lies on its own plane, so the total weight is never zero.
	write(contact_shadow_output, pixel, vec4f(lit / total_weight, 0.0, 0.0, 0.0));
}
