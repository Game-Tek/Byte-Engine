// Marks half-resolution texels whose short ray toward a sun is blocked by visible geometry, one channel per shadowed
// sun slot. The directional shadow
// map cannot resolve shadows smaller than its texels, such as the one where a foot meets the floor. The result is one
// where the ray is clear and falls toward zero where it is blocked. The contact-shadow filter then smooths it into a
// full-resolution image, and material evaluation multiplies the sun's shadow by the filtered result.
// The screen view constants describe the half-resolution image, mip zero of the linear depth pyramid.
ScreenView: struct {
	pixel_to_ray_mul: vec2f,
	pixel_to_ray_add: vec2f,
	projection_pixels_y: f32,
	view_z_sign: f32,
	depth_unproject_numerator: f32,
	depth_unproject_denominator_offset: f32,
}

// Must match the sun visibility parameters in sun-visibility.besl.
ContactShadowParameters: struct {
	// Per sun slot: the view-space unit direction from a surface toward the sun in xyz. The trace ignores w.
	suns: vec4f[4],
	// The resolve's full-resolution pixel rays, which the trace does not read.
	pixel_to_ray: vec4f,
	// World-space reach of one ray. Occluders further away are left to the shadow map.
	max_distance: f32,
	// How many sun slots hold a shadowed sun.
	sun_count: u32,
}

// One ray's screen-space path. Screen position and 1/z are both linear along a projected line. The ray starts on the
// pixel's own surface, whose 1/z changes across the screen by `surface_gradient` per pixel.
ContactShadowRay: struct {
	start_pixel: vec2f,
	end_pixel: vec2f,
	surface_gradient: vec2f,
	inverse_start_z: f32,
	inverse_end_z: f32,
}

screen_view: descriptor<{ type: ScreenView, binding: 0, access: read }>;
contact_shadow_parameters: descriptor<{ type: ContactShadowParameters, binding: 1, access: read }>;
// Mip zero holds positive linear depth at the trace resolution.
depth_pyramid: descriptor<{ type: Texture2D, binding: 1033, access: read }>;
contact_shadow_output: descriptor<{ type: StorageImage<rgba8>, binding: 1034, access: write }>;

CONTACT_SHADOW_STEP_COUNT: const u32 = 16;
// Screen-space reach in half-resolution texels. It bounds the march cost for texels close to the camera.
CONTACT_SHADOW_MAX_SCREEN_DISTANCE: const f32 = 32.0;
// A ray is blocked only while it is less than this far behind the depth buffer. The depth buffer stores only front
// faces, so without a thickness every ray that passes behind a thin object would count as blocked.
CONTACT_SHADOW_THICKNESS_BASE: const f32 = 0.05;
CONTACT_SHADOW_THICKNESS_SCALE: const f32 = 0.02;
// A ray must be at least this far behind the depth buffer, relative to the pixel's depth, to count as blocked. It
// absorbs floating-point error.
CONTACT_SHADOW_BIAS_SCALE: const f32 = 0.002;
// A depth sample within this relative distance of the pixel's own surface plane belongs to that surface.
CONTACT_SHADOW_PLANE_TOLERANCE: const f32 = 0.005;
// Bisection steps that locate where a ray crossed behind the depth buffer between two march steps.
CONTACT_SHADOW_REFINEMENT_STEPS: const u32 = 4;
// Occluders that the ray reaches past this fraction of its length cast a weaker shadow, down to none at its end, so a
// contact shadow ends in a ramp instead of a line at the ray's reach.
CONTACT_SHADOW_FADE_START: const f32 = 0.5;

// Interleaved gradient noise (Jimenez 2014). Each 3x3 pixel block covers [0, 1) evenly, so the filter pass averages
// the dithered march into a smooth result. It stays fixed over time: without temporal accumulation, animated noise
// would flicker.
interleaved_gradient_noise: fn (pixel: vec2f) -> f32 {
	return fract(52.9829189 * fract(0.06711056 * pixel.x + 0.00583715 * pixel.y));
}

// Returns the positive linear view depth of a texel, or zero where no surface was drawn or outside the image.
fetch_linear_depth: fn (column: f32, row: f32, extent: vec2u) -> f32 {
	if (column < 0.0 || row < 0.0 || column >= f32(extent.x) || row >= f32(extent.y)) {
		return 0.0;
	}
	return fetch(depth_pyramid, vec2u(u32(column), u32(row))).x;
}

// Returns the view-space position at continuous texel coordinates, where integers are texel centers.
view_position: fn (pixel: vec2f, z: f32) -> vec3f {
	let ray: vec2f = pixel * screen_view.pixel_to_ray_mul + screen_view.pixel_to_ray_add;
	return vec3f(ray.x * z, ray.y * z, z);
}

// Projects a view-space position to continuous texel coordinates, where integers are texel centers.
project_to_pixel: fn (position: vec3f) -> vec2f {
	let ray: vec2f = vec2f(position.x / position.z, position.y / position.z);
	return (ray - screen_view.pixel_to_ray_add) / screen_view.pixel_to_ray_mul;
}

ray_pixel: fn (ray: ContactShadowRay, fraction: f32) -> vec2f {
	return mix(ray.start_pixel, ray.end_pixel, fraction);
}

// Returns how far behind the depth buffer the ray is at `fraction` of its screen path. Negative is in front.
// Background holds nothing to block the ray, so the ray is in front of it.
//
// A plane cannot shadow itself, so depth samples on the texel's own surface never block the ray. Rays sample depth at
// texel centers, off the ray's own screen position, and on a surface seen at a grazing angle that offset alone would
// put the surface several centimeters in front of a ray leaving it.
ray_penetration: fn (ray: ContactShadowRay, fraction: f32, extent: vec2u) -> f32 {
	let texel: vec2f = round(ray_pixel(ray, fraction));
	let scene_z: f32 = fetch_linear_depth(texel.x, texel.y, extent);
	if (scene_z == 0.0) {
		return 0.0 - 1.0;
	}
	let surface_inverse_z: f32 = ray.inverse_start_z + dot(ray.surface_gradient, texel - ray.start_pixel);
	if (abs(1.0 / scene_z - surface_inverse_z) <= CONTACT_SHADOW_PLANE_TOLERANCE * surface_inverse_z) {
		return 0.0 - 1.0;
	}
	// Screen-space interpolation is linear in 1/z, which keeps the ray depth perspective-correct.
	return 1.0 / mix(ray.inverse_start_z, ray.inverse_end_z, fraction) - scene_z;
}

// Returns the error of predicting the center depth by extending the line through two neighbors on one side, in 1/z.
// 1/z is linear across the screen on a plane, so a side on the center's own surface predicts it exactly.
side_error: fn (center_z: f32, near_z: f32, far_z: f32) -> f32 {
	if (near_z == 0.0 || far_z == 0.0) {
		return 1000000.0;
	}
	return abs(2.0 / near_z - 1.0 / far_z - 1.0 / center_z);
}

// Returns how much 1/z of the texel's own surface changes per texel along one screen axis, or zero without a
// neighbor. It uses the side whose neighbors best extend the center's surface (atyuwen, "Accurate Normal
// Reconstruction from Depth Buffer", 2020), so a floor texel next to a foot takes its slope from the floor.
inverse_depth_gradient: fn (column: f32, row: f32, axis: vec2f, center_z: f32, extent: vec2u) -> f32 {
	let positive_z: f32 = fetch_linear_depth(column + axis.x, row + axis.y, extent);
	let negative_z: f32 = fetch_linear_depth(column - axis.x, row - axis.y, extent);
	let positive_error: f32 = side_error(
		center_z,
		positive_z,
		fetch_linear_depth(column + 2.0 * axis.x, row + 2.0 * axis.y, extent)
	);
	let negative_error: f32 = side_error(
		center_z,
		negative_z,
		fetch_linear_depth(column - 2.0 * axis.x, row - 2.0 * axis.y, extent)
	);
	if (positive_z != 0.0 && (positive_error <= negative_error || negative_z == 0.0)) {
		return 1.0 / positive_z - 1.0 / center_z;
	}
	if (negative_z != 0.0) {
		return 1.0 / center_z - 1.0 / negative_z;
	}
	return 0.0;
}

// Returns how much of a texel's ray toward the sun along view-space `direction` stays clear: one where nothing blocks
// it, falling toward zero where visible geometry does. `surface_gradient` is the texel's 1/z change per texel.
trace_contact_shadow: fn (
	pixel_f: vec2f,
	center_z: f32,
	surface_gradient: vec2f,
	direction: vec3f,
	extent: vec2u
) -> f32 {
	let origin: vec3f = view_position(pixel_f, center_z);
	let ray_length: f32 = contact_shadow_parameters.max_distance;
	// Stop rays in front of the camera plane so every step keeps a positive depth.
	let minimum_z: f32 = center_z * 0.05;
	if (origin.z + direction.z * ray_length < minimum_z) {
		ray_length = (minimum_z - origin.z) / direction.z;
	}
	let end: vec3f = origin + direction * ray_length;
	let end_pixel: vec2f = project_to_pixel(end);
	let inverse_end_z: f32 = 1.0 / end.z;
	let screen_length: f32 = length(end_pixel - pixel_f);
	// Shorten long rays on screen. Screen position and 1/z are both linear along the projected ray, so cutting both
	// at the same fraction keeps the ray on its line.
	if (screen_length > CONTACT_SHADOW_MAX_SCREEN_DISTANCE) {
		let kept_fraction: f32 = CONTACT_SHADOW_MAX_SCREEN_DISTANCE / screen_length;
		end_pixel = mix(pixel_f, end_pixel, kept_fraction);
		inverse_end_z = mix(1.0 / center_z, inverse_end_z, kept_fraction);
	}
	let ray: ContactShadowRay = ContactShadowRay(pixel_f, end_pixel, surface_gradient, 1.0 / center_z, inverse_end_z);
	let bias: f32 = CONTACT_SHADOW_BIAS_SCALE * center_z;
	let jitter: f32 = interleaved_gradient_noise(pixel_f);
	// The ray starts on the front side of its own surface.
	let previous_fraction: f32 = 0.0;
	let previous_in_front: bool = true;

	for (let step: u32 = 0; step < CONTACT_SHADOW_STEP_COUNT; step = step + 1) {
		let fraction: f32 = (f32(step) + jitter) / f32(CONTACT_SHADOW_STEP_COUNT);
		let sample_pixel: vec2f = ray_pixel(ray, fraction);
		if (sample_pixel.x < 0.0 - 0.5 || sample_pixel.y < 0.0 - 0.5 || sample_pixel.x >= f32(extent.x) - 0.5 || sample_pixel.y >= f32(extent.y) - 0.5) {
			break;
		}
		if (ray_penetration(ray, fraction, extent) <= bias) {
			previous_fraction = fraction;
			previous_in_front = true;
			continue;
		}
		// A ray that is still behind the same surface it went behind at an earlier step crosses nothing new.
		if (previous_in_front == false) {
			continue;
		}
		previous_in_front = false;

		// The ray went behind the depth buffer since the last step. One step can go far behind a surface seen at a
		// grazing angle, so bisect for where it crossed, then check that it crossed within the surface's thickness
		// instead of passing behind a thin object.
		let front: f32 = previous_fraction;
		let behind: f32 = fraction;
		for (let refinement: u32 = 0; refinement < CONTACT_SHADOW_REFINEMENT_STEPS; refinement = refinement + 1) {
			let middle: f32 = 0.5 * (front + behind);
			if (ray_penetration(ray, middle, extent) > bias) {
				behind = middle;
			} else {
				front = middle;
			}
		}
		let crossing_z: f32 = 1.0 / mix(ray.inverse_start_z, ray.inverse_end_z, behind);
		let thickness: f32 = CONTACT_SHADOW_THICKNESS_BASE + CONTACT_SHADOW_THICKNESS_SCALE * crossing_z;
		let penetration: f32 = ray_penetration(ray, behind, extent);
		if (penetration < thickness) {
			// A crossing near the thickness limit may be a ray passing behind a thin object, so it counts less.
			let strength: f32 = (1.0 - smoothstep(CONTACT_SHADOW_FADE_START, 1.0, behind))
				* (1.0 - smoothstep(0.5 * thickness, thickness, penetration));
			return 1.0 - strength;
		}
	}
	return 1.0;
}

// Returns the view-space unit direction from a surface toward the sun in slot `sun`.
sun_direction: fn (sun: u32) -> vec3f {
	let direction: vec4f = contact_shadow_parameters.suns[sun];
	return vec3f(direction.x, direction.y, direction.z);
}

main: fn (input: StageInput) -> void {
	let pixel: vec2u = input.thread_id;
	guard_image_bounds(contact_shadow_output, pixel);
	let extent: vec2u = image_size(contact_shadow_output);
	let column: f32 = f32(pixel.x);
	let row: f32 = f32(pixel.y);
	let center_z: f32 = fetch_linear_depth(column, row, extent);
	if (center_z == 0.0) {
		write(contact_shadow_output, pixel, vec4f(1.0, 1.0, 1.0, 1.0));
		return;
	}

	let pixel_f: vec2f = vec2f(column, row);
	let surface_gradient: vec2f = vec2f(
		inverse_depth_gradient(column, row, vec2f(1.0, 0.0), center_z, extent),
		inverse_depth_gradient(column, row, vec2f(0.0, 1.0), center_z, extent)
	);
	// Each sun's ray in its channel. Unused slots stay clear.
	let sun_count: u32 = contact_shadow_parameters.sun_count;
	let visibility: vec4f = vec4f(1.0, 1.0, 1.0, 1.0);
	visibility.x = trace_contact_shadow(pixel_f, center_z, surface_gradient, sun_direction(0), extent);
	if (sun_count > 1) {
		visibility.y = trace_contact_shadow(pixel_f, center_z, surface_gradient, sun_direction(1), extent);
		if (sun_count > 2) {
			visibility.z = trace_contact_shadow(pixel_f, center_z, surface_gradient, sun_direction(2), extent);
			if (sun_count > 3) {
				visibility.w = trace_contact_shadow(pixel_f, center_z, surface_gradient, sun_direction(3), extent);
			}
		}
	}
	write(contact_shadow_output, pixel, visibility);
}
