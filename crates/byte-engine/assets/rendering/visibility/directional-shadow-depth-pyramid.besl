// Build the 4x4 conservative max-depth level for every directional cascade in one dispatch.
// One SIMD group processes two adjacent 8x8 source tiles so all 32 lanes remain useful.
source_depth: descriptor<Texture2DArray, 1033, read>;
reduced_depth_1: descriptor<StorageImage<r32f>, 1034, write>;

shared_depth: workgroup<f32, 32>;

DIRECTIONAL_SHADOW_PYRAMID_WORKGROUP_WIDTH: const u32 = 8;
DIRECTIONAL_SHADOW_PYRAMID_WORKGROUP_HEIGHT: const u32 = 4;
DIRECTIONAL_SHADOW_LEVEL_1_TILE_WIDTH: const u32 = 4;

main: fn () -> void {
	let source_quad_coordinate: vec2u = thread_id();
	let lane: u32 = thread_idx();
	let source_extent: vec2u = texture_size(source_depth);
	let source_quad_cascade_height: u32 = source_extent.y / 2;
	let shadow_layer: u32 = source_quad_coordinate.y / source_quad_cascade_height;
	let workgroup_origin: vec2u = vec2u(
		source_quad_coordinate.x - source_quad_coordinate.x % DIRECTIONAL_SHADOW_PYRAMID_WORKGROUP_WIDTH,
		source_quad_coordinate.y - source_quad_coordinate.y % DIRECTIONAL_SHADOW_PYRAMID_WORKGROUP_HEIGHT
	);
	let cascade_source_quad_coordinate: vec2u = vec2u(
		source_quad_coordinate.x,
		source_quad_coordinate.y - shadow_layer * source_quad_cascade_height
	);

	// One gather or native maximum-reduction sample replaces four scalar source reads.
	let source_center_coordinate: vec2u = cascade_source_quad_coordinate * vec2u(2, 2) + vec2u(1, 1);
	let source_uv: vec2f = vec2f(f32(source_center_coordinate.x), f32(source_center_coordinate.y))
		/ vec2f(f32(source_extent.x), f32(source_extent.y));
	shared_depth[lane] = downsample_max(source_depth, source_uv, shadow_layer, 0.0);
	workgroup_barrier();

	// Lanes 0-3 reduce the left tile and lanes 4-7 reduce the right tile into 4x4 cells.
	if (lane < 8) {
		let tile: u32 = lane / 4;
		let tile_lane: u32 = lane % 4;
		let level_coordinate: vec2u = vec2u(tile_lane % 2, tile_lane / 2);
		let source_x: u32 = tile * DIRECTIONAL_SHADOW_LEVEL_1_TILE_WIDTH + level_coordinate.x * 2;
		let source_y: u32 = level_coordinate.y * 2;
		let source_index: u32 = source_y * DIRECTIONAL_SHADOW_PYRAMID_WORKGROUP_WIDTH + source_x;
		let maximum_depth: f32 = max(
			max(shared_depth[source_index], shared_depth[source_index + 1]),
			max(
				shared_depth[source_index + DIRECTIONAL_SHADOW_PYRAMID_WORKGROUP_WIDTH],
				shared_depth[source_index + DIRECTIONAL_SHADOW_PYRAMID_WORKGROUP_WIDTH + 1]
			)
		);
		shared_depth[lane] = maximum_depth;

		let output_coordinate: vec2u = workgroup_origin / vec2u(2, 2)
			+ vec2u(tile * 2 + level_coordinate.x, level_coordinate.y);
		write(reduced_depth_1, output_coordinate, vec4f(maximum_depth, 0.0, 0.0, 1.0));
	}
}
