linear_depth: descriptor<{ type: Texture2D, binding: 1033, access: read }>;
ao_source: descriptor<{ type: Texture2D, binding: 1034, access: read }>;
ao_output: descriptor<{ type: StorageImage<r8>, binding: 1035, access: write }>;

shared_linear_depth: workgroup<f32, 120>;
shared_ao: workgroup<f32, 96>;

GTAO_BLUR_WORKGROUP_WIDTH: const u32 = 8;
GTAO_BLUR_WORKGROUP_HEIGHT: const u32 = 8;
GTAO_BLUR_WORKGROUP_SIZE: const u32 = 64;
GTAO_BLUR_RADIUS: const u32 = 2;
GTAO_BLUR_DEPTH_TILE_WIDTH: const u32 = 12;
GTAO_BLUR_DEPTH_TILE_SIZE: const u32 = 120;
GTAO_BLUR_AO_TILE_WIDTH: const u32 = 12;
GTAO_BLUR_AO_TILE_SIZE: const u32 = 96;
GTAO_BLUR_DEPTH_HALO_X: const u32 = 2;
GTAO_BLUR_DEPTH_HALO_Y: const u32 = 1;
GTAO_BLUR_AO_HALO_X: const u32 = 2;
GTAO_BLUR_SPATIAL_WEIGHTS: const f32[3] = f32[3](0.4026199469, 0.2442013420, 0.0544886845);
GTAO_BLUR_BASE_RELATIVE_SIGMA: const f32 = 0.03;
GTAO_BLUR_MIN_RELATIVE_SIGMA: const f32 = 0.004;
GTAO_BLUR_SIGMA_VARIANCE_SCALE: const f32 = 32.0;
GTAO_BLUR_VARIANCE_BLEND_SCALE: const f32 = 96.0;

relative_depth_delta: fn (center_linear_depth: f32, sample_linear_depth: f32) -> f32 {
	return (sample_linear_depth - center_linear_depth) / max(center_linear_depth, 0.0001);
}

// Returns `origin + tile_coordinate - halo` clamped to the image, for a tile texel `tile_coordinate` steps along one axis
// from the halo's first texel. Offsets are unsigned, so the lower clamp happens before subtracting the halo.
tiled_source_coordinate: fn (origin: u32, tile_coordinate: u32, halo: u32, extent: u32) -> u32 {
	return min(max(origin + tile_coordinate, halo) - halo, extent - 1);
}

// Returns the variance of the relative depth differences between the center and the nonzero texels of its 3x3
// neighborhood, or zero with fewer than two of them. `center_index` is the center's index in the depth tile.
compute_local_depth_variance: fn (center_index: u32, center_linear_depth: f32) -> f32 {
	let mean: f32 = 0.0;
	let mean_sq: f32 = 0.0;
	// The nonzero center always counts, with a zero delta that leaves both sums unchanged, so the loop skips it.
	let sample_count: f32 = 1.0;
	// The neighborhood starts one row above and one texel left of the center.
	let first_index: u32 = center_index - GTAO_BLUR_DEPTH_TILE_WIDTH - 1;
	for (let y: u32 = 0; y < 3; y = y + 1) {
		for (let x: u32 = 0; x < 3; x = x + 1) {
			if (x == 1 && y == 1) {
				continue;
			}
			let sample_linear_depth: f32 = shared_linear_depth[first_index + y * GTAO_BLUR_DEPTH_TILE_WIDTH + x];
			if (sample_linear_depth != 0.0) {
				let delta: f32 = relative_depth_delta(center_linear_depth, sample_linear_depth);
				mean = mean + delta;
				mean_sq = mean_sq + delta * delta;
				sample_count = sample_count + 1.0;
			}
		}
	}

	if (sample_count <= 1.0) {
		return 0.0;
	}

	let normalized_mean: f32 = mean / sample_count;
	return max(mean_sq / sample_count - normalized_mean * normalized_mean, 0.0);
}

main: fn (input: StageInput) -> void {
	let coord: vec2u = input.thread_id;
	let extent: vec2u = image_size(ao_output);
	let workgroup_origin: vec2u = coord - coord % vec2u(GTAO_BLUR_WORKGROUP_WIDTH, GTAO_BLUR_WORKGROUP_HEIGHT);
	let lane: u32 = input.thread_idx;

	// The depth pyramid already stores positive linear depth at the same
	// half-resolution extent as the raw AO input.
	for (let index: u32 = lane; index < GTAO_BLUR_DEPTH_TILE_SIZE; index = index + GTAO_BLUR_WORKGROUP_SIZE) {
		let source_coordinate: vec2u = vec2u(
			tiled_source_coordinate(workgroup_origin.x, index % GTAO_BLUR_DEPTH_TILE_WIDTH, GTAO_BLUR_DEPTH_HALO_X, extent.x),
			tiled_source_coordinate(workgroup_origin.y, index / GTAO_BLUR_DEPTH_TILE_WIDTH, GTAO_BLUR_DEPTH_HALO_Y, extent.y)
		);
		shared_linear_depth[index] = fetch(linear_depth, source_coordinate).x;
	}
	for (let index: u32 = lane; index < GTAO_BLUR_AO_TILE_SIZE; index = index + GTAO_BLUR_WORKGROUP_SIZE) {
		let source_coordinate: vec2u = vec2u(
			tiled_source_coordinate(workgroup_origin.x, index % GTAO_BLUR_AO_TILE_WIDTH, GTAO_BLUR_AO_HALO_X, extent.x),
			tiled_source_coordinate(workgroup_origin.y, index / GTAO_BLUR_AO_TILE_WIDTH, 0, extent.y)
		);
		shared_ao[index] = fetch(ao_source, source_coordinate).x;
	}
	workgroup_barrier();

	// Partial edge workgroups must synchronize before their out-of-bounds lanes return.
	guard_image_bounds(ao_output, coord);
	let local: vec2u = coord - workgroup_origin;
	let depth_index: u32 = (local.y + GTAO_BLUR_DEPTH_HALO_Y) * GTAO_BLUR_DEPTH_TILE_WIDTH + local.x + GTAO_BLUR_DEPTH_HALO_X;
	let ao_index: u32 = local.y * GTAO_BLUR_AO_TILE_WIDTH + local.x + GTAO_BLUR_AO_HALO_X;

	let center_linear_depth: f32 = shared_linear_depth[depth_index];
	if (center_linear_depth == 0.0) {
		write(ao_output, coord, vec4f(1.0, 1.0, 1.0, 1.0));
		return;
	}

	let center_ao: f32 = shared_ao[ao_index];
	let local_depth_stddev: f32 = sqrt(compute_local_depth_variance(depth_index, center_linear_depth));
	let blur_mix: f32 = 1.0 / (1.0 + local_depth_stddev * GTAO_BLUR_VARIANCE_BLEND_SCALE);
	// Reuse the pixel-invariant bilateral scale across every depth tap.
	let sigma_scale: f32 = 1.0 + local_depth_stddev * GTAO_BLUR_SIGMA_VARIANCE_SCALE;
	let sigma: f32 = max(GTAO_BLUR_MIN_RELATIVE_SIGMA, GTAO_BLUR_BASE_RELATIVE_SIGMA / sigma_scale);
	let inverse_depth_variance_scale: f32 = 1.0 / max(2.0 * sigma * sigma, 0.000001);

	let filtered_ao: f32 = center_ao * GTAO_BLUR_SPATIAL_WEIGHTS[0];
	let total_weight: f32 = GTAO_BLUR_SPATIAL_WEIGHTS[0];

	for (let offset: u32 = 1; offset <= GTAO_BLUR_RADIUS; offset = offset + 1) {
		let spatial_weight: f32 = GTAO_BLUR_SPATIAL_WEIGHTS[offset];
		// The first side reads the tap `offset` texels to the right of the center, and the second the tap to its left.
		for (let side: u32 = 0; side < 2; side = side + 1) {
			let sample_linear_depth: f32 = shared_linear_depth[depth_index + offset - 2 * offset * side];
			if (sample_linear_depth != 0.0) {
				let difference: f32 = abs(relative_depth_delta(center_linear_depth, sample_linear_depth));
				let weight: f32 = spatial_weight * exp(0.0 - difference * difference * inverse_depth_variance_scale);
				filtered_ao = filtered_ao + shared_ao[ao_index + offset - 2 * offset * side] * weight;
				total_weight = total_weight + weight;
			}
		}
	}

	let blurred_ao: f32 = filtered_ao / max(total_weight, 0.00001);
	let final_ao: f32 = mix(center_ao, blurred_ao, blur_mix);
	write(ao_output, coord, vec4f(final_ao, 0.0, 0.0, 1.0));
}
