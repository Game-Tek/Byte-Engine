source_depth: descriptor<Texture2D, 1033, read>;
reduced_depth: descriptor<StorageImage<r32f>, 1034, write>;

clamp_source_coordinate: fn (coordinate: vec2u, extent: vec2u) -> vec2u {
	let clamped_x: u32 = coordinate.x;
	let clamped_y: u32 = coordinate.y;
	if (clamped_x >= extent.x) {
		clamped_x = extent.x - 1;
	}
	if (clamped_y >= extent.y) {
		clamped_y = extent.y - 1;
	}
	return vec2u(clamped_x, clamped_y);
}

main: fn () -> void {
	let coord: vec2u = thread_id();
	guard_image_bounds(reduced_depth, coord);
	let source_extent: vec2u = texture_size(source_depth);
	let source_coord: vec2u = coord * vec2u(2, 2);
	let top_left: f32 = fetch(source_depth, clamp_source_coordinate(source_coord, source_extent)).x;
	let top_right: f32 = fetch(
		source_depth,
		clamp_source_coordinate(source_coord + vec2u(1, 0), source_extent)
	).x;
	let bottom_left: f32 = fetch(
		source_depth,
		clamp_source_coordinate(source_coord + vec2u(0, 1), source_extent)
	).x;
	let bottom_right: f32 = fetch(
		source_depth,
		clamp_source_coordinate(source_coord + vec2u(1, 1), source_extent)
	).x;
	// Visibility uses reversed depth with zero as the background, so max keeps the nearest conservative sample.
	let maximum_depth: f32 = max(max(top_left, top_right), max(bottom_left, bottom_right));
	write(reduced_depth, coord, vec4f(maximum_depth, 0.0, 0.0, 1.0));
}
