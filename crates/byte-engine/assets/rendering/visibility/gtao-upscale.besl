// The final GTAO stage reconstructs full-resolution AO while completing the
// vertical denoise. Horizontal interpolation adds the smoothing that would
// otherwise require a separate upscale pass.
FastGTAOView: struct {
	pixel_to_ray_mul: vec2f,
	pixel_to_ray_add: vec2f,
	projection_pixels_y: f32,
	view_z_sign: f32,
	depth_unproject_numerator: f32,
	depth_unproject_denominator_offset: f32,
}

gtao_view: descriptor<{ type: FastGTAOView, binding: 0, access: read, memory: constant }>;
visibility_depth: descriptor<{ type: Texture2D, binding: 1033, access: read }>;
ao_source: descriptor<{ type: Texture2D, binding: 1034, access: read }>;
ao_output: descriptor<{ type: StorageImage<r8>, binding: 1035, access: write }>;
low_resolution_depth: descriptor<{ type: Texture2D, binding: 1036, access: read }>;

shared_linear_depth: workgroup<f32, 60>;
shared_ao: workgroup<f32, 60>;

GTAO_UPSCALE_WORKGROUP_WIDTH: const u32 = 8;
GTAO_UPSCALE_WORKGROUP_HEIGHT: const u32 = 8;
GTAO_UPSCALE_WORKGROUP_SIZE: const u32 = 64;
GTAO_UPSCALE_TILE_WIDTH: const u32 = 6;
GTAO_UPSCALE_TILE_SIZE: const u32 = 60;
GTAO_UPSCALE_HALO_X: const u32 = 1;
GTAO_UPSCALE_HALO_Y: const u32 = 3;
// Convolving a radius-two Gaussian with the two subpixel phases produces six
// source rows. The odd output phase uses these weights in reverse order.
GTAO_UPSCALE_EVEN_VERTICAL_WEIGHTS: const f32[6] = f32[6](
	0.0136221711,
	0.1019168489,
	0.2838059932,
	0.3630152957,
	0.1967731776,
	0.0408665134
);
// Horizontal interpolation weights, indexed by the output phase plus the tap index. The even phase weights the left tap
// by 0.25 and the right tap by 0.75, and the odd phase the reverse.
GTAO_UPSCALE_HORIZONTAL_WEIGHTS: const f32[3] = f32[3](0.25, 0.75, 0.25);
// A 2% relative-depth sigma gives a Gaussian inverse variance of 1,250.
GTAO_UPSCALE_INVERSE_DEPTH_VARIANCE: const f32 = 1250.0;

linearize_depth: fn (depth: f32) -> f32 {
	if (depth == 0.0) {
		return 0.0;
	}
	return gtao_view.depth_unproject_numerator / (depth + gtao_view.depth_unproject_denominator_offset);
}

// Maps one shared-tile coordinate to its clamped low-resolution texture texel. The upper clamp holds only while `origin`
// lies inside the image: past it, `extent - 1 - origin` wraps and the coordinate passes through unclamped.
tiled_source_coordinate: fn (origin: u32, tile_coordinate: u32, halo: u32, extent: u32) -> u32 {
	if (tile_coordinate < halo) {
		return origin - min(origin, halo - tile_coordinate);
	}
	return origin + min(tile_coordinate - halo, extent - 1 - origin);
}

main: fn (input: StageInput) -> void {
	let coordinate: vec2u = input.thread_id;
	let source_extent: vec2u = texture_size(ao_source);
	let workgroup_origin: vec2u = coordinate - coordinate % vec2u(GTAO_UPSCALE_WORKGROUP_WIDTH, GTAO_UPSCALE_WORKGROUP_HEIGHT);
	let source_origin: vec2u = workgroup_origin / vec2u(2, 2);
	let lane: u32 = input.thread_idx;

	// One 8x8 output group touches only a 6x10 low-resolution footprint.
	// Load both inputs once, then reuse them across every reconstruction tap.
	for (let index: u32 = lane; index < GTAO_UPSCALE_TILE_SIZE; index = index + GTAO_UPSCALE_WORKGROUP_SIZE) {
		let source_coordinate: vec2u = vec2u(
			tiled_source_coordinate(source_origin.x, index % GTAO_UPSCALE_TILE_WIDTH, GTAO_UPSCALE_HALO_X, source_extent.x),
			tiled_source_coordinate(source_origin.y, index / GTAO_UPSCALE_TILE_WIDTH, GTAO_UPSCALE_HALO_Y, source_extent.y)
		);
		// The AO source has the same extent as mip zero of the depth pyramid.
		shared_linear_depth[index] = fetch(low_resolution_depth, source_coordinate).x;
		shared_ao[index] = fetch(ao_source, source_coordinate).x;
	}
	workgroup_barrier();

	// Partial edge workgroups must participate in the cooperative load before returning.
	guard_image_bounds(ao_output, coordinate);
	let device_depth: f32 = fetch(visibility_depth, coordinate).x;
	let center_linear_depth: f32 = linearize_depth(device_depth);
	if (center_linear_depth == 0.0) {
		write(ao_output, coordinate, vec4f(1.0, 0.0, 0.0, 1.0));
		return;
	}

	let local_coordinate: vec2u = coordinate - workgroup_origin;
	let base: vec2u = local_coordinate / vec2u(2, 2) + vec2u(GTAO_UPSCALE_HALO_X, GTAO_UPSCALE_HALO_Y);
	let parity: vec2u = coordinate % vec2u(2, 2);
	let filtered_ao: f32 = 0.0;
	let total_weight: f32 = 0.0;

	// Each tap participates in both vertical denoising and depth-aware
	// reconstruction, so the upscale does not require a separate blur pass.
	for (let y_index: u32 = 0; y_index < 6; y_index = y_index + 1) {
		// The six rows start three rows above the base row in the even output phase and two rows above it in the odd one.
		let row_index: u32 = (base.y + parity.y + y_index - 3) * GTAO_UPSCALE_TILE_WIDTH;
		let y_weight: f32 = GTAO_UPSCALE_EVEN_VERTICAL_WEIGHTS[y_index];
		if (parity.y == 1) {
			y_weight = GTAO_UPSCALE_EVEN_VERTICAL_WEIGHTS[5 - y_index];
		}

		for (let x_index: u32 = 0; x_index < 2; x_index = x_index + 1) {
			// The two taps start one column left of the base column in the even phase and at it in the odd one.
			let tap_index: u32 = row_index + base.x + parity.x + x_index - 1;
			let sample_linear_depth: f32 = shared_linear_depth[tap_index];
			if (sample_linear_depth == 0.0) {
				continue;
			}

			let depth_delta: f32 = (sample_linear_depth - center_linear_depth) / max(center_linear_depth, 0.0001);
			let depth_weight: f32 = exp(0.0 - depth_delta * depth_delta * GTAO_UPSCALE_INVERSE_DEPTH_VARIANCE);
			let sample_weight: f32 = y_weight * GTAO_UPSCALE_HORIZONTAL_WEIGHTS[parity.x + x_index] * depth_weight;
			filtered_ao = filtered_ao + shared_ao[tap_index] * sample_weight;
			total_weight = total_weight + sample_weight;
		}
	}

	// A neutral fallback avoids dark halos when a thin full-resolution surface
	// has no matching representative in the conservative half-resolution depth.
	let final_ao: f32 = 1.0;
	if (total_weight > 0.00001) {
		final_ao = filtered_ao / total_weight;
	}
	write(ao_output, coordinate, vec4f(final_ao, 0.0, 0.0, 1.0));
}
