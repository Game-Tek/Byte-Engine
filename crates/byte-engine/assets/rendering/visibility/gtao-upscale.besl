// The final GTAO stage reconstructs full-resolution AO while completing the
// vertical denoise. Horizontal interpolation adds the smoothing that would
// otherwise require a separate upscale pass.
//
// Each thread writes one 2x2 output quad. The quad's four pixels share one half-resolution base texel, so together they
// read a 3x7 footprint, which eight gathers per source cover without shared memory or a barrier.

use ::byte_engine::rendering::visibility::layouts::screen_view::*;
use ::byte_engine::rendering::visibility::layouts::gtao_view::*;
use ::byte_engine::rendering::visibility::layouts::gtao_upscale::*;

// The filtered occlusion and total weight of the quad's four pixels, ordered left to right and then top to bottom.
QuadSums: struct {
	ao: vec4f,
	weight: vec4f,
}

// Convolving a radius-two Gaussian with the two subpixel phases produces six
// source rows. The odd output phase uses these weights in reverse order.
GTAO_UPSCALE_EVEN_VERTICAL_WEIGHTS: const f32[6] = f32[6](
	0.0136221711,
	0.1019168489,
	0.2838059932,
	0.3630152957,
	0.1967731776,
	0.0408665134
);
// Horizontal interpolation weights. The even phase weights the left tap by 0.25 and the right tap by 0.75, and the odd
// phase the reverse.
GTAO_UPSCALE_NEAR_WEIGHT: const f32 = 0.75;
GTAO_UPSCALE_FAR_WEIGHT: const f32 = 0.25;
// A 2% relative-depth sigma gives a Gaussian inverse variance of 1,250.
GTAO_UPSCALE_INVERSE_DEPTH_VARIANCE: const f32 = 1250.0;
// The footprint's rows run from three rows above the base row to three below it.
GTAO_UPSCALE_FOOTPRINT_ROWS: const u32 = 7;

// Returns one tap's weight: its spatial weight times its depth similarity to the center, or zero for background.
tap_weight: fn (sample_linear_depth: f32, center_linear_depth: f32, spatial_weight: f32) -> f32 {
	if (sample_linear_depth == 0.0) {
		return 0.0;
	}
	let depth_delta: f32 = (sample_linear_depth - center_linear_depth) / max(center_linear_depth, 0.0001);
	let depth_weight: f32 = exp(0.0 - depth_delta * depth_delta * GTAO_UPSCALE_INVERSE_DEPTH_VARIANCE);
	return spatial_weight * depth_weight;
}

// Adds one footprint row to the quad's top pixels, or to its bottom ones when `odd` is true. `depths` and `aos` hold
// the row's three columns, and the left pixel reads the first two while the right pixel reads the last two.
accumulate_row: fn (sums: QuadSums, odd: bool, row_weight: f32, depths: vec3f, aos: vec3f, centers: vec4f) -> QuadSums {
	let left_center: f32 = centers.x;
	let right_center: f32 = centers.y;
	if (odd) {
		left_center = centers.z;
		right_center = centers.w;
	}
	let left_far: f32 = tap_weight(depths.x, left_center, row_weight * GTAO_UPSCALE_FAR_WEIGHT);
	let left_near: f32 = tap_weight(depths.y, left_center, row_weight * GTAO_UPSCALE_NEAR_WEIGHT);
	let right_near: f32 = tap_weight(depths.y, right_center, row_weight * GTAO_UPSCALE_NEAR_WEIGHT);
	let right_far: f32 = tap_weight(depths.z, right_center, row_weight * GTAO_UPSCALE_FAR_WEIGHT);
	// Each pixel adds its left tap before its right one.
	if (odd) {
		return QuadSums(
			vec4f(sums.ao.x, sums.ao.y, sums.ao.z + aos.x * left_far + aos.y * left_near, sums.ao.w + aos.y * right_near + aos.z * right_far),
			vec4f(sums.weight.x, sums.weight.y, sums.weight.z + left_far + left_near, sums.weight.w + right_near + right_far)
		);
	}
	return QuadSums(
		vec4f(sums.ao.x + aos.x * left_far + aos.y * left_near, sums.ao.y + aos.y * right_near + aos.z * right_far, sums.ao.z, sums.ao.w),
		vec4f(sums.weight.x + left_far + left_near, sums.weight.y + right_near + right_far, sums.weight.z, sums.weight.w)
	);
}

// Adds footprint row `row` to every quad pixel whose six rows include it. The top pixels read rows zero through five
// and the bottom ones rows one through six, with the vertical weights reversed.
accumulate_footprint_row: fn (sums: QuadSums, row: u32, depths: vec3f, aos: vec3f, centers: vec4f) -> QuadSums {
	let result: QuadSums = sums;
	if (row < 6) {
		result = accumulate_row(result, false, GTAO_UPSCALE_EVEN_VERTICAL_WEIGHTS[row], depths, aos, centers);
	}
	if (row > 0) {
		result = accumulate_row(result, true, GTAO_UPSCALE_EVEN_VERTICAL_WEIGHTS[6 - row], depths, aos, centers);
	}
	return result;
}

// Writes one output pixel of the quad, unless it lies past the image. A pixel without a surface keeps full visibility,
// and so does one whose taps all were background: a neutral fallback avoids dark halos when a thin full-resolution
// surface has no matching representative in the conservative half-resolution depth.
write_output: fn (gtao_upscale: GtaoUpscale, coordinate: vec2u, extent: vec2u, center: f32, filtered_ao: f32, total_weight: f32) -> void {
	if (coordinate.x >= extent.x || coordinate.y >= extent.y) {
		return;
	}
	let final_ao: f32 = 1.0;
	if (center != 0.0 && total_weight > 0.00001) {
		final_ao = filtered_ao / total_weight;
	}
	write(gtao_upscale.ao_output, coordinate, vec4f(final_ao, 0.0, 0.0, 1.0));
}

main: fn (input: StageInput, gtao_view: GtaoView, gtao_upscale: GtaoUpscale) -> void {
	let quad: vec2u = input.thread_id;
	let extent: vec2u = image_size(gtao_upscale.ao_output);
	let origin: vec2u = quad * vec2u(2, 2);
	if (origin.x >= extent.x || origin.y >= extent.y) {
		return;
	}

	// One gather reads the quad's four depths. Past an odd image edge it reads the border's zero depth, for pixels the
	// quad never writes.
	let quad_depths: vec4f = gather(
		gtao_upscale.visibility_depth,
		vec2f((f32(origin.x) + 1.0) / f32(extent.x), (f32(origin.y) + 1.0) / f32(extent.y))
	);
	let centers: vec4f = vec4f(
		linearize_depth(gtao_view, quad_depths.w),
		linearize_depth(gtao_view, quad_depths.z),
		linearize_depth(gtao_view, quad_depths.x),
		linearize_depth(gtao_view, quad_depths.y)
	);

	// Every quad pixel's base texel is the quad's coordinate in the half-resolution sources. Each gather reads two
	// columns of two rows: the left one the columns left of and at the base texel, and the right one the column right of
	// it and an unused one. Both sources share mip zero's extent, and their samplers clamp to the edge.
	let source_extent: vec2u = texture_size(gtao_upscale.ao_source);
	let inverse_source_extent: vec2f = vec2f(1.0 / f32(source_extent.x), 1.0 / f32(source_extent.y));
	let left_u: f32 = f32(quad.x) * inverse_source_extent.x;
	let right_u: f32 = (f32(quad.x) + 2.0) * inverse_source_extent.x;
	let sums: QuadSums = QuadSums(vec4f(0.0, 0.0, 0.0, 0.0), vec4f(0.0, 0.0, 0.0, 0.0));

	for (let pair: u32 = 0; pair < 4; pair = pair + 1) {
		// The pair's first row is footprint row `2 * pair`, which lies three rows above the base row at pair zero.
		let first_row: u32 = pair * 2;
		let v: f32 = (f32(quad.y) + f32(first_row) - 2.0) * inverse_source_extent.y;
		let left_depths: vec4f = gather(gtao_upscale.low_resolution_depth, vec2f(left_u, v));
		let right_depths: vec4f = gather(gtao_upscale.low_resolution_depth, vec2f(right_u, v));
		let left_aos: vec4f = gather(gtao_upscale.ao_source, vec2f(left_u, v));
		let right_aos: vec4f = gather(gtao_upscale.ao_source, vec2f(right_u, v));

		// A gather's w and z hold its first row, left then right, and x and y its second row.
		sums = accumulate_footprint_row(
			sums,
			first_row,
			vec3f(left_depths.w, left_depths.z, right_depths.w),
			vec3f(left_aos.w, left_aos.z, right_aos.w),
			centers
		);
		if (first_row + 1 < GTAO_UPSCALE_FOOTPRINT_ROWS) {
			sums = accumulate_footprint_row(
				sums,
				first_row + 1,
				vec3f(left_depths.x, left_depths.y, right_depths.x),
				vec3f(left_aos.x, left_aos.y, right_aos.x),
				centers
			);
		}
	}

	write_output(gtao_upscale, origin, extent, centers.x, sums.ao.x, sums.weight.x);
	write_output(gtao_upscale, origin + vec2u(1, 0), extent, centers.y, sums.ao.y, sums.weight.y);
	write_output(gtao_upscale, origin + vec2u(0, 1), extent, centers.z, sums.ao.z, sums.weight.z);
	write_output(gtao_upscale, origin + vec2u(1, 1), extent, centers.w, sums.ao.w, sums.weight.w);
}
