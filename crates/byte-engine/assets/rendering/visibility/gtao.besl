// depth_pyramid stores conservative nearest-nonzero positive view-space distance.
// GTAO reads mip levels zero through two. Mip zero matches the half-resolution
// AO output, and later mips serve distant samples.
FastGTAOView: struct {
	pixel_to_ray_mul: vec2f,
	pixel_to_ray_add: vec2f,
	projection_pixels_y: f32,
	view_z_sign: f32,
	depth_unproject_numerator: f32,
	depth_unproject_denominator_offset: f32,
}

GTAOParameters: struct {
	radius: f32,
	samples_per_ray: u32,
	radial_rays: u32,
}

NormalDelta: struct {
	value: vec3f,
	valid: bool,
}

RadiusData: struct {
	screen_radius: f32,
	inverse_world_radius_sq: f32,
	fade: f32,
}

SampleAddress: struct {
	coord: vec2u,
	level: u32,
	key: u32,
}

gtao_view: descriptor<{ type: FastGTAOView, binding: 0, access: read, memory: constant }>;
gtao_parameters: descriptor<{ type: GTAOParameters, binding: 1, access: read, memory: constant }>;
depth_pyramid: descriptor<{ type: Texture2D, binding: 1033, access: read }>;
ao_output: descriptor<{ type: StorageImage<r8>, binding: 1034, access: write }>;

GTAO_BIAS: const f32 = 0.05;
GTAO_STRENGTH: const f32 = 1.0;
GTAO_MIN_RADIUS_PIXELS: const f32 = 4.0;
// Half-resolution pixels cover two sink pixels, so 32 preserves the original
// 64-pixel full-resolution search bound.
GTAO_MAX_RADIUS_PIXELS: const f32 = 32.0;
GTAO_MIN_EFFECTIVE_RADIUS_PIXELS: const f32 = 1.0;
GTAO_MIN_SAMPLES_PER_RAY: const u32 = 1;
GTAO_MAX_SAMPLES_PER_RAY: const u32 = 32;
GTAO_MIN_RADIAL_RAYS: const u32 = 2;
GTAO_MAX_RADIAL_RAYS: const u32 = 32;
GTAO_PI: const f32 = 3.14159265359;
GTAO_GOLDEN: const f32 = 0.618033988749;
// This threshold tests sin squared between the finite-difference tangents.
// Unlike a world-space area threshold, it is invariant under projection scale.
GTAO_NORMAL_SIN_SQ_EPSILON: const f32 = 0.00000001;

WORKGROUP_X: const u32 = 16;
WORKGROUP_Y: const u32 = 8;
WORKGROUP_THREADS: const u32 = 128;

// Each mip level caches the rectangle around the workgroup's footprint at that level, indexed by level. The halo is
// how far the rectangle reaches past the footprint on each side. Complete cached rectangles are 30x22, 24x20, and
// 20x18. Each row has one padding element to reduce shared-memory bank conflicts.
CACHE_HALOS: const u32[3] = u32[3](7, 8, 8);
CACHE_WIDTHS: const u32[3] = u32[3](30, 24, 20);
CACHE_HEIGHTS: const u32[3] = u32[3](22, 20, 18);
CACHE_STRIDES: const u32[3] = u32[3](31, 25, 21);
CACHE_BASES: const u32[3] = u32[3](0, 682, 1182);
INVALID_SAMPLE_KEY: const u32 = 4294967295;

cached_depth: workgroup<f32, 1560>;
required_mips: workgroup<u32, 128>;
group_required_mip: workgroup<u32, 1>;

interleaved_gradient_noise: fn (pixel: vec2u) -> f32 {
	return fract(52.9829189 * fract(0.06711056 * f32(pixel.x) + 0.00583715 * f32(pixel.y)));
}

fetch_linear_depth: fn (coordinate: vec2u, level: u32, extent: vec2u) -> f32 {
	let uv: vec2f = vec2f((f32(coordinate.x) + 0.5) / f32(extent.x), (f32(coordinate.y) + 0.5) / f32(extent.y));
	return texture_lod(depth_pyramid, uv, f32(level)).x;
}

// Maps a shared-tile coordinate to the corresponding clamped texture coordinate.
halo_coordinate: fn (base: u32, tile_coordinate: u32, halo: u32, extent: u32) -> u32 {
	return min(max(base + tile_coordinate, halo) - halo, extent - 1);
}

// Maps one texture coordinate back into a cache whose logical origin may be off-screen.
cache_coordinate: fn (coordinate: u32, base: u32, halo: u32) -> u32 {
	// Every caller selects a mip whose cache includes this coordinate, so the result is nonnegative.
	return halo + coordinate - base;
}

// Loads the cached rectangle of mip `level` around the workgroup whose level-zero origin is `group_base`.
prefetch_level: fn (level: u32, group_base: vec2u) -> void {
	let lane: u32 = thread_idx();
	let base_extent: vec2u = texture_size(depth_pyramid);
	// Mip extents halve per level down to one texel.
	let extent: vec2u = vec2u(max(base_extent.x >> level, 1), max(base_extent.y >> level, 1));
	let level_group_base: vec2u = vec2u(group_base.x >> level, group_base.y >> level);
	let halo: u32 = CACHE_HALOS[level];
	let stride: u32 = CACHE_STRIDES[level];

	for (let tile_y: u32 = lane / WORKGROUP_X; tile_y < CACHE_HEIGHTS[level]; tile_y = tile_y + WORKGROUP_Y) {
		for (let tile_x: u32 = lane % WORKGROUP_X; tile_x < CACHE_WIDTHS[level]; tile_x = tile_x + WORKGROUP_X) {
			// The center-depth loads in `main` already initialized the level-zero interior.
			if (level == 0 && tile_x >= halo && tile_x < halo + WORKGROUP_X && tile_y >= halo && tile_y < halo + WORKGROUP_Y) {
				continue;
			}

			let mip_coord: vec2u = vec2u(
				halo_coordinate(level_group_base.x, tile_x, halo, extent.x),
				halo_coordinate(level_group_base.y, tile_y, halo, extent.y)
			);
			cached_depth[CACHE_BASES[level] + tile_y * stride + tile_x] = fetch_linear_depth(mip_coord, level, extent);
		}
	}
}

// Reads the cached depth of the mip `level` texel that covers `base_resolution_coord`. This runs per sample step, so
// each level's arm indexes the cache tables with a constant instead of reading them at a runtime index.
cached_hierarchical_depth: fn (base_resolution_coord: vec2u, level: u32, group_base: vec2u) -> f32 {
	match level {
		2 => {
			return cached_depth[
				CACHE_BASES[2] +
				cache_coordinate(base_resolution_coord.y >> 2, group_base.y >> 2, CACHE_HALOS[2]) * CACHE_STRIDES[2] +
				cache_coordinate(base_resolution_coord.x >> 2, group_base.x >> 2, CACHE_HALOS[2])
			];
		}
		1 => {
			return cached_depth[
				CACHE_BASES[1] +
				cache_coordinate(base_resolution_coord.y >> 1, group_base.y >> 1, CACHE_HALOS[1]) * CACHE_STRIDES[1] +
				cache_coordinate(base_resolution_coord.x >> 1, group_base.x >> 1, CACHE_HALOS[1])
			];
		}
		_ => {
			return cached_depth[
				CACHE_BASES[0] +
				cache_coordinate(base_resolution_coord.y, group_base.y, CACHE_HALOS[0]) * CACHE_STRIDES[0] +
				cache_coordinate(base_resolution_coord.x, group_base.x, CACHE_HALOS[0])
			];
		}
	}
}

// Reconstructs Psample - Pcenter without materializing either complete position.
view_position_delta: fn (
	sample_coord: vec2u,
	center_coord: vec2u,
	sample_linear_depth: f32,
	center_ray: vec2f,
	center_z: f32
) -> vec3f {
	let delta_pixel: vec2f = vec2f(f32(sample_coord.x) - f32(center_coord.x), f32(sample_coord.y) - f32(center_coord.y));
	let sample_z: f32 = sample_linear_depth * gtao_view.view_z_sign;
	let delta_z: f32 = sample_z - center_z;
	let delta_ray: vec2f = delta_pixel * gtao_view.pixel_to_ray_mul;
	let delta_xy: vec2f = fma(center_ray, vec2f(delta_z, delta_z), delta_ray * sample_z);
	return vec3f(delta_xy.x, delta_xy.y, delta_z);
}

normal_delta: fn (
	sample_coord: vec2u,
	center_coord: vec2u,
	sample_depth: f32,
	center_ray: vec2f,
	center_z: f32
) -> NormalDelta {
	if (sample_depth == 0.0 || (sample_coord.x == center_coord.x && sample_coord.y == center_coord.y)) {
		return NormalDelta(vec3f(0.0, 0.0, 0.0), false);
	}
	return NormalDelta(view_position_delta(sample_coord, center_coord, sample_depth, center_ray, center_z), true);
}

// Returns a derivative oriented toward the positive screen axis. The negative
// candidate initially points left or up, so selecting it requires negation.
nearer_oriented_delta: fn (positive: NormalDelta, negative: NormalDelta) -> NormalDelta {
	let positive_is_nearer: bool = dot(positive.value, positive.value) <= dot(negative.value, negative.value);
	if (positive.valid && (negative.valid == false || positive_is_nearer)) {
		return positive;
	}
	if (negative.valid) {
		return NormalDelta(vec3f(0.0, 0.0, 0.0) - negative.value, true);
	}
	return NormalDelta(vec3f(0.0, 0.0, 0.0), false);
}

// Derives camera-facing winding from the projection convention. This remains
// stable at grazing angles where a per-pixel face-forward dot becomes ambiguous.
camera_facing_normal_winding: fn () -> f32 {
	let winding_test: f32 = (0.0 - gtao_view.view_z_sign) * gtao_view.pixel_to_ray_mul.x * gtao_view.pixel_to_ray_mul.y;
	if (winding_test < 0.0) {
		return 0.0 - 1.0;
	}
	return 1.0;
}

reconstruct_normal_cached: fn (
	pixel: vec2u,
	extent: vec2u,
	group_base: vec2u,
	center_ray: vec2f,
	center_z: f32
) -> vec3f {
	let right_coord: vec2u = vec2u(min(pixel.x + 1, extent.x - 1), pixel.y);
	let left_coord: vec2u = vec2u(max(pixel.x, 1) - 1, pixel.y);
	let top_coord: vec2u = vec2u(pixel.x, max(pixel.y, 1) - 1);
	let bottom_coord: vec2u = vec2u(pixel.x, min(pixel.y + 1, extent.y - 1));

	// Issue all four shared loads before consuming any result.
	let right_depth: f32 = cached_hierarchical_depth(right_coord, 0, group_base);
	let left_depth: f32 = cached_hierarchical_depth(left_coord, 0, group_base);
	let top_depth: f32 = cached_hierarchical_depth(top_coord, 0, group_base);
	let bottom_depth: f32 = cached_hierarchical_depth(bottom_coord, 0, group_base);

	let dx: NormalDelta = nearer_oriented_delta(
		normal_delta(right_coord, pixel, right_depth, center_ray, center_z),
		normal_delta(left_coord, pixel, left_depth, center_ray, center_z)
	);
	let dy: NormalDelta = nearer_oriented_delta(
		normal_delta(bottom_coord, pixel, bottom_depth, center_ray, center_z),
		normal_delta(top_coord, pixel, top_depth, center_ray, center_z)
	);

	// Without two reliable tangents, returning zero suppresses AO instead of
	// inventing a camera-ray normal with unrelated geometry.
	if (dx.valid == false || dy.valid == false) {
		return vec3f(0.0, 0.0, 0.0);
	}

	let dx_length_sq: f32 = dot(dx.value, dx.value);
	let dy_length_sq: f32 = dot(dy.value, dy.value);
	let unnormalized: vec3f = cross(dx.value, dy.value) * camera_facing_normal_winding();
	let normal_length_sq: f32 = dot(unnormalized, unnormalized);
	// cross squared divided by the tangent-length product is sin squared of
	// the angle between the derivatives. Compare without performing division.
	let tangent_product: f32 = dx_length_sq * dy_length_sq;
	if (normal_length_sq <= tangent_product * GTAO_NORMAL_SIN_SQ_EPSILON) {
		return vec3f(0.0, 0.0, 0.0);
	}

	return unnormalized * inversesqrt(normal_length_sq);
}

compute_radius_data: fn (linear_depth: f32) -> RadiusData {
	let pixels_per_unit: f32 = gtao_view.projection_pixels_y / max(linear_depth, 0.0001);
	let ideal_screen_radius: f32 = gtao_parameters.radius * pixels_per_unit;
	let screen_radius: f32 = clamp(ideal_screen_radius, GTAO_MIN_EFFECTIVE_RADIUS_PIXELS, GTAO_MAX_RADIUS_PIXELS);
	let inverse_world_radius: f32 = pixels_per_unit / screen_radius;
	return RadiusData(
		screen_radius,
		inverse_world_radius * inverse_world_radius,
		smoothstep(0.0, GTAO_MIN_RADIUS_PIXELS, ideal_screen_radius)
	);
}

// Returns the coarsest mip level that a pixel at `linear_depth` samples, or zero for background.
maximum_required_mip: fn (linear_depth: f32) -> u32 {
	if (linear_depth == 0.0) {
		return 0;
	}

	let screen_radius: f32 = compute_radius_data(linear_depth).screen_radius;
	let level: u32 = 0;
	if (screen_radius >= 7.5) {
		level = level + 1;
	}
	if (screen_radius >= 15.5) {
		level = level + 1;
	}
	return level;
}

make_sample_address: fn (
	pixel: vec2u,
	extent: vec2u,
	scaled_direction: vec2f,
	step_ratio: f32
) -> SampleAddress {
	let requested_offset: vec2f = round(scaled_direction * step_ratio);
	let maximum_offset: f32 = max(abs(requested_offset.x), abs(requested_offset.y));

	let level: u32 = u32(step(8.0, maximum_offset) + step(16.0, maximum_offset));
	let sample_coord: vec2u = vec2u(
		u32(clamp(f32(pixel.x) + requested_offset.x, 0.0, f32(extent.x - 1))),
		u32(clamp(f32(pixel.y) + requested_offset.y, 0.0, f32(extent.y - 1)))
	);
	// The key identifies the cached texel, so a step that lands on the previous step's texel can skip it.
	return SampleAddress(sample_coord, level, sample_coord.x | (sample_coord.y << 14) | (level << 28));
}

update_direction_occlusion: fn (
	previous_occlusion: f32,
	sample_coord: vec2u,
	sample_linear_depth: f32,
	pixel: vec2u,
	center_ray: vec2f,
	center_z: f32,
	normal: vec3f,
	inverse_radius_sq: f32
) -> f32 {
	if (sample_linear_depth == 0.0 || (sample_coord.x == pixel.x && sample_coord.y == pixel.y)) {
		return previous_occlusion;
	}

	let delta: vec3f = view_position_delta(sample_coord, pixel, sample_linear_depth, center_ray, center_z);
	let distance_sq: f32 = dot(delta, delta);
	let normalized_distance_sq: f32 = distance_sq * inverse_radius_sq;
	if (distance_sq <= 0.00001 || normalized_distance_sq > 1.0) {
		return previous_occlusion;
	}

	let alignment: f32 = max(dot(normal, delta) * inversesqrt(distance_sq) - GTAO_BIAS, 0.0);
	let falloff: f32 = 1.0 - normalized_distance_sq;
	return max(previous_occlusion, alignment * falloff * falloff);
}

main: fn (input: StageInput) -> void {
	let lane: u32 = input.thread_idx;
	let local: vec2u = vec2u(lane % WORKGROUP_X, lane / WORKGROUP_X);
	let pixel: vec2u = input.thread_id;
	let group_base: vec2u = pixel - local;
	let extent: vec2u = image_size(ao_output);
	let in_bounds: bool = pixel.x < extent.x && pixel.y < extent.y;
	let safe_pixel: vec2u = vec2u(min(pixel.x, extent.x - 1), min(pixel.y, extent.y - 1));

	// One coalesced center load per lane preserves the group-level background early out.
	let center_linear_depth: f32 = fetch_linear_depth(safe_pixel, 0, extent);
	let center_shared_index: u32 = CACHE_BASES[0] + (local.y + CACHE_HALOS[0]) * CACHE_STRIDES[0] + local.x + CACHE_HALOS[0];
	cached_depth[center_shared_index] = center_linear_depth;

	let active: bool = in_bounds && center_linear_depth != 0.0;
	required_mips[lane] = 0;
	if (active) {
		// Encode active mip zero as one so zero remains the all-background sentinel.
		required_mips[lane] = maximum_required_mip(center_linear_depth) + 1;
	}
	workgroup_barrier();

	// One lane reduces both workgroup predicates. This costs two barriers instead
	// of a seven-stage tree and keeps the result uniform for later prefetch branches.
	if (lane == 0) {
		let encoded_maximum: u32 = 0;
		for (let index: u32 = 0; index < WORKGROUP_THREADS; index = index + 1) {
			if (required_mips[index] > encoded_maximum) {
				encoded_maximum = required_mips[index];
			}
		}
		group_required_mip[0] = encoded_maximum;
	}
	workgroup_barrier();

	let encoded_group_mip: u32 = group_required_mip[0];
	if (encoded_group_mip == 0) {
		if (in_bounds) {
			write(ao_output, pixel, vec4f(1.0, 1.0, 1.0, 1.0));
		}
		return;
	}
	let group_maximum_mip: u32 = encoded_group_mip - 1;

	prefetch_level(0, group_base);
	if (group_maximum_mip >= 1) {
		prefetch_level(1, group_base);
	}
	if (group_maximum_mip >= 2) {
		prefetch_level(2, group_base);
	}
	workgroup_barrier();

	if (in_bounds == false) {
		return;
	}
	if (center_linear_depth == 0.0) {
		write(ao_output, pixel, vec4f(1.0, 1.0, 1.0, 1.0));
		return;
	}

	// Recompute short-lived values after prefetching instead of carrying them
	// across the shared-memory loading phase.
	let center_ray: vec2f = fma(vec2f(f32(pixel.x), f32(pixel.y)), gtao_view.pixel_to_ray_mul, gtao_view.pixel_to_ray_add);
	let center_z: f32 = center_linear_depth * gtao_view.view_z_sign;
	let normal: vec3f = reconstruct_normal_cached(pixel, extent, group_base, center_ray, center_z);
	if (dot(normal, normal) == 0.0) {
		write(ao_output, pixel, vec4f(1.0, 1.0, 1.0, 1.0));
		return;
	}
	let radius: RadiusData = compute_radius_data(center_linear_depth);
	let samples_per_ray: u32 = clamp(gtao_parameters.samples_per_ray, GTAO_MIN_SAMPLES_PER_RAY, GTAO_MAX_SAMPLES_PER_RAY);
	let radial_rays: u32 = clamp(gtao_parameters.radial_rays, GTAO_MIN_RADIAL_RAYS, GTAO_MAX_RADIAL_RAYS);
	let ray_pairs: u32 = radial_rays / 2;
	let inverse_samples_per_ray: f32 = 1.0 / f32(samples_per_ray);
	let rotation: f32 = interleaved_gradient_noise(pixel) * GTAO_PI;
	let rotation_trigonometry: vec2f = sincos(rotation);
	let axis_direction: vec2f = vec2f(rotation_trigonometry.y, rotation_trigonometry.x);
	let axis_rotation: vec2f = sincos(GTAO_PI / f32(ray_pairs));
	let total_occlusion: f32 = 0.0;

	// Keep this loop rolled. Unrolling the complete sample set can raise the
	// backend's register-allocation tier and reduce occupancy.
	for (let axis_index: u32 = 0; axis_index < ray_pairs; axis_index = axis_index + 1) {
		let negative_index: u32 = axis_index + ray_pairs;
		let positive_noise: f32 = interleaved_gradient_noise(pixel + vec2u(axis_index * 7, axis_index * 13));
		let negative_noise: f32 = interleaved_gradient_noise(pixel + vec2u(negative_index * 7, negative_index * 13));
		let positive_maximum: f32 = 0.0;
		let negative_maximum: f32 = 0.0;
		let previous_positive_key: u32 = INVALID_SAMPLE_KEY;
		let previous_negative_key: u32 = INVALID_SAMPLE_KEY;
		let scaled_axis_direction: vec2f = axis_direction * radius.screen_radius;

		for (let step: u32 = 1; step <= samples_per_ray; step = step + 1) {
			let step_f: f32 = f32(step);
			let positive_step_noise: f32 = fract(positive_noise + step_f * GTAO_GOLDEN);
			let negative_step_noise: f32 = fract(negative_noise + step_f * GTAO_GOLDEN);
			let positive_ratio: f32 = (step_f - 0.5 + positive_step_noise * 0.5) * inverse_samples_per_ray;
			let negative_ratio: f32 = (step_f - 0.5 + negative_step_noise * 0.5) * inverse_samples_per_ray;
			let positive_sample: SampleAddress = make_sample_address(pixel, extent, scaled_axis_direction, positive_ratio);
			let negative_sample: SampleAddress = make_sample_address(
				pixel,
				extent,
				vec2f(0.0, 0.0) - scaled_axis_direction,
				negative_ratio
			);
			let evaluate_positive: bool = positive_sample.key != previous_positive_key;
			let evaluate_negative: bool = negative_sample.key != previous_negative_key;
			let positive_depth: f32 = 0.0;
			let negative_depth: f32 = 0.0;

			// Issue both shared reads before consuming either result.
			if (evaluate_positive) {
				positive_depth = cached_hierarchical_depth(positive_sample.coord, positive_sample.level, group_base);
			}
			if (evaluate_negative) {
				negative_depth = cached_hierarchical_depth(negative_sample.coord, negative_sample.level, group_base);
			}

			if (evaluate_positive) {
				positive_maximum = update_direction_occlusion(
					positive_maximum,
					positive_sample.coord,
					positive_depth,
					pixel,
					center_ray,
					center_z,
					normal,
					radius.inverse_world_radius_sq
				);
			}
			if (evaluate_negative) {
				negative_maximum = update_direction_occlusion(
					negative_maximum,
					negative_sample.coord,
					negative_depth,
					pixel,
					center_ray,
					center_z,
					normal,
					radius.inverse_world_radius_sq
				);
			}

			previous_positive_key = positive_sample.key;
			previous_negative_key = negative_sample.key;
		}

		total_occlusion = total_occlusion + positive_maximum + negative_maximum;
		axis_direction = vec2f(
			axis_direction.x * axis_rotation.y - axis_direction.y * axis_rotation.x,
			axis_direction.x * axis_rotation.x + axis_direction.y * axis_rotation.y
		);
	}

	let average_occlusion: f32 = clamp(total_occlusion / f32(radial_rays) * GTAO_STRENGTH, 0.0, 1.0);
	let ao: f32 = 1.0 - average_occlusion * radius.fade;
	write(ao_output, pixel, vec4f(ao, ao, ao, 1.0));
}
