// Ground-truth ambient occlusion: Jimenez, Wu, Pesce, and Jarabo, "Practical Realtime Strategies for Accurate Indirect
// Occlusion" (2016), with the falloff, arc-cosine, and bent normal of Intel's XeGTAO. Each slice through the view
// direction keeps the highest horizon on either side of the pixel, then integrates the visible arc between the two
// horizons against the cosine around the normal, for visibility, and against the slice's direction, for the bent normal.
//
// depth_pyramid stores conservative nearest-nonzero positive view-space distance.
// GTAO reads mip levels zero through two. Mip zero matches the half-resolution
// AO output, and later mips serve distant samples.

use ::byte_engine::rendering::visibility::layouts::screen_view::*;
use ::byte_engine::rendering::visibility::layouts::gtao_view::*;
use ::byte_engine::rendering::visibility::layouts::gtao::*;

NormalDelta: struct {
	value: vec3f,
	valid: bool,
}

RadiusData: struct {
	screen_radius: f32,
	inverse_world_radius: f32,
	fade: f32,
}

// The level-zero depths of a pixel's four edge neighbors.
NeighborDepths: struct {
	right: f32,
	left: f32,
	top: f32,
	bottom: f32,
}

// Per mip level, the inverse of the mip's extent times its texel size in half-resolution pixels. Multiplying a
// half-resolution position by it gives the position's normalized coordinate in that mip.
LevelScales: struct {
	level_0: vec2f,
	level_1: vec2f,
	level_2: vec2f,
}

// One step's texel in the half-resolution image, as integer-valued coordinates, and the mip level that serves it.
SamplePoint: struct {
	position: vec2f,
	level: f32,
}

// Lowers every horizon cosine, so depth error in the pyramid's conservative mips doesn't occlude flat surfaces.
GTAO_BIAS: const f32 = 0.05;
// XeGTAO fades a sample's horizon to the tangent over the outer 61.5 % of the radius: one over 0.615.
GTAO_FALLOFF_SCALE: const f32 = 1.6260162602;
GTAO_STRENGTH: const f32 = 1.0;
GTAO_MIN_RADIUS_PIXELS: const f32 = 4.0;
// Half-resolution pixels cover two sink pixels, so 32 preserves the original
// 64-pixel full-resolution search bound.
GTAO_MAX_RADIUS_PIXELS: const f32 = 32.0;
GTAO_MIN_EFFECTIVE_RADIUS_PIXELS: const f32 = 1.0;
GTAO_MIN_SAMPLES_PER_RAY: const u32 = 1;
GTAO_MAX_SAMPLES_PER_RAY: const u32 = 32;
GTAO_MIN_RADIAL_RAYS: const u32 = 2;
GTAO_MAX_RADIAL_RAYS: const u32 = 32;
GTAO_PI: const f32 = 3.14159265359;
GTAO_HALF_PI: const f32 = 1.57079632679;
GTAO_GOLDEN: const f32 = 0.618033988749;
// This threshold tests sin squared between the finite-difference tangents.
// Unlike a world-space area threshold, it is invariant under projection scale.
GTAO_NORMAL_SIN_SQ_EPSILON: const f32 = 0.00000001;

// The side of the tiling blue-noise texture, `BLUE_NOISE_SIDE` in `lookup_textures.rs`.
GTAO_BLUE_NOISE_SIDE: const u32 = 64;

// Reads the depth of the mip `level` texel that covers the integer-valued half-resolution `position`. Scaling by the
// texel size puts the position's texel coordinate in the mip at `position >> level` plus a fraction, whether or not
// halving the extent dropped a texel, so nearest sampling reads that texel without integer math. The fraction lies at
// least an eighth of a texel from either edge, and positions past a mip's edge clamp to its last texel.
hierarchical_depth: fn (gtao_set: Gtao, position: vec2f, level: f32, level_scales: LevelScales) -> f32 {
	let position_scale: vec2f = level_scales.level_0;
	if (level == 1.0) {
		position_scale = level_scales.level_1;
	}
	if (level == 2.0) {
		position_scale = level_scales.level_2;
	}
	return texture_lod(gtao_set.depth_pyramid, (position + vec2f(0.5, 0.5)) * position_scale, level).x;
}

// Returns mip `level`'s entry of `LevelScales` for a mip zero of `extent`.
level_position_scale: fn (extent: vec2u, level: u32) -> vec2f {
	return vec2f(
		1.0 / f32(max(extent.x >> level, 1) << level),
		1.0 / f32(max(extent.y >> level, 1) << level)
	);
}

// Reconstructs Psample - Pcenter from the sample's offset in pixels, without materializing either complete position.
view_position_delta: fn (
	gtao_view: GtaoView,
	delta_pixel: vec2f,
	sample_linear_depth: f32,
	center_ray: vec2f,
	center_z: f32
) -> vec3f {
	let sample_z: f32 = sample_linear_depth * gtao_view.gtao_view.view_z_sign;
	let delta_z: f32 = sample_z - center_z;
	let delta_ray: vec2f = delta_pixel * gtao_view.gtao_view.pixel_to_ray_mul;
	let delta_xy: vec2f = fma(center_ray, vec2f(delta_z, delta_z), delta_ray * sample_z);
	return vec3f(delta_xy.x, delta_xy.y, delta_z);
}

normal_delta: fn (
	gtao_view: GtaoView,
	sample_coord: vec2u,
	center_coord: vec2u,
	sample_depth: f32,
	center_ray: vec2f,
	center_z: f32
) -> NormalDelta {
	if (sample_depth == 0.0 || (sample_coord.x == center_coord.x && sample_coord.y == center_coord.y)) {
		return NormalDelta(vec3f(0.0, 0.0, 0.0), false);
	}
	let delta_pixel: vec2f = vec2f(f32(sample_coord.x) - f32(center_coord.x), f32(sample_coord.y) - f32(center_coord.y));
	return NormalDelta(view_position_delta(gtao_view, delta_pixel, sample_depth, center_ray, center_z), true);
}

// Returns a derivative oriented toward the positive screen axis. The negative
// candidate initially points left or up, so selecting it requires negation.
nearer_oriented_delta: fn (positive: NormalDelta, negative: NormalDelta) -> NormalDelta {
	let positive_is_nearer: bool = dot(positive.value, positive.value) <= dot(negative.value, negative.value);
	if (positive.valid && (negative.valid == false || positive_is_nearer)) {
		return positive;
	}
	if (negative.valid) {
		return NormalDelta(vec3f(0.0, 0.0, 0.0) - negative.value, true);
	}
	return NormalDelta(vec3f(0.0, 0.0, 0.0), false);
}

// Derives camera-facing winding from the projection convention. This remains
// stable at grazing angles where a per-pixel face-forward dot becomes ambiguous.
camera_facing_normal_winding: fn (gtao_view: GtaoView) -> f32 {
	let winding_test: f32 = (0.0 - gtao_view.gtao_view.view_z_sign) * gtao_view.gtao_view.pixel_to_ray_mul.x * gtao_view.gtao_view.pixel_to_ray_mul.y;
	if (winding_test < 0.0) {
		return 0.0 - 1.0;
	}
	return 1.0;
}

reconstruct_normal: fn (
	gtao_view: GtaoView,
	pixel: vec2u,
	extent: vec2u,
	neighbor_depths: NeighborDepths,
	center_ray: vec2f,
	center_z: f32
) -> vec3f {
	let right_coord: vec2u = vec2u(min(pixel.x + 1, extent.x - 1), pixel.y);
	let left_coord: vec2u = vec2u(max(pixel.x, 1) - 1, pixel.y);
	let top_coord: vec2u = vec2u(pixel.x, max(pixel.y, 1) - 1);
	let bottom_coord: vec2u = vec2u(pixel.x, min(pixel.y + 1, extent.y - 1));

	// A neighbor past the image edge reads the edge texel, the pixel itself, which `normal_delta` rejects.
	let dx: NormalDelta = nearer_oriented_delta(
		normal_delta(gtao_view, right_coord, pixel, neighbor_depths.right, center_ray, center_z),
		normal_delta(gtao_view, left_coord, pixel, neighbor_depths.left, center_ray, center_z)
	);
	let dy: NormalDelta = nearer_oriented_delta(
		normal_delta(gtao_view, bottom_coord, pixel, neighbor_depths.bottom, center_ray, center_z),
		normal_delta(gtao_view, top_coord, pixel, neighbor_depths.top, center_ray, center_z)
	);

	// Without two reliable tangents, returning zero suppresses AO instead of
	// inventing a camera-ray normal with unrelated geometry.
	if (dx.valid == false || dy.valid == false) {
		return vec3f(0.0, 0.0, 0.0);
	}

	let dx_length_sq: f32 = dot(dx.value, dx.value);
	let dy_length_sq: f32 = dot(dy.value, dy.value);
	let unnormalized: vec3f = cross(dx.value, dy.value) * camera_facing_normal_winding(gtao_view);
	let normal_length_sq: f32 = dot(unnormalized, unnormalized);
	// cross squared divided by the tangent-length product is sin squared of
	// the angle between the derivatives. Compare without performing division.
	let tangent_product: f32 = dx_length_sq * dy_length_sq;
	if (normal_length_sq <= tangent_product * GTAO_NORMAL_SIN_SQ_EPSILON) {
		return vec3f(0.0, 0.0, 0.0);
	}

	return unnormalized * inversesqrt(normal_length_sq);
}

compute_radius_data: fn (gtao_view: GtaoView, gtao_set: Gtao, linear_depth: f32) -> RadiusData {
	let pixels_per_unit: f32 = gtao_view.gtao_view.projection_pixels_y / max(linear_depth, 0.0001);
	let ideal_screen_radius: f32 = gtao_set.gtao_parameters.radius * pixels_per_unit;
	let screen_radius: f32 = clamp(ideal_screen_radius, GTAO_MIN_EFFECTIVE_RADIUS_PIXELS, GTAO_MAX_RADIUS_PIXELS);
	return RadiusData(
		screen_radius,
		pixels_per_unit / screen_radius,
		smoothstep(0.0, GTAO_MIN_RADIUS_PIXELS, ideal_screen_radius)
	);
}

sample_point: fn (
	pixel_position: vec2f,
	maximum_position: vec2f,
	scaled_direction: vec2f,
	step_ratio: f32
) -> SamplePoint {
	let requested_offset: vec2f = round(scaled_direction * step_ratio);
	let maximum_offset: f32 = max(abs(requested_offset.x), abs(requested_offset.y));

	let level: f32 = step(8.0, maximum_offset) + step(16.0, maximum_offset);
	let position: vec2f = vec2f(
		clamp(pixel_position.x + requested_offset.x, 0.0, maximum_position.x),
		clamp(pixel_position.y + requested_offset.y, 0.0, maximum_position.y)
	);
	return SamplePoint(position, level);
}

// XeGTAO's arc cosine, accurate to about 0.007 radians with one square root.
fast_acos: fn (x: f32) -> f32 {
	let magnitude: f32 = abs(x);
	let result: f32 = (GTAO_HALF_PI - 0.156583 * magnitude) * sqrt(1.0 - magnitude);
	if (x < 0.0) {
		return GTAO_PI - result;
	}
	return result;
}

// Returns the higher of `previous_horizon` and the sample's horizon: the cosine of the angle between the view vector and
// the direction to the sample, faded to `low_horizon`, the surface's tangent, as the sample nears the radius.
update_horizon: fn (
	gtao_view: GtaoView,
	previous_horizon: f32,
	low_horizon: f32,
	sample_position: vec2f,
	sample_linear_depth: f32,
	pixel_position: vec2f,
	center_ray: vec2f,
	center_z: f32,
	view_vector: vec3f,
	inverse_radius: f32
) -> f32 {
	if (sample_linear_depth == 0.0 || (sample_position.x == pixel_position.x && sample_position.y == pixel_position.y)) {
		return previous_horizon;
	}

	let delta: vec3f = view_position_delta(gtao_view, sample_position - pixel_position, sample_linear_depth, center_ray, center_z);
	let distance_sq: f32 = dot(delta, delta);
	let inverse_distance: f32 = inversesqrt(distance_sq);
	let normalized_distance: f32 = distance_sq * inverse_distance * inverse_radius;
	if (distance_sq <= 0.00001 || normalized_distance > 1.0) {
		return previous_horizon;
	}

	let horizon: f32 = dot(delta, view_vector) * inverse_distance - GTAO_BIAS;
	let weight: f32 = clamp((1.0 - normalized_distance) * GTAO_FALLOFF_SCALE, 0.0, 1.0);
	return max(previous_horizon, mix(low_horizon, horizon, weight));
}

main: fn (input: StageInput, gtao_view: GtaoView, gtao_set: Gtao) -> void {
	let pixel: vec2u = input.thread_id;
	let extent: vec2u = image_size(gtao_set.ao_output);
	if (pixel.x >= extent.x || pixel.y >= extent.y) {
		return;
	}
	// Two gathers read the pixel and its four edge neighbors in mip zero: the first the quad that ends at the pixel, and
	// the second the quad that starts at it. The sampler clamps neighbors past the image edge to the edge.
	let inverse_extent: vec2f = vec2f(1.0 / f32(extent.x), 1.0 / f32(extent.y));
	let pixel_position: vec2f = vec2f(f32(pixel.x), f32(pixel.y));
	let upper_left: vec4f = gather(gtao_set.depth_pyramid, pixel_position * inverse_extent);
	let lower_right: vec4f = gather(gtao_set.depth_pyramid, (pixel_position + vec2f(1.0, 1.0)) * inverse_extent);
	let center_linear_depth: f32 = upper_left.y;
	if (center_linear_depth == 0.0) {
		write(gtao_set.ao_output, pixel, vec4f(1.0, 1.0, 1.0, 1.0));
		write(gtao_set.bent_normal_output, pixel, vec4f(0.5, 0.5, 0.0, 0.0));
		return;
	}

	let center_ray: vec2f = fma(pixel_position, gtao_view.gtao_view.pixel_to_ray_mul, gtao_view.gtao_view.pixel_to_ray_add);
	let center_z: f32 = center_linear_depth * gtao_view.gtao_view.view_z_sign;
	let normal: vec3f = reconstruct_normal(
		gtao_view,
		pixel,
		extent,
		NeighborDepths(lower_right.z, upper_left.x, upper_left.z, lower_right.x),
		center_ray,
		center_z
	);
	// Without a normal, the bent normal is the view vector: zero across it.
	if (dot(normal, normal) == 0.0) {
		write(gtao_set.ao_output, pixel, vec4f(1.0, 1.0, 1.0, 1.0));
		write(gtao_set.bent_normal_output, pixel, vec4f(0.5, 0.5, 0.0, 0.0));
		return;
	}
	let radius: RadiusData = compute_radius_data(gtao_view, gtao_set, center_linear_depth);
	let samples_per_ray: u32 = clamp(gtao_set.gtao_parameters.samples_per_ray, GTAO_MIN_SAMPLES_PER_RAY, GTAO_MAX_SAMPLES_PER_RAY);
	let radial_rays: u32 = clamp(gtao_set.gtao_parameters.radial_rays, GTAO_MIN_RADIAL_RAYS, GTAO_MAX_RADIAL_RAYS);
	let ray_pairs: u32 = radial_rays / 2;
	let inverse_samples_per_ray: f32 = 1.0 / f32(samples_per_ray);
	// Two channels of the engine's tiling blue noise: the slices' turn and the samples' offset along each side. Turning
	// by less than one slice spacing reaches every slice set, and keeps neighboring pixels' turns blue, which a turn of
	// up to π would fold over itself once per slice.
	let noise: vec4f = fetch(gtao_set.blue_noise, vec2u(pixel.x % GTAO_BLUE_NOISE_SIDE, pixel.y % GTAO_BLUE_NOISE_SIDE));
	let rotation: f32 = noise.x * GTAO_PI / f32(ray_pairs);
	let rotation_trigonometry: vec2f = sincos(rotation);
	let axis_direction: vec2f = vec2f(rotation_trigonometry.y, rotation_trigonometry.x);
	let axis_rotation: vec2f = sincos(GTAO_PI / f32(ray_pairs));
	let total_visibility: f32 = 0.0;
	let bent_normal: vec3f = vec3f(0.0, 0.0, 0.0);
	// The unit vector from the pixel's surface point toward the camera, which every slice contains.
	let view_vector: vec3f = normalize(vec3f(0.0 - center_ray.x * center_z, 0.0 - center_ray.y * center_z, 0.0 - center_z));
	let maximum_position: vec2f = vec2f(f32(extent.x - 1), f32(extent.y - 1));
	let level_scales: LevelScales = LevelScales(
		level_position_scale(extent, 0),
		level_position_scale(extent, 1),
		level_position_scale(extent, 2)
	);

	// Keep this loop rolled. Unrolling the complete sample set can raise the
	// backend's register-allocation tier and reduce occupancy.
	for (let axis_index: u32 = 0; axis_index < ray_pairs; axis_index = axis_index + 1) {
		let negative_index: u32 = axis_index + ray_pairs;
		// Each side shifts the sample offset along the golden-ratio sequence, which keeps it blue across the image and
		// decorrelates the sides.
		let positive_noise: f32 = fract(noise.y + f32(axis_index) * GTAO_GOLDEN);
		let negative_noise: f32 = fract(noise.y + f32(negative_index) * GTAO_GOLDEN);
		let scaled_axis_direction: vec2f = axis_direction * radius.screen_radius;

		// The slice is the plane through the view vector and the view-space direction a positive screen step takes at
		// constant depth. Angles in it run from the view vector, positive toward that direction.
		let slice_direction: vec3f = vec3f(
			axis_direction.x * gtao_view.gtao_view.pixel_to_ray_mul.x,
			axis_direction.y * gtao_view.gtao_view.pixel_to_ray_mul.y,
			0.0
		) * gtao_view.gtao_view.view_z_sign;
		let orthogonal_direction: vec3f = normalize(slice_direction - view_vector * dot(slice_direction, view_vector));
		let slice_axis: vec3f = cross(orthogonal_direction, view_vector);
		let projected_normal: vec3f = normal - slice_axis * dot(normal, slice_axis);
		let projected_length_sq: f32 = max(dot(projected_normal, projected_normal), 0.000000000001);
		let inverse_projected_length: f32 = inversesqrt(projected_length_sq);
		let projected_length: f32 = projected_length_sq * inverse_projected_length;
		// The projected normal's angle `n` from the view vector.
		let cos_n: f32 = clamp(dot(projected_normal, view_vector) * inverse_projected_length, 0.0, 1.0);
		let n: f32 = fast_acos(cos_n);
		if (dot(orthogonal_direction, projected_normal) < 0.0) {
			n = 0.0 - n;
		}
		// sin n from cos n, which avoids a sine; n and sin n share the sign of the normal's lean.
		let sin_n: f32 = sqrt(1.0 - cos_n * cos_n);
		if (n < 0.0) {
			sin_n = 0.0 - sin_n;
		}
		// Each side starts at the surface's tangent, a quarter turn from the normal: cos(n + π/2) and cos(n − π/2).
		let positive_low: f32 = 0.0 - sin_n;
		let negative_low: f32 = sin_n;
		let positive_horizon: f32 = positive_low;
		let negative_horizon: f32 = negative_low;

		for (let step: u32 = 1; step <= samples_per_ray; step = step + 1) {
			let step_f: f32 = f32(step);
			let positive_step_noise: f32 = fract(positive_noise + step_f * GTAO_GOLDEN);
			let negative_step_noise: f32 = fract(negative_noise + step_f * GTAO_GOLDEN);
			let positive_ratio: f32 = (step_f - 0.5 + positive_step_noise * 0.5) * inverse_samples_per_ray;
			let negative_ratio: f32 = (step_f - 0.5 + negative_step_noise * 0.5) * inverse_samples_per_ray;
			let positive_sample: SamplePoint = sample_point(pixel_position, maximum_position, scaled_axis_direction, positive_ratio);
			let negative_sample: SamplePoint = sample_point(
				pixel_position,
				maximum_position,
				vec2f(0.0, 0.0) - scaled_axis_direction,
				negative_ratio
			);

			// Issue both reads before consuming either result. A step that lands on the previous step's texel repeats
			// its horizon, which leaves the maximum unchanged, so every step evaluates without checking for repeats.
			let positive_depth: f32 = hierarchical_depth(gtao_set, positive_sample.position, positive_sample.level, level_scales);
			let negative_depth: f32 = hierarchical_depth(gtao_set, negative_sample.position, negative_sample.level, level_scales);
			positive_horizon = update_horizon(
				gtao_view,
				positive_horizon,
				positive_low,
				positive_sample.position,
				positive_depth,
				pixel_position,
				center_ray,
				center_z,
				view_vector,
				radius.inverse_world_radius
			);
			negative_horizon = update_horizon(
				gtao_view,
				negative_horizon,
				negative_low,
				negative_sample.position,
				negative_depth,
				pixel_position,
				center_ray,
				center_z,
				view_vector,
				radius.inverse_world_radius
			);
		}

		// The horizon angles, kept within the hemisphere around the projected normal.
		let h0: f32 = n + max(0.0 - fast_acos(negative_horizon) - n, 0.0 - GTAO_HALF_PI);
		let h1: f32 = n + min(fast_acos(positive_horizon) - n, GTAO_HALF_PI);
		// Every angle the integrals take is a multiple of h plus or minus n, so the sines and cosines of h0 and h1, with
		// those of n, give them all through the double- and triple-angle and angle-addition identities. That replaces
		// nine trigonometric calls per slice with two.
		let horizon_0: vec2f = sincos(h0);
		let horizon_1: vec2f = sincos(h1);
		let s0: f32 = horizon_0.x;
		let c0: f32 = horizon_0.y;
		let s1: f32 = horizon_1.x;
		let c1: f32 = horizon_1.y;
		// sin 2h = 2 s c and cos 2h = c² − s²; sin 3h = s (3 − 4 s²) and cos 3h = c (4 c² − 3).
		let double_sin_0: f32 = 2.0 * s0 * c0;
		let double_cos_0: f32 = c0 * c0 - s0 * s0;
		let double_sin_1: f32 = 2.0 * s1 * c1;
		let double_cos_1: f32 = c1 * c1 - s1 * s1;
		let triple_sin_0: f32 = s0 * (3.0 - 4.0 * s0 * s0);
		let triple_cos_0: f32 = c0 * (4.0 * c0 * c0 - 3.0);
		let triple_sin_1: f32 = s1 * (3.0 - 4.0 * s1 * s1);
		let triple_cos_1: f32 = c1 * (4.0 * c1 * c1 - 3.0);
		// The cosine-weighted visible arc on each side, the paper's equation 10, with cos(2h − n) expanded.
		let arc_0: f32 = (cos_n + 2.0 * h0 * sin_n - (double_cos_0 * cos_n + double_sin_0 * sin_n)) * 0.25;
		let arc_1: f32 = (cos_n + 2.0 * h1 * sin_n - (double_cos_1 * cos_n + double_sin_1 * sin_n)) * 0.25;
		total_visibility = total_visibility + projected_length * (arc_0 + arc_1);
		// The visible arc's mean direction in the slice, XeGTAO's integral: `t0` along the slice's direction and `t1`
		// along the view vector. sin(h − n), sin(3h − n), cos(3h − n), sin(h + n), and cos(h + n) expanded.
		let difference_sin: f32 = (s0 + s1) * cos_n - (c0 + c1) * sin_n;
		let triple_difference_sin: f32 = (triple_sin_0 + triple_sin_1) * cos_n - (triple_cos_0 + triple_cos_1) * sin_n;
		let triple_difference_cos: f32 = (triple_cos_0 + triple_cos_1) * cos_n + (triple_sin_0 + triple_sin_1) * sin_n;
		let sum_sin: f32 = (s0 + s1) * cos_n + (c0 + c1) * sin_n;
		let sum_cos: f32 = (c0 + c1) * cos_n - (s0 + s1) * sin_n;
		let t0: f32 = (6.0 * difference_sin - triple_difference_sin + 16.0 * sin_n - 3.0 * sum_sin) / 12.0;
		let t1: f32 = (8.0 * cos_n - triple_difference_cos - 3.0 * sum_cos) / 12.0;
		bent_normal = bent_normal + (orthogonal_direction * t0 + view_vector * t1) * projected_length;

		axis_direction = vec2f(
			axis_direction.x * axis_rotation.y - axis_direction.y * axis_rotation.x,
			axis_direction.x * axis_rotation.x + axis_direction.y * axis_rotation.y
		);
	}

	let average_occlusion: f32 = clamp((1.0 - total_visibility / f32(ray_pairs)) * GTAO_STRENGTH, 0.0, 1.0);
	let ao: f32 = 1.0 - average_occlusion * radius.fade;
	write(gtao_set.ao_output, pixel, vec4f(ao, ao, ao, 1.0));
	// A radius too small to resolve fades the bent normal back to the normal along with the occlusion.
	let unit_bent_normal: vec3f = bent_normal * inversesqrt(max(dot(bent_normal, bent_normal), 0.000000000001));
	let faded_bent_normal: vec3f = normalize(mix(normal, unit_bent_normal, radius.fade));
	// Every slice's visible arc holds the view vector, so the bent normal lies in the hemisphere around it, and its
	// two components across the view vector hold all of it. The frame is the one material evaluation rebuilds:
	// t = normalize(up × V) and b = V × t, with the view's up axis.
	let frame_t: vec3f = normalize(cross(vec3f(0.0, 1.0, 0.0), view_vector));
	let frame_b: vec3f = cross(view_vector, frame_t);
	write(
		gtao_set.bent_normal_output,
		pixel,
		vec4f(dot(faded_bent_normal, frame_t) * 0.5 + 0.5, dot(faded_bent_normal, frame_b) * 0.5 + 0.5, 0.0, 1.0)
	);
}
