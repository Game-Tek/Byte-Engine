// The descriptor set of the horizontal GTAO denoise: the linear depth that guards edges, the occlusion and bent normal
// it filters, and the images it writes.

GtaoBlur: layer {
	linear_depth: descriptor<{ type: Texture2D, binding: 0, access: read }>;
	ao_source: descriptor<{ type: Texture2D, binding: 1, access: read }>;
	ao_output: descriptor<{ type: StorageImage<r8>, binding: 2, access: write }>;
	bent_normal_source: descriptor<{ type: Texture2D, binding: 3, access: read }>;
	bent_normal_output: descriptor<{ type: StorageImage<rg8>, binding: 4, access: write }>;
}
