// The scene's light table, as the visibility pipeline uploads it for its lighting passes (`LightingData` in
// `shader_data.rs`). This layer declares types only; a layer module that uses it, such as `light_clusters.besl` or
// `fog_light.besl`, declares the buffer that holds the table. Material evaluation declares its own copy, which reads
// the shadow assignments as an array.

// The light types a record's `type` holds.
POINT_LIGHT: const u32 = 0;
CONE_LIGHT: const u32 = 1;
DIRECTIONAL_LIGHT: const u32 = 68;

// One light of the table. A sun keeps the direction its light travels in `position` and its illuminance in `color`.
Light: struct {
	position: vec3f,
	// A point or cone light's intensity, in candela per color channel, or a sun's illuminance, in lux.
	color: vec3f,
	direction: vec3f,
	// The cosines of a cone's inner and outer half angles.
	cone_cosines: vec2f,
	type: u32,
	// A sun's four cascade views, or a cone's view or a point's first cube-face view in the first, zero without a shadow.
	// Eight scalars hold the bytes of the `u32[4]`, size class, and padding that material evaluation declares, at the
	// same offsets on every backend.
	shadow_view_0: u32,
	shadow_view_1: u32,
	shadow_view_2: u32,
	shadow_view_3: u32,
	// The size class of a cone or point light's map, which indexes the cone or point shadow map images.
	shadow_size_class: u32,
	_padding_0: u32,
	_padding_1: u32,
	_padding_2: u32,
	shadow_layer: u32,
	ies_profile_texture: u32,
	ies_c0_tangent: vec2u16,
	// How far the light reaches, in meters, past which material evaluation leaves it out.
	reach: f32,
	_angular_radius_tangent: f32,
}

LightingBuffer: struct {
	light_count: u32,
	// The camera exposure as a linear factor.
	exposure: f32,
	// Scales the environment's light.
	environment_intensity: f32,
	lights: Light[1024],
}
