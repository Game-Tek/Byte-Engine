// The descriptor set of the material dispatch passes, which count the pixels of each material evaluation slot, turn
// the counts into list offsets and indirect dispatches, and write each slot's pixel list. Every table is indexed by
// evaluation slot: materials that compile to one evaluation pipeline share a slot. Material evaluation reads the
// same buffers through `visibility-buffer.besl`, which declares them read-only.

// The number of pixels each evaluation slot shades.
MaterialCount: struct {
	material_count: atomicu32[1024],
}

// Indexed by evaluation slot, like the counts the offsets were scanned from.
MaterialOffsetScratch: struct {
	material_offset_scratch: atomicu32[1024],
}

MaterialOffset: struct {
	material_offset: u32[1024],
}

MaterialEvaluationDispatches: struct {
	material_evaluation_dispatches: vec3u[1024],
}

PixelMapping: struct {
	pixel_mapping: vec2u16[8294400],
}

MaterialDispatch: layer {
	material_count_buffer: descriptor<{ type: MaterialCount, binding: 0, access: read_write, memory: device }>;
	material_offset_buffer: descriptor<{ type: MaterialOffset, binding: 1, access: read_write, memory: device }>;
	material_offset_scratch_buffer: descriptor<{ type: MaterialOffsetScratch, binding: 2, access: read_write, memory: device }>;
	material_evaluation_dispatches: descriptor<{ type: MaterialEvaluationDispatches, binding: 3, access: read_write, memory: device }>;
	pixel_mapping_buffer: descriptor<{ type: PixelMapping, binding: 4, access: write, memory: device }>;
	// The instance under each pixel, from the visibility buffer.
	instance_index_render_target: descriptor<{ type: StorageImage<r32ui>, binding: 5, access: read }>;
}
