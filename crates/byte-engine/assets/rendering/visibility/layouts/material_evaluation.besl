// The descriptor set of material evaluation: the images it shades into and everything lighting reads. The pixel
// mapping pass takes it too, to clear the images before evaluation. Bindings of a feature a project leaves out stay
// declared and are never reached, so they need no resource.
// `rendering/pipelines/visibility/render_pass.rs` creates it and binds its resources by these names.

Light: struct {
	position: vec3f,
	color: vec3f,
	direction: vec3f,
	cone_cosines: vec2f,
	type: u32,
	// A sun's four cascade views, or a cone's view or a point's first cube-face view in the first entry.
	shadow_views: u32[4],
	// The size class of a cone or point light's map, which indexes `cone_shadow_maps` or `point_shadow_maps`.
	shadow_size_class: u32,
	_padding_0: u32,
	_padding_1: u32,
	_padding_2: u32,
	// A sun's slot, a cone's layer, or a point's cube within the image of its size class.
	shadow_layer: u32,
	ies_profile: u32,
	ies_c0_tangent: vec2u16,
	reach: f32,
	angular_radius_tangent: f32,
}

// The light table outgrows constant-buffer limits, so it is a read-only storage buffer.
LightingData: struct {
	light_count: u32,
	exposure: f32,
	environment_intensity: f32,
	lights: Light[1024],
}

// One bit per light-table entry for every cluster. See `light-clusters.besl`.
LightClusterMasks: struct {
	words: u32[98304],
}

LightClusterParameters: struct {
	view: mat4x3f,
	edge_slopes: vec2f,
	near: f32,
	depth_slice_scale: f32,
}

// The camera constants of the half-resolution depth pyramid and SSGI images, as `ScreenViewData` lays them out. SSGI
// reads their pixel rays, and `sceneposition` the rays at the screen's corners.
SsgiView: struct {
	pixel_to_ray_mul: vec2f,
	pixel_to_ray_add: vec2f,
	projection_pixels_y: f32,
	view_z_sign: f32,
	depth_unproject_numerator: f32,
	depth_unproject_denominator_offset: f32,
}

ReflectionParameters: struct {
	world_to_previous_clip: mat4f,
	previous_exposure: f32,
	history_valid: u32,
	previous_depth_unproject_numerator: f32,
	previous_depth_unproject_denominator_offset: f32,
}

// Shadow lookups read the nearest occluder in the 2x2 texel footprint around a corner of the pyramid's base level.
nearest_occluder: sampler<{ filter: linear, mip_filter: nearest, reduction: max }>;
// The backdrop's light blends between pixels, so a refracted lookup moves smoothly. Its depth reads the pixel it falls
// in, since depths on either side of an edge belong to different surfaces. Both stop at the screen's edges.
backdrop_light: sampler<{ filter: linear, mip_filter: nearest, address: clamp }>;
backdrop_texel: sampler<{ filter: nearest, mip_filter: nearest, address: clamp }>;
// Reflection rays read the texel under each step, so a hit's light never blends with the background beside it. Past
// the screen's edge the image repeats mirrored, so a ray that leaves the screen keeps finding plausible depth instead
// of the edge texel smeared outward.
reflection_texel: sampler<{ filter: nearest, mip_filter: nearest, address: mirror }>;

MaterialEvaluation: layer {
	lit_map: descriptor<{ type: StorageImage<r11f_g11f_b10f>, binding: 0, access: read_write }>;
	lighting_data: descriptor<{ type: LightingData, binding: 1, access: read, memory: device }>;
	// The half-resolution SSGI history and normals, from which opaque evaluation reconstructs indirect diffuse light.
	ssgi_normals: descriptor<{ type: Texture2D, binding: 2, access: read }>;
	ssgi_view: descriptor<{ type: SsgiView, binding: 3, access: read, memory: device }>;
	ao: descriptor<{ type: Texture2D, binding: 4, access: read }>;
	depth_shadow_map: descriptor<{ type: Texture2DArray, binding: 5, access: read }>;
	directional_shadow_depth_pyramid: descriptor<{ type: Texture2D, binding: 6, access: read, sampler: nearest_occluder }>;
	environment_irradiance: descriptor<{ type: TextureCube, binding: 7, access: read }>;
	environment_specular: descriptor<{ type: TextureCube, binding: 8, access: read }>;
	ssgi_history: descriptor<{ type: Texture2D, binding: 9, access: read }>;
	// This frame's diffuse radiance, which the next frame's SSGI rays read.
	diffuse_radiance_map: descriptor<{ type: StorageImage<rgba16f>, binding: 10, access: write }>;
	// The sun's resolved visibility per opaque pixel, one channel per sun slot.
	sun_visibility: descriptor<{ type: Texture2D, binding: 11, access: read }>;
	reflection_parameters: descriptor<{ type: ReflectionParameters, binding: 12, access: read, memory: constant }>;
	// Mip zero of the linear depth pyramid, which reflection rays march and the indirect diffuse upsample reads.
	depth_pyramid: descriptor<{ type: Texture2D, binding: 13, access: read, sampler: reflection_texel }>;
	// The previous frame's lit image and reverse-Z depth, which reflection rays read the light at their hit from.
	previous_lit: descriptor<{ type: Texture2D, binding: 14, access: read, sampler: reflection_texel }>;
	previous_depth: descriptor<{ type: Texture2D, binding: 15, access: read, sampler: reflection_texel }>;
	light_cluster_masks: descriptor<{ type: LightClusterMasks, binding: 16, access: read, memory: device }>;
	light_cluster_parameters: descriptor<{ type: LightClusterParameters, binding: 17, access: read, memory: constant }>;
	// The opaque scene's light and positive linear view depth as they stood before the transparent phase, which blended
	// materials read the scene behind their surfaces from. See `backdrop.besl`.
	backdrop_color: descriptor<{ type: Texture2D, binding: 18, access: read, sampler: backdrop_light }>;
	backdrop_depth: descriptor<{ type: Texture2D, binding: 19, access: read, sampler: backdrop_texel }>;
	// One image per power-of-two size class of cone maps and point cube faces, from 128 texels per side up to 2048. A
	// light reads the image of its `shadow_size_class`. Arrayed bindings take `count` flat slots, so they sit past every
	// other binding of the layers a shader takes with this one.
	cone_shadow_maps: descriptor<{ type: Texture2DArray, binding: 20, access: read, count: 5 }>;
	point_shadow_maps: descriptor<{ type: TextureCubeArray, binding: 21, access: read, count: 5 }>;
	// The renderer's debug target pool, which the shown debug views of material evaluation write; see `debug_views.rs`.
	// An arrayed binding takes `count` flat slots, so it sits past every other binding of the layers a
	// shader takes with this one.
	debug_view_targets: descriptor<{ type: StorageImage, binding: 22, access: write, count: 15 }>;
}
