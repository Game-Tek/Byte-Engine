// The scene descriptor set of the visibility pipeline: the views, the instance and material tables, the geometry
// streams, and the bindless textures. Every stage that draws or shades the scene binds it, and reads what it needs from
// it. `rendering/pipelines/visibility/manager.rs` creates it and binds its resources by these names.

use ::byte_engine::rendering::visibility::layouts::scene_records::*;

// The camera, then each sun's cascades, then cone layers, then point cube faces.
Views: struct {
	views: View[129],
}

// What every pass of a frame shares: the frame clock's elapsed seconds, which a material's `time` node reads.
Frame: struct {
	time: f32,
}

// A material's bindless texture slots, its arm in the coverage shaders, and the opacity below which the masked passes
// leave out its fragments. A material the coverage shaders don't test has the arm 4294967295.
Material: struct {
	textures: u32[16],
	coverage_arm: u32,
	alpha_cutoff: f32,
	padding: vec2u,
}

Materials: struct {
	materials: Material[1024],
}

// The evaluation slot of every material table entry. Materials that compile to one evaluation pipeline share a slot,
// and 4294967295 marks a material no evaluation shades.
MaterialEvaluations: struct {
	evaluation_indices: u32[1024],
}

// Material textures repeat outside their bounds. Anisotropic filtering keeps surfaces seen at grazing angles, like
// floors, sharp instead of blurring them to the mip their steepest direction needs.
material_texel: sampler<{ address: repeat, anisotropy: 16 }>;
// IES profiles and lightmap rectangles end at their image's edges, which must not wrap to the opposite side.
clamped_texel: sampler<{ address: clamp }>;

Scene: layer {
	views: descriptor<{ type: Views, binding: 0, access: read, memory: constant }>;
	// One record per instance the frame draws, as many as the pipeline's instance capacity.
	meshes: descriptor<{ type: Mesh[], binding: 1, access: read, memory: device }>;
	// The resident detail levels, which instances name in `Mesh::level`.
	mesh_levels: descriptor<{ type: MeshLevel[], binding: 14, access: read, memory: device }>;
	vertex_positions: descriptor<{ type: vec3f[], binding: 2, access: read, memory: device }>;
	// Octahedrally encoded unit normals.
	vertex_normals: descriptor<{ type: vec2u16[], binding: 3, access: read, memory: device }>;
	vertex_uvs: descriptor<{ type: vec2f16[], binding: 4, access: read, memory: device }>;
	vertex_indices: descriptor<{ type: u16[], binding: 5, access: read, memory: device }>;
	// Three meshlet-local vertex indices per triangle.
	primitive_indices: descriptor<{ type: u8[], binding: 6, access: read, memory: device }>;
	meshlets: descriptor<{ type: Meshlet[], binding: 7, access: read, memory: device }>;
	// The bindless texture pool that material table entries index.
	textures: descriptor<{ type: Texture2D, binding: 8, access: read, count: 1024, sampler: material_texel }>;
	materials: descriptor<{ type: Materials, binding: 9, access: read, memory: device }>;
	// One packed work item per group of meshlets a task workgroup culls: the group's chunk of 32 meshlets in the low 7
	// bits, and the instance above them.
	mesh_dispatch_work: descriptor<{ type: u32[], binding: 10, access: read, memory: device }>;
	// The evaluation slot of every material table entry, which the material prepasses bucket pixels by.
	material_evaluations: descriptor<{ type: MaterialEvaluations, binding: 11, access: read, memory: device }>;
	// The values of dynamic material parameters, one entry per parameter. An instance's parameter block, in the high
	// half of `Mesh::material`, names where its material's parameters start, in the order the material declares them.
	material_parameters: descriptor<{ type: vec4f[], binding: 12, access: read, memory: device }>;
	// Lightmap UVs as UNORM16 pairs, zero for vertices of primitives without them.
	vertex_lightmap_uvs: descriptor<{ type: vec2u16[], binding: 13, access: read, memory: device }>;
	// The calibrated IES intensity profiles that lights' `ies_profile` index.
	ies_profiles: descriptor<{ type: Texture2D, binding: 15, access: read, count: 64, sampler: clamped_texel }>;
	// The baked lightmaps that instances' lightmap records index.
	lightmaps: descriptor<{ type: Texture2D, binding: 16, access: read, count: 16, sampler: clamped_texel }>;
	frame: descriptor<{ type: Frame, binding: 17, access: read, memory: constant }>;
}
