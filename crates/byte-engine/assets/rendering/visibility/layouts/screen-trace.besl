// The inputs of a pass that marches or reprojects through the linear depth pyramid, with helpers to move between
// texels and view space and to rebuild and store a texel's normal. List it after `screen-view.besl`.

// Two tangents whose cross product is shorter than this share of their lengths' product are parallel, so they rebuild
// no normal. GTAO's normal reconstruction tests the same.
NORMAL_SIN_SQ_EPSILON: const f32 = 0.00000001;

// The screen view constants describe the trace image, mip zero of the linear depth pyramid.
screen_view: descriptor<{ type: ScreenView, binding: 0, access: read }>;

// Mip zero holds positive linear depth at the trace resolution.
depth_pyramid: descriptor<{ type: Texture2D, binding: 1033, access: read }>;

// Interleaved gradient noise (Jimenez 2014). Each 3x3 pixel block covers [0, 1) evenly.
// https://www.iryoku.com/next-generation-post-processing-in-call-of-duty-advanced-warfare/
interleaved_gradient_noise: fn (pixel: vec2f) -> f32 {
	return fract(52.9829189 * fract(0.06711056 * pixel.x + 0.00583715 * pixel.y));
}

// Returns the view-space position at continuous texel coordinates, where integers are texel centers.
view_position: fn (pixel: vec2f, z: f32) -> vec3f {
	let ray: vec2f = pixel * screen_view.pixel_to_ray_mul + screen_view.pixel_to_ray_add;
	return vec3f(ray.x * z, ray.y * z, z);
}

// Projects a view-space position to continuous texel coordinates, where integers are texel centers.
project_to_pixel: fn (position: vec3f) -> vec2f {
	let ray: vec2f = vec2f(position.x / position.z, position.y / position.z);
	return (ray - screen_view.pixel_to_ray_add) / screen_view.pixel_to_ray_mul;
}

// Returns the error of predicting the center depth by extending the line through two neighbors on one side, in 1/z.
// 1/z is linear across the screen on a plane, so a side on the center's own surface predicts it exactly.
side_error: fn (center_z: f32, near_z: f32, far_z: f32) -> f32 {
	if (near_z == 0.0 || far_z == 0.0) {
		return 1000000.0;
	}
	return abs(2.0 / near_z - 1.0 / far_z - 1.0 / center_z);
}

// Reads the depth `offset` texels away from `pixel`, or zero when that texel is outside the image.
neighbor_depth: fn (pixel: vec2u, offset_x: f32, offset_y: f32, extent: vec2u) -> f32 {
	let x: f32 = f32(pixel.x) + offset_x;
	let y: f32 = f32(pixel.y) + offset_y;
	if (x < 0.0 || y < 0.0 || x >= f32(extent.x) || y >= f32(extent.y)) {
		return 0.0;
	}
	return fetch(depth_pyramid, vec2u(u32(x), u32(y))).x;
}

// Returns the view-space tangent along one screen axis, oriented toward the positive axis, or zero without one.
// `positive_z` and `positive_far_z` are the depths one and two texels along `axis`, and the negative pair lies the other
// way. It uses the side whose neighbors best extend the center's surface (atyuwen, "Accurate Normal Reconstruction from
// Depth Buffer", 2020). Taking the nearer neighbor instead fails at creases, where a touching object can be closer
// in depth than the center's own surface.
axis_tangent: fn (
	pixel: vec2f,
	axis: vec2f,
	center_position: vec3f,
	positive_z: f32,
	negative_z: f32,
	positive_far_z: f32,
	negative_far_z: f32
) -> vec3f {
	let positive_error: f32 = side_error(center_position.z, positive_z, positive_far_z);
	let negative_error: f32 = side_error(center_position.z, negative_z, negative_far_z);
	if (positive_z != 0.0 && (positive_error <= negative_error || negative_z == 0.0)) {
		return view_position(pixel + axis, positive_z) - center_position;
	}
	if (negative_z != 0.0) {
		return center_position - view_position(pixel - axis, negative_z);
	}
	return vec3f(0.0, 0.0, 0.0);
}

// Turns two screen-axis tangents into a camera-facing view-space normal, or zero when they are degenerate.
tangent_normal: fn (dx: vec3f, dy: vec3f, center_position: vec3f) -> vec3f {
	let unnormalized: vec3f = cross(dx, dy);
	let normal_length_sq: f32 = dot(unnormalized, unnormalized);
	let tangent_product: f32 = dot(dx, dx) * dot(dy, dy);
	if (tangent_product == 0.0 || normal_length_sq <= tangent_product * NORMAL_SIN_SQ_EPSILON) {
		return vec3f(0.0, 0.0, 0.0);
	}
	let normal: vec3f = unnormalized * inversesqrt(normal_length_sq);
	// Visible surfaces face the camera at the origin, which fixes the winding of the cross product.
	if (dot(normal, center_position) > 0.0) {
		return vec3f(0.0, 0.0, 0.0) - normal;
	}
	return normal;
}

// Encodes a unit normal as an octahedral pair for the two-channel normal image, or zero for a zero normal. Material
// evaluation's `ssgi_stored_normal` decodes it as `decode_stored_normal` does.
encode_stored_normal: fn (normal: vec3f) -> vec4f {
	let length: f32 = abs(normal.x) + abs(normal.y) + abs(normal.z);
	if (length == 0.0) {
		return vec4f(0.0, 0.0, 0.0, 0.0);
	}
	let projected: vec2f = vec2f(normal.x, normal.y) * (1.0 / length);
	if (normal.z < 0.0) {
		// The lower hemisphere folds into the corners. `step` picks the positive direction at zero.
		projected = vec2f(
			(1.0 - abs(projected.y)) * (step(0.0, projected.x) * 2.0 - 1.0),
			(1.0 - abs(projected.x)) * (step(0.0, projected.y) * 2.0 - 1.0)
		);
	}
	return vec4f(projected.x, projected.y, 0.0, 0.0);
}

// Decodes a normal `encode_stored_normal` stored as an octahedral pair in RG, or returns zero for the pair (0, 0), which
// marks a texel without a normal. That pair encodes +z, which points away from the camera and so is never a stored
// normal.
decode_stored_normal: fn (stored: vec4f) -> vec3f {
	if (stored.x == 0.0 && stored.y == 0.0) {
		return vec3f(0.0, 0.0, 0.0);
	}
	let z: f32 = 1.0 - abs(stored.x) - abs(stored.y);
	let fold: f32 = max(0.0 - z, 0.0);
	// `step` returns the positive direction at zero, matching the encoder.
	let normal: vec3f = vec3f(
		stored.x - (step(0.0, stored.x) * 2.0 - 1.0) * fold,
		stored.y - (step(0.0, stored.y) * 2.0 - 1.0) * fold,
		z
	);
	return normal * inversesqrt(dot(normal, normal));
}
