// The descriptor set of the skinning pass: the rest-pose vertex streams, the joint palettes, and the resident vertex
// streams it writes each posed instance's range of. List it after `scene-records.besl`.

MatrixPalette: struct {
	values: mat4x3f[65536],
}

DualQuaternion: struct {
	real: vec4f,
	dual: vec4f,
}

DualQuaternionPalette: struct {
	values: DualQuaternion[65536],
}

// Bind-pose sources are sized by the geometry capacity at runtime.
source_positions: descriptor<{ type: vec3f[], binding: 0, access: read, memory: device }>;
source_normals: descriptor<{ type: vec3f[], binding: 1, access: read, memory: device }>;
source_joints: descriptor<{ type: vec4u16[], binding: 2, access: read, memory: device }>;
source_weights: descriptor<{ type: vec4f[], binding: 3, access: read, memory: device }>;
matrix_palette: descriptor<{ type: MatrixPalette, binding: 4, access: read, memory: device }>;
// The resident streams, sized by the geometry capacity, which every stage reads posed instances from.
vertex_positions: descriptor<{ type: vec3f[], binding: 5, access: write, memory: device }>;
// Octahedrally encoded unit normals, as the loader writes them.
vertex_normals: descriptor<{ type: vec2u16[], binding: 7, access: write, memory: device }>;
dual_quaternion_palette: descriptor<{ type: DualQuaternionPalette, binding: 6, access: read, memory: device }>;
