// The descriptor set of the SSGI temporal filter: this frame's rays and normals, last frame's history, depth, and
// normals, and the history it writes.

raw_radiance: descriptor<{ type: Texture2D, binding: 1034, access: read }>;
history_output: descriptor<{ type: StorageImage<rgba16f>, binding: 1035, access: write }>;
previous_history: descriptor<{ type: Texture2D, binding: 1036, access: read }>;
previous_depth_pyramid: descriptor<{ type: Texture2D, binding: 1037, access: read }>;
surface_normals: descriptor<{ type: Texture2D, binding: 1038, access: read }>;
previous_surface_normals: descriptor<{ type: Texture2D, binding: 1039, access: read }>;
