// The descriptor set of the SSGI temporal filter: this frame's rays and normals, last frame's history, depth, and
// normals, and the history it writes.

SsgiTemporal: layer {
	raw_radiance: descriptor<{ type: Texture2D, binding: 0, access: read }>;
	history_output: descriptor<{ type: StorageImage<rgba16f>, binding: 1, access: write }>;
	previous_history: descriptor<{ type: Texture2D, binding: 2, access: read }>;
	previous_depth_pyramid: descriptor<{ type: Texture2D, binding: 3, access: read }>;
	surface_normals: descriptor<{ type: Texture2D, binding: 4, access: read }>;
	previous_surface_normals: descriptor<{ type: Texture2D, binding: 5, access: read }>;
}
