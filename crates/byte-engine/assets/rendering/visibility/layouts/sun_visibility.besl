// The descriptor set of the sun visibility resolve: the depths and contact-shadow trace it reads, the visibility buffer
// that names each pixel's triangle, its settings, and the image it
// writes. The sun's cascades come from `directional_shadows.besl`. The views that hold the camera and the cascades, and the geometry the triangles index, come from
// `scene.besl`.

use ::byte_engine::rendering::visibility::layouts::directional_shadows::*;

SunVisibility: layer {
	visibility_depth: descriptor<{ type: Texture2D, binding: 0, access: read }>;
	sun_visibility_output: descriptor<{ type: StorageImage<rgba8>, binding: 1, access: write }>;
	contact_shadow_trace: descriptor<{ type: Texture2D, binding: 2, access: read }>;
	sun_visibility_parameters: descriptor<{ type: SunVisibilityParameters, binding: 3, access: read }>;
	// The visibility buffer, as `visibility-buffer.besl` declares it: each pixel's meshlet and meshlet triangle, and its
	// instance. The resolve takes the receiver's plane and normal from that triangle.
	primitive_index: descriptor<{ type: StorageImage<r32ui>, binding: 4, access: read }>;
	instance_index: descriptor<{ type: StorageImage<r32ui>, binding: 5, access: read }>;
}
