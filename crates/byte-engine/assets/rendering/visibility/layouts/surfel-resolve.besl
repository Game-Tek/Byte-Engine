// The per-sink set of the surfel resolve, allocation, and reconstruction passes: the sink's cameras, its tiles' spawn
// requests, and the normals the resolve writes for the reconstruction. List it after `surfel-gi.besl`.

SurfelResolveParameters: struct {
	// Maps the sink camera's view-space positions and directions to world space.
	view_to_world: mat4f,
	// Maps a view-space position of this frame to the previous frame's clip space, for the temporal accumulation.
	current_view_to_previous_clip: mat4f,
	// Rotates this frame's view-space normals into the previous camera's axes (multiply with w = 0).
	current_view_to_previous_view: mat4f,
	// Which debug views to write; see `debug_view_slot`.
	debug_views: u32,
	// Spawn tiles per row: one per resolve workgroup.
	spawn_tiles_per_row: u32,
	// The spawn tiles of the sink that its request buffer holds.
	spawn_tile_count: u32,
	// The chance per frame that one resolve pixel one meter from the camera asks for a surfel. It scales with view
	// depth, so distant surfaces, which take fewer pixels, still spawn.
	spawn_probability: f32,
	// Nonzero when the previous frame's surfel history, normals, and depth pyramid hold this sink's data.
	history_valid: u32,
	// Converts the previous frame's pre-exposed light to this frame's exposure.
	history_exposure_ratio: f32,
	_padding0: u32,
	_padding1: u32,
}

// One tile's spawn request.
SurfelSpawn: struct {
	position: vec3f,
	// The normal, packed by `encode_surfel_normal`.
	normal: u32,
	// The surfel the new one copies its light from, or NO_SURFEL.
	parent: u32,
	// Nonzero when the tile asks for a surfel this frame.
	requested: u32,
}

surfel_resolve_parameters: descriptor<{ type: SurfelResolveParameters, binding: 1150, access: read }>;
surfel_spawns: descriptor<{ type: SurfelSpawn[], binding: 1151, access: read_write }>;
// The half-resolution view-space normals the reconstruction and material evaluation compare surfaces with, named
// `SSGI Normals` like SSGI's.
normal_output: descriptor<{ type: StorageImage<rg16_snorm>, binding: 1153, access: write }>;
debug_view_targets: descriptor<{ type: StorageImage, binding: 1154, access: write, count: 15 }>;

// Transforms a view-space point or direction (w = 0) of the sink's camera to world space.
to_world: fn (view: vec3f, w: f32) -> vec3f {
	let world: vec4f = surfel_resolve_parameters.view_to_world * vec4f(view.x, view.y, view.z, w);
	return vec3f(world.x, world.y, world.z);
}
