// The descriptor set of the surfel spatial pass: this frame's surfel history, its weights, and the normals, and the
// image material evaluation reads.

SurfelSpatial: layer {
	// This frame's `Surfel History` and `Surfel History Weights`, which the resolve wrote.
	surfel_temporal_history: descriptor<{ type: Texture2D, binding: 0, access: read }>;
	surfel_temporal_weights: descriptor<{ type: Texture2D, binding: 1, access: read }>;
	// This frame's `SSGI Normals`.
	surfel_spatial_normals: descriptor<{ type: Texture2D, binding: 2, access: read }>;
	// The half-resolution light material evaluation upsamples, named `SSGI History` like SSGI's: pre-exposed light in RGB,
	// as irradiance over π, and the hit fraction in alpha.
	surfel_output: descriptor<{ type: StorageImage<rgba16f>, binding: 3, access: write }>;
}
