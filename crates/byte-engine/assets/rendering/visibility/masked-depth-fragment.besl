Material: struct {
	textures: u32[16],
	coverage_factor: f32,
	coverage_texture_slot: u32,
	alpha_cutoff: f32,
	padding: u32,
}

Materials: struct {
	materials: Material[1024],
}

Mesh: struct {
	model: mat4x3f,
	material_index: u32,
	base_vertex_index: u32,
	base_primitive_index: u32,
	base_triangle_index: u32,
	base_meshlet_index: u32,
	meshlet_count: u32,
	skinned_base_vertex_index: u32,
	padding0: u32,
}

Meshes: struct {
	meshes: Mesh[1024],
}

meshes: descriptor<Meshes, 1, read, device>;
material_textures: descriptor<Texture2D, 9, read, 1024>;
materials: descriptor<Materials, 1046, read, device>;

in_instance_index: input<u32, 0>;
in_uv: input<vec2f16, 2>;

main: fn() -> void {
	let material_index: u32 = meshes.meshes[in_instance_index].material_index;
	let material: Material = materials.materials[material_index];
	let coverage: f32 = material.coverage_factor;
	if (material.coverage_texture_slot != 4294967295) {
		let texture_index: u32 = material.textures[material.coverage_texture_slot];
		coverage = coverage * sample(material_textures[texture_index], vec2f(in_uv)).w;
	}
	if (coverage < material.alpha_cutoff) {
		discard;
	}
}
