Material: struct {
	textures: u32[16],
	coverage_factor: f32,
	coverage_texture_slot: u32,
	alpha_cutoff: f32,
	padding: u32,
}

Materials: struct {
	materials: Material[1024],
}

Mesh: struct {
	model: mat4x3f,
	material_index: u32,
	base_vertex_index: u32,
	base_primitive_index: u32,
	base_triangle_index: u32,
	base_meshlet_index: u32,
	meshlet_count: u32,
	skinned_base_vertex_index: u32,
	flags: u32,
	bounding_sphere: vec4f,
}

Meshes: struct {
	meshes: Mesh[1024],
}

meshes: descriptor<{ type: Meshes, binding: 1, access: read, memory: device }>;
material_textures: descriptor<{ type: Texture2D, binding: 9, access: read, count: 1024 }>;
materials: descriptor<{ type: Materials, binding: 1046, access: read, memory: device }>;

main: fn (
	input: StageInput,
	pipeline_input: interface {
		instance_index: u32,
		primitive_index: u32,
		uv: vec2f16,
	},
) -> output {
	primitive_index: u32,
	instance_id: u32,
} {
	let material_index: u32 = meshes.meshes[pipeline_input.instance_index].material_index;
	// Read only the material fields the alpha test uses, instead of copying the whole material and its texture slots.
	let coverage: f32 = materials.materials[material_index].coverage_factor;
	let coverage_texture_slot: u32 = materials.materials[material_index].coverage_texture_slot;
	if (coverage_texture_slot != 4294967295) {
		let texture_index: u32 = materials.materials[material_index].textures[coverage_texture_slot];
		coverage = coverage * sample(material_textures[texture_index], vec2f(pipeline_input.uv)).w;
	}
	if (coverage < materials.materials[material_index].alpha_cutoff) {
		discard;
	}
	return {
		primitive_index: pipeline_input.primitive_index,
		instance_id: pipeline_input.instance_index,
	};
}
