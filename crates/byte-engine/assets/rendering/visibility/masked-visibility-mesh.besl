// Draws the groups of meshlets the task stage kept into the visibility buffer, for masked materials: each triangle's
// instance, its meshlet and place in it, and the material word and UV the coverage shader's alpha test reads. Other materials draw with
// `visibility-mesh.besl`, which passes no UV.

use ::byte_engine::rendering::visibility::layouts::scene_records::*;
use ::byte_engine::rendering::visibility::layouts::scene::*;

// The task stage's kept meshlets, in groups that each fill one mesh grid. `scene_records` gives the format.
meshlet_instances: task_payload<u32, 193>;
// The instance, once per vertex: every vertex of a meshlet shares it, and a grid has half as many vertices as
// triangles. Integers aren't interpolated, so each triangle reads it whole.
out_instance_index: vertex_output<u32, 0, 128>;
// The instance's material word, the same way, so the fragments find their material without reading the instance
// record. The coverage shader's interface sorts its fields by name, which sets these locations.
out_material_word: vertex_output<u32, 1, 128>;
out_primitive_index: output<u32, 2, 252>;
// One UV per vertex, interpolated across each triangle for the alpha test.
out_uv: vertex_output<vec2f16, 3, 128>;

// The task stage's batch layout. The camera's visibility pass draws one view into an unlayered target.
push_constant: push_constant {
	work_range: u32,
	view_base: u32,
	layer_base: u32,
	view_count: u32,
}

main: fn(scene: Scene) -> void {
	let group: u32 = threadgroup_position();
	let work: u32 = meshlet_instances[MESHLET_PAYLOAD_WORK];
	let thread: u32 = thread_idx();

	// Find the entries that hold this thread's vertex and two triangles among the group's, and the group's totals.
	// Each entry's vertices and triangles follow those of the entries before it, and its triangles name its own
	// vertices. A grid emits up to twice as many triangles as it has threads, so each thread draws the triangle of its
	// index and the one MESH_THREADS after it.
	let vertex_entry: u32 = 0;
	let vertex_start: u32 = 0;
	let first_entry: u32 = 0;
	let first_start: u32 = 0;
	let first_vertex_start: u32 = 0;
	let second_entry: u32 = 0;
	let second_start: u32 = 0;
	let second_vertex_start: u32 = 0;
	let second: u32 = thread + MESH_THREADS;
	let vertex_count: u32 = 0;
	let triangle_count: u32 = 0;
	for (let index: u32 = group_first_entry(meshlet_instances[group]); index < MESHLET_PAYLOAD_WORK; index = index + 1) {
		let entry: u32 = meshlet_instances[index];
		if (thread >= vertex_count && thread < entry_vertex_end(entry)) {
			vertex_entry = entry;
			vertex_start = vertex_count;
		}
		if (thread >= triangle_count && thread < entry_triangle_end(entry)) {
			first_entry = entry;
			first_start = triangle_count;
			first_vertex_start = vertex_count;
		}
		if (second >= triangle_count && second < entry_triangle_end(entry)) {
			second_entry = entry;
			second_start = triangle_count;
			second_vertex_start = vertex_count;
		}
		vertex_count = entry_vertex_end(entry);
		triangle_count = entry_triangle_end(entry);
		if ((entry & MESHLET_ENTRY_ENDS_GROUP) != 0) {
			break;
		}
	}

	set_mesh_output_counts(vertex_count, triangle_count);

	if (thread < vertex_count) {
		// The entry's lane names its instance and meshlet through the workgroup's work items.
		let lane: u32 = entry_lane(vertex_entry);
		let item: u32 = scene.mesh_dispatch_work[lane_work_index(work, lane)];
		let instance_index: u32 = item >> 7;
		let mesh: Mesh = scene.meshes[instance_index];
		let level: MeshLevel = scene.mesh_levels[mesh.level & MESH_LEVEL_MASK];
		let meshlet: Meshlet = scene.meshlets[level.first_meshlet + lane_meshlet(work, item, lane)];
		let view: View = scene.views.views[push_constant.view_base + entry_view_offset(vertex_entry)];
		// A meshlet's vertices lie in a row in the meshlet vertex buffer when it keeps them there. Otherwise, and for a
		// posed instance, each is looked up through its index.
		let meshlet_vertex: u32 = meshlet.primitive_offset + thread - vertex_start;
		let object_position: vec3f = vec3f(0.0, 0.0, 0.0);
		let uv: vec2f16 = vec2f16(0.0, 0.0);
		if (draws_local_vertices(mesh, meshlet)) {
			let local: MeshletVertex = scene.meshlet_vertices[meshlet_vertex];
			object_position = meshlet_vertex_position(local, level);
			uv = local.uv;
		} else {
			// A posed instance's record points at its own range, which skinning wrote this frame.
			let vertex_index: u32 = instance_vertex_base(mesh, level) + u32(scene.vertex_indices[meshlet_vertex]);
			object_position = scene.vertex_positions[vertex_index];
			uv = scene.vertex_uvs[vertex_index];
		}
		let world_position: vec3f = mesh.model * vec4f(object_position.x, object_position.y, object_position.z, 1.0);
		set_mesh_vertex_position(thread, view.view_projection * vec4f(world_position.x, world_position.y, world_position.z, 1.0));
		out_uv[thread] = uv;
		out_instance_index[thread] = instance_index;
		out_material_word[thread] = mesh.material;
	}

	for (let slot: u32 = 0; slot < 2; slot = slot + 1) {
		let triangle_thread: u32 = thread + slot * MESH_THREADS;
		let triangle_entry: u32 = first_entry;
		let triangle_start: u32 = first_start;
		let triangle_vertex_start: u32 = first_vertex_start;
		if (slot == 1) {
			triangle_entry = second_entry;
			triangle_start = second_start;
			triangle_vertex_start = second_vertex_start;
		}
		if (triangle_thread < triangle_count) {
			// The entry's lane names its instance and meshlet through the workgroup's work items.
			let lane: u32 = entry_lane(triangle_entry);
			let item: u32 = scene.mesh_dispatch_work[lane_work_index(work, lane)];
			let instance_index: u32 = item >> 7;
			let mesh: Mesh = scene.meshes[instance_index];
			let level: MeshLevel = scene.mesh_levels[mesh.level & MESH_LEVEL_MASK];
			let meshlet_index: u32 = level.first_meshlet + lane_meshlet(work, item, lane);
			let meshlet: Meshlet = scene.meshlets[meshlet_index];
			let first_index: u32 = (meshlet.triangle_offset + triangle_thread - triangle_start) * 3;
			// A triangle names its meshlet's vertices, which follow the vertices of the group's earlier entries.
			let triangle: vec3u = vec3u(
				u32(scene.primitive_indices[first_index]),
				u32(scene.primitive_indices[first_index + 1]),
				u32(scene.primitive_indices[first_index + 2])
			) + vec3u(triangle_vertex_start, triangle_vertex_start, triangle_vertex_start);
			set_mesh_triangle(triangle_thread, instance_triangle(mesh, triangle));
			out_primitive_index[triangle_thread] = (meshlet_index << 8) | ((triangle_thread - triangle_start) & 255);
		}
	}
}
