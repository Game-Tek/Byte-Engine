Mesh: struct {
	model: mat4x3f,
	material_index: u32,
	base_vertex_index: u32,
	base_primitive_index: u32,
	base_triangle_index: u32,
	base_meshlet_index: u32,
	meshlet_count: u32,
	skinned_base_vertex_index: u32,
	flags: u32,
	bounding_sphere: vec4f,
}

MeshData: struct {
	meshes: Mesh[1024],
}

// The evaluation slot of every material table entry. Materials that compile to one evaluation pipeline share a slot,
// and 4294967295 marks a material no evaluation shades.
MaterialEvaluations: struct {
	evaluation_indices: u32[1024],
}

// Indexed by evaluation slot: materials that compile to one evaluation pipeline share a slot and its count.
MaterialCount: struct {
	material_count: atomicu32[1024],
}

mesh_data: descriptor<{ type: MeshData, binding: 1, access: read, memory: device }>;
material_evaluations: descriptor<{ type: MaterialEvaluations, binding: 1068, access: read, memory: device }>;
material_count_buffer: descriptor<{ type: MaterialCount, binding: 1033, access: read_write, memory: device }>;
instance_index_render_target: descriptor<{ type: StorageImage<r32ui>, binding: 1040, access: read }>;

tile_histogram_keys: workgroup<atomicu32, 32>;
tile_histogram_counts: workgroup<atomicu32, 32>;

MATERIAL_COUNT_TILE_CAPACITY: const u32 = 32;
INVALID_EVALUATION_INDEX: const u32 = 4294967295;

main: fn (input: StageInput) -> void {
	let coord: vec2u = input.thread_id;
	let extent: vec2u = image_size(instance_index_render_target);
	// The pixel's evaluation slot. Pixels are counted per slot, not per material, so every material of a slot is
	// shaded by one dispatch.
	let evaluation_index: u32 = INVALID_EVALUATION_INDEX;

	if (coord.x < extent.x && coord.y < extent.y) {
		let pixel_instance_index: u32 = image_load_u32(instance_index_render_target, coord);
		if (pixel_instance_index < 1024) {
			evaluation_index = material_evaluations.evaluation_indices[mesh_data.meshes[pixel_instance_index].material_index];
		}
	}

	if (input.thread_idx < MATERIAL_COUNT_TILE_CAPACITY) {
		atomic_store(tile_histogram_keys[input.thread_idx], INVALID_EVALUATION_INDEX);
		atomic_store(tile_histogram_counts[input.thread_idx], 0);
	}
	workgroup_barrier();

	// A subgroup elects one leader per evaluation, so matching pixels update the tile histogram together.
	let remaining: vec4u = subgroup_ballot(evaluation_index < 1024);
	for (
		let has_remaining: bool = subgroup_ballot_any(remaining);
		has_remaining;
		has_remaining = subgroup_ballot_any(remaining)
	) {
		let leader_lane: u32 = subgroup_ballot_find_lsb(remaining);
		let leader_evaluation_index: u32 = subgroup_broadcast_u32(evaluation_index, leader_lane);
		let matching: vec4u = subgroup_ballot(evaluation_index == leader_evaluation_index);
		let matching_count: u32 = subgroup_ballot_count(matching);

		if (subgroup_lane_index() == leader_lane) {
			let claimed_slot: u32 = INVALID_EVALUATION_INDEX;
			for (
				let probe: u32 = 0;
				probe < MATERIAL_COUNT_TILE_CAPACITY && claimed_slot == INVALID_EVALUATION_INDEX;
				probe = probe + 1
			) {
				let slot: u32 = (leader_evaluation_index + probe) & 31;
				let key: u32 = atomic_load(tile_histogram_keys[slot]);
				// Most later leaders hit an established key and avoid a contended compare-exchange. An empty slot is
				// claimed, unless another leader claims it first.
				if (key == INVALID_EVALUATION_INDEX) {
					key = atomic_compare_exchange(tile_histogram_keys[slot], INVALID_EVALUATION_INDEX, leader_evaluation_index);
				}
				if (key == INVALID_EVALUATION_INDEX || key == leader_evaluation_index) {
					atomic_add(tile_histogram_counts[slot], matching_count);
					claimed_slot = slot;
				}
			}

			if (claimed_slot == INVALID_EVALUATION_INDEX) {
				// A full tile hash falls back once per subgroup evaluation partition, not once per pixel.
				atomic_add(material_count_buffer.material_count[leader_evaluation_index], matching_count);
			}
		}

		remaining = subgroup_ballot_and_not(remaining, matching);
	}
	workgroup_barrier();

	// Distinct occupied slots flush independently after the tile histogram is complete.
	if (input.thread_idx < MATERIAL_COUNT_TILE_CAPACITY) {
		let key: u32 = atomic_load(tile_histogram_keys[input.thread_idx]);

		if (key < 1024) {
			atomic_add(material_count_buffer.material_count[key], atomic_load(tile_histogram_counts[input.thread_idx]));
		}
	}
}
