MaterialCount: struct {
	material_count: atomicu32[1024],
}

MaterialOffset: struct {
	material_offset: u32[1024],
}

MaterialOffsetScratch: struct {
	material_offset_scratch: atomicu32[1024],
}

MaterialEvaluationDispatches: struct {
	material_evaluation_dispatches: vec3u[1024],
}

material_count_buffer: descriptor<{ type: MaterialCount, binding: 1033, access: read_write }>;
material_offset_buffer: descriptor<{ type: MaterialOffset, binding: 1034, access: read_write }>;
material_offset_scratch_buffer: descriptor<{ type: MaterialOffsetScratch, binding: 1035, access: read_write }>;
material_evaluation_dispatches: descriptor<{ type: MaterialEvaluationDispatches, binding: 1036, access: read_write }>;

// Each thread's running total while the workgroup scans them.
thread_totals: workgroup<u32, 256>;

// One workgroup scans the pixel count of every evaluation slot: each thread owns four consecutive slots. Materials that
// compile to one evaluation pipeline share a slot, so its offset starts one pixel list for all of them.
MATERIAL_OFFSET_WORKGROUP_SIZE: const u32 = 256;
MATERIALS_PER_THREAD: const u32 = 4;

main: fn (input: StageInput) -> void {
	let thread: u32 = input.thread_idx;
	let first_material: u32 = thread * MATERIALS_PER_THREAD;
	let thread_total: u32 = 0;
	for (let i: u32 = 0; i < MATERIALS_PER_THREAD; i = i + 1) {
		thread_total = thread_total + atomic_load(material_count_buffer.material_count[first_material + i]);
	}
	thread_totals[thread] = thread_total;
	workgroup_barrier();

	// An inclusive scan of the thread totals: after the step of distance d, each total covers the 2d threads ending at
	// it. Every thread reads before any thread writes, so each step needs two barriers.
	for (let distance: u32 = 1; distance < MATERIAL_OFFSET_WORKGROUP_SIZE; distance = distance * 2) {
		let earlier: u32 = 0;
		if (thread >= distance) {
			earlier = thread_totals[thread - distance];
		}
		workgroup_barrier();
		thread_totals[thread] = thread_totals[thread] + earlier;
		workgroup_barrier();
	}

	// The slots before this thread's first one hold every pixel the inclusive total does not count from this thread.
	let offset: u32 = thread_totals[thread] - thread_total;
	for (let i: u32 = 0; i < MATERIALS_PER_THREAD; i = i + 1) {
		let material: u32 = first_material + i;
		let count: u32 = atomic_load(material_count_buffer.material_count[material]);
		material_offset_buffer.material_offset[material] = offset;
		atomic_store(material_offset_scratch_buffer.material_offset_scratch[material], offset);
		// The indirect dispatch consumes all three components for group counts.
		material_evaluation_dispatches.material_evaluation_dispatches[material] = vec3u((count + 127) / 128, 1, 1);
		offset = offset + count;
	}
}
