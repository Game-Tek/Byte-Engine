// Culls the meshlets of one workgroup's lanes against up to six views, and hands the mesh stage the ones it keeps in
// groups that each fill one mesh grid. Small meshlets share a grid, whatever instances they belong to.

use ::byte_engine::rendering::visibility::layouts::scene_records::*;
use ::byte_engine::rendering::visibility::layouts::scene::*;
use ::byte_engine::rendering::visibility::layouts::occlusion::*;

// Up to six views of each of the workgroup's 32 meshlets, then the workgroup's work in the last word. `scene_records`
// gives the format.
meshlet_instances: task_payload<u32, 193>;
visible_count: workgroup<atomicu32>;
// The late pass's unoccluded meshlets, one bit per lane.
unoccluded_meshlets: workgroup<atomicu32>;

// One dispatch draws `view_count` consecutive views, from `view_base`, into layers from `layer_base`. The camera's
// visibility pass is a batch of one view. `occlusion_phase` selects one of the `OCCLUSION_*` culling phases, or zero to
// cull by frustum and normal cone only, as the shadow views do. `minimum_caster_extent` is the narrowest instance, in
// normalized device units across x, that the views draw: directional cascades skip small casters with it, and every
// other dispatch passes zero, since a perspective view's widths change with distance. `shared_lanes` is nonzero when
// every lane has a work item of its own, 32 to a workgroup: the meshlets of small instances, which share workgroups.
// Otherwise each workgroup has one item: an instance and a chunk of 32 of its meshlets. `work_range` is the range of
// work the dispatch draws, whose first item the start of `scene.mesh_dispatch_work` gives.
push_constant: push_constant {
	work_range: u32,
	view_base: u32,
	layer_base: u32,
	view_count: u32,
	occlusion_phase: u32,
	minimum_caster_extent: f32,
	shared_lanes: u32,
}

// Draws the meshlets the previous late pass found unoccluded. Their depth builds this frame's occlusion pyramid.
OCCLUSION_EARLY: const u32 = 1;
// Tests every meshlet against this frame's occlusion pyramid, draws the unoccluded ones the early pass skipped, and
// records which were unoccluded for the next frame's early pass.
OCCLUSION_LATE: const u32 = 2;
// Tests every meshlet against this frame's occlusion pyramid, as transparent geometry does.
OCCLUSION_TEST: const u32 = 3;

MAX_TASK_VIEWS: const u32 = 6;
// The coarsest occlusion pyramid level. Keep it one below `OCCLUSION_PYRAMID_MIP_COUNT`.
OCCLUSION_PYRAMID_LAST_LEVEL: const f32 = 8.0;

// Returns an SNORM8 component of a packed word, from the byte at bit `shift`.
decode_snorm8: fn(word: u32, shift: u32) -> f32 {
	let byte: f32 = f32((word >> shift) & 255);
	// Bytes from 128 up are the negative values of two's complement.
	return (byte - step(128.0, byte) * 256.0) / 127.0;
}

// Returns a meshlet's object-space bounding sphere, which its record stores relative to its level's sphere.
meshlet_sphere: fn(meshlet: Meshlet, level: MeshLevel) -> vec4f {
	let level_center: vec3f = vec3f(level.bounding_sphere.x, level.bounding_sphere.y, level.bounding_sphere.z);
	let quantized: vec3f = vec3f(
		f32(meshlet.bounds.x & 65535),
		f32(meshlet.bounds.x >> 16),
		f32(meshlet.bounds.y & 65535)
	) / 65535.0;
	let center: vec3f = level_center + (quantized * 2.0 - vec3f(1.0, 1.0, 1.0)) * level.bounding_sphere.w;
	return vec4f(center.x, center.y, center.z, f32(meshlet.bounds.y >> 16) / 65535.0 * level.bounding_sphere.w);
}

// Returns whether a sphere reaches the positive side of a plane, after normalizing the plane.
sphere_intersects_plane: fn(plane: vec4f, sphere: vec4f) -> bool {
	let normal: vec3f = vec3f(plane.x, plane.y, plane.z);
	let scale: f32 = inversesqrt(max(dot(normal, normal), 0.000000000001));
	return dot(vec3f(sphere.x, sphere.y, sphere.z), normal * scale) + plane.w * scale >= 0.0 - sphere.w;
}

// Returns whether a world-space sphere may show in a view: no frustum plane has it wholly outside.
sphere_is_visible: fn(view: View, sphere: vec4f) -> bool {
	let matrix: mat4f = view.view_projection;
	let row0: vec4f = vec4f(matrix[0].x, matrix[1].x, matrix[2].x, matrix[3].x);
	let row1: vec4f = vec4f(matrix[0].y, matrix[1].y, matrix[2].y, matrix[3].y);
	let row2: vec4f = vec4f(matrix[0].z, matrix[1].z, matrix[2].z, matrix[3].z);
	let row3: vec4f = vec4f(matrix[0].w, matrix[1].w, matrix[2].w, matrix[3].w);

	return sphere_intersects_plane(row3 + row0, sphere)
		&& sphere_intersects_plane(row3 - row0, sphere)
		&& sphere_intersects_plane(row3 - row1, sphere)
		&& sphere_intersects_plane(row3 + row1, sphere)
		&& sphere_intersects_plane(row2, sphere)
		&& sphere_intersects_plane(row3 - row2, sphere);
}

// Returns whether a world-space sphere spans at least `minimum_extent` of an orthographic view's normalized device x.
// Such a view maps every distance to the same scale: the length of its projection's first row, in units per meter.
sphere_is_wide_enough: fn(view: View, sphere: vec4f, minimum_extent: f32) -> bool {
	let matrix: mat4f = view.view_projection;
	let row0: vec3f = vec3f(matrix[0].x, matrix[1].x, matrix[2].x);
	return 2.0 * sphere.w * sqrt(dot(row0, row0)) >= minimum_extent;
}

// Returns whether a meshlet may face a view: some triangle of it may be front-facing from the view's camera. `sphere`
// is the meshlet's object-space bounding sphere.
cone_allows_rendering: fn(mesh: Mesh, meshlet: Meshlet, sphere: vec4f, view: View) -> bool {
	let determinant: f32 = dot(cross(mesh.model[0], mesh.model[1]), mesh.model[2]);
	// Both faces of a double-sided material are visible, so no view direction culls it. A mirroring model keeps its
	// faces' sides, since the mesh shader swaps its triangles' winding, so only a degenerate one skips the test.
	if ((mesh.level & MESH_FLAG_DOUBLE_SIDED) != 0 || abs(determinant) <= 0.000001) {
		return true;
	}

	// The inverse view's translation column is the camera's world position. The rows of the model's inverse are the
	// cross products of its columns over the determinant.
	let world_delta: vec3f = view.inverse_view[3] - mesh.model[3];
	let inverse_determinant: f32 = 1.0 / determinant;
	let camera_position_object: vec3f = vec3f(
		dot(cross(mesh.model[1], mesh.model[2]) * inverse_determinant, world_delta),
		dot(cross(mesh.model[2], mesh.model[0]) * inverse_determinant, world_delta),
		dot(cross(mesh.model[0], mesh.model[1]) * inverse_determinant, world_delta)
	);
	let cone_axis: vec3f = vec3f(
		decode_snorm8(meshlet.cone, 0),
		decode_snorm8(meshlet.cone, 8),
		decode_snorm8(meshlet.cone, 16)
	);
	let cone_cutoff: f32 = decode_snorm8(meshlet.cone, 24);
	// Every triangle faces away from every point of the bounding sphere's view when the cone holds the whole sphere.
	// The stored cutoff already covers the axis's rounding, and a cutoff of one never culls.
	let center_delta: vec3f = vec3f(sphere.x, sphere.y, sphere.z) - camera_position_object;
	return dot(center_delta, cone_axis) < cone_cutoff * length(center_delta) + sphere.w;
}

// Places an object-space sphere in the world with `model`. The radius grows by the model's largest axis scale.
world_sphere: fn(model: mat4x3f, sphere: vec4f) -> vec4f {
	let scale: f32 = sqrt(max(dot(model[0], model[0]), max(dot(model[1], model[1]), dot(model[2], model[2]))));
	let world_center: vec3f = model * vec4f(sphere.x, sphere.y, sphere.z, 1.0);
	return vec4f(world_center.x, world_center.y, world_center.z, sphere.w * scale);
}

// Returns the smaller and the larger tangent slope, lateral over depth, from the eye to a view-space circle. The circle
// must lie past `radius` in depth.
circle_tangent_slopes: fn(lateral: f32, depth: f32, radius: f32) -> vec2f {
	let tangent_length: f32 = sqrt(lateral * lateral + depth * depth - radius * radius);
	let first: f32 = (tangent_length * lateral - radius * depth) / (tangent_length * depth + radius * lateral);
	let second: f32 = (tangent_length * lateral + radius * depth) / (tangent_length * depth - radius * lateral);
	return vec2f(min(first, second), max(first, second));
}

// Returns whether the occlusion pyramid proves a world-space sphere hidden from the perspective `view` that drew it:
// the sphere's nearest point lies behind the farthest surface anywhere across its screen rectangle.
//
// A sphere that crosses the near plane, or reaches past the screen edge, is never hidden. The pyramid holds nothing
// outside the screen.
sphere_is_occluded: fn(occlusion: Occlusion, view: View, sphere: vec4f) -> bool {
	let center: vec3f = view.view * vec4f(sphere.x, sphere.y, sphere.z, 1.0);
	let nearest_z: f32 = center.z - sphere.w;
	if (nearest_z <= view.near) {
		return false;
	}

	// The view's rotation rows are unit vectors, so each view-projection row's length is its axis's projection scale.
	let row_x: vec3f = vec3f(view.view_projection[0].x, view.view_projection[1].x, view.view_projection[2].x);
	let row_y: vec3f = vec3f(view.view_projection[0].y, view.view_projection[1].y, view.view_projection[2].y);
	// The tangent planes through the eye bound the sphere's projection on each screen axis.
	let slopes_x: vec2f = circle_tangent_slopes(center.x, center.z, sphere.w) * sqrt(dot(row_x, row_x));
	let slopes_y: vec2f = circle_tangent_slopes(center.y, center.z, sphere.w) * sqrt(dot(row_y, row_y));
	// Normalized device Y points up and texture V points down.
	let uv_min: vec2f = vec2f(slopes_x.x * 0.5 + 0.5, 0.5 - slopes_y.y * 0.5);
	let uv_max: vec2f = vec2f(slopes_x.y * 0.5 + 0.5, 0.5 - slopes_y.x * 0.5);
	if (uv_min.x < 0.0 || uv_min.y < 0.0 || uv_max.x > 1.0 || uv_max.y > 1.0) {
		return false;
	}

	// Pick the level where the rectangle spans at most one texel on each axis. The bilinear 2x2 footprint around its
	// center then covers all of it, and the minimum-reduction sampler returns the farthest of those four texels.
	let base_extent: vec2u = texture_size(occlusion.occlusion_pyramid);
	let footprint: f32 = max(
		(uv_max.x - uv_min.x) * f32(base_extent.x),
		(uv_max.y - uv_min.y) * f32(base_extent.y)
	);
	let level: f32 = 0.0 - floor(0.0 - log2(max(footprint, 1.0)));
	if (level > OCCLUSION_PYRAMID_LAST_LEVEL) {
		return false;
	}
	let farthest_depth: f32 = downsample_min(occlusion.occlusion_pyramid, (uv_min + uv_max) * 0.5, level);
	// Reversed perspective depth runs from one at the near plane to zero at the far plane.
	let nearest_depth: f32 = (view.near * view.far / nearest_z - view.near) / (view.far - view.near);
	return nearest_depth < farthest_depth;
}

main: fn(scene: Scene, occlusion: Occlusion) -> void {
	let workgroup_index: u32 = thread_position() / 32;
	let lane: u32 = thread_idx();
	let shared: bool = push_constant.shared_lanes != 0;
	// The workgroup's first work item. The GPU laid the range out this frame.
	let range_base: u32 = scene.mesh_dispatch_work[push_constant.work_range * 2];
	let work_index: u32 = range_base + workgroup_index;
	let work: u32 = work_index;
	if (shared) {
		work_index = range_base + workgroup_index * 32;
		work = work_index | MESHLET_WORK_SHARED;
	}
	// The workgroup's occlusion record is keyed by its first item, counted from the first item of the frame.
	let occlusion_record: u32 = work_index - WORK_HEADER;
	let item: u32 = scene.mesh_dispatch_work[lane_work_index(work, lane)];
	// A lane past the last shared item has no meshlet. It reads instance zero, and emits nothing.
	let has_item: bool = shared == false || item != EMPTY_WORK_ITEM;
	if (has_item == false) {
		item = 0;
	}
	let instance_index: u32 = item >> 7;
	let relative_meshlet_index: u32 = lane_meshlet(work, item, lane);
	let view_count: u32 = min(push_constant.view_count, MAX_TASK_VIEWS);
	let phase: u32 = push_constant.occlusion_phase;

	let mesh: Mesh = scene.meshes[instance_index];
	let level: MeshLevel = scene.mesh_levels[mesh.level & MESH_LEVEL_MASK];
	// Posed meshlets can leave their bind-pose bounds, so every view keeps a skinned instance and all its meshlets.
	let skinned: bool = (mesh.level & MESH_FLAG_SKINNED) != 0;
	let tests_occlusion: bool = (phase == OCCLUSION_LATE || phase == OCCLUSION_TEST) && skinned == false;
	let instance_sphere: vec4f = world_sphere(mesh.model, level.bounding_sphere);
	// A merged mesh's sphere spans many copies, each a caster of its own, so the small-caster test measures one copy.
	let caster_sphere: vec4f = world_sphere(mesh.model, vec4f(
		level.bounding_sphere.x, level.bounding_sphere.y, level.bounding_sphere.z, level.caster_radius
	));

	// Bit `v` marks view `view_base + v` as one the lane's instance may show in. Lanes of one instance compute the
	// same mask, so a workgroup whose one instance no view sees returns before it reads a single meshlet.
	let instance_views: u32 = 0;
	for (let view_offset: u32 = 0; view_offset < view_count; view_offset = view_offset + 1) {
		let view: View = scene.views.views[push_constant.view_base + view_offset];
		let shows: bool = sphere_is_visible(view, instance_sphere)
			&& sphere_is_wide_enough(view, caster_sphere, push_constant.minimum_caster_extent);
		if (skinned || shows) {
			instance_views = instance_views | (1 << view_offset);
		}
	}

	// Every view of a phase reads the same work range, so both camera passes read the same word and agree on what the
	// early pass drew whatever the word holds. Instances keep their order between frames, so a word mostly stays with
	// its lanes' meshlets.
	let previously_unoccluded: u32 = 0;
	if (phase == OCCLUSION_EARLY || phase == OCCLUSION_LATE) {
		previously_unoccluded = occlusion.occlusion_visibility[occlusion_record];
	}
	// The early pass draws only what the previous late pass found unoccluded.
	let drawn_early: bool = ((previously_unoccluded >> lane) & 1) != 0;
	let draws: bool = phase != OCCLUSION_EARLY || drawn_early;
	// Only the camera's batch of one view culls by occlusion, so one test covers every view in the mask. The nested
	// condition skips the pyramid read entirely when it cannot matter, since shader languages need not short-circuit.
	// A hidden instance hides every meshlet, and the early pass already drew any it had to.
	if (tests_occlusion && instance_views != 0) {
		if (sphere_is_occluded(occlusion, scene.views.views[push_constant.view_base], instance_sphere)) {
			instance_views = 0;
		}
	}
	// Lanes that share one instance agree, so they all leave here. Lanes with instances of their own go on, since
	// another lane may still draw.
	if (shared == false && (instance_views == 0 || (phase == OCCLUSION_EARLY && previously_unoccluded == 0))) {
		if (lane == 0) {
			if (phase == OCCLUSION_LATE) {
				occlusion.occlusion_visibility[occlusion_record] = 0;
			}
			set_task_mesh_output_count(0);
		}
		return;
	}

	if (lane == 0) {
		atomic_store(visible_count, 0);
		atomic_store(unoccluded_meshlets, 0);
		meshlet_instances[MESHLET_PAYLOAD_WORK] = work;
	}
	workgroup_barrier();

	if (has_item && draws && instance_views != 0 && relative_meshlet_index < level.meshlet_count) {
		let meshlet: Meshlet = scene.meshlets[level.first_meshlet + relative_meshlet_index];
		let vertex_count: u32 = meshlet.counts & 255;
		let triangle_count: u32 = (meshlet.counts >> 8) & 255;
		let object_sphere: vec4f = meshlet_sphere(meshlet, level);
		let world_meshlet_sphere: vec4f = world_sphere(mesh.model, object_sphere);
		for (let view_offset: u32 = 0; view_offset < view_count; view_offset = view_offset + 1) {
			// A meshlet without a triangle draws nothing, and an entry can't hold a count of zero.
			if ((instance_views & (1 << view_offset)) != 0 && vertex_count != 0 && triangle_count != 0) {
				let view: View = scene.views.views[push_constant.view_base + view_offset];
				if (skinned || (sphere_is_visible(view, world_meshlet_sphere) && cone_allows_rendering(mesh, meshlet, object_sphere, view))) {
					// Occlusion-testing passes are never early, so the test decides alone.
					let emit: bool = true;
					if (tests_occlusion) {
						emit = sphere_is_occluded(occlusion, view, world_meshlet_sphere) == false;
					}
					// The late pass remembers every unoccluded meshlet, but draws only those the early pass skipped.
					if (phase == OCCLUSION_LATE) {
						if (emit) {
							atomic_or(unoccluded_meshlets, 1 << lane);
						}
						emit = emit && drawn_early == false;
					}
					if (emit) {
						let payload_index: u32 = atomic_add(visible_count, 1);
						// One payload word keeps the meshlet and its view indivisible across emitted mesh grids.
						meshlet_instances[payload_index] = meshlet_entry(lane, view_offset, vertex_count, triangle_count);
					}
				}
			}
		}
	}

	workgroup_barrier();
	if (lane == 0) {
		if (phase == OCCLUSION_LATE) {
			occlusion.occlusion_visibility[occlusion_record] = atomic_load(unoccluded_meshlets);
		}

		// Form the groups: each takes the next entry while it stays within what one mesh grid emits. A full meshlet
		// is a group of its own, and small ones share a grid whichever lanes and views they came from.
		let entry_count: u32 = atomic_load(visible_count);
		let group: u32 = 0;
		let vertices: u32 = 0;
		let triangles: u32 = 0;
		for (let index: u32 = 0; index < entry_count; index = index + 1) {
			let entry: u32 = meshlet_instances[index];
			let entry_vertices: u32 = entry_vertex_end(entry);
			let entry_triangles: u32 = entry_triangle_end(entry);
			let starts_group: bool = index > 0
				&& (vertices + entry_vertices > MAX_GROUP_VERTICES || triangles + entry_triangles > MAX_GROUP_TRIANGLES);
			if (starts_group) {
				meshlet_instances[index - 1] = meshlet_instances[index - 1] | MESHLET_ENTRY_ENDS_GROUP;
				group = group + 1;
				vertices = 0;
				triangles = 0;
			}
			vertices = vertices + entry_vertices;
			triangles = triangles + entry_triangles;
			// The entry's own counts give way to the group's running totals.
			meshlet_instances[index] = (entry & 255) | ((vertices - 1) << 8) | ((triangles - 1) << 14);
			// A group never starts before the entry of its own index, so that word is already in its final form.
			if (starts_group) {
				meshlet_instances[group] = meshlet_instances[group] | (index << 22);
			}
		}
		if (entry_count == 0) {
			set_task_mesh_output_count(0);
		} else {
			meshlet_instances[entry_count - 1] = meshlet_instances[entry_count - 1] | MESHLET_ENTRY_ENDS_GROUP;
			set_task_mesh_output_count(group + 1);
		}
	}
}
