// Lights each half-resolution pixel from the probe volume, and marks the probes it reads so the schedule updates them
// first.
//
// Each pixel rebuilds its surface from the linear depth pyramid, as the surfel resolve does, and looks up the probes
// around it. It writes their light, pre-exposed, to `SSGI History` and its normal to `SSGI Normals`, the images SSGI
// writes, so material evaluation reads either source the same way. A pixel no cascade reaches takes the environment's
// light as if nothing hid the sky. Every other pixel of every other row marks the eight probes around it in each cascade
// that lights it, with the frame.

// Per tile texel: the positive linear depth, or zero where no surface was drawn or outside the image.
tile_depth: workgroup<f32, 144>;

PROBE_RESOLVE_WORKGROUP_WIDTH: const u32 = 8;
PROBE_RESOLVE_WORKGROUP_SIZE: const u32 = 64;
// Normal reconstruction reads two texels on each side of the center, so the tile adds two texels on every side.
PROBE_RESOLVE_TILE_RADIUS: const u32 = 2;
PROBE_RESOLVE_TILE_WIDTH: const u32 = 12;
PROBE_RESOLVE_TILE_SIZE: const u32 = 144;
// The probes debug view draws each probe of the finest cascade as a sphere of this share of its spacing, marching the
// view ray in steps of PROBE_DEBUG_STEP spacings, at most PROBE_DEBUG_STEPS of them.
PROBE_DEBUG_RADIUS: const f32 = 0.1;
PROBE_DEBUG_STEP: const f32 = 0.5;
PROBE_DEBUG_STEPS: const u32 = 64;
// The stops below white the debug views spread their light over.
PROBE_VIEW_STOPS: const f32 = 12.0;

// Returns `axis_tangent` with neighbor depths read from the workgroup's tile. `stride` steps one texel along `axis`
// in the tile.
tile_axis_tangent: fn (center_index: u32, stride: u32, pixel: vec2f, axis: vec2f, center_position: vec3f) -> vec3f {
	return axis_tangent(
		pixel,
		axis,
		center_position,
		tile_depth[center_index + stride],
		tile_depth[center_index - stride],
		tile_depth[center_index + 2 * stride],
		tile_depth[center_index - 2 * stride]
	);
}

// Transforms a view-space point or direction (w = 0) of the sink's camera to world space.
to_world: fn (view: vec3f, w: f32) -> vec3f {
	let world: vec4f = probe_resolve_parameters.view_to_world * vec4f(view.x, view.y, view.z, w);
	return vec3f(world.x, world.y, world.z);
}

// Marks the eight probes of `cascade` around `position` as read in this frame, with one plus the frame index, so zero
// means a probe no pixel ever read.
mark_probes: fn (cascade: u32, position: vec3f) -> void {
	let window: ProbeCascade = probe_volume_parameters.cascades[cascade];
	let base: vec3f = probe_cell(probe_grid_position(window, position));
	let mark: u32 = probe_volume_parameters.frame_index + 1;
	for (let corner: u32 = 0; corner < 8; corner = corner + 1) {
		probe_seen[probe_slot(window.start, base + probe_corner(corner), cascade)] = mark;
	}
}

// Returns pre-exposed `light` for a debug view: its brightest channel on a logarithmic scale where the
// PROBE_VIEW_STOPS stops below white run from black to full brightness, with its hue kept, so light in shade still
// reads.
view_light: fn (light: vec3f) -> vec4f {
	let peak: f32 = max(max(light.x, light.y), light.z);
	if (peak <= 0.0) {
		return vec4f(0.0, 0.0, 0.0, 1.0);
	}
	let level: f32 = clamp((log2(peak) + PROBE_VIEW_STOPS) / PROBE_VIEW_STOPS, 0.0, 1.0);
	let scale: f32 = level / peak;
	return vec4f(light.x * scale, light.y * scale, light.z * scale, 1.0);
}

// Returns the color the probes debug view gives the probe in `slot`, whose record is `record`, where its sphere faces
// `normal`: magenta for an unset probe, red for a buried one, and its irradiance toward `normal` for the rest, dimmed
// toward blue for an idle one.
probe_debug_color: fn (slot: u32, record: ProbeRecord, normal: vec3f) -> vec4f {
	if (record.state == PROBE_STATE_UNSET) {
		return vec4f(1.0, 0.0, 1.0, 1.0);
	}
	if (record.state == PROBE_STATE_BURIED) {
		return vec4f(1.0, 0.0, 0.0, 1.0);
	}
	let irradiance: vec4f = texture_lod(
		probe_irradiance,
		probe_atlas_uv(slot, normal, PROBE_IRRADIANCE_SIDE, PROBE_IRRADIANCE_TILE, texture_size(probe_irradiance)),
		0.0
	);
	let color: vec4f = view_light(vec3f(irradiance.x, irradiance.y, irradiance.z) * probe_resolve_parameters.exposure);
	if (record.state == PROBE_STATE_IDLE) {
		return vec4f(color.x * 0.25, color.y * 0.25, color.z * 0.25 + 0.3, 1.0);
	}
	return color;
}

// Returns the color of the first probe sphere of the finest cascade along the view ray from `origin` along the unit
// `direction`, before `limit` meters, or a negative alpha when the ray passes every sphere.
probe_sphere_color: fn (origin: vec3f, direction: vec3f, limit: f32) -> vec4f {
	let window: ProbeCascade = probe_volume_parameters.cascades[0];
	let radius: f32 = PROBE_DEBUG_RADIUS * window.spacing;
	let nearest: f32 = limit;
	let color: vec4f = vec4f(0.0, 0.0, 0.0, -1.0);
	for (let step_index: u32 = 0; step_index < PROBE_DEBUG_STEPS; step_index = step_index + 1) {
		let along: f32 = f32(step_index) * PROBE_DEBUG_STEP * window.spacing;
		if (along > nearest) {
			break;
		}
		// The probe nearest the step's point.
		let grid: vec3f = probe_grid_position(window, origin + direction * along);
		let local: vec3f = vec3f(floor(grid.x + 0.5), floor(grid.y + 0.5), floor(grid.z + 0.5));
		if (
			local.x < 0.0 || local.y < 0.0 || local.z < 0.0
			|| local.x > f32(PROBE_GRID_X - 1) || local.y > f32(PROBE_GRID_Y - 1) || local.z > f32(PROBE_GRID_Z - 1)
		) {
			continue;
		}
		let slot: u32 = probe_slot(window.start, local, 0);
		let record: ProbeRecord = probe_records[slot];
		let center: vec3f = (window.start + local) * window.spacing + record.offset;
		// The nearer root of |origin + t direction - center|² = radius².
		let to_origin: vec3f = origin - center;
		let b: f32 = dot(to_origin, direction);
		let discriminant: f32 = b * b - (dot(to_origin, to_origin) - radius * radius);
		if (discriminant < 0.0) {
			continue;
		}
		let t: f32 = -b - sqrt(discriminant);
		if (t > 0.0 && t < nearest) {
			nearest = t;
			color = probe_debug_color(slot, record, normalize(origin + direction * t - center));
		}
	}
	return color;
}

// Writes `color` to the full-resolution pixels a half-resolution `pixel` covers in the debug view at pool `slot`.
write_debug_view: fn (slot: u32, pixel: vec2u, color: vec4f) -> void {
	let x: u32 = pixel.x * 2;
	let y: u32 = pixel.y * 2;
	write(debug_view_targets[slot], vec2u(x, y), color);
	write(debug_view_targets[slot], vec2u(x + 1, y), color);
	write(debug_view_targets[slot], vec2u(x, y + 1), color);
	write(debug_view_targets[slot], vec2u(x + 1, y + 1), color);
}

main: fn (input: StageInput) -> void {
	let pixel: vec2u = input.thread_id;
	let lane: u32 = input.thread_idx;
	let extent: vec2u = image_size(history_output);
	let local: vec2u = vec2u(lane % PROBE_RESOLVE_WORKGROUP_WIDTH, lane / PROBE_RESOLVE_WORKGROUP_WIDTH);
	let workgroup_origin: vec2u = pixel - local;
	// Every invocation helps load the tile, including those past the image edge, before any of them returns.
	for (
		let tile_index: u32 = lane;
		tile_index < PROBE_RESOLVE_TILE_SIZE;
		tile_index = tile_index + PROBE_RESOLVE_WORKGROUP_SIZE
	) {
		tile_depth[tile_index] = neighbor_depth(
			workgroup_origin,
			f32(tile_index % PROBE_RESOLVE_TILE_WIDTH) - f32(PROBE_RESOLVE_TILE_RADIUS),
			f32(tile_index / PROBE_RESOLVE_TILE_WIDTH) - f32(PROBE_RESOLVE_TILE_RADIUS),
			extent
		);
	}
	workgroup_barrier();

	if (pixel.x >= extent.x || pixel.y >= extent.y) {
		return;
	}
	let center_index: u32 = (local.y + PROBE_RESOLVE_TILE_RADIUS) * PROBE_RESOLVE_TILE_WIDTH + local.x + PROBE_RESOLVE_TILE_RADIUS;
	let center_z: f32 = tile_depth[center_index];
	let pixel_f: vec2f = vec2f(f32(pixel.x), f32(pixel.y));
	let view_normal: vec3f = vec3f(0.0, 0.0, 0.0);
	let world_position: vec3f = vec3f(0.0, 0.0, 0.0);
	if (center_z != 0.0) {
		let center_position: vec3f = view_position(pixel_f, center_z);
		view_normal = tangent_normal(
			tile_axis_tangent(center_index, 1, pixel_f, vec2f(1.0, 0.0), center_position),
			tile_axis_tangent(center_index, PROBE_RESOLVE_TILE_WIDTH, pixel_f, vec2f(0.0, 1.0), center_position),
			center_position
		);
		world_position = to_world(center_position, 1.0);
	}
	let surface: bool = dot(view_normal, view_normal) != 0.0;
	let normal: vec3f = to_world(view_normal, 0.0);
	let camera: vec3f = to_world(vec3f(0.0, 0.0, 0.0), 1.0);
	let exposure: f32 = probe_resolve_parameters.exposure;

	let history: vec4f = vec4f(0.0, 0.0, 0.0, 0.0);
	if (surface) {
		let light: vec4f = probe_volume_lookup(world_position, normal, normalize(camera - world_position), true);
		if (light.w >= 0.0) {
			history = vec4f(light.x * exposure, light.y * exposure, light.z * exposure, light.w);
		} else {
			// No cascade reaches the pixel. It takes the environment's light as if nothing hid the sky, as material
			// evaluation would light it without probe GI.
			let sky: vec4f = texture_lod(probe_environment_irradiance, normal, 0.0);
			let scale: f32 = probe_volume_parameters.environment_intensity * exposure;
			history = vec4f(sky.x * scale, sky.y * scale, sky.z * scale, 0.0);
		}
		// A quarter of the pixels mark the probes they read: neighbors read the same probes.
		if (((pixel.x | pixel.y) & 1) == 0) {
			for (let cascade: u32 = 0; cascade < PROBE_CASCADES; cascade = cascade + 1) {
				let share: f32 = probe_cascade_share(cascade, world_position);
				if (share > 0.0) {
					mark_probes(cascade, world_position);
					// Past its blend band, the cascade lights the pixel alone.
					if (share >= 1.0) {
						break;
					}
				}
			}
		}
	}
	write(history_output, pixel, history);
	write(normal_output, pixel, encode_stored_normal(view_normal));

	// The probe light view writes the slot after the probes view's when both are shown.
	let light_slot: u32 = probe_resolve_parameters.debug_view_first_slot;
	if (probe_resolve_parameters.debug_view_probes) {
		light_slot = light_slot + 1;
	}
	if (probe_resolve_parameters.debug_view_probes) {
		let view_ray: vec3f = view_position(pixel_f, 1.0);
		let direction: vec3f = normalize(to_world(view_ray, 0.0));
		let limit: f32 = 1000.0;
		if (surface) {
			limit = length(world_position - camera);
		}
		let color: vec4f = probe_sphere_color(camera, direction, limit);
		if (color.w < 0.0) {
			color = view_light(vec3f(history.x, history.y, history.z));
		}
		write_debug_view(probe_resolve_parameters.debug_view_first_slot, pixel, color);
	}
	if (probe_resolve_parameters.debug_view_probe_light) {
		write_debug_view(light_slot, pixel, view_light(vec3f(history.x, history.y, history.z)));
	}
}
