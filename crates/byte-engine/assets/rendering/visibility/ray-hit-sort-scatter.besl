// The last pass of the hit sort: places each ray that hit in its material's run, at its rank among the run's hits. It
// runs once for each ray of the technique's budget, and the rays past those the trace cast return.
//
// Next, the shade pass runs the closest-hit shader of each sorted hit, so neighboring invocations mostly run the same
// shader.

main: fn (input: StageInput) -> void {
	let ray: u32 = input.thread_id.x;
	if (ray >= ray_hit_sort.rays) {
		return;
	}
	let key: u32 = ray_hit_keys[ray];
	if (key == NO_HIT) {
		return;
	}
	ray_sorted_hits[ray_hit_sort.offsets[key >> HIT_RANK_BITS] + (key & HIT_RANK_MASK)] = ray;
}
