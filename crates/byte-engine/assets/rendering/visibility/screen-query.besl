// Reads the instance the opaque layer drew at each queried pixel. See layouts/screen_query.besl.

use ::byte_engine::rendering::visibility::layouts::screen_query::*;

main: fn (input: StageInput, screen_query: ScreenQuery) -> void {
	let query: u32 = input.thread_idx;
	if (query >= SCREEN_QUERY_CAPACITY) {
		return;
	}
	screen_query.instances.instances[query] = instance_at_query(screen_query, query);
}
