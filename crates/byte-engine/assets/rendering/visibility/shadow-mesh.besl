View: struct {
	view: mat4x3f,
	view_projection: mat4f,
	inverse_view: mat4x3f,
	fov: vec2f,
	near: f32,
	far: f32,
}

Mesh: struct {
	model: mat4x3f,
	material_index: u32,
	base_vertex_index: u32,
	base_primitive_index: u32,
	base_triangle_index: u32,
	base_meshlet_index: u32,
	meshlet_count: u32,
	skinned_base_vertex_index: u32,
	flags: u32,
	bounding_sphere: vec4f,
}

Meshlet: struct {
	primitive_offset: u32,
	triangle_offset: u32,
	primitive_count: u32,
	triangle_count: u32,
	center_radius: vec4f,
	cone_apex_cutoff: vec4f,
	cone_axis: vec2u16,
}

SkinnedVertex: struct {
	position: vec3f,
	normal: vec3f,
}

Views: struct {
	views: View[117],
}

Meshes: struct {
	meshes: Mesh[1024],
}

SkinnedVertices: struct {
	vertices: SkinnedVertex[262144],
}

views: descriptor<{ type: Views, binding: 0, access: read, memory: constant }>;
meshes: descriptor<{ type: Meshes, binding: 1, access: read, memory: device }>;
vertex_positions: descriptor<{ type: vec3f[], binding: 2, access: read, memory: device }>;
vertex_uvs: descriptor<{ type: vec2f16[], binding: 5, access: read, memory: device }>;
skinned_vertices: descriptor<{ type: SkinnedVertices, binding: 4, access: read, memory: device }>;
vertex_indices: descriptor<{ type: u16[], binding: 6, access: read, memory: device }>;
primitive_indices: descriptor<{ type: u8[], binding: 7, access: read, memory: device }>;
meshlets: descriptor<{ type: Meshlet[], binding: 8, access: read, memory: device }>;

meshlet_instances: task_payload<u32, 192>;
out_instance_index: output<u32, 0, 126>;
out_primitive_index: output<u32, 1, 126>;
// One UV per meshlet vertex, interpolated across each triangle for the alpha test.
out_uv: vertex_output<vec2f16, 2, 64>;

// One dispatch draws `view_count` consecutive views, from `view_base`, into layers from `layer_base`.
push_constant: push_constant {
	work_item_base: u32,
	view_base: u32,
	layer_base: u32,
	view_count: u32,
}

main: fn() -> void {
	let payload_index: u32 = threadgroup_position();
	// Decode every index from the same payload read so a meshlet cannot be paired with another grid's instance or view.
	let meshlet_instance: u32 = meshlet_instances[payload_index];
	let instance_index: u32 = (meshlet_instance >> 12) & 1023;
	let view_offset: u32 = (meshlet_instance >> 22) & 7;
	let mesh: Mesh = meshes.meshes[instance_index];
	// Task shaders pack the meshlet relative to its instance's first meshlet.
	let meshlet_index: u32 = mesh.base_meshlet_index + (meshlet_instance & 4095);
	let view: View = views.views[push_constant.view_base + view_offset];
	let meshlet: Meshlet = meshlets[meshlet_index];
	let primitive_index: u32 = thread_idx();

	if (primitive_index == 0) {
		set_mesh_output_counts(meshlet.primitive_count, meshlet.triangle_count);
	}

	if (primitive_index < meshlet.primitive_count) {
		let relative_vertex_index: u32 =
			u32(vertex_indices[mesh.base_primitive_index + meshlet.primitive_offset + primitive_index]);
		let vertex_index: u32 = mesh.base_vertex_index + relative_vertex_index;
		// A skinned vertex reads only its posed position, never the bind-pose one.
		let position: vec4f = vec4f(0.0, 0.0, 0.0, 1.0);
		if (mesh.skinned_base_vertex_index != 4294967295) {
			let skinned_position: vec3f =
				skinned_vertices.vertices[mesh.skinned_base_vertex_index + relative_vertex_index].position;
			position = vec4f(skinned_position.x, skinned_position.y, skinned_position.z, 1.0);
		} else {
			let object_position: vec3f = vertex_positions[vertex_index];
			position = vec4f(object_position.x, object_position.y, object_position.z, 1.0);
		}

		let world_position: vec3f = mesh.model * position;
		let clip_position: vec4f = view.view_projection * vec4f(world_position.x, world_position.y, world_position.z, 1.0);
		set_mesh_vertex_position(primitive_index, clip_position);
		out_uv[primitive_index] = vertex_uvs[vertex_index];
	}

	if (primitive_index < meshlet.triangle_count) {
		let triangle_base_index: u32 = mesh.base_triangle_index + meshlet.triangle_offset + primitive_index;
		set_mesh_triangle(
			primitive_index,
			vec3u(
				u32(primitive_indices[triangle_base_index * 3 + 0]),
				u32(primitive_indices[triangle_base_index * 3 + 1]),
				u32(primitive_indices[triangle_base_index * 3 + 2])
			)
		);
		set_mesh_primitive_render_target_array_index(primitive_index, push_constant.layer_base + view_offset);
		out_instance_index[primitive_index] = instance_index;
		out_primitive_index[primitive_index] = (meshlet_index << 8) | (primitive_index & 255);
	}
}
