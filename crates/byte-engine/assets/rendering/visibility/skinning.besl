SkinnedVertex: struct {
	position: vec4f,
	normal: vec4f,
}

SourcePositions: struct {
	values: vec3f[262144],
}

SourceNormals: struct {
	values: vec3f[262144],
}

SourceJoints: struct {
	values: vec4u16[262144],
}

SourceWeights: struct {
	values: vec4f[262144],
}

MatrixPalette: struct {
	values: mat4x3f[65536],
}

DualQuaternion: struct {
	real: vec4f,
	dual: vec4f,
}

DualQuaternionPalette: struct {
	values: DualQuaternion[65536],
}

SkinnedVertices: struct {
	values: SkinnedVertex[262144],
}

source_positions: descriptor<{ type: SourcePositions, binding: 0, access: read, memory: device }>;
source_normals: descriptor<{ type: SourceNormals, binding: 1, access: read, memory: device }>;
source_joints: descriptor<{ type: SourceJoints, binding: 2, access: read, memory: device }>;
source_weights: descriptor<{ type: SourceWeights, binding: 3, access: read, memory: device }>;
matrix_palette: descriptor<{ type: MatrixPalette, binding: 4, access: read, memory: device }>;
skinned_vertices: descriptor<{ type: SkinnedVertices, binding: 5, access: write, memory: device }>;
dual_quaternion_palette: descriptor<{ type: DualQuaternionPalette, binding: 6, access: read, memory: device }>;

push_constant: push_constant {
	source_vertex_base: u32,
	destination_vertex_base: u32,
	palette_base: u32,
	palette_count: u32,
	vertex_count: u32,
	palette_kind: u32,
}

transform_normal: fn(column0: vec3f, column1: vec3f, column2: vec3f, normal: vec3f) -> vec3f {
	let cofactor0: vec3f = cross(column1, column2);
	let cofactor1: vec3f = cross(column2, column0);
	let cofactor2: vec3f = cross(column0, column1);
	let determinant: f32 = dot(column0, cofactor0);
	if (abs(determinant) > 0.00000001) {
		return (cofactor0 * normal.x + cofactor1 * normal.y + cofactor2 * normal.z) / determinant;
	}

	// Singular joint transforms retain their usable linear directions instead of producing NaNs.
	return column0 * normal.x + column1 * normal.y + column2 * normal.z;
}

safe_normalize: fn(value: vec3f, fallback: vec3f) -> vec3f {
	let length_squared: f32 = dot(value, value);
	if (length_squared > 0.00000001) {
		return value * inversesqrt(length_squared);
	}
	return fallback;
}

rotate_by_quaternion: fn(rotation: vec4f, value: vec3f) -> vec3f {
	let vector: vec3f = vec3f(rotation.x, rotation.y, rotation.z);
	return value + cross(vector, cross(vector, value) + value * rotation.w) * 2.0;
}

dual_quaternion_translation: fn(real: vec4f, dual: vec4f) -> vec3f {
	let real_vector: vec3f = vec3f(real.x, real.y, real.z);
	let dual_vector: vec3f = vec3f(dual.x, dual.y, dual.z);
	return (dual_vector * real.w - real_vector * dual.w + cross(real_vector, dual_vector)) * 2.0;
}

antipodal_sign: fn(reference_rotation: vec4f, value: vec4f) -> f32 {
	let alignment: f32 = dot(reference_rotation, value);
	if (alignment < 0.0) {
		return 0.0 - 1.0;
	}
	return 1.0;
}

main: fn () -> void {
	let local_vertex_index: u32 = thread_id().x;
	if (local_vertex_index >= push_constant.vertex_count) {
		return;
	}

	let source_vertex_index: u32 = push_constant.source_vertex_base + local_vertex_index;
	let source_position: vec3f = source_positions.values[source_vertex_index];
	let source_normal: vec3f = source_normals.values[source_vertex_index];
	let joints: vec4u16 = source_joints.values[source_vertex_index];
	let weights: vec4f = source_weights.values[source_vertex_index];
	let destination_vertex_index: u32 = push_constant.destination_vertex_base + local_vertex_index;
	if (
		push_constant.palette_count == 0
		|| (weights.x > 0.0 && u32(joints.x) >= push_constant.palette_count)
		|| (weights.y > 0.0 && u32(joints.y) >= push_constant.palette_count)
		|| (weights.z > 0.0 && u32(joints.z) >= push_constant.palette_count)
		|| (weights.w > 0.0 && u32(joints.w) >= push_constant.palette_count)
	) {
		// Preserve legal output for malformed legacy assets instead of reading outside the matrix palette.
		let fallback: vec3f = safe_normalize(source_normal, vec3f(0.0, 0.0, 1.0));
		skinned_vertices.values[destination_vertex_index] = SkinnedVertex(
			vec4f(source_position.x, source_position.y, source_position.z, 1.0),
			vec4f(fallback.x, fallback.y, fallback.z, 0.0)
		);
		return;
	}
	// Zero-weight lanes may contain legacy sentinel indices. Redirect them before any palette access.
	let joint0: u32 = 0;
	let joint1: u32 = 0;
	let joint2: u32 = 0;
	let joint3: u32 = 0;
	if (u32(joints.x) < push_constant.palette_count) {
		joint0 = u32(joints.x);
	}
	if (u32(joints.y) < push_constant.palette_count) {
		joint1 = u32(joints.y);
	}
	if (u32(joints.z) < push_constant.palette_count) {
		joint2 = u32(joints.z);
	}
	if (u32(joints.w) < push_constant.palette_count) {
		joint3 = u32(joints.w);
	}
	let total_weight: f32 = weights.x + weights.y + weights.z + weights.w;

	let fallback_normal: vec3f = safe_normalize(source_normal, vec3f(0.0, 0.0, 1.0));
	let position: vec4f = vec4f(source_position.x, source_position.y, source_position.z, 1.0);
	let normal: vec3f = fallback_normal;
	if (total_weight > 0.00000001) {
		if (push_constant.palette_kind == 1) {
			let dual0: DualQuaternion = dual_quaternion_palette.values[push_constant.palette_base + joint0];
			let dual1: DualQuaternion = dual_quaternion_palette.values[push_constant.palette_base + joint1];
			let dual2: DualQuaternion = dual_quaternion_palette.values[push_constant.palette_base + joint2];
			let dual3: DualQuaternion = dual_quaternion_palette.values[push_constant.palette_base + joint3];
			let reference_rotation: vec4f = dual0.real;
			if (weights.x <= 0.00000001 && weights.y > 0.00000001) {
				reference_rotation = dual1.real;
			}
			if (weights.x <= 0.00000001 && weights.y <= 0.00000001 && weights.z > 0.00000001) {
				reference_rotation = dual2.real;
			}
			if (
				weights.x <= 0.00000001
				&& weights.y <= 0.00000001
				&& weights.z <= 0.00000001
				&& weights.w > 0.00000001
			) {
				reference_rotation = dual3.real;
			}

			let signed_weight0: f32 = weights.x * antipodal_sign(reference_rotation, dual0.real);
			let signed_weight1: f32 = weights.y * antipodal_sign(reference_rotation, dual1.real);
			let signed_weight2: f32 = weights.z * antipodal_sign(reference_rotation, dual2.real);
			let signed_weight3: f32 = weights.w * antipodal_sign(reference_rotation, dual3.real);
			let blended_real: vec4f = dual0.real * signed_weight0
				+ dual1.real * signed_weight1
				+ dual2.real * signed_weight2
				+ dual3.real * signed_weight3;
			let blended_dual: vec4f = dual0.dual * signed_weight0
				+ dual1.dual * signed_weight1
				+ dual2.dual * signed_weight2
				+ dual3.dual * signed_weight3;
			let real_length_squared: f32 = dot(blended_real, blended_real);
			if (real_length_squared > 0.00000001) {
				let inverse_real_length: f32 = inversesqrt(real_length_squared);
				let real: vec4f = blended_real * inverse_real_length;
				let dual: vec4f = blended_dual * inverse_real_length;
				let skinned_position: vec3f = rotate_by_quaternion(real, source_position)
					+ dual_quaternion_translation(real, dual);
				position = vec4f(skinned_position.x, skinned_position.y, skinned_position.z, 1.0);
				normal = safe_normalize(rotate_by_quaternion(real, source_normal), fallback_normal);
			}
		}
		if (push_constant.palette_kind != 1) {
			let matrix0: mat4x3f = matrix_palette.values[push_constant.palette_base + joint0];
			let matrix1: mat4x3f = matrix_palette.values[push_constant.palette_base + joint1];
			let matrix2: mat4x3f = matrix_palette.values[push_constant.palette_base + joint2];
			let matrix3: mat4x3f = matrix_palette.values[push_constant.palette_base + joint3];
			let inverse_total_weight: f32 = 1.0 / total_weight;
			// Blend columns explicitly so every backend and the validation VM use the same affine matrix representation.
			let blended_column0: vec3f = (
				matrix0[0] * weights.x + matrix1[0] * weights.y + matrix2[0] * weights.z + matrix3[0] * weights.w
			) * inverse_total_weight;
			let blended_column1: vec3f = (
				matrix0[1] * weights.x + matrix1[1] * weights.y + matrix2[1] * weights.z + matrix3[1] * weights.w
			) * inverse_total_weight;
			let blended_column2: vec3f = (
				matrix0[2] * weights.x + matrix1[2] * weights.y + matrix2[2] * weights.z + matrix3[2] * weights.w
			) * inverse_total_weight;
			let blended_column3: vec3f = (
				matrix0[3] * weights.x + matrix1[3] * weights.y + matrix2[3] * weights.z + matrix3[3] * weights.w
			) * inverse_total_weight;
			let matrix: mat4x3f = mat4x3f(blended_column0, blended_column1, blended_column2, blended_column3);
			let skinned_position: vec3f = matrix * position;
			position = vec4f(skinned_position.x, skinned_position.y, skinned_position.z, 1.0);
			normal = safe_normalize(
				transform_normal(matrix[0], matrix[1], matrix[2], source_normal),
				fallback_normal
			);
		}
	}

	skinned_vertices.values[destination_vertex_index] = SkinnedVertex(
		vec4f(position.x, position.y, position.z, 1.0),
		vec4f(normal.x, normal.y, normal.z, 0.0)
	);
}
