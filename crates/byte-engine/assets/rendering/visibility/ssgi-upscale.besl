// Reconstructs full-resolution pre-exposed indirect diffuse light from the half-resolution SSGI history. Bilinear taps are
// weighted by how well they lie on the full-resolution pixel's surface, so light does not bleed across edges.
// Each 8x8 workgroup first loads the linear depth of its pixels and a two-pixel border into workgroup memory, so every
// pixel rebuilds its normal from shared values instead of fetching and linearizing eight neighbors again. It also loads
// the position, normal, and light of the 6x6 low-resolution texels its pixels tap, so the taps read shared values
// instead of fetching three images each.
ScreenView: struct {
	pixel_to_ray_mul: vec2f,
	pixel_to_ray_add: vec2f,
	projection_pixels_y: f32,
	view_z_sign: f32,
	depth_unproject_numerator: f32,
	depth_unproject_denominator_offset: f32,
}

screen_view: descriptor<{ type: ScreenView, binding: 0, access: read }>;
visibility_depth: descriptor<{ type: Texture2D, binding: 1033, access: read }>;
radiance_source: descriptor<{ type: Texture2D, binding: 1034, access: read }>;
radiance_output: descriptor<{ type: StorageImage<rgba16f>, binding: 1035, access: write }>;
low_resolution_depth: descriptor<{ type: Texture2D, binding: 1036, access: read }>;
low_resolution_normals: descriptor<{ type: Texture2D, binding: 1037, access: read }>;

// Per tile pixel: the positive linear depth, or zero where no surface was drawn or outside the image.
tile_depth: workgroup<f32, 144>;
// Per low-resolution tile texel: the view-space position, whose z is zero where no surface was drawn; the decoded
// normal; and the light.
source_positions: workgroup<vec4f, 36>;
source_normals: workgroup<vec4f, 36>;
source_radiance: workgroup<vec4f, 36>;

// A 2% relative-depth sigma gives a Gaussian inverse variance of 1,250. It applies where no normal is known.
SSGI_UPSCALE_INVERSE_DEPTH_VARIANCE: const f32 = 1250.0;
// A 1% sigma, relative to the pixel's depth, for a tap's distance from the pixel's tangent plane.
SSGI_UPSCALE_INVERSE_PLANE_VARIANCE: const f32 = 10000.0;
// Taps whose normal differs from the pixel's by more than about 45 degrees lie on another surface.
SSGI_UPSCALE_NORMAL_REJECT_COSINE: const f32 = 0.7;
SSGI_UPSCALE_NORMAL_ACCEPT_COSINE: const f32 = 0.9;
// Matches the finite-difference degeneracy test the trace uses for reconstructed normals.
SSGI_UPSCALE_NORMAL_SIN_SQ_EPSILON: const f32 = 0.00000001;
// Normal reconstruction reads two pixels on each side of the center.
SSGI_UPSCALE_TILE_RADIUS: const u32 = 2;
SSGI_UPSCALE_WORKGROUP_WIDTH: const u32 = 8;
SSGI_UPSCALE_WORKGROUP_SIZE: const u32 = 64;
// The workgroup's pixels plus the reconstruction radius on every side.
SSGI_UPSCALE_TILE_WIDTH: const u32 = 12;
SSGI_UPSCALE_TILE_SIZE: const u32 = 144;
// The workgroup's 8x8 pixels lie over 4x4 low-resolution texels, and their bilinear taps reach one texel past those on
// every side.
SSGI_UPSCALE_SOURCE_TILE_WIDTH: const u32 = 6;
SSGI_UPSCALE_SOURCE_TILE_SIZE: const u32 = 36;

// Decodes a normal the trace stored as an octahedral pair in RG, or returns zero for the pair (0, 0), which marks a
// texel without a normal. That pair encodes +z, which points away from the camera and so is never a stored normal.
// `ssgi-temporal.besl` holds the same decoder; keep both in sync with `encode_stored_normal` in `ssgi-trace.besl`.
decode_stored_normal: fn (stored: vec4f) -> vec3f {
	if (stored.x == 0.0 && stored.y == 0.0) {
		return vec3f(0.0, 0.0, 0.0);
	}
	let z: f32 = 1.0 - abs(stored.x) - abs(stored.y);
	let fold: f32 = max(0.0 - z, 0.0);
	// `step` returns the positive direction at zero, matching the trace's encoder.
	let normal: vec3f = vec3f(
		stored.x - (step(0.0, stored.x) * 2.0 - 1.0) * fold,
		stored.y - (step(0.0, stored.y) * 2.0 - 1.0) * fold,
		z
	);
	return normal * inversesqrt(dot(normal, normal));
}

// Returns the view-space position at continuous half-resolution coordinates, where integers are texel centers.
// The screen view constants describe the half-resolution image.
view_position: fn (half_resolution_coordinate: vec2f, z: f32) -> vec3f {
	let ray: vec2f = half_resolution_coordinate * screen_view.pixel_to_ray_mul + screen_view.pixel_to_ray_add;
	return vec3f(ray.x * z, ray.y * z, z);
}

// Reads the full-resolution linear depth `offset` pixels away, or zero outside the image or where no surface was drawn.
neighbor_depth: fn (coordinate: vec2u, offset_x: f32, offset_y: f32, extent: vec2u) -> f32 {
	let x: f32 = f32(coordinate.x) + offset_x;
	let y: f32 = f32(coordinate.y) + offset_y;
	if (x < 0.0 || y < 0.0 || x >= f32(extent.x) || y >= f32(extent.y)) {
		return 0.0;
	}
	let depth: f32 = fetch(visibility_depth, vec2u(u32(x), u32(y))).x;
	if (depth == 0.0) {
		return 0.0;
	}
	return screen_view.depth_unproject_numerator / (depth + screen_view.depth_unproject_denominator_offset);
}

// Returns the error of predicting the center depth by extending the line through two neighbors on one side, in 1/z.
side_error: fn (center_z: f32, near_z: f32, far_z: f32) -> f32 {
	if (near_z == 0.0 || far_z == 0.0) {
		return 1000000.0;
	}
	return abs(2.0 / near_z - 1.0 / far_z - 1.0 / center_z);
}

// Returns the view-space tangent along one screen axis from the side whose neighbors best extend the center's
// surface (atyuwen, "Accurate Normal Reconstruction from Depth Buffer", 2020), or zero without one. Where a boot
// stands on a floor, the floor pixel next to the boot takes its tangent from the floor side. `stride` steps one pixel
// along the tile; `axis` is that pixel's displacement in half-resolution coordinates.
axis_tangent: fn (center_index: u32, stride: u32, coordinate: vec2f, axis: vec2f, center_position: vec3f) -> vec3f {
	let center_z: f32 = center_position.z;
	let positive_z: f32 = tile_depth[center_index + stride];
	let negative_z: f32 = tile_depth[center_index - stride];
	let positive_error: f32 = side_error(center_z, positive_z, tile_depth[center_index + 2 * stride]);
	let negative_error: f32 = side_error(center_z, negative_z, tile_depth[center_index - 2 * stride]);
	if (positive_z != 0.0 && (positive_error <= negative_error || negative_z == 0.0)) {
		return view_position(coordinate + axis, positive_z) - center_position;
	}
	if (negative_z != 0.0) {
		return center_position - view_position(coordinate - axis, negative_z);
	}
	return vec3f(0.0, 0.0, 0.0);
}

// Rebuilds a camera-facing view-space normal from the tile's full-resolution depth, or returns zero when it is
// degenerate.
reconstruct_normal: fn (center_index: u32, coordinate: vec2f, center_position: vec3f, full_to_half_scale: vec2f) -> vec3f {
	let dx: vec3f = axis_tangent(center_index, 1, coordinate, vec2f(full_to_half_scale.x, 0.0), center_position);
	let dy: vec3f = axis_tangent(center_index, SSGI_UPSCALE_TILE_WIDTH, coordinate, vec2f(0.0, full_to_half_scale.y), center_position);
	let unnormalized: vec3f = cross(dx, dy);
	let normal_length_sq: f32 = dot(unnormalized, unnormalized);
	let tangent_product: f32 = dot(dx, dx) * dot(dy, dy);
	if (tangent_product == 0.0 || normal_length_sq <= tangent_product * SSGI_UPSCALE_NORMAL_SIN_SQ_EPSILON) {
		return vec3f(0.0, 0.0, 0.0);
	}
	let normal: vec3f = unnormalized * inversesqrt(normal_length_sq);
	// Visible surfaces face the camera at the origin, which fixes the winding of the cross product.
	if (dot(normal, center_position) > 0.0) {
		return vec3f(0.0, 0.0, 0.0) - normal;
	}
	return normal;
}

// Returns how much a tap belongs to the pixel's surface: one on the pixel's tangent plane with a similar normal,
// falling to zero for another surface. Without normals, it compares depth only.
surface_weight: fn (center_normal: vec3f, center_position: vec3f, tap_normal: vec3f, tap_position: vec3f) -> f32 {
	if (dot(center_normal, center_normal) == 0.0 || dot(tap_normal, tap_normal) == 0.0) {
		let relative_delta: f32 = (tap_position.z - center_position.z) / center_position.z;
		return exp(0.0 - relative_delta * relative_delta * SSGI_UPSCALE_INVERSE_DEPTH_VARIANCE);
	}
	let plane_distance: f32 = dot(center_normal, tap_position - center_position) / center_position.z;
	let normal_agreement: f32 = clamp(
		(dot(center_normal, tap_normal) - SSGI_UPSCALE_NORMAL_REJECT_COSINE)
			/ (SSGI_UPSCALE_NORMAL_ACCEPT_COSINE - SSGI_UPSCALE_NORMAL_REJECT_COSINE),
		0.0,
		1.0
	);
	return normal_agreement * exp(0.0 - plane_distance * plane_distance * SSGI_UPSCALE_INVERSE_PLANE_VARIANCE);
}

// Returns the continuous low-resolution texel coordinates under a pixel, where integers are texel centers. Odd full
// extents do not divide exactly by two, so texel centers match by normalized screen position.
source_position_of: fn (pixel: vec2u, full_to_half_scale: vec2f) -> vec2f {
	return (vec2f(f32(pixel.x), f32(pixel.y)) + vec2f(0.5, 0.5)) * full_to_half_scale - vec2f(0.5, 0.5);
}

main: fn (input: StageInput) -> void {
	let coordinate: vec2u = input.thread_id;
	let extent: vec2u = image_size(radiance_output);
	let local: vec2u = vec2u(input.thread_idx % SSGI_UPSCALE_WORKGROUP_WIDTH, input.thread_idx / SSGI_UPSCALE_WORKGROUP_WIDTH);
	let workgroup_origin: vec2u = coordinate - local;
	let source_extent: vec2u = texture_size(radiance_source);
	let full_to_half_scale: vec2f = vec2f(f32(source_extent.x) / f32(extent.x), f32(source_extent.y) / f32(extent.y));
	// Every invocation helps load the tiles, including those past the image edge, before any of them returns.
	for (
		let tile_index: u32 = input.thread_idx;
		tile_index < SSGI_UPSCALE_TILE_SIZE;
		tile_index = tile_index + SSGI_UPSCALE_WORKGROUP_SIZE
	) {
		tile_depth[tile_index] = neighbor_depth(
			workgroup_origin,
			f32(tile_index % SSGI_UPSCALE_TILE_WIDTH) - f32(SSGI_UPSCALE_TILE_RADIUS),
			f32(tile_index / SSGI_UPSCALE_TILE_WIDTH) - f32(SSGI_UPSCALE_TILE_RADIUS),
			extent
		);
	}
	// The source tile starts one texel before the texel under the workgroup's first pixel, or at the image's first
	// texel, and a tile texel past the image repeats the image's last one.
	let origin_source_position: vec2f = source_position_of(workgroup_origin, full_to_half_scale);
	let source_tile_origin: vec2u = vec2u(
		u32(max(floor(origin_source_position.x) - 1.0, 0.0)),
		u32(max(floor(origin_source_position.y) - 1.0, 0.0))
	);
	if (input.thread_idx < SSGI_UPSCALE_SOURCE_TILE_SIZE) {
		let texel: vec2u = vec2u(
			min(source_tile_origin.x + input.thread_idx % SSGI_UPSCALE_SOURCE_TILE_WIDTH, source_extent.x - 1),
			min(source_tile_origin.y + input.thread_idx / SSGI_UPSCALE_SOURCE_TILE_WIDTH, source_extent.y - 1)
		);
		// Mip zero of the depth pyramid holds positive linear depth at the source resolution.
		let z: f32 = fetch(low_resolution_depth, texel).x;
		let position: vec3f = view_position(vec2f(f32(texel.x), f32(texel.y)), z);
		let normal: vec3f = decode_stored_normal(fetch(low_resolution_normals, texel));
		source_positions[input.thread_idx] = vec4f(position.x, position.y, z, 0.0);
		source_normals[input.thread_idx] = vec4f(normal.x, normal.y, normal.z, 0.0);
		source_radiance[input.thread_idx] = fetch(radiance_source, texel);
	}
	workgroup_barrier();

	guard_image_bounds(radiance_output, coordinate);
	let center_index: u32 = (local.y + SSGI_UPSCALE_TILE_RADIUS) * SSGI_UPSCALE_TILE_WIDTH + local.x + SSGI_UPSCALE_TILE_RADIUS;
	let center_z: f32 = tile_depth[center_index];
	if (center_z == 0.0) {
		write(radiance_output, coordinate, vec4f(0.0, 0.0, 0.0, 0.0));
		return;
	}
	let source_position: vec2f = source_position_of(coordinate, full_to_half_scale);
	let center_position: vec3f = view_position(source_position, center_z);
	let center_normal: vec3f = reconstruct_normal(center_index, source_position, center_position, full_to_half_scale);

	// Interpolate the low-resolution texels surrounding this normalized screen position.
	let clamped_position: vec2f = vec2f(
		clamp(source_position.x, 0.0, f32(source_extent.x - 1)),
		clamp(source_position.y, 0.0, f32(source_extent.y - 1))
	);
	let base: vec2u = vec2u(u32(floor(clamped_position.x)), u32(floor(clamped_position.y)));
	let fraction: vec2f = vec2f(clamped_position.x - f32(base.x), clamped_position.y - f32(base.y));
	// The base texel's place in the source tile, kept inside it together with the tap after it.
	let tile_base: vec2u = vec2u(
		min(base.x - source_tile_origin.x, SSGI_UPSCALE_SOURCE_TILE_WIDTH - 2),
		min(base.y - source_tile_origin.y, SSGI_UPSCALE_SOURCE_TILE_WIDTH - 2)
	);
	let sum: vec4f = vec4f(0.0, 0.0, 0.0, 0.0);
	let total_weight: f32 = 0.0;

	for (let tap: u32 = 0; tap < 4; tap = tap + 1) {
		let tap_index: u32 = (tile_base.y + tap / 2) * SSGI_UPSCALE_SOURCE_TILE_WIDTH + tile_base.x + tap % 2;
		let tap_position: vec4f = source_positions[tap_index];
		if (tap_position.z == 0.0) {
			continue;
		}
		let bilinear: f32 = mix(1.0 - fraction.x, fraction.x, f32(tap % 2)) * mix(1.0 - fraction.y, fraction.y, f32(tap / 2));
		let tap_normal: vec4f = source_normals[tap_index];
		// A small floor keeps a tap that lands exactly on the far side of the bilinear footprint eligible.
		let weight: f32 = max(bilinear, 0.001)
			* surface_weight(
				center_normal,
				center_position,
				vec3f(tap_normal.x, tap_normal.y, tap_normal.z),
				vec3f(tap_position.x, tap_position.y, tap_position.z)
			);
		sum = sum + source_radiance[tap_index] * weight;
		total_weight = total_weight + weight;
	}

	// Without a matching tap, report every ray as missed so the environment lights the pixel instead of a neighbor.
	let result: vec4f = vec4f(0.0, 0.0, 0.0, 0.0);
	if (total_weight > 0.00001) {
		result = sum * (1.0 / total_weight);
	}
	write(radiance_output, coordinate, result);
}
