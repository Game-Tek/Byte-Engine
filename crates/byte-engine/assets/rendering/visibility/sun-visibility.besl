// Sun visibility: each shadowed sun's filtered shadow-map visibility times its contact shadow, for every opaque pixel,
// with sun slot `s` in channel `s`. Material evaluation multiplies each sun by one channel of one fetch of the result.
// Resolving the shadow map here, instead of in the material shader, keeps its many fetches in a small kernel that hides
// their latency, and lets the GPU overlap them with the other screen-space passes. Blended surfaces lie in front of
// this depth, so the material shader resolves the map for them, with the same filter: `sample_directional_shadow` in
// `layouts/directional_shadows.besl`, which says how a receiver is searched, proven, and filtered. This pass takes each
// cascade's texels and depth per meter from workgroup memory, where one lane per cascade computes them once.
//
// The receiver's plane and normal come from the pixel's triangle in the visibility buffer, and the receiver moves off
// that triangle along its normal. A pixel every map shadows is done. Otherwise the contact-shadow trace, which dithers
// each pixel's ray start, is smoothed by the mean of the 3x3 pixels around the pixel that lie on its surface, which
// turns the dither into a smooth ramp. A pixel on another surface, such as a foot in front of the floor, does not
// count, so shadows keep to their surface. Each 8x8 workgroup first loads the depth and trace of the 10x10 pixels its
// pixels tap into workgroup memory, so every pixel's taps read shared values.

use ::byte_engine::rendering::visibility::layouts::scene_records::*;
use ::byte_engine::rendering::visibility::layouts::scene::*;
use ::byte_engine::rendering::visibility::layouts::sun_visibility::*;
use ::byte_engine::rendering::visibility::layouts::directional_shadows::*;
use ::byte_engine::rendering::visibility::layouts::virtual_shadows::*;

// Returns the view-space position at continuous full-resolution pixel coordinates, where integers are pixel centers.
sun_view_position: fn (sun_visibility: SunVisibility, pixel: vec2f, z: f32) -> vec3f {
	let pixel_to_ray: vec4f = sun_visibility.sun_visibility_parameters.pixel_to_ray;
	let ray: vec2f = pixel * vec2f(pixel_to_ray.x, pixel_to_ray.y) + vec2f(pixel_to_ray.z, pixel_to_ray.w);
	return vec3f(ray.x * z, ray.y * z, z);
}


// Projects a world-space receiver into one level of the virtual shadow map, moved off its surface by `normal_offset`
// texels of that level. Returns its virtual texel position in x and y, and its depth with a small margin in z: half a
// texel of the level plus five millimeters, which the plane comparison leaves to rounding alone.
virtual_shadow_receiver: fn (
	scene: Scene,
	sampling: VirtualShadowSampling,
	level: u32,
	world_space_position: vec3f,
	normal_offset: vec3f
) -> vec3f {
	let texels_per_meter: f32 = virtual_shadow_texels_per_meter(sampling.sampled_frame.constants, level);
	let position: vec3f = virtual_shadow_level_position(
		scene.views.views[1 + level].view_projection, world_space_position + normal_offset / texels_per_meter
	);
	let margin: f32 = (0.005 + 0.5 / texels_per_meter) / sampling.sampled_frame.constants.w;
	return vec3f(position.x, position.y, position.z + margin);
}

// Returns one of the three candidate levels' values: `first` for offset zero, then `second`, then `third`.
virtual_shadow_candidate: fn (offset: u32, first: vec3f, second: vec3f, third: vec3f) -> vec3f {
	if (offset == 0) {
		return first;
	}
	if (offset == 1) {
		return second;
	}
	return third;
}

// Resolves the sun's shadow from its virtual shadow map, with the cascades' blocker search, penumbra width, and level
// choice, read from pages. The candidate levels run from the one the receiver's distance from the camera picks to two
// coarser, the levels the marking gave it pages in. The receiver's level is the first of them that holds it, and it is
// lit when none does. `surface_vector0`, `surface_vector1`, and `normal_offset` are as `sample_directional_shadow`
// takes them.
sample_virtual_shadow: fn (
	scene: Scene,
	sampling: VirtualShadowSampling,
	angular_radius_tangent: f32,
	world_space_position: vec3f,
	surface_vector0: vec3f,
	surface_vector1: vec3f,
	normal_offset: vec3f
) -> f32 {
	let camera: vec4f = sampling.sampled_frame.camera;
	let constants: vec4f = sampling.sampled_frame.constants;
	let distance: f32 = length(world_space_position - vec3f(camera.x, camera.y, camera.z));
	if (distance >= camera.w) {
		return 1.0;
	}
	let first_level: u32 = virtual_shadow_receiver_level(constants, distance);
	let last_level: u32 = min(first_level + 2, VIRTUAL_SHADOW_LEVELS - 1);
	// Each candidate's receiver, projected once, and one bit per candidate, from the first, for the ones that hold it.
	let receiver0: vec3f = virtual_shadow_receiver(scene, sampling, first_level, world_space_position, normal_offset);
	let receiver1: vec3f = virtual_shadow_receiver(scene, sampling, min(first_level + 1, last_level), world_space_position, normal_offset);
	let receiver2: vec3f = virtual_shadow_receiver(scene, sampling, last_level, world_space_position, normal_offset);
	let held: u32 = 0;
	let depth_level: u32 = VIRTUAL_SHADOW_LEVELS;
	for (let level: u32 = first_level; level <= last_level; level = level + 1) {
		let receiver: vec3f = virtual_shadow_candidate(level - first_level, receiver0, receiver1, receiver2);
		if (virtual_shadow_level_holds(sampling, level, vec2f(receiver.x, receiver.y), receiver.z)) {
			held = held | (1 << (level - first_level));
			depth_level = min(depth_level, level);
		}
	}
	if (held == 0) {
		return 1.0;
	}

	// The blocker search runs in the first level where occluders up to two meters above the receiver cast penumbrae
	// within twelve texels, or the last candidate, as `directional_shadow_fitting_cascade` picks a cascade; in the
	// receiver's level when that one doesn't hold it.
	let search_level: u32 = last_level;
	for (let level: u32 = last_level; level > depth_level; level = level - 1) {
		if (2.0 * angular_radius_tangent * virtual_shadow_texels_per_meter(constants, level - 1) <= 12.0) {
			search_level = level - 1;
		}
	}
	if ((held & (1 << (search_level - first_level))) == 0) {
		search_level = depth_level;
	}
	let search_receiver: vec3f = virtual_shadow_candidate(search_level - first_level, receiver0, receiver1, receiver2);
	let texels: f32 = f32(VIRTUAL_SHADOW_RESOLUTION);
	let search_gradient: vec2f = directional_shadow_receiver_gradient(
		scene.views.views[1 + search_level].view_projection, surface_vector0, surface_vector1
	) / texels;
	let occluder_distance: f32 = virtual_shadow_occluder_distance(
		sampling, search_level, vec2f(search_receiver.x, search_receiver.y), search_receiver.z, search_gradient
	);
	if (search_level == depth_level) {
		if (occluder_distance <= 0.0 - 2.0) {
			return 0.0;
		}
		if (occluder_distance < 0.0) {
			return 1.0;
		}
	}

	// The penumbra filters in the candidate that holds the receiver where clamping its width to the tent's two to
	// eight texels changes it least, mixed with the best one on the other side of sqrt(12) texels where the two fit
	// almost as well, as `sample_directional_shadow` chooses among cascades.
	let penumbra_meters: f32 = max(occluder_distance, 0.0) * angular_radius_tangent;
	let fitted_penumbra_meters: f32 = max(penumbra_meters, 0.0001);
	let last_filter_level: u32 = min(search_level + 1, last_level);
	let narrow_level: u32 = VIRTUAL_SHADOW_LEVELS;
	let narrow_misfit: f32 = 100000000.0;
	let wide_level: u32 = VIRTUAL_SHADOW_LEVELS;
	let wide_misfit: f32 = 100000000.0;
	for (let level: u32 = depth_level; level <= last_filter_level; level = level + 1) {
		if ((held & (1 << (level - first_level))) != 0) {
			let width: f32 = fitted_penumbra_meters * virtual_shadow_texels_per_meter(constants, level);
			let misfit: f32 = max(2.0 / width, width / 6.0);
			if (width * width < 12.0) {
				if (misfit < narrow_misfit) {
					narrow_level = level;
					narrow_misfit = misfit;
				}
			} else if (misfit < wide_misfit) {
				wide_level = level;
				wide_misfit = misfit;
			}
		}
	}
	let filter_level: u32 = wide_level;
	let filter_misfit: f32 = wide_misfit;
	let partner_level: u32 = narrow_level;
	let partner_misfit: f32 = narrow_misfit;
	if (narrow_misfit < wide_misfit || (narrow_misfit == wide_misfit && narrow_level < wide_level)) {
		filter_level = narrow_level;
		filter_misfit = narrow_misfit;
		partner_level = wide_level;
		partner_misfit = wide_misfit;
	}
	let filter_share: f32 = 1.0;
	let sampled_levels: u32 = 1;
	if (partner_level != VIRTUAL_SHADOW_LEVELS) {
		filter_share = min(partner_misfit / filter_misfit - 0.5, 1.0);
		if (filter_share < 1.0) {
			sampled_levels = 2;
		}
	}
	let lit: f32 = 0.0;
	for (let sampled: u32 = 0; sampled < sampled_levels; sampled = sampled + 1) {
		let level: u32 = filter_level;
		let share: f32 = filter_share;
		if (sampled == 1) {
			level = partner_level;
			share = 1.0 - filter_share;
		}
		let receiver: vec3f = virtual_shadow_candidate(level - first_level, receiver0, receiver1, receiver2);
		let gradient: vec2f = search_gradient;
		if (level != search_level) {
			gradient = directional_shadow_receiver_gradient(
				scene.views.views[1 + level].view_projection, surface_vector0, surface_vector1
			) / texels;
		}
		// A level other than the search's proves the receiver lit or shadowed itself where it can, since a thin occluder
		// or gap can vanish at the search's resolution.
		let proven: f32 = 0.0;
		if (occluder_distance <= 0.0 && level != search_level) {
			proven = virtual_shadow_occluder_distance(sampling, level, vec2f(receiver.x, receiver.y), receiver.z, gradient);
		}
		let level_lit: f32 = 0.0;
		if (proven == 0.0 - 1.0) {
			level_lit = 1.0;
		} else if (proven != 0.0 - 2.0) {
			level_lit = virtual_shadow_penumbra(
				sampling, level, vec2f(receiver.x, receiver.y), receiver.z, gradient,
				penumbra_meters * virtual_shadow_texels_per_meter(constants, level)
			);
		}
		lit = lit + share * level_lit;
	}
	return lit;
}

// Per tile pixel: 1/z of the view depth, or zero without a surface; and every sun's trace, one per channel.
shared_inverse_depth: workgroup<f32, 100>;
shared_trace: workgroup<vec4f, 100>;
// Per cascade of every sun, its texels per meter and its stored depth per meter, which depend only on the cascade's fit.
shared_cascade_texels_per_meter: workgroup<f32, 16>;
shared_cascade_depth_per_meter: workgroup<f32, 16>;

CONTACT_SHADOW_FILTER_WORKGROUP_WIDTH: const u32 = 8;
CONTACT_SHADOW_FILTER_WORKGROUP_SIZE: const u32 = 64;
// The workgroup's 8x8 pixels and the pixel around them that their 3x3 neighborhoods reach.
CONTACT_SHADOW_FILTER_TILE_WIDTH: const u32 = 10;
CONTACT_SHADOW_FILTER_TILE_SIZE: const u32 = 100;
// A neighbor counts fully when its depth lies on the pixel's surface plane, and less the further it lies from it, down
// to nothing at this distance relative to the pixel's depth.
CONTACT_SHADOW_FILTER_PLANE_TOLERANCE: const f32 = 0.02;

// Returns the image pixel under one tile pixel. The tile starts one pixel before the workgroup's first pixel, and a tile
// pixel past the image repeats the image's edge.
contact_tile_pixel: fn (workgroup_origin: vec2u, extent: vec2u, tile_index: u32) -> vec2u {
	return vec2u(
		min(max(workgroup_origin.x + tile_index % CONTACT_SHADOW_FILTER_TILE_WIDTH, 1) - 1, extent.x - 1),
		min(max(workgroup_origin.y + tile_index / CONTACT_SHADOW_FILTER_TILE_WIDTH, 1) - 1, extent.y - 1)
	);
}

// Loads one tile pixel's 1/z into workgroup memory, or zero without a surface.
load_tile_inverse_depth: fn (sun_visibility: SunVisibility, workgroup_origin: vec2u, extent: vec2u, tile_index: u32) -> void {
	let device_depth: f32 = fetch(sun_visibility.visibility_depth, contact_tile_pixel(workgroup_origin, extent, tile_index)).x;
	shared_inverse_depth[tile_index] = 0.0;
	if (device_depth != 0.0) {
		shared_inverse_depth[tile_index] = (device_depth + sun_visibility.sun_visibility_parameters.depth_unproject_denominator_offset)
			/ sun_visibility.sun_visibility_parameters.depth_unproject_numerator;
	}
}

// Resolves one sun's shadow map at the pixel's receiver, from its four cascades after the camera's view. `edge0` and
// `edge1` are the receiver's world-space triangle edges, and `normal` and `view_normal` its unit triangle normal, in
// world and view space; either side of the triangle serves.
resolve_sun_shadow: fn (
	scene: Scene,
	sun_visibility: SunVisibility,
	sampling: VirtualShadowSampling,
	shadows: DirectionalShadows,
	sun: u32,
	world_position: vec3f,
	view_position: vec3f,
	edge0: vec3f,
	edge1: vec3f,
	normal: vec3f,
	view_normal: vec3f
) -> f32 {
	let normal_offset: vec3f = directional_shadow_normal_offset(normal, dot(view_normal, vec3f(
		sun_visibility.sun_visibility_parameters.suns[sun].x, sun_visibility.sun_visibility_parameters.suns[sun].y, sun_visibility.sun_visibility_parameters.suns[sun].z
	)));
	// Under virtual shadow maps the one shadowed sun samples its pages instead of cascades.
	if (sun_visibility.sun_visibility_parameters.virtual_shadows != 0) {
		return sample_virtual_shadow(
			scene, sampling, sun_visibility.sun_visibility_parameters.suns[sun].w, world_position, edge0, edge1, normal_offset
		);
	}
	let first_cascade: u32 = sun * 4;
	return sample_directional_shadow(
		scene, shadows,
		shadows.directional_shadow_map,
		first_cascade + 1,
		first_cascade + 2,
		first_cascade + 3,
		first_cascade + 4,
		vec4f(
			shared_cascade_texels_per_meter[first_cascade],
			shared_cascade_texels_per_meter[first_cascade + 1],
			shared_cascade_texels_per_meter[first_cascade + 2],
			shared_cascade_texels_per_meter[first_cascade + 3]
		),
		vec4f(
			shared_cascade_depth_per_meter[first_cascade],
			shared_cascade_depth_per_meter[first_cascade + 1],
			shared_cascade_depth_per_meter[first_cascade + 2],
			shared_cascade_depth_per_meter[first_cascade + 3]
		),
		sun_visibility.sun_visibility_parameters.suns[sun].w,
		world_position,
		abs(view_position.z),
		edge0,
		edge1,
		normal_offset
	);
}

main: fn (input: StageInput, scene: Scene, sun_visibility: SunVisibility, sampling: VirtualShadowSampling, shadows: DirectionalShadows) -> void {
	let pixel: vec2u = input.thread_id;
	let extent: vec2u = image_size(sun_visibility.sun_visibility_output);
	let sun_count: u32 = sun_visibility.sun_visibility_parameters.sun_count;
	let local: vec2u = vec2u(
		input.thread_idx % CONTACT_SHADOW_FILTER_WORKGROUP_WIDTH,
		input.thread_idx / CONTACT_SHADOW_FILTER_WORKGROUP_WIDTH
	);
	// The 64 lanes load the 100 tile pixels in two rounds.
	let workgroup_origin: vec2u = pixel - local;
	let second_tile_index: u32 = input.thread_idx + CONTACT_SHADOW_FILTER_WORKGROUP_SIZE;
	load_tile_inverse_depth(sun_visibility, workgroup_origin, extent, input.thread_idx);
	if (second_tile_index < CONTACT_SHADOW_FILTER_TILE_SIZE) {
		load_tile_inverse_depth(sun_visibility, workgroup_origin, extent, second_tile_index);
	}
	// The bake removes this block, and with it the trace binding, when the project leaves contact shadows out.
	if (sun_visibility.sun_visibility_parameters.contact_shadows != 0) {
		shared_trace[input.thread_idx] = fetch(sun_visibility.contact_shadow_trace, contact_tile_pixel(workgroup_origin, extent, input.thread_idx));
		if (second_tile_index < CONTACT_SHADOW_FILTER_TILE_SIZE) {
			shared_trace[second_tile_index] = fetch(sun_visibility.contact_shadow_trace, contact_tile_pixel(workgroup_origin, extent, second_tile_index));
		}
	}
	// One lane per cascade of every sun computes its scales while the tile loads; views 1 onward hold the cascades.
	if (input.thread_idx < sun_count * 4) {
		let cascade_view_projection: mat4f = scene.views.views[input.thread_idx + 1].view_projection;
		shared_cascade_texels_per_meter[input.thread_idx] = directional_shadow_texels_per_meter(
			cascade_view_projection, f32(texture_size(shadows.directional_shadow_map).x)
		);
		shared_cascade_depth_per_meter[input.thread_idx] = directional_shadow_depth_per_meter(cascade_view_projection);
	}
	workgroup_barrier();

	guard_image_bounds(sun_visibility.sun_visibility_output, pixel);
	let device_depth: f32 = fetch(sun_visibility.visibility_depth, pixel).x;
	if (device_depth == 0.0) {
		write(sun_visibility.sun_visibility_output, pixel, vec4f(1.0, 1.0, 1.0, 1.0));
		return;
	}
	let center_inverse_z: f32 = (device_depth + sun_visibility.sun_visibility_parameters.depth_unproject_denominator_offset) / sun_visibility.sun_visibility_parameters.depth_unproject_numerator;
	// The receiver the shadow map sees: the pixel's view-space position from its depth, on the plane of the triangle the
	// visibility buffer holds for the pixel. The plane comes from the triangle itself, not from neighboring depths,
	// so it does not jump where the pixel's neighbors lie on other triangles, at creases and silhouettes. The shadow
	// helpers take world space, as the cascades are fitted there.
	let pixel_f: vec2f = vec2f(f32(pixel.x), f32(pixel.y));
	let view_position: vec3f = sun_view_position(sun_visibility, pixel_f, 1.0 / center_inverse_z);
	let world_position: vec3f = scene.views.views[0].inverse_view * vec4f(view_position.x, view_position.y, view_position.z, 1.0);
	let instance_index: u32 = image_load_u32(sun_visibility.instance_index, pixel);
	if (instance_index == 4294967295) {
		write(sun_visibility.sun_visibility_output, pixel, vec4f(1.0, 1.0, 1.0, 1.0));
		return;
	}
	let mesh: Mesh = scene.meshes[instance_index];
	// The low eight bits name the triangle within its meshlet, and the rest the meshlet.
	let triangle_meshlet_indices: u32 = image_load_u32(sun_visibility.primitive_index, pixel);
	let meshlet: Meshlet = scene.meshlets[triangle_meshlet_indices >> 8];
	let primitive_index_base: u32 = (meshlet.triangle_offset + (triangle_meshlet_indices & 255)) * 3;
	let vertex_index_base: u32 = meshlet.primitive_offset;
	let vertex_base: u32 = instance_vertex_base(mesh.level, mesh.surface.x, scene.mesh_levels[mesh.level & MESH_LEVEL_MASK].vertex_base);
	let position0: vec3f = scene.vertex_positions[vertex_base + u32(scene.vertex_indices[vertex_index_base + u32(scene.primitive_indices[primitive_index_base])])];
	let position1: vec3f = scene.vertex_positions[vertex_base + u32(scene.vertex_indices[vertex_index_base + u32(scene.primitive_indices[primitive_index_base + 1])])];
	let position2: vec3f = scene.vertex_positions[vertex_base + u32(scene.vertex_indices[vertex_index_base + u32(scene.primitive_indices[primitive_index_base + 2])])];
	let edge0: vec3f = mesh.model * vec4f(position1.x - position0.x, position1.y - position0.y, position1.z - position0.z, 0.0);
	let edge1: vec3f = mesh.model * vec4f(position2.x - position0.x, position2.y - position0.y, position2.z - position0.z, 0.0);
	// The triangle's normal. Each sun's resolve turns it to that sun's side, which the receiver's normal offset leaves on.
	let normal: vec3f = normalize(cross(edge0, edge1));
	let view_normal: vec3f = scene.views.views[0].view * vec4f(normal.x, normal.y, normal.z, 0.0);
	// Each sun's shadow-map visibility in its channel. Material evaluation never reads an unused slot's channel, so
	// it stays zero and leaves the fully-shadowed test below to the used ones.
	//
	// The first sun resolves outside any loop, and the bake removes the loop over the later suns from a project that
	// shadows one sun. The receiver's position, edges, and normal then die inside that one resolve, where its filter
	// needs their registers. Behind a loop they stay live for the next sun, and the compiler spills them to the stack
	// on every pixel. A project that shadows more suns compiles the resolve twice and pays that spill.
	let suns: vec4f = vec4f(0.0, 0.0, 0.0, 0.0);
	suns.x = resolve_sun_shadow(scene, sun_visibility, sampling, shadows, 0, world_position, view_position, edge0, edge1, normal, view_normal);
	if (sun_visibility.sun_visibility_parameters.later_suns != 0) {
		for (let sun: u32 = 1; sun < sun_count; sun = sun + 1) {
			suns[sun] = resolve_sun_shadow(scene, sun_visibility, sampling, shadows, sun, world_position, view_position, edge0, edge1, normal, view_normal);
		}
	}
	// A pixel every shadow map fully shadows needs no contact shadow.
	if (max(max(suns.x, suns.y), max(suns.z, suns.w)) <= 0.0) {
		write(sun_visibility.sun_visibility_output, pixel, vec4f(0.0, 0.0, 0.0, 0.0));
		return;
	}
	// Without contact shadows, the shadow map alone shadows the pixel.
	let result: vec4f = vec4f(1.0, 1.0, 1.0, 1.0);
	if (sun_visibility.sun_visibility_parameters.contact_shadows != 0) {
		// 1/z is linear across the screen on a plane. On the plane n . p = d through the pixel's triangle, with
		// p = z (r.x x + a.x, r.y y + a.y, 1) for pixel_to_ray (r, a), 1/z changes by n.x r.x / d per pixel along x and by
		// n.y r.y / d along y, which predicts each neighbor's depth on the pixel's own surface.
		let plane_distance: f32 = dot(view_normal, view_position);
		let surface_gradient: vec2f = vec2f(0.0, 0.0);
		if (abs(plane_distance) > 0.000001 * view_position.z) {
			let pixel_to_ray: vec4f = sun_visibility.sun_visibility_parameters.pixel_to_ray;
			surface_gradient = vec2f(view_normal.x * pixel_to_ray.x, view_normal.y * pixel_to_ray.y) / plane_distance;
		}
		// The mean of the trace over the 3x3 pixels around the pixel that lie on its surface. Each 3x3 block of the
		// trace's noise covers its range evenly, so the mean turns the dithered march into a smooth ramp, and a pixel on
		// another surface, such as a foot in front of the floor, does not count, so shadows keep to their surface.
		let center_index: u32 = (local.y + 1) * CONTACT_SHADOW_FILTER_TILE_WIDTH + local.x + 1;
		let lit: vec4f = vec4f(0.0, 0.0, 0.0, 0.0);
		let total_weight: f32 = 0.0;
		for (let tap_row: u32 = 0; tap_row < 3; tap_row = tap_row + 1) {
			for (let tap_column: u32 = 0; tap_column < 3; tap_column = tap_column + 1) {
				let tap_index: u32 = center_index + tap_row * CONTACT_SHADOW_FILTER_TILE_WIDTH + tap_column - CONTACT_SHADOW_FILTER_TILE_WIDTH - 1;
				let tap_inverse_z: f32 = shared_inverse_depth[tap_index];
				if (tap_inverse_z != 0.0) {
					let offset: vec2f = vec2f(f32(tap_column), f32(tap_row)) - vec2f(1.0, 1.0);
					let predicted_inverse_z: f32 = center_inverse_z + dot(surface_gradient, offset);
					let plane_error: f32 = abs(tap_inverse_z - predicted_inverse_z) / center_inverse_z;
					let weight: f32 = clamp(1.0 - plane_error / CONTACT_SHADOW_FILTER_PLANE_TOLERANCE, 0.0, 1.0);
					lit = lit + shared_trace[tap_index] * weight;
					total_weight = total_weight + weight;
				}
			}
		}
		// Without a neighbor on the pixel's plane, such as on a surface thinner than a pixel, the shadow map alone
		// shadows it.
		if (total_weight > 0.00001) {
			result = lit / total_weight;
		}
	}
	write(sun_visibility.sun_visibility_output, pixel, suns * result);
}
