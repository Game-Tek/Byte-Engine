// Turns one tile's spawn request into a surfel: takes a free slot and starts the new surfel there.
//
// A slot comes from the free stack while it holds one, then from the slots no surfel has used yet. A full pool spawns
// nothing. When the resolve found a mature parent that faces the same way, the new surfel starts with its parent's
// light, worth SURFEL_PARENT_PRIOR_RAYS rays, so it neither flashes dark while it fades in nor jumps to its first rays'
// noisy average. The next frame's grid lists it.

main: fn (input: StageInput) -> void {
	let tile: u32 = input.thread_id.x;
	if (tile >= surfel_resolve_parameters.spawn_tile_count || surfel_spawns[tile].requested == 0) {
		return;
	}
	let slot: u32 = surfel_take_slot();
	if (slot == NO_SURFEL) {
		return;
	}
	let request: SurfelSpawn = surfel_spawns[tile];
	let light: vec4f = vec4f(0.0, 0.0, 0.0, 0.0);
	let prior: f32 = 0.0;
	if (request.parent != NO_SURFEL) {
		light = vec4f(surfel_records[request.parent].irradiance);
		prior = SURFEL_PARENT_PRIOR_RAYS;
	}
	surfel_start(slot, request.position, request.normal, light, prior, 0);
}
