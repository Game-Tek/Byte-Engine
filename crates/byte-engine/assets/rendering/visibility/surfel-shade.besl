// Shades the frame's surfel hits, one invocation per hit in material order: runs the closest-hit shader of the
// material each hit landed on, then lights the surface it reports.
//
// A hit's surface reflects the scene's lights that reach it and the light the surfels around it gathered last frame,
// the sky they see included, and adds what it emits. The result goes to the hit's ray, which the integrate pass then
// folds into its surfel's estimate. The surfel that lights a hit most earns importance, which keeps it alive while it
// serves rays even off the screen. A hit no surfel covers asks for one, when the camera saw the surfel whose ray found
// it, so surfaces the camera never saw, such as a ceiling lit through a doorway, still get bounce light.
//
// Spawning where rays hit follows the irradiance cache of kajiya by Tomasz Stachowiak (MIT License, Copyright (c) 2019
// Embark Studios), which allocates entries where rays look them up, limited by the lookup's bounce. See
// THIRD_PARTY_NOTICES.md.

// How far along its normal a shadow ray leaves a hit, in meters.
SURFEL_HIT_OFFSET: const f32 = 0.002;
// The most surfels a hit reads from its cell for the light gathered there: the first of its list, which starts with the
// surfels near the cell's center.
SURFEL_HIT_LOOKUP_LIMIT: const u32 = 16;
// The importance a surfel earns for a hit it lights with pre-exposed light of luminance one, and the most it earns.
SURFEL_HIT_IMPORTANCE: const f32 = 50.0;
// The surfels' light at a hit is their trusted light over their coverage, but over at least this much coverage, so
// the light fades out toward the edge of the last disc instead of stopping there.
SURFEL_HIT_MIN_COVERAGE: const f32 = 0.1;
// A hit asks for a surfel while its coverage is below this, as a pixel does.
SURFEL_HIT_SPAWN_COVERAGE: const f32 = 0.1;

// Returns the light the scene's lights give a surface at `position` with the unit `normal`, as irradiance over π: each
// sun, and each point and cone light within reach, when no geometry hides it. Point and cone lights shine as material
// evaluation lights a surface, but at their peak intensity in every direction: an IES profile doesn't shape their light
// here. It matches `probe_direct_light` in `probe-shade.besl`, so both techniques light a hit the same way.
surfel_direct_light: fn (position: vec3f, normal: vec3f) -> vec3f {
	let shadow_origin: vec3f = position + normal * SURFEL_HIT_OFFSET;
	let light: vec3f = vec3f(0.0, 0.0, 0.0);
	for (let index: u32 = 0; index < surfel_scene_lights.light_count; index = index + 1) {
		if (surfel_scene_lights.lights[index].type == DIRECTIONAL_LIGHT) {
			// A sun keeps the direction its light travels in `position`.
			let toward_sun: vec3f = -surfel_scene_lights.lights[index].position;
			let sun_cosine: f32 = dot(normal, toward_sun);
			if (sun_cosine > 0.0) {
				if (!trace_occlusion(scene_structure, 255, shadow_origin, toward_sun, 0.0, SURFEL_RAY_LENGTH)) {
					light = light + surfel_scene_lights.lights[index].color * (sun_cosine / 3.14159265359);
				}
			}
			continue;
		}
		let to_light: vec3f = surfel_scene_lights.lights[index].position - position;
		let distance_squared: f32 = dot(to_light, to_light);
		let reach: f32 = surfel_scene_lights.lights[index].reach;
		if (distance_squared <= 0.0 || distance_squared >= reach * reach) {
			continue;
		}
		let distance: f32 = sqrt(distance_squared);
		let toward_light: vec3f = to_light * (1.0 / distance);
		let cosine: f32 = dot(normal, toward_light);
		let falloff: f32 = 1.0 / distance_squared;
		if (surfel_scene_lights.lights[index].type == CONE_LIGHT) {
			let cone: vec2f = surfel_scene_lights.lights[index].cone_cosines;
			let along: f32 = 0.0 - dot(surfel_scene_lights.lights[index].direction, toward_light);
			falloff = falloff * clamp((along - cone.y) / (cone.x - cone.y), 0.0, 1.0);
		}
		if (cosine > 0.0 && falloff > 0.0) {
			if (!trace_occlusion(scene_structure, 255, shadow_origin, toward_light, 0.0, distance - SURFEL_HIT_OFFSET)) {
				light = light + surfel_scene_lights.lights[index].color * (falloff * cosine / 3.14159265359);
			}
		}
	}
	return light;
}

main: fn (input: StageInput) -> void {
	let index: u32 = input.launch_index.x;
	if (index >= ray_hit_sort.hit_count) {
		return;
	}
	let ray: u32 = ray_sorted_hits[index];
	let hit: Hit = kept_ray_hit(ray);
	let surface: HitSurface = invoke(
		hit,
		HitSurface(vec3f16(0.0, 0.0, 0.0), 0, vec3f(0.0, 0.0, 0.0), vec3f16(0.0, 0.0, 1.0))
	);
	let radiance: vec3f = surface.emission;
	let albedo: vec3f = vec3f(surface.albedo);
	if (surface.front_face == 0) {
		// The ray saw into a surface from behind, which the integrate pass counts toward its surfel lying inside
		// geometry.
		surfel_ray_results[ray].flags = surfel_ray_results[ray].flags | SURFEL_RAY_BACK_FACE;
	} else if (albedo.x + albedo.y + albedo.z > 0.0) {
		// A black surface reflects nothing, so it needs no light.
		let position: vec3f = hit.origin + hit.direction * hit.distance;
		let normal: vec3f = normalize(vec3f(surface.normal));
		// The light reaching the hit as irradiance over π, which the albedo turns into reflected radiance.
		let light: vec3f = surfel_direct_light(position, normal);

		// The surfels around the hit hold the light that reached them last frame, pre-exposed, from the sky and from
		// other surfaces. A hit where no surfel lies yet gets none, as in webgiya, rather than sky that walls may hide.
		// Radial depth hides a surfel on the other side of a wall from the hit, as it does from a pixel, so light doesn't
		// bounce through walls. Each surfel's light counts as far as lookups trust it, so a new surfel fades in.
		let cell: u32 = surfel_cell_of(position);
		let start: u32 = surfel_scan[cell];
		let cell_count: u32 = surfel_scan[cell + 1] - start;
		let end: u32 = start + min(cell_count, SURFEL_HIT_LOOKUP_LIMIT);
		let gathered: vec4f = vec4f(0.0, 0.0, 0.0, 0.0);
		let coverage: f32 = 0.0;
		let best_contribution: f32 = 0.0;
		let best_surfel: u32 = NO_SURFEL;
		for (let entry: u32 = start; entry < end; entry = entry + 1) {
			let surfel: u32 = surfel_cell_entries[entry];
			// As in the resolve, a surfel farther away than its lookup radius weighs nothing.
			let surfel_offset: vec3f = position - surfel_records[surfel].position;
			let reach: f32 = surfel_records[surfel].radius * SURFEL_LOOKUP_SCALE;
			if (dot(surfel_offset, surfel_offset) >= reach * reach) {
				continue;
			}
			let record: SurfelRecord = surfel_records[surfel];
			let surfel_normal: vec3f = decode_surfel_normal(record.normal);
			let distance: f32 = surfel_distance(surfel_offset, surfel_normal);
			let weight: f32 = (1.0 - smoothstep(0.0, reach, distance)) * max(0.0, dot(surfel_normal, normal));
			if (weight > 0.0) {
				weight = weight * surfel_occlusion(surfel, record, surfel_normal, position);
			}
			let contribution: vec4f = vec4f(record.irradiance) * (weight * record.weight);
			gathered = gathered + contribution;
			coverage = coverage + weight;
			let luminance: f32 = contribution.x * 0.2126 + contribution.y * 0.7152 + contribution.z * 0.0722;
			if (luminance > best_contribution) {
				best_contribution = luminance;
				best_surfel = surfel;
			}
		}
		if (best_surfel != NO_SURFEL && best_contribution > 0.01) {
			atomic_max(surfel_states[best_surfel].touched, u32(min(best_contribution * SURFEL_HIT_IMPORTANCE, SURFEL_HIT_IMPORTANCE)));
		}
		let blended: vec4f = gathered * (1.0 / max(coverage, SURFEL_HIT_MIN_COVERAGE));
		light = light + vec3f(blended.x, blended.y, blended.z) * (1.0 / surfel_parameters.previous_exposure);
		radiance = radiance + albedo * light;

		// An uncovered hit asks for a surfel, once per grid cell a frame, while the cell isn't crowded. Only the rays of
		// surfels the camera saw ask, so requests from later bounces never take the pool's slots from the surfaces
		// that matter most, and the pool keeps a share of its slots for the camera's own spawns.
		let caster: u32 = surfel_rays[ray] & SURFEL_SLOT_MASK;
		if (
			coverage < SURFEL_HIT_SPAWN_COVERAGE
			&& cell_count < SURFEL_CROWDED_CELL
			&& surfel_states[caster].bounce == 0
		) {
			// The first hit to claim the cell this frame asks. A claim holds the frame index plus one, so the zeros a
			// new pool starts with claim nothing.
			let claim: u32 = surfel_parameters.frame_index + 1;
			if (atomic_exchange(surfel_cells.claims[cell], claim) != claim) {
				let request: u32 = atomic_add(surfel_pool.hit_spawns, 1);
				if (request < SURFEL_MAX_HIT_SPAWNS) {
					surfel_hit_spawns[request] = SurfelHitSpawn(position, encode_surfel_normal(normal));
				}
			}
		}
	}
	// The trace wrote the rest of the ray's result.
	surfel_ray_results[ray].radiance = radiance;
}
