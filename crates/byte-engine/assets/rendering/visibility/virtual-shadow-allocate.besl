// Gives each request a physical page, as the chapter's allocation pass does: request `i` takes free page `i`, the
// requests past the free pages take the pages no receiver needed this frame, and the rest wait for a later frame.
// A taken page leaves the slot that held it. One thread per request.

use ::byte_engine::rendering::visibility::layouts::virtual_shadows::*;

main: fn (input: StageInput, pages: VirtualShadowPages) -> void {
	let request: u32 = input.thread_id.x;
	if (request >= pages.requests.total) {
		return;
	}
	let slot: u32 = pages.requests.slots[request];
	let free_count: u32 = atomic_load(pages.page_lists.free_count);
	let physical: u32 = 0;
	if (request < free_count) {
		physical = pages.page_lists.free_pages[request];
	} else if (request - free_count < atomic_load(pages.page_lists.unvisited_count)) {
		physical = pages.page_lists.unvisited_pages[request - free_count];
		let previous_owner: u32 = atomic_load(pages.page_owners.owners[physical]);
		atomic_store(pages.page_table.entries[previous_owner & OWNER_SLOT_MASK], 0);
	} else {
		return;
	}
	atomic_store(pages.page_table.entries[slot], PAGE_ALLOCATED | PAGE_REQUESTED | PAGE_VISITED | physical);
	atomic_store(pages.page_owners.owners[physical], OWNER_ALLOCATED | OWNER_VISITED | slot);
	pages.page_origins.origins[physical] = pages.page_frame.constants.z;
}
