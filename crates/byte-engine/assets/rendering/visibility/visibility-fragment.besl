main: fn (
	input: StageInput,
	// The mesh stage writes the instance once per vertex, the same for every vertex of a triangle, and the primitive
	// once per primitive.
	pipeline_input: interface {
		instance_index: u32,
		primitive_index: primitive<u32>,
	},
) -> output {
	primitive_index: u32,
	instance_id: u32,
} {
	return {
		primitive_index: pipeline_input.primitive_index,
		instance_id: pipeline_input.instance_index,
	};
}
