// Converts group item counts to offsets and writes the indirect dispatch records. Each lane scans consecutive
// groups so a stable instance list keeps its meshlets in the same order for next frame's occlusion tests.

use ::byte_engine::rendering::visibility::layouts::scene_records::*;
use ::byte_engine::rendering::visibility::layouts::work_build::*;

RANGE_LANES: const u32 = 64;
lane_totals: workgroup<vec2u, 64>;

push_constant: push_constant {
	// One past the last group of each raster phase. The phases' groups follow one another.
	opaque_end: u32,
	masked_end: u32,
	double_sided_end: u32,
	double_sided_masked_end: u32,
	transparent_end: u32,
	// The words the work buffer holds, its ranges included.
	capacity: u32,
}

main: fn (input: StageInput, work_build: WorkBuild) -> void {
	let lane: u32 = input.thread_idx;
	let first_group: u32 = 0;
	// The ranges take the first words of the work buffer.
	let first_item: u32 = WORK_HEADER;
	for (let phase: u32 = 0; phase < 5; phase = phase + 1) {
		let end_group: u32 = push_constant.opaque_end;
		if (phase == 1) { end_group = push_constant.masked_end; }
		if (phase == 2) { end_group = push_constant.double_sided_end; }
		if (phase == 3) { end_group = push_constant.double_sided_masked_end; }
		if (phase == 4) { end_group = push_constant.transparent_end; }

		// Sum a contiguous run per lane. Empty runs contribute zero, including in an empty phase.
		let run: u32 = (end_group - first_group + RANGE_LANES - 1) / RANGE_LANES;
		let first: u32 = min(first_group + lane * run, end_group);
		let end: u32 = min(first + run, end_group);
		let total: vec2u = vec2u(0, 0);
		for (let group: u32 = first; group < end; group = group + 1) {
			total = total + work_build.group_items[group];
		}
		lane_totals[lane] = total;
		workgroup_barrier();
		// Scan chunks and shared items together. Each step reads the previous step before any lane overwrites it.
		for (let distance: u32 = 1; distance < RANGE_LANES; distance = distance * 2) {
			let earlier: vec2u = vec2u(0, 0);
			if (lane >= distance) {
				earlier = lane_totals[lane - distance];
			}
			workgroup_barrier();
			lane_totals[lane] = lane_totals[lane] + earlier;
			workgroup_barrier();
		}
		// The last prefix counts every chunk (x) and shared item (y) in the phase.
		let phase_counts: vec2u = lane_totals[RANGE_LANES - 1];
		let shared_base: u32 = first_item + phase_counts.x;
		let offset: vec2u = vec2u(first_item, shared_base) + (lane_totals[lane] - total);
		// Every lane has read its prefix and the phase total before the next phase can reuse lane_totals.
		workgroup_barrier();
		for (let group: u32 = first; group < end; group = group + 1) {
			let counts: vec2u = work_build.group_items[group];
			work_build.group_items[group] = offset;
			offset = offset + counts;
		}
		// Shared items fill whole workgroups of 32 lanes, the last one padded with empty items.
		let shared_groups: u32 = (phase_counts.y + 31) / 32;
		let item_count: u32 = phase_counts.x + shared_groups * 32;
		if (lane == 0) {
			// Dispatch only chunks and complete shared groups that fit in the buffer.
			let drawn_chunks: u32 = min(phase_counts.x, push_constant.capacity - first_item);
			let shared_room: u32 = 0;
			if (shared_base < push_constant.capacity) {
				shared_room = (push_constant.capacity - shared_base) / 32;
			}
			let drawn_shared: u32 = min(shared_groups, shared_room);
			for (let item: u32 = shared_base + phase_counts.y; item < shared_base + drawn_shared * 32; item = item + 1) {
				work_build.work_items[item] = EMPTY_WORK_ITEM;
			}

			let range: u32 = phase * 2;
			work_build.work_items[range * 2] = first_item;
			work_build.work_items[range * 2 + 1] = drawn_chunks;
			work_build.work_items[range * 2 + 2] = shared_base;
			work_build.work_items[range * 2 + 3] = drawn_shared;
			work_build.work_dispatches[range * 3] = drawn_chunks;
			work_build.work_dispatches[range * 3 + 1] = 1;
			work_build.work_dispatches[range * 3 + 2] = 1;
			work_build.work_dispatches[range * 3 + 3] = drawn_shared;
			work_build.work_dispatches[range * 3 + 4] = 1;
			work_build.work_dispatches[range * 3 + 5] = 1;
		}

		first_item = min(first_item + item_count, push_constant.capacity);
		first_group = end_group;
	}
}
