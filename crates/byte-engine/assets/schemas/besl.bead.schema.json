{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byte-engine.dev/schemas/besl.bead.schema.json",
  "title": "Byte Engine standalone BESL shader settings",
  "description": "Pipeline-stage metadata for an adjacent standalone .besl source file.",
  "oneOf": [
    { "$ref": "#/$defs/raster" },
    { "$ref": "#/$defs/compute" },
    { "$ref": "#/$defs/tile" },
    { "$ref": "#/$defs/task" },
    { "$ref": "#/$defs/mesh" },
    { "$ref": "#/$defs/rayTracing" }
  ],
  "$defs": {
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "layouts": {
      "description": "Layout layer .besl files this shader builds on, relative to the shader's directory. Layers stack in order: each layer can reference the layers before it, and the shader can reference all of them.",
      "type": "array",
      "items": { "type": "string" }
    },
    "workgroup": {
      "description": "Positive workgroup dimensions. Omitted width, height, or depth dimensions default to 1.",
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/positiveInteger" },
            { "$ref": "#/$defs/positiveInteger" },
            { "$ref": "#/$defs/positiveInteger" }
          ],
          "items": false
        },
        {
          "type": "object",
          "properties": {
            "width": { "$ref": "#/$defs/positiveInteger" },
            "height": { "$ref": "#/$defs/positiveInteger" },
            "depth": { "$ref": "#/$defs/positiveInteger" }
          },
          "additionalProperties": false
        }
      ]
    },
    "raster": {
      "type": "object",
      "properties": { "$schema": { "type": "string" }, "stage": { "enum": ["Vertex", "Fragment"] }, "layouts": { "$ref": "#/$defs/layouts" } },
      "required": ["stage"],
      "additionalProperties": false
    },
    "rayTracing": {
      "type": "object",
      "properties": { "$schema": { "type": "string" }, "stage": { "enum": ["RayGeneration", "ClosestHit"] }, "layouts": { "$ref": "#/$defs/layouts" } },
      "required": ["stage"],
      "additionalProperties": false
    },
    "compute": {
      "type": "object",
      "properties": { "$schema": { "type": "string" }, "stage": { "const": "Compute" }, "layouts": { "$ref": "#/$defs/layouts" }, "workgroup": { "$ref": "#/$defs/workgroup" } },
      "required": ["stage"],
      "additionalProperties": false
    },
    "tile": {
      "description": "A compute-like screen-pass shader whose results are color attachments. Metal runs it as a tile function inside a render pass; other platforms run it as a compute shader.",
      "type": "object",
      "properties": {
        "$schema": { "type": "string" },
        "stage": { "const": "Tile" },
        "layouts": { "$ref": "#/$defs/layouts" },
        "tile": { "description": "Pixels along each edge of a square tile.", "enum": [16, 32] },
        "workgroup": {
          "description": "Threads per tile: a square that divides the tile by 1, 2, or 4, with at most 256 threads. Defaults to one thread per pixel.",
          "$ref": "#/$defs/workgroup"
        }
      },
      "required": ["stage", "tile"],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
		"$schema": { "type": "string" },
        "stage": { "const": "Task" },
        "layouts": { "$ref": "#/$defs/layouts" },
        "workgroup": { "$ref": "#/$defs/workgroup" },
        "maximum_mesh_threadgroups": { "$ref": "#/$defs/positiveInteger" }
      },
      "required": ["stage", "maximum_mesh_threadgroups"],
      "additionalProperties": false
    },
    "mesh": {
      "type": "object",
      "properties": {
		"$schema": { "type": "string" },
        "stage": { "const": "Mesh" },
        "layouts": { "$ref": "#/$defs/layouts" },
        "workgroup": { "$ref": "#/$defs/workgroup" },
        "maximum_vertices": { "$ref": "#/$defs/positiveInteger" },
        "maximum_primitives": { "$ref": "#/$defs/positiveInteger" }
      },
      "required": ["stage", "maximum_vertices", "maximum_primitives"],
      "additionalProperties": false
    }
  }
}
