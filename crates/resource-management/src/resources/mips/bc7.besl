// Encodes RGBA8 texels into BC7 blocks, one 4x4 block per invocation.
//
// The search follows the "ultra fast" profile of Intel's ISPC texture compressor. Opaque blocks are encoded in mode 6.
// Blocks with transparency try modes 6, 5, and 4. Every candidate places its endpoints on the principal axis of the
// block's texels, then refines them with least squares, and the block keeps the candidate with the smallest squared
// error.

source: descriptor<{ type: Texture2D, binding: 0, access: read }>;
blocks: descriptor<{ type: vec4u[], binding: 1, access: write }>;

push_constant: push_constant {
	// Size of the source level in texels. Blocks that cross its edges repeat the last row and column.
	width: u32,
	height: u32,
	// Size of the level in blocks. Invocations outside it do nothing.
	blocks_x: u32,
	blocks_y: u32,
	// Index in `blocks` of the level's first block, so one buffer can hold a whole mip chain.
	first_block: u32,
}

// Interpolation weights out of 64 for 2-, 3-, and 4-bit indices. They start at offsets 0, 4, and 12, which is the
// palette size minus 4.
WEIGHTS: const u32[28] = u32[28](0, 21, 43, 64, 0, 9, 18, 27, 37, 46, 55, 64, 0, 4, 9, 13, 17, 21, 26, 30, 34, 38, 43, 47, 51, 55, 60, 64);

// Larger than any squared block error, which stays below 16 * 4 * 255 * 255.
NO_ERROR_YET: const f32 = 100000000.0;

// Describes how one set of endpoints and indices is stored.
Format: struct {
	index_bits: u32,
	// Bits of each stored endpoint channel, including the p-bit when the format has one.
	endpoint_bits: u32,
	// 1 when each endpoint stores a p-bit, its lowest bit, and 0 without p-bits.
	pbits: u32,
	// 1.0 for each channel the subset encodes. The other channels don't count toward its error.
	channels: vec4f,
	// How many least-squares passes follow the principal-axis guess.
	refinements: u32,
	// 1 forces every p-bit to 1 so that mode 6 keeps the alpha of an opaque block at exactly 255.
	opaque: u32,
}

// Endpoints in the 0 to 255 range before quantization.
Endpoints: struct {
	low: vec4f,
	high: vec4f,
}

// Stored endpoint values. The p-bit, when the format has one, is each value's lowest bit.
Codes: struct {
	low: vec4u,
	high: vec4u,
}

// Palette indices, 4 bits per texel with texels 0 to 7 in `x`, and their total squared error.
Fit: struct {
	indices: vec2u,
	error: f32,
}

// One encoded set of endpoints and indices for the whole block.
Subset: struct {
	low: vec4u,
	high: vec4u,
	indices: vec2u,
	error: f32,
}

// One complete block and its squared error.
Candidate: struct {
	error: f32,
	bits: vec4u,
}

// A 128-bit block under construction and the position of its next free bit.
Bits: struct {
	words: vec4u,
	position: u32,
}

// Appends the low `count` bits of `value` to the block, least significant bit first.
put: fn (bits: Bits, value: u32, count: u32) -> Bits {
	let result: Bits = bits;
	let word: u32 = bits.position >> 5;
	let shift: u32 = bits.position & 31;
	result.words[word] = result.words[word] | (value << shift);
	// A field that crosses a word boundary continues in the next word.
	if (shift + count > 32) {
		result.words[word + 1] = result.words[word + 1] | (value >> (32 - shift));
	}
	result.position = bits.position + count;
	return result;
}

index_at: fn (indices: vec2u, texel: u32) -> u32 {
	if (texel < 8) {
		return (indices.x >> (texel * 4)) & 15;
	}
	return (indices.y >> ((texel - 8) * 4)) & 15;
}

// Sets the index of `texel`, which must still be 0.
with_index: fn (indices: vec2u, texel: u32, index: u32) -> vec2u {
	let result: vec2u = indices;
	if (texel < 8) {
		result.x = result.x | (index << (texel * 4));
	} else {
		result.y = result.y | (index << ((texel - 8) * 4));
	}
	return result;
}

clamp_color: fn (value: vec4f) -> vec4f {
	return vec4f(clamp(value.x, 0.0, 255.0), clamp(value.y, 0.0, 255.0), clamp(value.z, 0.0, 255.0), clamp(value.w, 0.0, 255.0));
}

// Widens a stored endpoint value to 8 bits by repeating its top bits, as BC7 decoders do.
expand: fn (value: u32, bits: u32) -> u32 {
	return (value << (8 - bits)) | (value >> (2 * bits - 8));
}

expand_codes: fn (codes: vec4u, bits: u32) -> vec4f {
	return vec4f(f32(expand(codes.x, bits)), f32(expand(codes.y, bits)), f32(expand(codes.z, bits)), f32(expand(codes.w, bits)));
}

// Returns the stored value whose expansion is closest to `value`. With p-bits, only values whose lowest bit equals
// `pbit` are candidates.
quantize_channel: fn (value: f32, format: Format, pbit: u32) -> u32 {
	let bits: u32 = format.endpoint_bits;
	let scaled: f32 = value * f32((1 << bits) - 1) / 255.0;
	let step: u32 = 1;
	let first: u32 = 0;
	if (format.pbits != 0) {
		step = 2;
		first = pbit;
	}
	let steps: u32 = ((1 << bits) - 1 - first) / step;
	let guess: u32 = u32(clamp(floor((scaled - f32(first)) / f32(step) + 0.5), 0.0, f32(steps)));

	// Rounding in the stored domain can miss the nearest expansion by one step, so compare the neighbors too.
	let rounded: u32 = first + guess * step;
	let best: u32 = rounded;
	let best_error: f32 = abs(f32(expand(rounded, bits)) - value);
	if (guess > 0) {
		let lower_error: f32 = abs(f32(expand(rounded - step, bits)) - value);
		if (lower_error < best_error) {
			best = rounded - step;
			best_error = lower_error;
		}
	}
	if (guess < steps) {
		let upper_error: f32 = abs(f32(expand(rounded + step, bits)) - value);
		if (upper_error < best_error) {
			best = rounded + step;
		}
	}
	return best;
}

// Returns the stored value whose expansion is closest to `value` from below, or from above when `upward` is set. When
// nothing is stored on that side, returns the nearest value.
quantize_toward: fn (value: f32, format: Format, pbit: u32, upward: bool) -> u32 {
	let nearest: u32 = quantize_channel(value, format, pbit);
	let expanded: f32 = f32(expand(nearest, format.endpoint_bits));
	// Stepping by 2 keeps the p-bit, which is the stored value's lowest bit.
	let step: u32 = 1;
	if (format.pbits != 0) {
		step = 2;
	}
	if (upward) {
		if (expanded < value && nearest + step < (1 << format.endpoint_bits)) {
			return nearest + step;
		}
	} else {
		if (expanded > value && nearest >= step) {
			return nearest - step;
		}
	}
	return nearest;
}

quantize_endpoint: fn (value: vec4f, format: Format, pbit: u32) -> vec4u {
	return vec4u(quantize_channel(value.x, format, pbit), quantize_channel(value.y, format, pbit), quantize_channel(value.z, format, pbit), quantize_channel(value.w, format, pbit));
}

endpoint_error: fn (value: vec4f, codes: vec4u, format: Format) -> f32 {
	let difference: vec4f = (expand_codes(codes, format.endpoint_bits) - value) * format.channels;
	return dot(difference, difference);
}

// Quantizes one endpoint and picks the p-bit that represents it best. Formats without p-bits ignore the p-bit
// argument.
quantize_single: fn (value: vec4f, format: Format) -> vec4u {
	let odd: vec4u = quantize_endpoint(value, format, 1);
	if (format.pbits == 0 || format.opaque != 0) {
		return odd;
	}
	let even: vec4u = quantize_endpoint(value, format, 0);
	if (endpoint_error(value, even, format) < endpoint_error(value, odd, format)) {
		return even;
	}
	return odd;
}

// Interpolates between two expanded endpoints with a weight out of 64, rounding as BC7 decoders do.
interpolate: fn (low: vec4f, high: vec4f, weight: u32) -> vec4f {
	let w: f32 = f32(weight);
	let value: vec4f = (low * (64.0 - w) + high * w + vec4f(32.0, 32.0, 32.0, 32.0)) / 64.0;
	return vec4f(floor(value.x), floor(value.y), floor(value.z), floor(value.w));
}

palette_error: fn (pixel: vec4f, low: vec4f, high: vec4f, weight: u32, channels: vec4f) -> f32 {
	let difference: vec4f = (interpolate(low, high, weight) - pixel) * channels;
	return dot(difference, difference);
}

// Picks the palette entry for every texel by rounding its projection onto the endpoint line. The palette
// weights are within one part in 64 of evenly spaced, so the rounded entry is the nearest one for all but texels
// that sit almost exactly between two entries, and checking the neighbors costs more than it recovers.
fit_indices: fn (pixels: vec4f[16], low: vec4f, high: vec4f, format: Format) -> Fit {
	let entries: u32 = 1 << format.index_bits;
	let offset: u32 = entries - 4;
	let direction: vec4f = (high - low) * format.channels;
	let length: f32 = dot(direction, direction);
	let scale: f32 = 0.0;
	if (length > 0.0) {
		scale = f32(entries - 1) / length;
	}

	let result: Fit = Fit(vec2u(0, 0), 0.0);
	for (let texel: u32 = 0; texel < 16; texel = texel + 1) {
		let pixel: vec4f = pixels[texel];
		let projected: f32 = dot(pixel - low, direction) * scale;
		let entry: u32 = u32(clamp(floor(projected + 0.5), 0.0, f32(entries - 1)));
		result.indices = with_index(result.indices, texel, entry);
		result.error = result.error + palette_error(pixel, low, high, WEIGHTS[offset + entry], format.channels);
	}
	return result;
}

// Returns a unit vector along the direction of greatest variance of a symmetric 4x4 matrix, given by its rows, or
// zero when every row is zero. A few power iterations from the row with the largest diagonal are enough to rank
// directions for block compression.
principal_axis: fn (row0: vec4f, row1: vec4f, row2: vec4f, row3: vec4f) -> vec4f {
	let axis: vec4f = row0;
	let largest: f32 = row0.x;
	if (row1.y > largest) {
		axis = row1;
		largest = row1.y;
	}
	if (row2.z > largest) {
		axis = row2;
		largest = row2.z;
	}
	if (row3.w > largest) {
		axis = row3;
	}
	for (let iteration: u32 = 0; iteration < 4; iteration = iteration + 1) {
		axis = vec4f(dot(row0, axis), dot(row1, axis), dot(row2, axis), dot(row3, axis));
		// Rescaling keeps the iteration away from overflow; only the direction matters.
		let size: f32 = max(max(abs(axis.x), abs(axis.y)), max(abs(axis.z), abs(axis.w)));
		if (size > 0.0) {
			axis = axis / size;
		}
	}
	let length: f32 = dot(axis, axis);
	if (length > 0.0) {
		return axis * inversesqrt(length);
	}
	return vec4f(0.0, 0.0, 0.0, 0.0);
}

// Places the endpoints at the extremes of the block's texels along their principal axis.
principal_endpoints: fn (pixels: vec4f[16], channels: vec4f) -> Endpoints {
	let sum: vec4f = vec4f(0.0, 0.0, 0.0, 0.0);
	for (let texel: u32 = 0; texel < 16; texel = texel + 1) {
		sum = sum + pixels[texel] * channels;
	}
	let mean: vec4f = sum / 16.0;

	let row0: vec4f = vec4f(0.0, 0.0, 0.0, 0.0);
	let row1: vec4f = vec4f(0.0, 0.0, 0.0, 0.0);
	let row2: vec4f = vec4f(0.0, 0.0, 0.0, 0.0);
	let row3: vec4f = vec4f(0.0, 0.0, 0.0, 0.0);
	for (let texel: u32 = 0; texel < 16; texel = texel + 1) {
		let offset: vec4f = pixels[texel] * channels - mean;
		row0 = row0 + offset * offset.x;
		row1 = row1 + offset * offset.y;
		row2 = row2 + offset * offset.z;
		row3 = row3 + offset * offset.w;
	}
	let axis: vec4f = principal_axis(row0, row1, row2, row3);

	let lowest: f32 = NO_ERROR_YET;
	let highest: f32 = 0.0 - NO_ERROR_YET;
	for (let texel: u32 = 0; texel < 16; texel = texel + 1) {
		let position: f32 = dot(pixels[texel] * channels - mean, axis);
		lowest = min(lowest, position);
		highest = max(highest, position);
	}
	return Endpoints(clamp_color(mean + axis * lowest), clamp_color(mean + axis * highest));
}

// Solves for the endpoints that minimize the block's squared error with its current indices. Keeps the previous
// endpoints when every texel uses the same weight, which leaves the system without a unique solution.
refine_endpoints: fn (pixels: vec4f[16], indices: vec2u, previous: Endpoints, format: Format) -> Endpoints {
	let offset: u32 = (1 << format.index_bits) - 4;
	let low_low: f32 = 0.0;
	let low_high: f32 = 0.0;
	let high_high: f32 = 0.0;
	let toward_low: vec4f = vec4f(0.0, 0.0, 0.0, 0.0);
	let toward_high: vec4f = vec4f(0.0, 0.0, 0.0, 0.0);
	for (let texel: u32 = 0; texel < 16; texel = texel + 1) {
		let weight: f32 = f32(WEIGHTS[offset + index_at(indices, texel)]) / 64.0;
		let inverse: f32 = 1.0 - weight;
		low_low = low_low + inverse * inverse;
		low_high = low_high + inverse * weight;
		high_high = high_high + weight * weight;
		toward_low = toward_low + pixels[texel] * inverse;
		toward_high = toward_high + pixels[texel] * weight;
	}
	let determinant: f32 = low_low * high_high - low_high * low_high;
	if (determinant < 0.0001) {
		return previous;
	}
	let low: vec4f = (toward_low * high_high - toward_high * low_high) / determinant;
	let high: vec4f = (toward_high * low_low - toward_low * low_high) / determinant;
	return Endpoints(clamp_color(low), clamp_color(high));
}

// Encodes a block whose 16 texels all hold `color`.
//
// Least squares can't spread identical texels over the palette, and both endpoints would round to the same stored
// value. Instead, the endpoints bracket the color from below and above, and every texel uses the palette entry that
// lands closest to it. Every allowed p-bit pair is tried.
encode_uniform_subset: fn (color: vec4f, format: Format) -> Subset {
	let entries: u32 = 1 << format.index_bits;
	let offset: u32 = entries - 4;
	let best: Subset = Subset(vec4u(0, 0, 0, 0), vec4u(0, 0, 0, 0), vec2u(0, 0), NO_ERROR_YET);
	let best_entry: u32 = 0;
	for (let pbits: u32 = 0; pbits < 4; pbits = pbits + 1) {
		let low_pbit: u32 = pbits & 1;
		let high_pbit: u32 = pbits >> 1;
		// Formats without p-bits, or opaque mode 6, allow only some pairs.
		let allowed: bool = true;
		if (format.pbits == 0 && pbits != 0) {
			allowed = false;
		}
		if (format.opaque != 0 && pbits != 3) {
			allowed = false;
		}
		if (allowed) {
			let low: vec4u = vec4u(quantize_toward(color.x, format, low_pbit, false), quantize_toward(color.y, format, low_pbit, false), quantize_toward(color.z, format, low_pbit, false), quantize_toward(color.w, format, low_pbit, false));
			let high: vec4u = vec4u(quantize_toward(color.x, format, high_pbit, true), quantize_toward(color.y, format, high_pbit, true), quantize_toward(color.z, format, high_pbit, true), quantize_toward(color.w, format, high_pbit, true));
			let low_expanded: vec4f = expand_codes(low, format.endpoint_bits);
			let high_expanded: vec4f = expand_codes(high, format.endpoint_bits);
			for (let entry: u32 = 0; entry < entries; entry = entry + 1) {
				let error: f32 = palette_error(color, low_expanded, high_expanded, WEIGHTS[offset + entry], format.channels);
				if (error < best.error) {
					best = Subset(low, high, vec2u(0, 0), error);
					best_entry = entry;
				}
			}
		}
	}

	// Every texel shares the entry, so it can't be an anchor with its top bit set; swapping the endpoints mirrors it.
	let low: vec4u = best.low;
	let high: vec4u = best.high;
	if (best_entry >= entries / 2) {
		low = best.high;
		high = best.low;
		best_entry = entries - 1 - best_entry;
	}
	let indices: vec2u = vec2u(0, 0);
	for (let texel: u32 = 0; texel < 16; texel = texel + 1) {
		indices = with_index(indices, texel, best_entry);
	}
	return Subset(low, high, indices, best.error * 16.0);
}

// Encodes the block's channels that `format` stores with one set of endpoints and indices. Texel 0's index must keep
// its top bit clear, so the endpoints swap when the best fit sets it.
encode_subset: fn (pixels: vec4f[16], format: Format) -> Subset {
	// A block of identical texels takes the exact single-color path.
	let first: vec4f = pixels[0];
	let spread: f32 = 0.0;
	for (let texel: u32 = 1; texel < 16; texel = texel + 1) {
		let difference: vec4f = (pixels[texel] - first) * format.channels;
		spread = spread + dot(difference, difference);
	}
	if (spread == 0.0) {
		return encode_uniform_subset(first, format);
	}

	let endpoints: Endpoints = principal_endpoints(pixels, format.channels);
	let best: Subset = Subset(vec4u(0, 0, 0, 0), vec4u(0, 0, 0, 0), vec2u(0, 0), NO_ERROR_YET);
	for (let pass: u32 = 0; pass <= format.refinements; pass = pass + 1) {
		let codes: Codes = Codes(quantize_single(endpoints.low, format), quantize_single(endpoints.high, format));
		let low: vec4f = expand_codes(codes.low, format.endpoint_bits);
		let high: vec4f = expand_codes(codes.high, format.endpoint_bits);
		let fit: Fit = fit_indices(pixels, low, high, format);
		if (fit.error < best.error) {
			best = Subset(codes.low, codes.high, fit.indices, fit.error);
		}
		if (pass < format.refinements) {
			endpoints = refine_endpoints(pixels, fit.indices, endpoints, format);
		}
	}

	let entries: u32 = 1 << format.index_bits;
	if (index_at(best.indices, 0) < entries / 2) {
		return best;
	}
	let flipped: vec2u = vec2u(0, 0);
	for (let texel: u32 = 0; texel < 16; texel = texel + 1) {
		flipped = with_index(flipped, texel, entries - 1 - index_at(best.indices, texel));
	}
	return Subset(best.high, best.low, flipped, best.error);
}

// Appends the 16 texel indices of `index_bits` bits each. Texel 0 drops its implied top bit.
put_indices: fn (bits: Bits, indices: vec2u, index_bits: u32) -> Bits {
	let result: Bits = bits;
	for (let texel: u32 = 0; texel < 16; texel = texel + 1) {
		let width: u32 = index_bits;
		if (texel == 0) {
			width = index_bits - 1;
		}
		result = put(result, index_at(indices, texel), width);
	}
	return result;
}

// Packs a mode 6 block: one subset, 7-bit RGBA endpoints with a p-bit each, and 4-bit indices.
pack_mode6: fn (subset: Subset) -> vec4u {
	let bits: Bits = Bits(vec4u(0, 0, 0, 0), 0);
	bits = put(bits, 64, 7);
	for (let channel: u32 = 0; channel < 4; channel = channel + 1) {
		bits = put(bits, subset.low[channel] >> 1, 7);
		bits = put(bits, subset.high[channel] >> 1, 7);
	}
	bits = put(bits, subset.low.x & 1, 1);
	bits = put(bits, subset.high.x & 1, 1);
	bits = put_indices(bits, subset.indices, 4);
	return bits.words;
}

// Encodes mode 6: 7-bit RGBA endpoints with a p-bit each, and 4-bit indices. Opaque blocks refine once, as the
// profile's opaque search does; blocks with transparency refine twice.
encode_mode6: fn (pixels: vec4f[16], opaque: u32) -> Candidate {
	let refinements: u32 = 2;
	if (opaque != 0) {
		refinements = 1;
	}
	let subset: Subset = encode_subset(pixels, Format(4, 8, 1, vec4f(1.0, 1.0, 1.0, 1.0), refinements, opaque));
	return Candidate(subset.error, pack_mode6(subset));
}

// Encodes mode 4 or 5, which store alpha with its own endpoints and indices. In mode 4, `index_selection` 1 swaps
// which of the two index sets holds color and which holds alpha.
encode_separate_alpha: fn (pixels: vec4f[16], mode: u32, index_selection: u32) -> Candidate {
	let color_bits: u32 = 7;
	let alpha_bits: u32 = 8;
	let color_indices: u32 = 2;
	let alpha_indices: u32 = 2;
	// The second index set is the 3-bit one in mode 4, whichever of color and alpha it holds.
	let second_bits: u32 = 2;
	if (mode == 4) {
		color_bits = 5;
		alpha_bits = 6;
		color_indices = 2 + index_selection;
		alpha_indices = 3 - index_selection;
		second_bits = 3;
	}
	// Color and alpha refine once each, as the profile's search for these modes does.
	let color: Subset = encode_subset(pixels, Format(color_indices, color_bits, 0, vec4f(1.0, 1.0, 1.0, 0.0), 1, 0));
	let alpha: Subset = encode_subset(pixels, Format(alpha_indices, alpha_bits, 0, vec4f(0.0, 0.0, 0.0, 1.0), 1, 0));

	let bits: Bits = Bits(vec4u(0, 0, 0, 0), 0);
	bits = put(bits, 1 << mode, mode + 1);
	// Rotation 0 keeps alpha in the alpha channel.
	bits = put(bits, 0, 2);
	if (mode == 4) {
		bits = put(bits, index_selection, 1);
	}
	for (let channel: u32 = 0; channel < 3; channel = channel + 1) {
		bits = put(bits, color.low[channel], color_bits);
		bits = put(bits, color.high[channel], color_bits);
	}
	bits = put(bits, alpha.low.w, alpha_bits);
	bits = put(bits, alpha.high.w, alpha_bits);

	// The 2-bit index set comes first. It holds color unless mode 4 selects the swap.
	let first: Subset = color;
	let second: Subset = alpha;
	if (index_selection == 1) {
		first = alpha;
		second = color;
	}
	bits = put_indices(bits, first.indices, 2);
	bits = put_indices(bits, second.indices, second_bits);
	return Candidate(color.error + alpha.error, bits.words);
}

better: fn (current: Candidate, candidate: Candidate) -> Candidate {
	if (candidate.error < current.error) {
		return candidate;
	}
	return current;
}

// Candidates only replace a strictly better one, so the search stops as soon as a block is encoded without error.
encode_transparent: fn (pixels: vec4f[16]) -> Candidate {
	let best: Candidate = encode_mode6(pixels, 0);
	if (best.error == 0.0) {
		return best;
	}
	best = better(best, encode_separate_alpha(pixels, 5, 0));
	if (best.error == 0.0) {
		return best;
	}
	best = better(best, encode_separate_alpha(pixels, 4, 0));
	return better(best, encode_separate_alpha(pixels, 4, 1));
}

// Reads texel `index` of a block in 0 to 255 units, repeating the level's last row and column past its edges.
texel: fn (block: vec2u, index: u32) -> vec4f {
	let x: u32 = min(block.x * 4 + (index & 3), push_constant.width - 1);
	let y: u32 = min(block.y * 4 + (index >> 2), push_constant.height - 1);
	let value: vec4f = fetch(source, vec2u(x, y)) * 255.0;
	return vec4f(floor(value.x + 0.5), floor(value.y + 0.5), floor(value.z + 0.5), floor(value.w + 0.5));
}

main: fn (input: StageInput) -> void {
	let block: vec2u = input.thread_id;
	if (block.x >= push_constant.blocks_x || block.y >= push_constant.blocks_y) {
		return;
	}
	let pixels: vec4f[16] = vec4f[16](texel(block, 0), texel(block, 1), texel(block, 2), texel(block, 3), texel(block, 4), texel(block, 5), texel(block, 6), texel(block, 7), texel(block, 8), texel(block, 9), texel(block, 10), texel(block, 11), texel(block, 12), texel(block, 13), texel(block, 14), texel(block, 15));

	let opaque: bool = true;
	for (let index: u32 = 0; index < 16; index = index + 1) {
		if (pixels[index].w < 255.0) {
			opaque = false;
		}
	}
	let best: Candidate = Candidate(0.0, vec4u(0, 0, 0, 0));
	if (opaque) {
		best = encode_mode6(pixels, 1);
	} else {
		best = encode_transparent(pixels);
	}
	blocks[push_constant.first_block + block.y * push_constant.blocks_x + block.x] = best.bits;
}
