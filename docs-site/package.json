{
  "name": "docs-site",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "bun run check:style && bun run generate:api && bun run build:site && bun run check:links",
    "build:site": "vite build",
    "check:links": "bun ../scripts/check-doc-links.mjs",
    "check:style": "vale sync && vale ../docs",
    "deploy": "wrangler deploy",
    "dev": "vite dev",
    "generate:api": "../scripts/generate-api-docs.sh",
    "postinstall": "fumadocs-mdx",
    "start": "bun .output/server/index.mjs",
    "test": "bun test test"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-start": "^1.168.27",
    "fumadocs-core": "^16.15.4",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-openapi": "^11.3.5",
    "fumadocs-ui": "^16.15.4",
    "hast-util-to-jsx-runtime": "2.3.6",
    "next-themes": "^0.4.6",
    "nucleo-glass": "^1.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "unified": "11.0.5",
    "vite": "^8.1.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.43.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/bun": "^1.4.4",
    "@types/hast": "3.0.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vvago/vale": "3.24.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.107.0"
  },
  "trustedDependencies": [
    "@vvago/vale"
  ]
}
